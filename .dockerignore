# Build artefacts — regenerated by dotnet publish
**/bin/
**/obj/

# Runtime data — never send user state or secrets to the Docker build context.
# Committed distributable defaults under config/ remain available to the
# Dockerfile; the exclusions below are deliberately narrower than config/.
config/secrets/
config/backups/
config/**/*.bak
config/**/*.tmp
config/ui/library-preferences.json
config/ui/profiles/*
!config/ui/profiles/example-profile.json
*.db
*.db-shm
*.db-wal

# Editor and OS noise
.vs/
.idea/
**/.DS_Store
**/Thumbs.db

# Git
.git/
.gitignore

# Test output
**/TestResults/

# Large binary tools (ffmpeg — downloaded separately, not part of the image)
tools/ffmpeg/

# Node (if any)
**/node_modules/

# Secrets / local settings
appsettings.*.json
