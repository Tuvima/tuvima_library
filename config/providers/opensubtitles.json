{
  "name": "opensubtitles",
  "version": "1.0",
  "enabled": false,
  "weight": 0.75,
  "domain": "Video",
  "icon": "images/providers/opensubtitles.png",
  "capability_tags": ["subtitles", "webvtt", "srt"],
  "provider_capabilities": ["subtitles"],
  "available_fields": ["subtitles"],
  "field_weights": {
    "subtitles": 0.85
  },
  "endpoints": {
    "api": "https://api.opensubtitles.com/api/v1"
  },
  "rate_limit": {
    "requests_per_second": 1,
    "burst": 1,
    "max_concurrency": 1
  },
  "hydration_stages": [],
  "cache_ttl_hours": 168,
  "adapter_type": "text_track",
  "provider_id": "be00000e-0000-4000-8000-000000000016",
  "display_name": "OpenSubtitles",
  "requires_api_key": true,
  "language_strategy": "localized",
  "http_client": {
    "timeout_seconds": 20,
    "user_agent": "Tuvima Library/1.0 (https://github.com/shyfaruqi/tuvima-library)",
    "api_key_delivery": "header",
    "api_key_param_name": "Api-Key"
  },
  "can_handle": {
    "media_types": ["Movies", "TV"],
    "entity_types": ["MediaAsset"]
  },
  "preferred_bridge_ids": {
    "Movies": ["imdb_id", "tmdb_id"],
    "TV": ["imdb_id", "tmdb_id"]
  },
  "ui_metadata": {
    "accent_color": "#0F8BFD",
    "material_icon": "Subtitles",
    "category": "Enrichment",
    "requires_key": true,
    "auth_type": "api_key",
    "search_chips": {
      "Movies": ["IMDb/TMDB", "Language"],
      "TV": ["IMDb/TMDB", "Season", "Episode", "Language"]
    },
    "ranking_chips": {
      "Movies": ["Download count", "Exact ID"],
      "TV": ["Episode match", "Language"]
    }
  },
  "onboarding": {
    "classification": "optional",
    "signup_url": "https://www.opensubtitles.com/en/consumers",
    "help_url": "https://opensubtitles.stoplight.io/docs/opensubtitles-api/b1eb44d4c8502-open-subtitles-api",
    "terms_url": "https://www.opensubtitles.com/en/tos",
    "privacy_url": "https://www.opensubtitles.com/en/privacy",
    "supported_lanes": ["watch"],
    "required_scopes": ["Read-only OpenSubtitles API access"],
    "skip_consequences": [
      { "lane": "watch", "summary": "Movies and owned TV episodes will not receive downloadable subtitles from OpenSubtitles.", "unavailable_capabilities": ["subtitles"] }
    ],
    "credentials": [
      { "key": "api_key", "label": "OpenSubtitles API Key", "input_type": "password", "required": true, "format_hint": "The API key assigned to your OpenSubtitles consumer application.", "minimum_length": 16, "maximum_length": 128, "validation_pattern": "^[A-Za-z0-9_-]+$" }
    ],
    "authentication_probe": { "path": "/infos/formats", "method": "GET", "success_status_codes": [200] }
  }
}
