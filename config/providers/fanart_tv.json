{
  "name": "fanart_tv",
  "display_name": "Fanart.tv",
  "provider_id": "bc00000c-0000-4000-8000-000000000013",
  "adapter_type": "config_driven",
  "enabled": true,
  "icon": "images/providers/fanart_tv.png",
  "hydration_stages": [3],
  "provider_capabilities": ["artwork"],
  "requires_api_key": true,

  "can_handle": {
    "media_types": ["Movies", "TV", "Music"],
    "entity_types": ["Work", "MediaAsset"]
  },

  "rate_limit": {
    "requests_per_second": 2,
    "burst": 2,
    "max_concurrency": 2
  },
  "cache_ttl_hours": 336,

  "endpoints": {
    "api": "https://webservice.fanart.tv/v3"
  },

  "http_client": {
    "timeout_seconds": 15,
    "user_agent": "Tuvima Library/1.0",
    "api_key": "",
    "api_key_delivery": "query",
    "api_key_param_name": "api_key"
  },

  "search_strategies": [
    {
      "name": "movie_lookup",
      "required_fields": ["tmdb_id"],
      "url_template": "{base_url}/movies/{tmdb_id}?api_key={api_key}",
      "method": "GET",
      "response_format": "json"
    },
    {
      "name": "tv_lookup",
      "required_fields": ["tvdb_id"],
      "url_template": "{base_url}/tv/{tvdb_id}?api_key={api_key}",
      "method": "GET",
      "response_format": "json"
    },
    {
      "name": "music_lookup",
      "required_fields": ["musicbrainz_id"],
      "url_template": "{base_url}/music/{musicbrainz_id}?api_key={api_key}",
      "method": "GET",
      "response_format": "json"
    }
  ],

  "character_art_fields": {
    "Movies": "characterart",
    "TV": "characterart"
  },

  "language_strategy": "source",
  "ui_metadata": {
    "accent_color": "#19C1CC",
    "material_icon": "Image",
    "external_url_template": "",
    "category": "Image",
    "requires_key": true,
    "auth_type": "api_key",
    "search_chips": {},
    "ranking_chips": {}
  },
  "onboarding": {
    "classification": "optional",
    "signup_url": "https://fanart.tv/get-an-api-key/",
    "help_url": "https://fanart.tv/api-docs/",
    "terms_url": "https://fanart.tv/terms-of-service/",
    "privacy_url": "https://fanart.tv/privacy-policy/",
    "supported_lanes": ["watch", "listen"],
    "required_scopes": ["Read-only Fanart.tv API access"],
    "skip_consequences": [
      { "lane": "watch", "summary": "Movies and TV shows will use other artwork sources and may have fewer logos or backgrounds.", "unavailable_capabilities": ["artwork"] },
      { "lane": "listen", "summary": "Music will use other artwork sources and may have fewer artist or album images.", "unavailable_capabilities": ["artwork"] }
    ],
    "credentials": [
      { "key": "api_key", "label": "Fanart.tv API Key", "input_type": "password", "required": true, "format_hint": "The personal API key from your Fanart.tv account.", "minimum_length": 16, "maximum_length": 128, "validation_pattern": "^[A-Za-z0-9_-]+$" }
    ],
    "authentication_probe": { "path": "/movies/603", "method": "GET", "success_status_codes": [200] }
  }
}
