{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuvima pipeline configuration",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "strategy": { "enum": ["Waterfall", "Cascade", "Sequential"] },
      "max_provider_attempts": { "type": "integer", "minimum": 1 },
      "scoring": {
        "type": "object",
        "properties": {
          "creator_list_mode": {
            "enum": ["proportional", "local-primary-containment"]
          },
          "auto_accept_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "ambiguous_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      },
      "providers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["rank", "name", "purpose"],
          "properties": {
            "rank": { "type": "integer", "minimum": 1 },
            "name": { "type": "string", "minLength": 1 },
            "purpose": {
              "type": "string",
              "enum": ["identity", "enrichment", "retail", "artwork", "text-track", "canonical"]
            },
            "requires_identity": { "type": "boolean", "default": false },
            "use_as_identity_fallback": { "type": "boolean", "default": false },
            "accepted_actions": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["apple-album-manifest"] }
            },
            "accepted_transition": {
              "type": "object",
              "required": ["when", "provider", "max_attempts", "hint_fields"],
              "properties": {
                "when": { "enum": ["accepted", "identity-fallback-accepted"] },
                "provider": { "type": "string", "minLength": 1 },
                "max_attempts": { "type": "integer", "minimum": 1 },
                "hint_fields": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": true
  }
}
