{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuvima hydration configuration",
  "type": "object",
  "properties": {
    "stage1_timeout_seconds": { "type": "integer", "minimum": 1 },
    "quick_hydration_timeout_seconds": { "type": "integer", "minimum": 1 },
    "auto_review_confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "collection_rollup_relationship_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
