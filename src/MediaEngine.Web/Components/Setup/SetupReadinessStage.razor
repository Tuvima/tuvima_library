@namespace MediaEngine.Web.Components.Setup
@using MediaEngine.Contracts.Setup

<div class="setup-stage-content">
    <div class="setup-stage__heading"><MudIcon Icon="@Icons.Material.Outlined.TaskAlt" /><div><h2 id="setup-stage-title">@(Readiness?.CanComplete == true ? "Ready to begin" : "Checking readiness…")</h2><p>Tuvima is confirming the core server capabilities needed to begin.</p></div></div>
    @if (Readiness is null || Busy && !Readiness.CanComplete)
    {
        <div class="setup-preparing" role="status"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Checking administrator, media locations, providers, and server capabilities…</span></div>
    }
    else
    {
        @if (!Readiness.CanComplete)
        {
            <AppAlert Tone="AppUiTone.Warning">Needs attention</AppAlert>
        }
        <div class="setup-checks">
            @foreach (var capability in Readiness.Capabilities.Where(item => item.Key != "readiness"))
            {
                <article><AppStatusBadge Text="@StatusLabel(capability.Status)" Tone="@StatusTone(capability.Status)" /><div><strong>@CapabilityLabel(capability.Key)</strong><small>@capability.Detail</small>@if (!string.IsNullOrWhiteSpace(capability.RepairTarget) && capability.Status is not "passed") { <a href="@capability.RepairTarget">@(capability.Status == "deferred" ? "Set up later" : "Fix")</a> }</div></article>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(SampleScanDetail))
        {
            <AppAlert Tone="AppUiTone.Info">@SampleScanDetail</AppAlert>
        }
        <div class="setup-actions setup-actions--end"><AppButton Label="Run a sample scan" StartIcon="@Icons.Material.Outlined.Search" ButtonStyle="AppButtonStyle.Text" Loading="@Busy" Disabled="@(!Readiness.CanComplete)" OnClick="SampleScan" /><AppButton Label="Finish setup" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@Busy" Disabled="@(!Readiness.CanComplete)" OnClick="Complete" /></div>
    }
</div>

@code {
    [Parameter] public SetupReadinessDto? Readiness { get; set; }
    [Parameter] public string? SampleScanDetail { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback SampleScan { get; set; }
    [Parameter] public EventCallback Complete { get; set; }
    private static string CapabilityLabel(string key) => key switch { "preflight" => "Core server capabilities", "administrator" => "Administrator", "media-locations" => "Media locations", "providers" => "Metadata providers", _ => key.Replace('-', ' ') };
    private static string StatusLabel(string status) => status switch { "passed" => "Ready", "deferred" => "Ready · later", "blocked" => "Needs attention", _ => "Not checked" };
    private static AppUiTone StatusTone(string status) => status switch { "passed" => AppUiTone.Success, "blocked" => AppUiTone.Error, "deferred" => AppUiTone.Neutral, _ => AppUiTone.Neutral };
}
