@namespace MediaEngine.Web.Components.Discovery
@using MediaEngine.Web.Services.Editing

@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject CollectionEditorLauncherService CollectionEditorLauncher
@inject ISnackbar Snackbar

<AppDialogShell Title="Add to Collection"
                Size="Medium"
                Modal="true"
                CenterTitle="true"
                OnClose="Cancel">
    <ChildContent>
        <div class="add-to-collection">
            <div class="add-to-collection__media">
                <div class="add-to-collection__media-art">
                    @if (!string.IsNullOrWhiteSpace(ArtworkUrl))
                    {
                        <img src="@ArtworkUrl" alt="" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.ImageNotSupported" />
                    }
                </div>
                <div><strong>@WorkTitle</strong><span>@WorkMeta</span></div>
            </div>

            <div class="add-to-collection__tabs" role="tablist" aria-label="Choose an existing collection or create one">
                <AppNativeButton Type="button" Class="@(_showCreate ? null : "is-active")" OnClick="ShowExisting" Role="tab" AriaSelected="@(!_showCreate)">Existing</AppNativeButton>
                @if (CanCreate)
                {
                    <AppNativeButton Type="button" Class="@(_showCreate ? "is-active" : null)" OnClick="ShowCreate" Role="tab" AriaSelected="@_showCreate">Create new</AppNativeButton>
                }
            </div>

            @if (_showCreate)
            {
                <div class="add-to-collection__create-choice">
                    @if (CanCreateCurated)
                    {
                        <AppNativeButton Type="button" OnClick="@(() => CreateAsync(CollectionEditorMode.CuratedCollection))">
                            <span><MudIcon Icon="@Icons.Material.Outlined.Layers" /></span>
                            <div><strong>Curated Collection</strong><small>Publish a manual or dynamic cross-media collection.</small></div>
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" />
                        </AppNativeButton>
                    }
                    @if (CanCreatePlaylist)
                    {
                        <AppNativeButton Type="button" OnClick="@(() => CreateAsync(CollectionEditorMode.ManualPlaylist))">
                            <span><MudIcon Icon="@Icons.Material.Outlined.QueueMusic" /></span>
                            <div><strong>Playlist</strong><small>Create a personal Listen queue from this item.</small></div>
                            <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" />
                        </AppNativeButton>
                    }
                </div>
            }
            else
            {
                <div class="add-to-collection__toolbar">
                    <div class="add-to-collection__filters">
                        @foreach (var filter in Filters)
                        {
                            <AppNativeButton Type="button" Class="@(_filter == filter.Key ? "is-active" : null)" OnClick="@(() => SetFilter(filter.Key))">@filter.Label</AppNativeButton>
                        }
                    </div>
                    <AppIconButton Icon="@(_searchOpen ? Icons.Material.Outlined.Close : Icons.Material.Outlined.Search)"
                                   Size="Size.Small"
                                   OnClick="ToggleSearch"
                                   aria-label="@(_searchOpen ? "Close collection search" : "Search collections")" />
                </div>

                @if (_searchOpen)
                {
                    <AppTextField T="string"
                                  Value="@_searchText"
                                  ValueChanged="OnSearchChanged"
                                  Placeholder="Search collections"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  DebounceInterval="250"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Search"
                                  Class="add-to-collection__search app-dialog-field" />
                }

                @if (_loading)
                {
                    <div class="add-to-collection__state"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><span>Loading collections…</span></div>
                }
                else if (FilteredCollections.Count == 0)
                {
                    <div class="add-to-collection__state">
                        <MudIcon Icon="@Icons.Material.Outlined.CollectionsBookmark" />
                        <span>No eligible collections match.</span>
                        @if (CanCreate && !string.IsNullOrWhiteSpace(_searchText))
                        {
                            <AppButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateFromSearchAsync">Create “@_searchText.Trim()”</AppButton>
                        }
                    </div>
                }
                else
                {
                    <div class="add-to-collection__sections">
                        @RenderSection($"Suggested for {WorkTitle}", SuggestedCollections)
                        @RenderSection("Recent", RecentCollections)
                        @RenderSection("All collections", RemainingCollections)
                    </div>
                }

                @if (CanCreate)
                {
                    <AppNativeButton Type="button" Class="add-to-collection__create" OnClick="ShowCreate">
                        <span class="add-to-collection__create-icon"><MudIcon Icon="@Icons.Material.Outlined.Add" /></span>
                        <span class="add-to-collection__create-copy">
                            <strong>Create new</strong>
                            <small>@(CanCreatePlaylist ? "Create a collection or personal playlist" : "Build a curated collection")</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                    </AppNativeButton>
                }
            }
        </div>
    </ChildContent>
</AppDialogShell>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid WorkId { get; set; }
    [Parameter, EditorRequired] public string WorkTitle { get; set; } = string.Empty;
    [Parameter] public string? MediaType { get; set; }
    [Parameter] public string? Year { get; set; }
    [Parameter] public string? ArtworkUrl { get; set; }

    private static readonly (string Key, string Label)[] Filters =
    [
        ("all", "All"),
        ("curated", "Curated"),
        ("lists", "Lists"),
        ("playlists", "Playlists"),
        ("mine", "Mine"),
    ];

    private readonly List<ManagedCollectionViewModel> _collections = [];
    private ProfileViewModel? _profile;
    private bool _loading = true;
    private bool _searchOpen;
    private bool _showCreate;
    private string _searchText = string.Empty;
    private string _filter = "all";
    private Guid? _addingId;

    private string WorkMeta => string.Join(" · ", new[] { MediaType, Year }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private bool CanCreateCurated => string.Equals(_profile?.Role, "Administrator", StringComparison.OrdinalIgnoreCase);
    private bool CanCreatePlaylist => _profile is not null && IsListenMedia(MediaType);
    private bool CanCreate => CanCreateCurated || CanCreatePlaylist;

    private IReadOnlyList<ManagedCollectionViewModel> FilteredCollections => _collections
        .Where(IsEligibleTarget)
        .Where(MatchesFilter)
        .Where(MatchesSearch)
        .OrderByDescending(collection => collection.ModifiedAt ?? collection.CreatedAt)
        .ThenBy(collection => collection.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<ManagedCollectionViewModel> SuggestedCollections => FilteredCollections
        .Where(IsSuggested)
        .Take(3)
        .ToList();
    private IReadOnlyList<ManagedCollectionViewModel> RecentCollections => FilteredCollections
        .Except(SuggestedCollections)
        .Take(2)
        .ToList();
    private IReadOnlyList<ManagedCollectionViewModel> RemainingCollections => FilteredCollections
        .Except(SuggestedCollections)
        .Except(RecentCollections)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Orchestrator.GetActiveProfileAsync();
            _collections.AddRange(await ApiClient.GetManagedCollectionsAsync(_profile?.Id));
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment RenderSection(string title, IReadOnlyList<ManagedCollectionViewModel> collections) => @<text>
        @if (collections.Count > 0)
        {
            <section class="add-to-collection__section">
                <h3>@title</h3>
                <div>
                    @foreach (var collection in collections)
                    {
                        <div class="add-to-collection__row" @key="collection.Id">
                            <div class="add-to-collection__artwork">
                                @if (!string.IsNullOrWhiteSpace(collection.CoverArtworkUrl))
                                {
                                    <img src="@collection.CoverArtworkUrl" alt="" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.CollectionsBookmark" />
                                }
                            </div>
                            <div class="add-to-collection__copy"><strong>@collection.Name</strong><small>@Classification(collection)</small></div>
                            <AppIconButton Icon="@(_addingId == collection.Id ? Icons.Material.Outlined.HourglassTop : Icons.Material.Outlined.AddCircleOutline)"
                                           Size="Size.Small"
                                           Disabled="@(_addingId.HasValue)"
                                           OnClick="@(() => AddAsync(collection))"
                                           aria-label="@($"Add {WorkTitle} to {collection.Name}")" />
                        </div>
                    }
                </div>
            </section>
        }
    </text>;

    private bool IsEligibleTarget(ManagedCollectionViewModel collection) =>
        collection.IsEnabled
        && collection.CanEdit
        && string.Equals(collection.Resolution, "materialized", StringComparison.OrdinalIgnoreCase)
        && (!string.Equals(collection.CollectionType, "Playlist", StringComparison.OrdinalIgnoreCase) || IsListenMedia(MediaType));

    private bool MatchesFilter(ManagedCollectionViewModel collection) => _filter switch
    {
        "curated" => string.Equals(collection.CollectionType, "Custom", StringComparison.OrdinalIgnoreCase),
        "lists" => string.Equals(collection.CollectionType, "System", StringComparison.OrdinalIgnoreCase),
        "playlists" => string.Equals(collection.CollectionType, "Playlist", StringComparison.OrdinalIgnoreCase),
        "mine" => collection.ProfileId == _profile?.Id,
        _ => true,
    };

    private bool MatchesSearch(ManagedCollectionViewModel collection) =>
        string.IsNullOrWhiteSpace(_searchText)
        || collection.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
        || (collection.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        || collection.TypeLabel.Contains(_searchText, StringComparison.OrdinalIgnoreCase);

    private bool IsSuggested(ManagedCollectionViewModel collection)
    {
        if (collection.ProfileId == _profile?.Id)
            return true;
        if (IsListenMedia(MediaType))
            return collection.CollectionType is "Playlist" or "System";
        return collection.CollectionType is "Custom" or "System";
    }

    private async Task AddAsync(ManagedCollectionViewModel collection)
    {
        _addingId = collection.Id;
        try
        {
            if (!await ApiClient.AddCollectionItemAsync(collection.Id, WorkId, _profile?.Id))
            {
                Snackbar.Add("The item could not be added to that collection.", Severity.Error);
                return;
            }
            Snackbar.Add($"Added \"{WorkTitle}\" to \"{collection.Name}\".", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _addingId = null;
        }
    }

    private async Task CreateAsync(CollectionEditorMode mode, string? title = null)
    {
        var changed = await CollectionEditorLauncher.OpenAsync(new CollectionEditorLaunchRequest
        {
            ActiveProfileId = _profile?.Id,
            CanManageSharedCollections = CanCreateCurated,
            TypeSelectionConfirmed = true,
            Mode = mode,
            InitialCollectionType = mode == CollectionEditorMode.CuratedCollection ? "Custom" : "Playlist",
            InitialRulesEnabled = false,
            InitialTitle = title,
            TriggeringWorkId = WorkId,
            TriggeringWorkTitle = WorkTitle,
            TriggeringMediaType = MediaType,
            TriggeringYear = Year,
            TriggeringArtworkUrl = ArtworkUrl,
        });
        if (changed)
            MudDialog.Close(DialogResult.Ok(true));
    }

    private Task CreateFromSearchAsync() => CreateAsync(CanCreatePlaylist ? CollectionEditorMode.ManualPlaylist : CollectionEditorMode.CuratedCollection, _searchText.Trim());
    private void SetFilter(string value) => _filter = value;
    private void ToggleSearch() { _searchOpen = !_searchOpen; if (!_searchOpen) _searchText = string.Empty; }
    private Task OnSearchChanged(string value) { _searchText = value; return Task.CompletedTask; }
    private void ShowExisting() => _showCreate = false;
    private void ShowCreate() => _showCreate = true;
    private void Cancel() => MudDialog.Cancel();

    private static string Classification(ManagedCollectionViewModel collection)
    {
        var type = collection.CollectionType switch
        {
            "Custom" => "Curated",
            "System" => "List",
            "Playlist" => "Playlist",
            _ => collection.TypeLabel,
        };
        var scope = collection.IsShared ? "Published" : "Personal";
        return $"{type} · {scope} · {collection.ItemCount} {((collection.ItemCount == 1) ? "item" : "items")}";
    }

    private static bool IsListenMedia(string? mediaType) => mediaType?.Contains("music", StringComparison.OrdinalIgnoreCase) == true
        || mediaType?.Contains("audio", StringComparison.OrdinalIgnoreCase) == true
        || mediaType?.Contains("track", StringComparison.OrdinalIgnoreCase) == true;
}
