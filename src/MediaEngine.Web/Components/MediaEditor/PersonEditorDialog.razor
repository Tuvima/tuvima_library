@namespace MediaEngine.Web.Components.MediaEditor
@using Microsoft.AspNetCore.Components.Forms
@using MediaEngine.Contracts.Items
@using MediaEngine.Contracts.Metadata
@using MediaEngine.Contracts.Operations
@using MediaEngine.Contracts.Persons
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject ISnackbar Snackbar

<AppDialog Class="sme-dialog">
<DialogContent>
<div class="person-editor">
    <header class="person-editor__header">
        <div class="person-editor__portrait">
            @if (!string.IsNullOrWhiteSpace(_person?.EffectiveHeadshotUrl))
            {
                <img src="@_person.EffectiveHeadshotUrl" alt="" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.Person" />
            }
        </div>
        <div class="person-editor__header-copy">
            <span class="person-editor__kicker">@(_person?.IsGroup == true ? "GROUP" : "PERSON")</span>
            <h2>@(_person?.Name ?? Request.HeaderTitle ?? "Person")</h2>
            <p>@(_person is null ? "Loading..." : string.Join(" · ", _person.RoleLabels))</p>
        </div>
        @if (_dirty)
        {
            <AppButton Variant="Variant.Text" Color="Color.Inherit" OnClick="ResetChanges">Reset changes</AppButton>
        }
        <AppButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_dirty || _saving)" OnClick="SaveAsync">
            @(_saving ? "Saving..." : "Save Changes")
        </AppButton>
        <AppIconButton Icon="@Icons.Material.Outlined.Close" Tooltip="Close editor" AriaLabel="Close editor" OnClick="Close" />
    </header>

    <div class="person-editor__workspace">
        <nav class="person-editor__nav" aria-label="Person editor sections">
            @foreach (var tab in Tabs)
            {
                var captured = tab;
                <AppButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           Class="@(_activeTab == captured.Id ? "person-editor__nav-item is-active" : "person-editor__nav-item")"
                           OnClick="@(() => _activeTab = captured.Id)">
                    <MudIcon Icon="@captured.Icon" Size="Size.Small" />
                    <span>@captured.Label</span>
                </AppButton>
            }

            <div class="person-editor__nav-footer">
                    <AppButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               StartIcon="@Icons.Material.Outlined.Sync"
                               Disabled="@_queueing"
                               OnClick="RefreshNowAsync">
                        @(_queueing ? "Queueing..." : "Refresh enrichment")
                    </AppButton>
                    <small>@_refresh.Status · @FormatDate(_refresh.LastSuccessAt)</small>
            </div>
        </nav>

        <main class="person-editor__main">
            @if (_loading)
            {
                <div class="person-editor__empty"><MudProgressCircular Indeterminate="true" /></div>
            }
            else if (_person is null || _state is null)
            {
                <div class="person-editor__empty">This person could not be loaded for editing.</div>
            }
            else if (_activeTab == "details")
            {
                <div class="person-editor__notice">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" />
                    <span>Provider-managed facts refresh when matching changes. Local overrides and private library fields are preserved.</span>
                </div>
                <div class="person-editor__details-stack">
                    <MediaEditorPanel Title="Appearance" Description="How this person appears throughout Tuvima Library." Class="person-editor__details-section">
                        <AppFormFieldRow Label="Display name"
                                         Value="@_name"
                                         ValueChanged="@((string? value) => SetValue("name", value))"
                                         Locked="@IsLocked("name")"
                                         Unlocked="@_enabledOverrides.Contains("name")"
                                         OverrideActive="@_savedOverrides.ContainsKey("name")"
                                         ActionIcon="@GetActionIcon("name")"
                                         ActionLabel="Use or remove the local display name override"
                                         OnAction="@(() => ToggleOverride("name"))"
                                         HelpText="@GetOverrideHelp("name")" />
                        <AppFormFieldRow Label="Biography"
                                         Value="@_biography"
                                         ValueChanged="@((string? value) => SetValue("biography", value))"
                                         InputKind="textarea"
                                         Lines="8"
                                         Locked="@IsLocked("biography")"
                                         Unlocked="@_enabledOverrides.Contains("biography")"
                                         OverrideActive="@_savedOverrides.ContainsKey("biography")"
                                         ActionIcon="@GetActionIcon("biography")"
                                         ActionLabel="Use or remove the local biography override"
                                         OnAction="@(() => ToggleOverride("biography"))"
                                         HelpText="@GetOverrideHelp("biography")" />
                        <AppFormFieldRow Label="Sort name"
                                         Value="@_sortName"
                                         ValueChanged="@((string? value) => SetValue("sort_name", value))"
                                         Locked="@IsLocked("sort_name")"
                                         Unlocked="@_enabledOverrides.Contains("sort_name")"
                                         OverrideActive="@_savedOverrides.ContainsKey("sort_name")"
                                         ActionIcon="@GetActionIcon("sort_name")"
                                         ActionLabel="Use or remove the local sort name override"
                                         OnAction="@(() => ToggleOverride("sort_name"))"
                                         HelpText="@GetOverrideHelp("sort_name")" />
                    </MediaEditorPanel>

                    <MediaEditorPanel Title="My Library" Description="Private organization for the active profile." Class="person-editor__details-section">
                        <MediaEditorTagEditor Label="Local tags"
                                              Value="@_tags"
                                              ValueChanged="@((string? value) => SetLocalTags(value))"
                                              Suggestions="@_tagSuggestions" />
                    </MediaEditorPanel>

                    <MediaEditorPanel Title="Source facts" Class="person-editor__details-section person-editor__details-section--source-facts">
                        <Actions>
                            <span class="person-editor__source-facts-description">Identity facts are managed by your library sources.</span>
                        </Actions>
                        <ChildContent>
                            <dl class="person-editor__facts">
                                <div><MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Medium" Class="person-editor__fact-icon" /><div class="person-editor__fact-copy"><dt>Occupation</dt><dd>@(_person.Occupation ?? "Not available")</dd></div></div>
                                <div><MudIcon Icon="@Icons.Material.Outlined.Cake" Size="Size.Medium" Class="person-editor__fact-icon" /><div class="person-editor__fact-copy"><dt>Born</dt><dd>@(_person.DateOfBirth ?? "Not available")</dd></div></div>
                                <div><MudIcon Icon="@Icons.Material.Outlined.Public" Size="Size.Medium" Class="person-editor__fact-icon" /><div class="person-editor__fact-copy"><dt>Nationality</dt><dd>@(_person.Nationality ?? "Not available")</dd></div></div>
                                <div><MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Medium" Class="person-editor__fact-icon" /><div class="person-editor__fact-copy"><dt>Wikidata</dt><dd>@if (!string.IsNullOrWhiteSpace(_person.WikidataQid)) { <a href="@GetWikidataUrl(_person.WikidataQid)" target="_blank" rel="noopener noreferrer">@_person.WikidataQid <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" /></a> } else { <span>Not matched</span> }</dd></div></div>
                            </dl>
                        </ChildContent>
                    </MediaEditorPanel>
                </div>
            }
            else if (_activeTab == "artwork")
            {
                var selectedSlot = SelectedPersonArtworkSlot;
                var selectedVariant = SelectedPersonArtworkVariant;
                <div class="person-editor__artwork-context">
                    <div>
                        <strong>Person artwork</strong>
                        <span>Choose the durable portrait and supporting artwork used throughout Tuvima Library.</span>
                    </div>
                </div>
                <section class="person-editor__artwork-workspace">
                    <div class="person-editor__artwork-main">
                        <div class="person-editor__artwork-type-picker" role="tablist" aria-label="Artwork types">
                            @foreach (var slot in _artwork?.Slots ?? [])
                            {
                                var isActive = string.Equals(slot.AssetType, selectedSlot?.AssetType, StringComparison.OrdinalIgnoreCase);
                                <AppButton Variant="Variant.Text"
                                           Color="Color.Inherit"
                                           Class="@(isActive ? "person-editor__artwork-rail-item is-active" : "person-editor__artwork-rail-item")"
                                           OnClick="@(() => SelectPersonArtworkSlot(slot.AssetType))">
                                    <MudIcon Icon="@GetArtworkIcon(slot.AssetType)" Size="Size.Small" />
                                    <span>@FormatArtworkType(slot.AssetType)</span>
                                </AppButton>
                            }
                        </div>
                        @if (selectedSlot is null)
                        {
                            <div class="person-editor__artwork-empty">No editable artwork types are available for this person.</div>
                        }
                        else
                        {
                            <div class="person-editor__artwork-heading">
                                <div>
                                    <h3>@FormatArtworkType(selectedSlot.AssetType) artwork</h3>
                                    <p>@GetArtworkHelp(selectedSlot.AssetType)</p>
                                </div>
                                <AppButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.CloudUpload" Class="person-editor__artwork-upload-button">
                                    Upload
                                    <span class="person-editor__artwork-file-shell">
                                        <InputFile class="person-editor__artwork-file-input"
                                                   accept="@GetArtworkAcceptedTypes(selectedSlot.AssetType)"
                                                   OnChange="@((args) => UploadArtworkAsync(selectedSlot.AssetType, args))" />
                                    </span>
                                </AppButton>
                            </div>

                            <div class="person-editor__artwork-editor-grid">
                                <div class="person-editor__artwork-showcase">
                                    <div class="person-editor__artwork-primary-card person-editor__artwork-primary-card--@GetArtworkPreviewClass(selectedSlot.AssetType)">
                                        @if (selectedVariant is not null)
                                        {
                                            <div class="person-editor__artwork-stage person-editor__artwork-stage--@GetArtworkPreviewClass(selectedSlot.AssetType)">
                                                <img src="@selectedVariant.ImageUrl" alt="@FormatArtworkType(selectedSlot.AssetType)" />
                                                @if (selectedVariant.IsPreferred)
                                                {
                                                    <span class="person-editor__artwork-check" aria-label="Primary artwork"><MudIcon Icon="@Icons.Material.Filled.Check" /></span>
                                                    <span class="person-editor__artwork-primary-badge">Primary</span>
                                                }
                                            </div>
                                            <div class="person-editor__artwork-primary-actions">
                                                <AppButton Label="Preview" StartIcon="@Icons.Material.Outlined.Visibility" OnClick="@(() => _previewArtwork = selectedVariant)" />
                                                @if (!selectedVariant.IsPreferred)
                                                {
                                                    <AppButton Label="Set primary" StartIcon="@Icons.Material.Outlined.StarOutline" OnClick="@(() => SetPreferredAsync(selectedVariant.Id))" />
                                                }
                                                <AppButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.SwapHoriz" Class="person-editor__artwork-upload-button">
                                                    Replace
                                                    <span class="person-editor__artwork-file-shell">
                                                        <InputFile class="person-editor__artwork-file-input"
                                                                   accept="@GetArtworkAcceptedTypes(selectedSlot.AssetType)"
                                                                   OnChange="@((args) => UploadArtworkAsync(selectedSlot.AssetType, args))" />
                                                    </span>
                                                </AppButton>
                                                @if (selectedVariant.CanDelete)
                                                {
                                                    <AppButton Label="Remove" StartIcon="@Icons.Material.Outlined.Delete" Tone="AppUiTone.Error" OnClick="@(() => DeleteArtworkAsync(selectedVariant.Id))" />
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="person-editor__artwork-primary-empty"><MudIcon Icon="@GetArtworkIcon(selectedSlot.AssetType)" /><span>No artwork yet</span></div>
                                        }
                                    </div>

                                    <aside class="person-editor__artwork-details">
                                        <h3>Artwork details</h3>
                                        <dl>
                                            <div><dt>Artwork type</dt><dd>@FormatArtworkType(selectedSlot.AssetType)</dd></div>
                                            <div><dt>Source</dt><dd>@GetArtworkSource(selectedVariant)</dd></div>
                                            <div><dt>Image size</dt><dd>@GetArtworkImageSize(selectedVariant)</dd></div>
                                            <div><dt>Added</dt><dd>@(selectedVariant?.CreatedAt?.LocalDateTime.ToString("MMM d, yyyy") ?? "Provider managed")</dd></div>
                                        </dl>
                                    </aside>

                                    <div class="person-editor__artwork-add-panel">
                                        <MudIcon Icon="@Icons.Material.Outlined.Add" />
                                        <strong>Add artwork</strong>
                                        <span>Upload a new @FormatArtworkType(selectedSlot.AssetType).ToLowerInvariant() image.</span>
                                        <small>JPG or PNG, up to 20 MB</small>
                                        <AppButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.CloudUpload" Class="person-editor__artwork-upload-button">
                                            Upload file
                                            <span class="person-editor__artwork-file-shell">
                                                <InputFile class="person-editor__artwork-file-input"
                                                           accept="@GetArtworkAcceptedTypes(selectedSlot.AssetType)"
                                                           OnChange="@((args) => UploadArtworkAsync(selectedSlot.AssetType, args))" />
                                            </span>
                                        </AppButton>
                                    </div>
                                </div>

                                <div class="person-editor__artwork-tips person-editor__artwork-tips--banner">
                                    <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" Size="Size.Small" />
                                    <div>
                                        <strong>@FormatArtworkType(selectedSlot.AssetType) artwork tips</strong>
                                        <span>@GetArtworkGuidance(selectedSlot.AssetType)</span>
                                    </div>
                                </div>

                                @if (selectedSlot.Variants.Count > 1)
                                {
                                    <section class="person-editor__artwork-variants-section">
                                        <div class="person-editor__artwork-variants-heading">
                                            <h4>Other @FormatArtworkType(selectedSlot.AssetType).ToLowerInvariant() options</h4>
                                            <span>@selectedSlot.Variants.Count options</span>
                                        </div>
                                        <div class="person-editor__artwork-variant-strip">
                                            @foreach (var variant in selectedSlot.Variants)
                                            {
                                                var isSelected = variant.Id == selectedVariant?.Id;
                                                <AppNativeButton Type="button"
                                                                 Class="@(isSelected ? "person-editor__artwork-variant is-selected" : "person-editor__artwork-variant")"
                                                                 aria-label="@GetArtworkVariantLabel(selectedSlot, variant)"
                                                                 OnClick="@(() => SelectPersonArtworkVariantAsync(variant))">
                                                    <span class="person-editor__artwork-stage person-editor__artwork-stage--@GetArtworkPreviewClass(selectedSlot.AssetType)">
                                                        <img src="@variant.ImageUrl" alt="" />
                                                    </span>
                                                </AppNativeButton>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                    </div>
                </section>

                <MediaEditorArtworkLightbox IsOpen="@(_previewArtwork is not null)"
                                            ImageUrl="@_previewArtwork?.ImageUrl"
                                            Label="@(selectedSlot is null ? null : FormatArtworkType(selectedSlot.AssetType))"
                                            Summary="@(selectedSlot is null || _previewArtwork is null ? null : GetArtworkVariantLabel(selectedSlot, _previewArtwork))"
                                            PreviewClass="@(selectedSlot is null ? null : GetArtworkPreviewClass(selectedSlot.AssetType))"
                                            ImageClass="contain"
                                            OnClose="@(() => _previewArtwork = null)" />
            }
            else if (_activeTab == "history")
            {
                <div class="person-editor__tab-heading"><div><h3>History</h3><p>Identity, metadata, artwork, and enrichment activity for this person.</p></div></div>
                <div class="person-editor__history">
                    @if (_state.History.Count == 0)
                    {
                        <div class="person-editor__empty">No person history has been recorded yet.</div>
                    }
                    @foreach (var entry in _state.History)
                    {
                        <article>
                            <MudIcon Icon="@HistoryIcon(entry.Category)" />
                            <div><strong>@entry.Label</strong><span>@entry.Detail</span></div>
                            <time>@entry.OccurredAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</time>
                        </article>
                    }
                </div>
            }
        </main>
    </div>
</div>
</DialogContent>
</AppDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public MediaEditorLaunchRequest Request { get; set; } = new();

    private static readonly (string Id, string Label, string Icon)[] Tabs =
    [
        ("details", "Details", Icons.Material.Outlined.Feed),
        ("artwork", "Artwork", Icons.Material.Outlined.Collections),
        ("history", "History", Icons.Material.Outlined.History),
    ];

    private PersonDetailViewModel? _person;
    private PersonEditorStateResponse? _state;
    private ArtworkEditorDto? _artwork;
    private ArtworkVariantDto? _previewArtwork;
    private EnrichmentRefreshScheduleDto _refresh = new() { Status = "Ready" };
    private IReadOnlyList<string> _tagSuggestions = [];
    private readonly Dictionary<string, string> _savedOverrides = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _enabledOverrides = new(StringComparer.OrdinalIgnoreCase);
    private string _activeTab = "details";
    private string? _selectedArtworkAssetType;
    private Guid? _selectedArtworkVariantId;
    private string _name = string.Empty;
    private string _biography = string.Empty;
    private string _sortName = string.Empty;
    private string _tags = string.Empty;
    private bool _loading = true;
    private bool _saving;
    private bool _queueing;
    private bool _dirty;

    private Guid PersonId => Request.LaunchEntityId ?? Request.EntityIds.FirstOrDefault();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (PersonId == Guid.Empty)
            return;
        _loading = true;
        var personTask = ApiClient.GetPersonDetailAsync(PersonId);
        var stateTask = ApiClient.GetPersonEditorStateAsync(PersonId, Request.ActiveProfileId);
        var artworkTask = ApiClient.GetPersonArtworkAsync(PersonId);
        var scheduleTask = ApiClient.GetEnrichmentRefreshScheduleAsync("Person", limit: 500);
        var suggestionsTask = ApiClient.GetItemEditorSuggestionsAsync("tags", Request.ActiveProfileId);
        await Task.WhenAll(personTask, stateTask, artworkTask, scheduleTask, suggestionsTask);
        _person = personTask.Result;
        _state = stateTask.Result;
        _artwork = artworkTask.Result;
        NormalizePersonArtworkSelection();
        _refresh = scheduleTask.Result?.Items.FirstOrDefault(item => item.EntityId == PersonId)
            ?? new EnrichmentRefreshScheduleDto
            {
                EntityType = "Person",
                EntityId = PersonId,
                EntityName = _person?.Name ?? string.Empty,
                Status = "Ready",
            };
        _tagSuggestions = suggestionsTask.Result;
        ResetChanges();
        _loading = false;
    }

    private void ResetChanges()
    {
        if (_state is null)
            return;
        _savedOverrides.Clear();
        foreach (var pair in _state.DisplayOverrides)
            _savedOverrides[pair.Key] = pair.Value;
        _enabledOverrides.Clear();
        foreach (var key in _savedOverrides.Keys)
            _enabledOverrides.Add(key);
        _name = GetValue("name", _state.BaselineName);
        _biography = NormalizeBiographyLineBreaks(GetValue("biography", _state.BaselineBiography));
        _sortName = GetValue("sort_name", BuildSortName(_state.BaselineName));
        _tags = string.Join(", ", _state.LocalTags);
        _dirty = false;
    }

    private string GetValue(string key, string? baseline) =>
        _savedOverrides.TryGetValue(key, out var value) ? value : baseline ?? string.Empty;

    private bool IsLocked(string key) => !_enabledOverrides.Contains(key);
    private string GetActionIcon(string key) => _savedOverrides.ContainsKey(key) ? Icons.Material.Outlined.Restore : IsLocked(key) ? Icons.Material.Outlined.Lock : Icons.Material.Outlined.LockOpen;
    private string GetOverrideHelp(string key) => _savedOverrides.ContainsKey(key) ? "Local override. Use restore to return to the provider value." : IsLocked(key) ? "Provider-managed value. Unlock to create a durable local override." : "Local override enabled; provider refreshes will not replace it.";

    private void ToggleOverride(string key)
    {
        if (_savedOverrides.ContainsKey(key))
        {
            _savedOverrides.Remove(key);
            _enabledOverrides.Remove(key);
            if (_state is not null)
            {
                if (key == "name") _name = _state.BaselineName;
                if (key == "biography") _biography = _state.BaselineBiography ?? string.Empty;
                if (key == "sort_name") _sortName = BuildSortName(_state.BaselineName);
            }
        }
        else if (!_enabledOverrides.Add(key))
        {
            _enabledOverrides.Remove(key);
        }
        _dirty = true;
    }

    private void SetValue(string key, string? value)
    {
        if (key == "name") _name = value ?? string.Empty;
        if (key == "biography") _biography = value ?? string.Empty;
        if (key == "sort_name") _sortName = value ?? string.Empty;
        _dirty = true;
    }

    private void SetLocalTags(string? value) { _tags = value ?? string.Empty; _dirty = true; }

    private async Task SaveAsync()
    {
        if (_state is null || _person is null)
            return;
        _saving = true;
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var key in _enabledOverrides)
        {
            var value = key switch { "name" => _name, "biography" => _biography, "sort_name" => _sortName, _ => string.Empty };
            if (!string.IsNullOrWhiteSpace(value)) values[key] = value.Trim();
        }
        var saved = await ApiClient.SavePersonEditorStateAsync(PersonId, new PersonEditorSaveRequest
        {
            ProfileId = Request.ActiveProfileId,
            ExpectedRevision = _state.Revision,
            DisplayOverrides = values,
            LocalTags = SplitValues(_tags).ToList(),
        });
        _saving = false;
        if (!saved)
        {
            Snackbar.Add("The person changes could not be saved. Reload the editor and try again.", Severity.Error);
            return;
        }
        Snackbar.Add("Person changes saved.", Severity.Success);
        await LoadAsync();
    }

    private async Task UploadArtworkAsync(string assetType, InputFileChangeEventArgs args)
    {
        var file = args.File;
        await using var stream = file.OpenReadStream(20 * 1024 * 1024);
        var uploaded = await ApiClient.UploadPersonArtworkAsync(PersonId, assetType, stream, file.Name);
        Snackbar.Add(uploaded ? "Custom artwork uploaded." : "The artwork could not be uploaded.", uploaded ? Severity.Success : Severity.Error);
        if (uploaded)
        {
            _artwork = await ApiClient.GetPersonArtworkAsync(PersonId);
            _person = await ApiClient.GetPersonDetailAsync(PersonId);
            _selectedArtworkAssetType = assetType;
            _selectedArtworkVariantId = _artwork?.Slots
                .FirstOrDefault(slot => string.Equals(slot.AssetType, assetType, StringComparison.OrdinalIgnoreCase))?
                .Variants.FirstOrDefault(variant => variant.IsPreferred)?.Id;
            NormalizePersonArtworkSelection();
        }
    }

    private async Task SetPreferredAsync(Guid variantId)
    {
        if (await ApiClient.SetPreferredArtworkAsync(variantId))
        {
            _artwork = await ApiClient.GetPersonArtworkAsync(PersonId);
            _person = await ApiClient.GetPersonDetailAsync(PersonId);
            _selectedArtworkVariantId = variantId;
            NormalizePersonArtworkSelection();
        }
    }

    private async Task DeleteArtworkAsync(Guid variantId)
    {
        if (await ApiClient.DeleteArtworkAsync(variantId))
        {
            _artwork = await ApiClient.GetPersonArtworkAsync(PersonId);
            _person = await ApiClient.GetPersonDetailAsync(PersonId);
            if (_selectedArtworkVariantId == variantId)
                _selectedArtworkVariantId = null;
            NormalizePersonArtworkSelection();
        }
    }

    private ArtworkSlotDto? SelectedPersonArtworkSlot =>
        _artwork?.Slots.FirstOrDefault(slot => string.Equals(slot.AssetType, _selectedArtworkAssetType, StringComparison.OrdinalIgnoreCase))
        ?? _artwork?.Slots.FirstOrDefault();

    private ArtworkVariantDto? SelectedPersonArtworkVariant
    {
        get
        {
            var slot = SelectedPersonArtworkSlot;
            return slot?.Variants.FirstOrDefault(variant => variant.Id == _selectedArtworkVariantId)
                ?? slot?.Variants.FirstOrDefault(variant => variant.IsPreferred)
                ?? slot?.Variants.FirstOrDefault();
        }
    }

    private void NormalizePersonArtworkSelection()
    {
        var slot = SelectedPersonArtworkSlot;
        _selectedArtworkAssetType = slot?.AssetType;
        var variant = SelectedPersonArtworkVariant;
        _selectedArtworkVariantId = variant?.Id;
        if (_previewArtwork is not null && slot?.Variants.All(item => item.Id != _previewArtwork.Id) != false)
            _previewArtwork = null;
    }

    private void SelectPersonArtworkSlot(string assetType)
    {
        _selectedArtworkAssetType = assetType;
        _selectedArtworkVariantId = null;
        _previewArtwork = null;
        NormalizePersonArtworkSelection();
    }

    private async Task SelectPersonArtworkVariantAsync(ArtworkVariantDto variant)
    {
        _selectedArtworkVariantId = variant.Id;
        if (!variant.IsPreferred)
            await SetPreferredAsync(variant.Id);
    }

    private static string GetArtworkIcon(string assetType) => assetType switch
    {
        "Headshot" => Icons.Material.Outlined.Person,
        "Background" => Icons.Material.Outlined.Landscape,
        "Banner" => Icons.Material.Outlined.ViewAgenda,
        "Logo" => Icons.Material.Outlined.BrandingWatermark,
        _ => Icons.Material.Outlined.Image,
    };

    private static string GetArtworkPreviewClass(string assetType) => assetType switch
    {
        "Headshot" => "portrait",
        "Background" => "background",
        "Banner" => "banner",
        "Logo" => "logo",
        _ => "portrait",
    };

    private static string GetArtworkAcceptedTypes(string assetType) =>
        string.Equals(assetType, "Logo", StringComparison.OrdinalIgnoreCase)
            ? "image/png"
            : "image/png,image/jpeg";

    private static string GetArtworkImageSize(ArtworkVariantDto? variant) =>
        variant?.WidthPx is > 0 && variant.HeightPx is > 0
            ? $"{variant.WidthPx.Value:N0} x {variant.HeightPx.Value:N0} px"
            : "Not reported";

    private static string GetArtworkGuidance(string assetType) => assetType switch
    {
        "Headshot" => "Use a high-resolution portrait with the face centered and enough space around the head for responsive crops. Aim for at least 1200 px on the longest edge.",
        "Background" => "Use a wide, text-free image with room for foreground copy. A 16:9 source at 1920 x 1080 px or larger works best.",
        "Banner" => "Use a wide promotional strip with the subject centered. Aim for roughly 5:1 and at least 1920 px wide.",
        "Logo" => "Use a transparent PNG containing only the person's or group's mark. Leave clear padding and aim for at least 1200 px wide.",
        _ => "Use a high-resolution JPG or PNG and keep important content away from the edges.",
    };

    private static string NormalizeBiographyLineBreaks(string value) => value
        .Replace("\\r\\n", "\n", StringComparison.Ordinal)
        .Replace("\\n", "\n", StringComparison.Ordinal)
        .Replace("\r\n", "\n", StringComparison.Ordinal)
        .Replace('\r', '\n');

    private static string GetWikidataUrl(string qid) =>
        $"https://www.wikidata.org/wiki/{Uri.EscapeDataString(qid.Trim())}";

    private static string GetArtworkSource(ArtworkVariantDto? variant) =>
        variant is null
            ? "Not available"
            : string.IsNullOrWhiteSpace(variant.ProviderName) ? variant.Origin : variant.ProviderName;

    private static string GetArtworkVariantLabel(ArtworkSlotDto slot, ArtworkVariantDto variant) =>
        $"{FormatArtworkType(slot.AssetType)} | {(variant.IsPreferred ? "Primary" : GetArtworkSource(variant))}";

    private async Task RefreshNowAsync()
    {
        _queueing = true;
        var queued = await ApiClient.QueueEnrichmentRefreshNowAsync("Person", PersonId);
        _queueing = false;
        Snackbar.Add(queued?.Message ?? "The person refresh could not be queued.", queued is null ? Severity.Error : Severity.Success);
        if (queued is not null)
        {
            var schedule = await ApiClient.GetEnrichmentRefreshScheduleAsync("Person", limit: 500);
            _refresh = schedule?.Items.FirstOrDefault(item => item.EntityId == PersonId) ?? _refresh;
        }
    }

    private void Close()
    {
        if (_dirty)
        {
            Snackbar.Add("Save or reset your person changes before closing.", Severity.Warning);
            return;
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private static IReadOnlyList<string> SplitValues(string? value) => string.IsNullOrWhiteSpace(value) ? [] : value.Split([',', ';', '|'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private static string BuildSortName(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length < 2 ? name : $"{parts[^1]}, {string.Join(" ", parts[..^1])}"; }
    private static string FormatArtworkType(string type) => type == "Headshot" ? "Portrait" : type;
    private static string GetArtworkHelp(string type) => type switch { "Headshot" => "Primary portrait used on person cards and details.", "Background" => "Wide cinematic background for the person detail page.", "Banner" => "Wide banner alternative.", "Logo" => "Transparent identity mark; PNG only.", _ => "Custom artwork." };
    private static string HistoryIcon(string category) => category switch { "artwork" => Icons.Material.Outlined.Collections, "match" => Icons.Material.Outlined.TravelExplore, _ => Icons.Material.Outlined.Edit };
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("MMM d, yyyy · h:mm tt") ?? "Not yet";
}
