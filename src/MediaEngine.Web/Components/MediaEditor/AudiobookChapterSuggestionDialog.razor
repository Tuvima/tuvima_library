@namespace MediaEngine.Web.Components.MediaEditor
@using MediaEngine.Contracts.Playback

<AppDialog>
    <TitleContent>
        <div class="sme-ai-dialog__title">
            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
            <span>Review chapter suggestions</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="sme-ai-dialog__content">
            <AppAlert Tone="AppUiTone.Info">
                Suggestions only update the editor. Nothing is written until you choose Save Changes.
            </AppAlert>
            @foreach (var warning in Suggestions.Warnings)
            {
                <AppAlert Tone="AppUiTone.Warning">@warning</AppAlert>
            }
            <div class="sme-ai-dialog__toolbar">
                <AppButton Label="Accept high confidence"
                           StartIcon="@Icons.Material.Outlined.DoneAll"
                           OnClick="AcceptHighConfidence" />
                <span>@_selected.Count of @Suggestions.Suggestions.Count selected</span>
            </div>
            <div class="sme-ai-suggestion-list">
                @foreach (var suggestion in Suggestions.Suggestions)
                {
                    <label class="sme-ai-suggestion" @key="suggestion.ChapterIndex">
                        <AppCheckbox Value="@_selected.Contains(suggestion.ChapterIndex)"
                                     ValueChanged="@((bool selected) => SetSelected(suggestion.ChapterIndex, selected))"
                                     aria-label="@($"Use suggestion for chapter {suggestion.ChapterIndex + 1}")" />
                        <span class="sme-ai-suggestion__number">@(suggestion.ChapterIndex + 1)</span>
                        <span class="sme-ai-suggestion__copy">
                            <small>@suggestion.CurrentTitle</small>
                            <strong>@suggestion.SuggestedTitle</strong>
                            @if (!string.IsNullOrWhiteSpace(suggestion.Reason))
                            {
                                <span>@suggestion.Reason</span>
                            }
                        </span>
                        <AppChip Text="@($"{suggestion.Confidence:P0}")"
                                 Tone="@(suggestion.Confidence >= HighConfidenceThreshold ? AppUiTone.Success : AppUiTone.Neutral)" />
                    </label>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <AppButton Label="Cancel" OnClick="Cancel" />
        <AppButton Label="Apply selected"
                   ButtonStyle="AppButtonStyle.Filled"
                   Tone="AppUiTone.Primary"
                   Disabled="@(_selected.Count == 0)"
                   OnClick="Apply" />
    </DialogActions>
</AppDialog>

@code {
    private const double HighConfidenceThreshold = 0.8;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public AudiobookChapterNameSuggestionsDto Suggestions { get; set; } = new();
    private readonly HashSet<int> _selected = [];

    private void SetSelected(int chapterIndex, bool selected)
    {
        if (selected) _selected.Add(chapterIndex);
        else _selected.Remove(chapterIndex);
    }

    private void AcceptHighConfidence()
    {
        foreach (var suggestion in Suggestions.Suggestions.Where(item => item.Confidence >= HighConfidenceThreshold))
            _selected.Add(suggestion.ChapterIndex);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Apply() => MudDialog.Close(DialogResult.Ok<IReadOnlyList<AudiobookChapterNameSuggestionDto>>(
        Suggestions.Suggestions.Where(item => _selected.Contains(item.ChapterIndex)).ToList()));
}
