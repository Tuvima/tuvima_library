@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details

@if (Model.PrimaryModule.Kind != DetailPrimaryModuleKind.None)
{
    <section id="detail-primary-module" class="@RootClass" aria-labelledby="detail-primary-module-title">
        @if (ShowHeader)
        {
            <header class="tl-detail-primary-module__header">
                <div class="tl-detail-primary-module__title">
                    <MudIcon Icon="@ModuleIcon" Size="Size.Small" />
                    <h2 id="detail-primary-module-title">@Model.PrimaryModule.Title</h2>
                </div>

                @if (ShowModuleControls)
                {
                    <div class="tl-detail-primary-module__controls">
                        @if (ShowRoleFilter)
                        {
                            <div class="tl-detail-primary-module__role-filters"
                                 aria-label="Filter works by role">
                                @foreach (var role in RoleOptions)
                                {
                                    <AppNativeButton Type="button"
                                                     Class="@RoleFilterClass(role.Key)"
                                                     OnClick="@(() => SelectRole(role.Key))"
                                                     aria-pressed="@(_selectedRole == role.Key)"
                                                     title="@($"{role.Label} ({role.Count})")">
                                        <MudIcon Icon="@RoleIcon(role.Key)" Size="Size.Small" />
                                        <span class="tl-detail-primary-module__filter-label">@role.Label</span>
                                    </AppNativeButton>
                                }
                            </div>
                        }

                        @if (ShowRoleFilter && ShowLaneFilters)
                        {
                            <span class="tl-detail-primary-module__filter-separator" aria-hidden="true"></span>
                        }

                        @if (ShowLaneFilters)
                        {
                            <div class="tl-detail-primary-module__filters" aria-label="Filter works by library lane">
                                @foreach (var lane in DisplayedLaneOptions)
                                {
                                    <AppNativeButton Type="button"
                                                     Class="@FilterClass(_selectedLane, lane.Key)"
                                                     Disabled="@(lane.Count == 0)"
                                                     OnClick="@(() => SelectLane(lane.Key))"
                                                     aria-pressed="@(_selectedLane == lane.Key)"
                                                     title="@($"{lane.Label} ({lane.Count})")">
                                        @if (LaneIcon(lane.Key) is { } icon)
                                        {
                                            <MudIcon Icon="@icon" Size="Size.Small" />
                                        }
                                        <span class="tl-detail-primary-module__filter-label">@lane.Label</span>
                                        <span class="tl-detail-primary-module__filter-count">@lane.Count</span>
                                    </AppNativeButton>
                                }
                            </div>
                        }
                    </div>
                }
            </header>
        }

        <div class="tl-detail-primary-module__viewport">
            @if (Model.PrimaryModule.Kind is DetailPrimaryModuleKind.Sequence or DetailPrimaryModuleKind.Episodes
                 && Model.SequencePlacement is not null)
            {
                <SequencePlacementPanel Placement="Model.SequencePlacement"
                                        DetailSurface="true"
                                        OnContainerSelected="OnContainerSelected" />
            }
            else if (Model.PrimaryModule.Kind == DetailPrimaryModuleKind.Chapters)
            {
                <AudiobookChapterList Groups="PrimaryGroups"
                                      AudiobookTitle="@Model.Title"
                                      AudiobookArtworkUrl="@ArtworkUrl" />
            }
            else if (FilteredItems.Count == 0)
            {
                <p class="tl-detail-primary-module__empty">No owned library items are available for this section.</p>
            }
            else
            {
                <div class="tl-detail-primary-module__rail">
                    @foreach (var item in FilteredItems)
                    {
                        <a class="@ItemClass(item)" href="@ResolveRoute(item)">
                            <span class="tl-detail-primary-module__art">
                                @if (!string.IsNullOrWhiteSpace(item.ArtworkUrl))
                                {
                                    <img src="@item.ArtworkUrl" alt="" />
                                }
                                else
                                {
                                    <GeneratedIdentity Name="@item.Title" />
                                }
                                <span class="@MediaTypeBadgeClass(item)">
                                    <MudIcon Icon="@MediaTypeIcon(item.EntityType)" Size="Size.Small" />
                                    @MediaTypeLabel(item.EntityType)
                                </span>
                            </span>
                            <span class="tl-detail-primary-module__copy">
                                <strong>@item.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <small>@item.Subtitle</small>
                                }
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public DetailPageViewModel Model { get; set; } = default!;
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback<SequenceContainerOptionViewModel> OnContainerSelected { get; set; }

    private string _selectedLane = "all";
    private string _selectedRole = "all";
    private string? _modelId;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_modelId, Model.Id, StringComparison.Ordinal))
        {
            _modelId = Model.Id;
            var ownedLanes = LaneOptions
                .Where(option => option.Key != "all" && option.Count > 0)
                .ToList();
            _selectedLane = ownedLanes.Count == 1 ? ownedLanes[0].Key : "all";
            _selectedRole = "all";
        }
    }

    private IReadOnlyList<MediaGroupingViewModel> PrimaryGroups
        => Model.PrimaryModule.GroupKeys.Count == 0
            ? Model.MediaGroups
            : Model.MediaGroups
                .Where(group => Model.PrimaryModule.GroupKeys.Contains(group.Key, StringComparer.OrdinalIgnoreCase))
                .ToList();

    private IReadOnlyList<MediaGroupingItemViewModel> AllItems
        => PrimaryGroups
            .SelectMany(group => group.Items)
            .Where(item => item.IsOwned)
            .GroupBy(item => $"{item.EntityType}:{item.Id}", StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();

    private IReadOnlyList<MediaGroupingItemViewModel> FilteredItems
        => AllItems
            .Where(item => _selectedLane == "all" || string.Equals(ResolveLane(item), _selectedLane, StringComparison.OrdinalIgnoreCase))
            .Where(item => _selectedRole == "all" || item.Roles.Contains(_selectedRole, StringComparer.OrdinalIgnoreCase))
            .OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<FilterOption> LaneOptions
    {
        get
        {
            var values = AllItems
                .GroupBy(ResolveLane, StringComparer.OrdinalIgnoreCase)
                .Where(group => !string.Equals(group.Key, "other", StringComparison.OrdinalIgnoreCase))
                .OrderBy(group => LaneSort(group.Key))
                .Select(group => new FilterOption(group.Key, LaneLabel(group.Key), group.Count()))
                .ToList();
            return [new FilterOption("all", "All", AllItems.Count), .. values];
        }
    }

    private IReadOnlyList<FilterOption> DisplayedLaneOptions
    {
        get
        {
            var owned = LaneOptions
                .Where(option => option.Key != "all")
                .ToDictionary(option => option.Key, StringComparer.OrdinalIgnoreCase);

            if (IsPersonSurface)
            {
                return new[] { "read", "watch", "listen" }
                    .Select(key => owned.TryGetValue(key, out var option)
                        ? option
                        : new FilterOption(key, LaneLabel(key), 0))
                    .ToList();
            }

            return owned.Values.OrderBy(option => LaneSort(option.Key)).ToList();
        }
    }

    private IReadOnlyList<FilterOption> RoleOptions
    {
        get
        {
            var values = AllItems
                .SelectMany(item => item.Roles)
                .Where(role => !string.IsNullOrWhiteSpace(role))
                .GroupBy(role => role, StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(group => group.Count())
                .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
                .Select(group => new FilterOption(group.Key, group.Key, group.Count()))
                .ToList();
            return [new FilterOption("all", "All roles", AllItems.Count), .. values];
        }
    }

    private bool HasMultipleOwnedLanes => LaneOptions.Count(option => option.Key != "all") > 1;
    private bool IsPersonSurface => Model.EntityType == DetailEntityType.Person;
    private bool ShowRoleFilter => Model.PrimaryModule.SupportsRoleFilter && RoleOptions.Count > 1;
    private bool ShowLaneFilters => Model.PrimaryModule.SupportsLaneFilter
        && (HasMultipleOwnedLanes || (IsPersonSurface && AllItems.Count > 0));
    private bool ShowModuleControls => ShowRoleFilter || ShowLaneFilters;

    private bool ShowHeader => Model.PrimaryModule.Kind is not DetailPrimaryModuleKind.Chapters
        and not DetailPrimaryModuleKind.Sequence
        and not DetailPrimaryModuleKind.Episodes;

    private string ModuleIcon => Model.EntityType == DetailEntityType.Person
        ? Icons.Material.Outlined.Workspaces
        : Model.EntityType == DetailEntityType.Collection
            ? Icons.Material.Outlined.CollectionsBookmark
            : Icons.Material.Outlined.AccountTree;

    private string? ArtworkUrl => Model.Artwork.CoverUrl ?? Model.Artwork.PosterUrl ?? Model.Artwork.HeroArtwork.Url;

    private string RootClass =>
        $"tl-detail-primary-module tl-detail-primary-module--{Model.PrimaryModule.Kind.ToString().ToLowerInvariant()} {(Embedded ? "tl-detail-primary-module--embedded" : "tl-detail-primary-module--below-hero")}";

    private static string FilterClass(string selected, string key)
        => $"tl-detail-primary-module__filter tl-detail-primary-module__filter--{key}{(string.Equals(selected, key, StringComparison.OrdinalIgnoreCase) ? " is-active" : string.Empty)}";

    private string RoleFilterClass(string key)
        => $"tl-detail-primary-module__role-filter{(string.Equals(_selectedRole, key, StringComparison.OrdinalIgnoreCase) ? " is-active" : string.Empty)}";

    private string ItemClass(MediaGroupingItemViewModel item)
        => $"tl-detail-primary-module__item tl-detail-primary-module__item--{ArtworkShape(item.EntityType)}";

    private string ArtworkShape(DetailEntityType entityType)
        => entityType switch
        {
            DetailEntityType.MusicAlbum or DetailEntityType.Audiobook => "square",
            DetailEntityType.TvEpisode => "wide",
            _ => "portrait",
        };

    private static string MediaTypeBadgeClass(MediaGroupingItemViewModel item)
        => $"tl-detail-primary-module__media-type tl-detail-primary-module__media-type--{ResolveLane(item)}";

    private static string MediaTypeLabel(DetailEntityType entityType) => entityType switch
    {
        DetailEntityType.Movie => "Movie",
        DetailEntityType.TvShow => "TV Series",
        DetailEntityType.TvSeason => "Season",
        DetailEntityType.TvEpisode => "Episode",
        DetailEntityType.MusicAlbum => "Album",
        DetailEntityType.Audiobook => "Audiobook",
        DetailEntityType.ComicIssue => "Comic",
        DetailEntityType.ComicSeries => "Comic series",
        DetailEntityType.BookSeries => "Book series",
        _ => "Book",
    };

    private static string MediaTypeIcon(DetailEntityType entityType) => entityType switch
    {
        DetailEntityType.Movie => Icons.Material.Outlined.LocalMovies,
        DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => Icons.Material.Outlined.Tv,
        DetailEntityType.MusicAlbum => Icons.Material.Outlined.Album,
        DetailEntityType.Audiobook => Icons.Material.Outlined.Headphones,
        DetailEntityType.ComicIssue or DetailEntityType.ComicSeries => Icons.Material.Outlined.AutoStories,
        _ => Icons.Material.Outlined.MenuBook,
    };

    private static string ResolveRoute(MediaGroupingItemViewModel item)
        => item.Actions.FirstOrDefault(action => !string.IsNullOrWhiteSpace(action.Route))?.Route
           ?? FallbackDetailRoute(item);

    private static string FallbackDetailRoute(MediaGroupingItemViewModel item) => item.EntityType switch
    {
        DetailEntityType.Movie or DetailEntityType.TvEpisode
            => $"/details/work/{item.Id}?context=watch",
        DetailEntityType.Book or DetailEntityType.Audiobook or DetailEntityType.ComicIssue or DetailEntityType.Work
            => $"/details/work/{item.Id}?context={ResolveLane(item)}",
        DetailEntityType.TvShow => $"/details/tvshow/{item.Id}?context=watch",
        DetailEntityType.MusicAlbum => $"/details/musicalbum/{item.Id}?context=listen",
        DetailEntityType.MovieSeries => $"/details/movieseries/{item.Id}?context=watch",
        DetailEntityType.BookSeries => $"/details/bookseries/{item.Id}?context=read",
        DetailEntityType.ComicSeries => $"/details/comicseries/{item.Id}?context=comics",
        DetailEntityType.Collection => $"/details/collection/{item.Id}?context={ResolveLane(item)}",
        DetailEntityType.Person => $"/details/person/{item.Id}?context={ResolveLane(item)}",
        _ => $"/details/work/{item.Id}?context={ResolveLane(item)}",
    };

    private static string ResolveLane(MediaGroupingItemViewModel item)
        => !string.IsNullOrWhiteSpace(item.Lane) ? item.Lane : item.EntityType switch
        {
            DetailEntityType.Movie or DetailEntityType.MovieSeries or DetailEntityType.TvShow or DetailEntityType.TvSeason or DetailEntityType.TvEpisode => "watch",
            DetailEntityType.MusicAlbum or DetailEntityType.Audiobook => "listen",
            DetailEntityType.Book or DetailEntityType.BookSeries or DetailEntityType.ComicIssue or DetailEntityType.ComicSeries => "read",
            _ => "other",
        };

    private static string LaneLabel(string key) => key switch
    {
        "read" => "Read",
        "watch" => "Watch",
        "listen" => "Listen",
        _ => "Other",
    };

    private static string? LaneIcon(string key) => key switch
    {
        "read" => Icons.Material.Outlined.MenuBook,
        "watch" => Icons.Material.Outlined.Tv,
        "listen" => Icons.Material.Outlined.Headphones,
        _ => null,
    };

    private static string RoleIcon(string role) => role.ToLowerInvariant() switch
    {
        "all" => Icons.Material.Outlined.Workspaces,
        "actor" or "voice actor" => Icons.Material.Outlined.Person,
        "director" => Icons.Material.Outlined.Movie,
        "author" or "writer" or "screenwriter" => Icons.Material.Outlined.EditNote,
        "artist" or "illustrator" or "colorist" or "letterer" or "photographer" => Icons.Material.Outlined.Palette,
        "narrator" => Icons.Material.Outlined.RecordVoiceOver,
        "performer" or "singer" or "musician" => Icons.Material.Outlined.Mic,
        "composer" => Icons.Material.Outlined.MusicNote,
        "producer" or "editor" or "publisher" => Icons.Material.Outlined.Badge,
        "translator" => Icons.Material.Outlined.Translate,
        _ => Icons.Material.Outlined.Badge,
    };

    private static int LaneSort(string key) => key switch
    {
        "read" => 0,
        "watch" => 1,
        "listen" => 2,
        _ => 3,
    };

    private void SelectLane(string lane)
        => _selectedLane = string.Equals(_selectedLane, lane, StringComparison.OrdinalIgnoreCase) ? "all" : lane;

    private void SelectRole(string role)
        => _selectedRole = string.Equals(_selectedRole, role, StringComparison.OrdinalIgnoreCase) ? "all" : role;

    private sealed record FilterOption(string Key, string Label, int Count);
}
