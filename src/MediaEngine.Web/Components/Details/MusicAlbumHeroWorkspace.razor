@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details

@if (Model.MusicAlbumWorkspace is { } workspace)
{
    <section class="tl-music-album-workspace" aria-label="@($"{Model.Title} album workspace")">
        @if (workspace.MoreByAlbums.Count > 0)
        {
            <aside class="tl-music-album-workspace__more-by" aria-labelledby="music-more-by-title">
                <header>
                    <h2 id="music-more-by-title">More by @workspace.PrimaryArtistName</h2>
                    @if (!string.IsNullOrWhiteSpace(workspace.PrimaryArtistRoute))
                    {
                        <a href="@workspace.PrimaryArtistRoute">View all</a>
                    }
                </header>

                <div class="tl-music-album-workspace__more-by-list">
                    @foreach (var album in workspace.MoreByAlbums)
                    {
                        <a class="tl-music-album-workspace__album" href="@album.Route">
                            <span class="tl-music-album-workspace__album-art">
                                @if (!string.IsNullOrWhiteSpace(album.ArtworkUrl))
                                {
                                    <img src="@album.ArtworkUrl" alt="" />
                                }
                                else
                                {
                                    <GeneratedIdentity Name="@album.Title" />
                                }
                            </span>
                            <span class="tl-music-album-workspace__album-copy">
                                <strong>@album.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(album.Year))
                                {
                                    <small>@album.Year</small>
                                }
                            </span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                        </a>
                    }
                </div>
            </aside>
        }

        <div id="music-album-workspace-panel"
             class="tl-music-album-workspace__panel"
             role="tabpanel">
            @if (_activeSection == "tracks")
            {
                <MusicTrackList Groups="Model.MediaGroups"
                                AlbumTitle="@Model.Title"
                                AlbumArtworkUrl="@(Model.Artwork.CoverUrl ?? Model.Artwork.PosterUrl)"
                                Compact="true">
                    <ToolbarLeadingContent>
                        <MusicAlbumWorkspaceNavigation ActiveSection="@_activeSection"
                                                       ActiveSectionChanged="SelectSectionAsync" />
                    </ToolbarLeadingContent>
                </MusicTrackList>
            }
            else
            {
                <header class="tl-music-album-workspace__panel-header">
                    <MusicAlbumWorkspaceNavigation ActiveSection="@_activeSection"
                                                   ActiveSectionChanged="SelectSectionAsync" />
                </header>
                <div class="tl-music-album-workspace__panel-scroller">
                    @if (_activeSection == "credits")
                    {
                        @if (Model.ContributorGroups.Count > 0)
                        {
                            <PeopleAndCharactersTab ContributorGroups="Model.ContributorGroups"
                                                    IncludeCharacters="false" />
                        }
                        else
                        {
                            <p class="tl-music-album-workspace__empty">No album credits are available yet.</p>
                        }
                    }
                    else
                    {
                        <DetailsTab Model="Model" />
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public DetailPageViewModel Model { get; set; } = default!;

    private string _activeSection = "tracks";
    private string? _lastModelId;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastModelId, Model.Id, StringComparison.Ordinal))
        {
            _lastModelId = Model.Id;
            _activeSection = "tracks";
        }
    }

    private Task SelectSectionAsync(string section)
    {
        _activeSection = section is "credits" or "details" ? section : "tracks";
        return Task.CompletedTask;
    }
}
