@namespace MediaEngine.Web.Components.Details
@using MediaEngine.Contracts.Details

@if (Actions.Count > 0)
{
    <AppOverflowMenu Icon="@Icons.Material.Outlined.MoreHoriz"
                     Label="@Label"
                     AriaLabel="More actions"
                     Class="tl-detail-overflow"
                     TriggerClass="@EffectiveButtonClass"
                     PopoverClass="@PopoverRootClass"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
        <ManageActionsMenu Actions="Actions" OnActionSelected="OnActionSelected" />
    </AppOverflowMenu>
}

@code {
    [Parameter] public IReadOnlyList<DetailAction> Actions { get; set; } = [];
    [Parameter] public string? Label { get; set; }
    [Parameter] public string ButtonClass { get; set; } = "tl-detail-person-more-action";
    [Parameter] public EventCallback<DetailAction> OnActionSelected { get; set; }

    private string PopoverRootClass =>
        $"tl-detail-overflow-popover {(Actions.Count == 1 ? "tl-detail-overflow-popover--compact" : null)}";
    private string EffectiveButtonClass =>
        string.Join(" ", ButtonClass.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(value => !string.Equals(value, "tl-detail-more-action", StringComparison.Ordinal)));
}
