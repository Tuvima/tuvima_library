@namespace MediaEngine.Web.Components.Details

<div class="tl-music-workspace-nav" role="tablist" aria-label="Album information">
    @foreach (var item in Sections)
    {
        <AppNativeButton Type="button"
                         Class="@TabClass(item.Key)"
                         OnClick="@(() => ActiveSectionChanged.InvokeAsync(item.Key))"
                         role="tab"
                         aria-selected="@(ActiveSection == item.Key ? "true" : "false")"
                         aria-controls="music-album-workspace-panel">
            @item.Label
        </AppNativeButton>
    }
</div>

@code {
    [Parameter] public string ActiveSection { get; set; } = "tracks";
    [Parameter] public EventCallback<string> ActiveSectionChanged { get; set; }

    private static readonly IReadOnlyList<(string Key, string Label)> Sections =
    [
        ("tracks", "Tracks"),
        ("credits", "Credits"),
        ("details", "Details"),
    ];

    private string TabClass(string key)
        => $"tl-music-workspace-nav__tab{(ActiveSection == key ? " is-active" : string.Empty)}";
}
