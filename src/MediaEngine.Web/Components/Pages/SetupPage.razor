@page "/setup"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout MediaEngine.Web.Shared.SetupWizardLayout
@using MediaEngine.Contracts.Setup
@using MediaEngine.Contracts.Settings
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IEngineApiClient ApiClient
@inject ProtectedLocalStorage Storage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Set up Tuvima Library</PageTitle>

<main class="setup-page">
    <AppPageHeader Eyebrow="Tuvima Library" Title="@PageTitleText" Subtitle="@PageSubtitle" Compact="true" />

    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading setup" Message="Checking this server's durable setup state." />
    }
    else if (_status is null)
    {
        <AppPageState Kind="AppPageStateKind.Error" Title="Setup is unavailable" Message="The Engine did not return setup status. Check the container logs and retry." />
    }
    else
    {
        <div class="setup-progress" aria-label="Setup progress">
            <span>Step @(CurrentIndex + 1) of @SetupWorkflow.StepKeys.Length</span>
            <progress class="setup-progress__track" max="100" value="@ProgressPercent">@ProgressPercent%</progress>
            <strong>@Friendly(CurrentStep)</strong>
        </div>

        <ol class="setup-stepper" aria-label="Setup steps">
            @foreach (var step in SetupWorkflow.StepKeys)
            {
                var state = StepState(step);
                <li class="@StepClass(step)" aria-current="@(step == CurrentStep ? "step" : null)">
                    <AppNativeButton Type="button" Disabled="@(!CanNavigateTo(step))" OnClick="@(() => GoToStep(step))">
                        <span>@(state is "passed" or "deferred" ? "✓" : (Array.IndexOf(SetupWorkflow.StepKeys, step) + 1).ToString())</span>
                        <small>@Friendly(step)</small>
                    </AppNativeButton>
                </li>
            }
        </ol>

        <section class="setup-stage" aria-labelledby="setup-stage-title">
            @switch (CurrentStep)
            {
                case "preflight":
                    @PreflightStage()
                    break;
                case "administrator":
                    @AdministratorStage()
                    break;
                case "media-locations":
                    @MediaLocationsStage()
                    break;
                case "providers":
                    @ProvidersStage()
                    break;
                default:
                    @ReadinessStage()
                    break;
            }
            @if (CurrentIndex > 0)
            {
                <footer class="setup-stage__footer">
                    <AppButton Label="Back" StartIcon="@Icons.Material.Outlined.ArrowBack" OnClick="GoBack" />
                    @if (CurrentStep != WorkflowStep)
                    {
                        <AppButton Label="Return to current step" EndIcon="@Icons.Material.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="ReturnToCurrentStep" />
                    }
                </footer>
            }
        </section>
    }
</main>

@code {
    private const string SetupSessionKey = "tuvima.setup.session.v2";
    private SetupStatusDto? _status;
    private SetupPreflightDto? _preflight;
    private SetupBackupInspectionDto? _backup;
    private SetupMediaLocationsDto? _media;
    private LibrariesConfigurationDto? _setupLibraries;
    private SetupReadinessDto? _readiness;
    private string? _setupSession;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _passwordConfirmation = string.Empty;
    private string _displayName = "Administrator";
    private IReadOnlyList<string> _recoveryCodes = [];
    private IReadOnlyList<(string Name, bool Success, string Detail)> _providerResults = [];
    private IReadOnlyList<ProviderCatalogueDto> _providerCatalogue = [];
    private readonly Dictionary<string, Dictionary<string, string>> _providerCredentials = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, ProviderCredentialOperationResultDto> _providerCredentialResults = new(StringComparer.OrdinalIgnoreCase);
    private bool _providerTestCompleted;
    private string? _sampleScanDetail;
    private bool _loading = true;
    private bool _busy;
    private bool _showRestore;
    private bool _showLibraryWizard;
    private bool _authenticated;
    private string? _selectedStep;
    private string? _busyProvider;

    private string WorkflowStep => NormalizeStep(_status?.CurrentStep);
    private string CurrentStep => _selectedStep ?? WorkflowStep;
    private int CurrentIndex => Math.Max(0, Array.IndexOf(SetupWorkflow.StepKeys, CurrentStep));
    private int ProgressPercent => (int)Math.Round(((CurrentIndex + 1d) / SetupWorkflow.StepKeys.Length) * 100d);
    private bool PasswordsMatch => string.Equals(_password, _passwordConfirmation, StringComparison.Ordinal);
    private string RecoveryCodesText => $"Tuvima Library administrator recovery codes{Environment.NewLine}Created: {DateTimeOffset.Now:g}{Environment.NewLine}{Environment.NewLine}{string.Join(Environment.NewLine, _recoveryCodes)}{Environment.NewLine}";
    private string RecoveryCodesDownloadUri => $"data:text/plain;charset=utf-8,{Uri.EscapeDataString(RecoveryCodesText)}";
    private IReadOnlyList<ProviderCatalogueDto> KeyedProviders => _providerCatalogue
        .Where(provider => provider.Enabled && provider.RequiresKey && provider.Onboarding is not null)
        .OrderBy(provider => provider.Onboarding!.Classification == "recommended" ? 0 : 1)
        .ThenBy(provider => provider.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    private IReadOnlyList<ProviderCatalogueDto> BuiltInProviders => _providerCatalogue
        .Where(provider => provider.Enabled && !provider.RequiresKey && provider.Onboarding is not null)
        .OrderBy(provider => provider.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    private string PageTitleText => CurrentStep == "preflight" ? "Welcome to your library" : Friendly(CurrentStep);
    private string PageSubtitle => CurrentStep switch
    {
        "preflight" => "Start fresh or recover a backup, then verify the storage and tools visible to this server.",
        "administrator" => "Create the first authenticated administrator and household profile.",
        "media-locations" => "Connect read-only sources separately from storage Tuvima may manage.",
        "providers" => "Connect the metadata services that make each media lane useful.",
        _ => "Review what passed, what was deferred, and anything that still needs repair.",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await Storage.GetAsync<string>(SetupSessionKey);
            _setupSession = stored.Success ? stored.Value : null;
        }
        catch { _setupSession = null; }
        _authenticated = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _status = await ApiClient.GetSetupStatusAsync();
        if (_status?.RequiresSetupStart == true && !_authenticated && string.IsNullOrWhiteSpace(_setupSession))
        {
            var started = await ApiClient.BeginSetupAsync();
            if (started is not null)
            {
                _setupSession = started.SetupSessionToken;
                await Storage.SetAsync(SetupSessionKey, _setupSession);
                _status = started.Status;
            }
        }
        _loading = false;
        if (_status?.State == "complete")
        {
            Navigation.NavigateTo(_authenticated ? "/" : "/auth/login", forceLoad: true, replace: true);
            return;
        }
        if (_status?.RequiresAuthentication == true && !_authenticated && _status.CurrentStep != "administrator")
        {
            Navigation.NavigateTo("/auth/login?returnUrl=%2Fsetup", forceLoad: true);
            return;
        }
        if (CurrentStep == "preflight" && _setupLibraries is null)
            _setupLibraries = await ApiClient.GetSetupLibrariesAsync(_setupSession);
        StateHasChanged();
        if (CurrentStep == "providers" && !_providerTestCompleted && !_busy)
        {
            await LoadProvidersAsync();
            _providerTestCompleted = true;
        }
    }

    private RenderFragment PreflightStage() => @<text>
        <div class="setup-stage__heading"><MudIcon Icon="@Icons.Material.Outlined.FactCheck" /><div><h2 id="setup-stage-title">Prepare this installation</h2><p>You can begin with a clean library or recover an existing Tuvima backup.</p></div></div>
        <AppAlert Tone="AppUiTone.Info">Keep this Dashboard on your private network until the first administrator is created. An unconfigured server intentionally accepts setup without a separate claim token.</AppAlert>
        @if (_showRestore)
        {
            <div class="setup-restore">
                <h3>Restore a backup file</h3>
                <p>Choose a Tuvima backup ZIP. It is inspected before anything is replaced.</p>
                <InputFile OnChange="UploadBackupAsync" accept=".zip,application/zip" class="setup-file-input" />
                @if (_backup is not null)
                {
                    <dl class="setup-facts"><div><dt>File</dt><dd>@_backup.FileName</dd></div><div><dt>Created</dt><dd>@(_backup.CreatedAt?.ToString("g") ?? "Unknown")</dd></div><div><dt>Database epoch</dt><dd>@_backup.DatabaseEpoch</dd></div><div><dt>Entries</dt><dd>@_backup.EntryCount</dd></div></dl>
                    <AppAlert Tone="AppUiTone.Warning">@_backup.Warning The application will restart after confirmation.</AppAlert>
                    <div class="setup-actions"><AppButton Label="Cancel restore" OnClick="@(() => { _showRestore = false; _backup = null; })" /><AppButton Label="Restore and restart" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Warning" Loading="@_busy" OnClick="ConfirmRestoreAsync" /></div>
                }
            </div>
        }
        else
        {
            <div class="setup-choice-grid"><AppNativeButton Type="button" Class="setup-choice" OnClick="RunPreflightAsync"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" /><strong>Start fresh</strong><small>Validate this installation and use the editable storage locations below.</small></AppNativeButton><AppNativeButton Type="button" Class="setup-choice" OnClick="@(() => _showRestore = true)"><MudIcon Icon="@Icons.Material.Outlined.Restore" /><strong>Restore backup</strong><small>Recover a catalogue and non-secret configuration from a ZIP file.</small></AppNativeButton></div>
        }
        @if (_setupLibraries is not null)
        {
            <div class="setup-storage-editor">
                <div><h3>Server storage locations</h3><p>These are the host folders Tuvima may browse or manage. In Docker, each path must also be mounted into the container.</p></div>
                @foreach (var location in _setupLibraries.StorageLocations)
                {
                    <div class="setup-storage-row">
                        <AppTextField Label="@location.Label" Value="@location.Path" ValueChanged="@((string? value) => location.Path = value?.Trim() ?? string.Empty)" />
                        <AppStatusBadge Text="@(location.AllowWrite ? "Writable" : "Read only")" Tone="@(location.AllowWrite ? AppUiTone.Success : AppUiTone.Neutral)" />
                    </div>
                }
                <div class="setup-actions"><AppButton Label="Save storage locations" StartIcon="@Icons.Material.Outlined.Save" Loading="@_busy" OnClick="SaveStorageLocationsAsync" /></div>
            </div>
        }
        @if (_preflight is not null)
        {
            <AppAlert Tone="@(_preflight.Passed ? AppUiTone.Success : AppUiTone.Error)">@_preflight.ContainerExplanation</AppAlert>
            <div class="setup-checks">@foreach (var check in _preflight.Checks) { <article><AppStatusBadge Text="@Friendly(check.Status)" Tone="@(check.Status == "passed" ? AppUiTone.Success : AppUiTone.Error)" /><div><strong>@check.Label</strong><code>@check.Path</code><small>@check.Detail @if (check.Key is "database" or "config") { <span> This startup-owned location is changed with the server environment or container volume, then a restart.</span> }</small></div></article> }</div>
            <div class="setup-runtime">@_preflight.RuntimeIdentifier · @_preflight.ProcessArchitecture · FFmpeg: @_preflight.FfmpegStatus</div>
            <div class="setup-actions setup-actions--end"><AppButton Label="Continue" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(!_preflight.Passed)" OnClick="ReloadAsync" /></div>
        }
    </text>;

    private RenderFragment AdministratorStage() => @<text>
        <div class="setup-stage__heading"><MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" /><div><h2 id="setup-stage-title">Administrator</h2><p>This account can manage libraries, providers, users, backups, and remote access.</p></div></div>
        @if (_recoveryCodes.Count > 0)
        {
            <AppAlert Tone="AppUiTone.Warning">Save these one-time recovery codes somewhere private. They will not be shown again.</AppAlert>
            <div class="setup-recovery-codes">
                <AppTextarea Value="@RecoveryCodesText" ReadOnly="true" Lines="@(_recoveryCodes.Count + 2)" Class="setup-recovery-text" />
                <div class="setup-actions"><AppButton Label="Copy all" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyRecoveryCodesAsync" /><a class="setup-download-button" href="@RecoveryCodesDownloadUri" download="tuvima-administrator-recovery-codes.txt"><span class="mud-icon-root mud-svg-icon mud-icon-size-medium">↓</span> Download .txt</a></div>
            </div>
            <div class="setup-actions setup-actions--end"><AppButton Label="I saved the codes — sign in" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" OnClick="SignIn" /></div>
        }
        else if (_status?.AdministratorConfigured == true)
        {
            <AppAlert Tone="AppUiTone.Success">The first administrator account and household profile are configured.</AppAlert>
        }
        else
        {
            <div class="setup-form-grid"><AppTextField Label="Display name" Value="@_displayName" ValueChanged="@((string? value) => _displayName = value ?? string.Empty)" /><AppTextField Label="Email" Value="@_email" ValueChanged="@((string? value) => _email = value ?? string.Empty)" /><AppTextField Label="Password" InputType="InputType.Password" Value="@_password" ValueChanged="@((string? value) => _password = value ?? string.Empty)" /><AppTextField Label="Confirm password" InputType="InputType.Password" Value="@_passwordConfirmation" ValueChanged="@((string? value) => _passwordConfirmation = value ?? string.Empty)" Error="@(!string.IsNullOrEmpty(_passwordConfirmation) && !PasswordsMatch)" ErrorText="Passwords do not match." /></div>
            <small>Use at least 8 characters. This password remains on your Tuvima server.</small>
            <div class="setup-actions setup-actions--end"><AppButton Label="Create administrator" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@(_busy || string.IsNullOrWhiteSpace(_email) || _password.Length < 8 || !PasswordsMatch)" OnClick="CreateAdministratorAsync" /></div>
        }
    </text>;

    private RenderFragment MediaLocationsStage() => @<text>
        <div class="setup-stage__heading"><MudIcon Icon="@Icons.Material.Outlined.FolderOpen" /><div><h2 id="setup-stage-title">Media locations</h2><p>Existing libraries remain read-only unless you explicitly choose managed writable storage.</p></div></div>
        @if (_showLibraryWizard)
        {
            <AddLibraryWizard Embedded="true" SetupSession="@_setupSession" LibraryCreated="LibraryCreatedAsync" Cancelled="@(() => _showLibraryWizard = false)" />
        }
        else
        {
            @if (_media is not null) { <AppAlert Tone="@(_media.Passed ? AppUiTone.Success : AppUiTone.Warning)">@_media.Detail</AppAlert> }
            <div class="setup-actions"><AppButton Label="Add a library" StartIcon="@Icons.Material.Outlined.CreateNewFolder" OnClick="@(() => _showLibraryWizard = true)" /><AppButton Label="Validate locations" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" OnClick="ValidateMediaAsync" /></div>
        }
    </text>;

    private RenderFragment ProvidersStage() => @<text>
        <div class="setup-stage__heading"><MudIcon Icon="@Icons.Material.Outlined.CloudSync" /><div><h2 id="setup-stage-title">Metadata providers</h2><p>Set up the services that need an API key. Built-in providers work without an account.</p></div></div>
        <AppAlert Tone="AppUiTone.Info">Apple API, Wikidata, MusicBrainz, and other open services need no credentials. TVDB identifiers are resolved through available metadata and used by Fanart.tv; Tuvima does not currently require a separate TVDB account.</AppAlert>
        @if (_providerCatalogue.Count == 0)
        {
            <AppButton Label="Load providers" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" OnClick="LoadProvidersAsync" />
        }
        else
        {
            <div class="setup-provider-grid">
                @foreach (var provider in KeyedProviders)
                {
                    <article class="setup-provider-card">
                        <div class="setup-provider-card__heading"><div><strong>@provider.DisplayName</strong><small>@ProviderPurpose(provider)</small></div><AppStatusBadge Text="@ProviderStatus(provider)" Tone="@ProviderTone(provider)" /></div>
                        @if (provider.Onboarding?.SignupUrl is { Length: > 0 } signupUrl)
                        {
                            <a href="@signupUrl" target="_blank" rel="noopener noreferrer">Create or open provider account <span aria-hidden="true">↗</span></a>
                        }
                        @foreach (var field in provider.Onboarding?.Credentials ?? [])
                        {
                            <AppTextField Label="@field.Label" InputType="InputType.Password" Value="@CredentialValue(provider.Name, field.Key)" ValueChanged="@(value => SetCredential(provider.Name, field.Key, value))" HelpText="@field.FormatHint" />
                        }
                        <AppButton Label="Save and verify" Size="AppControlSize.Compact" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@(_busyProvider == provider.Name)" Disabled="@(!CanSaveProvider(provider))" OnClick="@(() => SaveProviderCredentialsAsync(provider))" />
                        @if (_providerCredentialResults.TryGetValue(provider.Name, out var credentialResult))
                        {
                            <small class="@(credentialResult.Success ? "setup-provider-success" : "setup-provider-error")">@credentialResult.Message</small>
                        }
                    </article>
                }
            </div>
            <div class="setup-builtins"><strong>Ready without signup</strong><span>@string.Join(" · ", BuiltInProviders.Select(provider => provider.DisplayName))</span></div>
        }
        @if (_providerResults.Count > 0) { <div class="setup-checks">@foreach (var result in _providerResults) { <article><AppStatusBadge Text="@(result.Success ? "Passed" : "Unavailable")" Tone="@(result.Success ? AppUiTone.Success : AppUiTone.Warning)" /><div><strong>@result.Name</strong><small>@result.Detail</small></div></article> }</div> }
        <div class="setup-actions setup-actions--end"><AppButton Label="Finish provider setup later" OnClick="@(() => DecideStepAsync("providers", "deferred", "Provider credential setup deferred; built-in providers remain available."))" /><AppButton Label="Continue" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" OnClick="SaveProviderResultAsync" /></div>
    </text>;

    private RenderFragment ReadinessStage() => @<text>
        <div class="setup-stage__heading"><MudIcon Icon="@Icons.Material.Outlined.TaskAlt" /><div><h2 id="setup-stage-title">Ready to begin</h2><p>Required capabilities must pass. Optional capabilities may remain deferred.</p></div></div>
        @if (_readiness is null) { <AppButton Label="Check readiness" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" OnClick="LoadReadinessAsync" /> }
        else
        {
            <div class="setup-checks">@foreach (var capability in _readiness.Capabilities) { <article><AppStatusBadge Text="@Friendly(capability.Status)" Tone="@StatusTone(capability.Status)" /><div><strong>@Friendly(capability.Label)</strong><small>@capability.Detail</small>@if (!string.IsNullOrWhiteSpace(capability.RepairTarget) && capability.Status is not "passed") { <a href="@capability.RepairTarget">Repair</a> }</div></article> }</div>
            @if (!string.IsNullOrWhiteSpace(_sampleScanDetail)) { <AppAlert Tone="AppUiTone.Info">@_sampleScanDetail</AppAlert> }
            <div class="setup-actions setup-actions--end"><AppButton Label="Run sample scan" StartIcon="@Icons.Material.Outlined.Search" Loading="@_busy" Disabled="@(!_readiness.CanComplete)" OnClick="SampleScanAsync" /><AppButton Label="Finish setup" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Loading="@_busy" Disabled="@(!_readiness.CanComplete)" OnClick="CompleteAsync" /></div>
        }
    </text>;

    private async Task RunPreflightAsync() { _busy = true; _preflight = await ApiClient.RunSetupPreflightAsync(_setupSession); _busy = false; if (_preflight is null) Snackbar.Add("Preflight could not run.", Severity.Error); }
    private async Task SaveStorageLocationsAsync()
    {
        if (_setupLibraries is null) return;
        _busy = true;
        var saved = await ApiClient.UpdateSetupLibrariesAsync(new UpdateLibrariesRequest
        {
            SchemaVersion = _setupLibraries.SchemaVersion,
            StorageLocations = _setupLibraries.StorageLocations,
            ViewStorage = _setupLibraries.ViewStorage,
            Libraries = _setupLibraries.Libraries,
            IncomingSources = _setupLibraries.IncomingSources,
            PersonalLibraryPolicy = _setupLibraries.PersonalLibraryPolicy,
        }, _setupSession);
        _busy = false;
        if (saved is null) { Snackbar.Add("Storage locations could not be saved. Check that every path is absolute and visible to the server.", Severity.Error); return; }
        _setupLibraries = saved;
        Snackbar.Add("Storage locations saved.", Severity.Success);
        await RunPreflightAsync();
    }
    private async Task UploadBackupAsync(InputFileChangeEventArgs args) { _busy = true; try { await using var stream = args.File.OpenReadStream(2L * 1024 * 1024 * 1024); _backup = await ApiClient.UploadSetupBackupAsync(stream, args.File.Name, _setupSession ?? string.Empty); if (_backup is null) Snackbar.Add("The backup failed validation.", Severity.Error); } finally { _busy = false; } }
    private async Task ConfirmRestoreAsync() { if (_backup is null || _setupSession is null) return; _busy = true; var result = await ApiClient.ConfirmSetupRestoreAsync(_backup.OperationId, _setupSession); _busy = false; if (result is null) Snackbar.Add("The restore could not be scheduled.", Severity.Error); else Snackbar.Add("Restore scheduled. Tuvima is restarting.", Severity.Info); }
    private async Task CreateAdministratorAsync() { if (_setupSession is null || !PasswordsMatch) { Snackbar.Add("Enter the same password twice.", Severity.Error); return; } _busy = true; var result = await ApiClient.CreateSetupAdministratorAsync(new SetupAdministratorRequest { Email = _email, Password = _password, DisplayName = _displayName, DeviceId = Guid.NewGuid().ToString("D"), DeviceName = "Setup browser" }, _setupSession); _busy = false; if (result is null) Snackbar.Add("The administrator could not be created.", Severity.Error); else if (result.RecoveryCodes.Count > 0) _recoveryCodes = result.RecoveryCodes; else SignIn(); }
    private async Task CopyRecoveryCodesAsync() { await JS.InvokeVoidAsync("navigator.clipboard.writeText", RecoveryCodesText); Snackbar.Add("Recovery codes copied.", Severity.Success); }
    private void SignIn() => Navigation.NavigateTo("/auth/login?returnUrl=%2Fsetup", forceLoad: true);
    private async Task ValidateMediaAsync() { _busy = true; _media = await ApiClient.ValidateSetupMediaLocationsAsync(_setupSession); _busy = false; if (_media?.Passed == true) await ReloadAsync(); }
    private async Task LibraryCreatedAsync() { _showLibraryWizard = false; await ValidateMediaAsync(); }
    private async Task LoadProvidersAsync() { _busy = true; _providerCatalogue = await ApiClient.GetProviderCatalogueAsync(); foreach (var provider in KeyedProviders) _providerCredentials.TryAdd(provider.Name, new(StringComparer.OrdinalIgnoreCase)); _busy = false; }
    private async Task TestProvidersAsync() { await LoadProvidersAsync(); _busy = true; var tests = new List<(string, bool, string)>(); foreach (var provider in BuiltInProviders) { var result = await ApiClient.TestProviderAsync(provider.Name); tests.Add((provider.DisplayName, result?.Success == true, result?.Message ?? "No response from provider.")); } _providerResults = tests; _providerTestCompleted = true; _busy = false; }
    private string CredentialValue(string provider, string key) => _providerCredentials.TryGetValue(provider, out var values) && values.TryGetValue(key, out var value) ? value : string.Empty;
    private void SetCredential(string provider, string key, string? value) { if (!_providerCredentials.TryGetValue(provider, out var values)) _providerCredentials[provider] = values = new(StringComparer.OrdinalIgnoreCase); values[key] = value ?? string.Empty; }
    private bool CanSaveProvider(ProviderCatalogueDto provider) => provider.Onboarding?.Credentials.Where(field => field.Required).All(field => !string.IsNullOrWhiteSpace(CredentialValue(provider.Name, field.Key))) == true;
    private async Task SaveProviderCredentialsAsync(ProviderCatalogueDto provider) { _busyProvider = provider.Name; var result = await ApiClient.SaveSetupProviderCredentialsAsync(provider.Name, new ProviderCredentialWriteRequest { Credentials = new Dictionary<string, string>(_providerCredentials.GetValueOrDefault(provider.Name) ?? [], StringComparer.OrdinalIgnoreCase) }, _setupSession); _busyProvider = null; if (result is null) Snackbar.Add($"{provider.DisplayName} could not be configured.", Severity.Error); else { _providerCredentialResults[provider.Name] = result; Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error); } }
    private static string ProviderPurpose(ProviderCatalogueDto provider) => provider.Onboarding?.SupportedLanes.Count > 0 ? $"Improves {string.Join(", ", provider.Onboarding.SupportedLanes.Select(Friendly))}." : "Optional metadata enrichment.";
    private string ProviderStatus(ProviderCatalogueDto provider) => _providerCredentialResults.TryGetValue(provider.Name, out var result) ? (result.Success ? "Connected" : "Needs attention") : provider.Onboarding?.Credentials.All(field => field.Configured) == true ? "Configured" : provider.Onboarding?.Classification == "recommended" ? "Recommended" : "Optional";
    private AppUiTone ProviderTone(ProviderCatalogueDto provider) => _providerCredentialResults.TryGetValue(provider.Name, out var result) ? (result.Success ? AppUiTone.Success : AppUiTone.Error) : provider.Onboarding?.Credentials.All(field => field.Configured) == true ? AppUiTone.Success : AppUiTone.Warning;
    private Task SaveProviderResultAsync() => DecideStepAsync("providers", "passed", $"Provider setup reviewed; {_providerCredentialResults.Count(result => result.Value.Success)} keyed provider(s) connected. Built-in providers require no credentials.");
    private async Task DecideStepAsync(string step, string status, string detail) { _status = await ApiClient.DecideSetupStepAsync(step, status, detail, _setupSession); _selectedStep = null; if (_status is null) Snackbar.Add("The setup choice could not be saved.", Severity.Error); }
    private async Task LoadReadinessAsync() { _busy = true; _readiness = await ApiClient.GetSetupReadinessAsync(_setupSession); _busy = false; }
    private async Task SampleScanAsync() { _busy = true; var result = await ApiClient.TriggerScanAsync(); _busy = false; _sampleScanDetail = result is null ? "The dry-run scan could not start. Use the media-location repair link to check the configured source." : $"Dry run found {result.TotalCount} pending file operation{(result.TotalCount == 1 ? string.Empty : "s")}. No files were changed."; }
    private async Task CompleteAsync() { _busy = true; var result = await ApiClient.CompleteSetupAsync(_setupSession); _busy = false; if (result?.State == "complete") { try { await Storage.DeleteAsync(SetupSessionKey); } catch { _setupSession = null; } Navigation.NavigateTo(_authenticated ? "/" : "/auth/login", forceLoad: true); } else Snackbar.Add("Required setup checks are still blocked.", Severity.Error); }
    private string StepState(string key) => _status?.Steps.FirstOrDefault(step => step.Key == key)?.Status ?? "not_started";
    private string StepClass(string key) => key == CurrentStep ? "is-current" : StepState(key) is "passed" or "deferred" ? "is-complete" : string.Empty;
    private bool CanNavigateTo(string key) => Array.IndexOf(SetupWorkflow.StepKeys, key) <= Array.IndexOf(SetupWorkflow.StepKeys, WorkflowStep) || StepState(key) is "passed" or "deferred";
    private void GoToStep(string key) { if (CanNavigateTo(key)) _selectedStep = key; }
    private void GoBack() { var index = Math.Max(0, CurrentIndex - 1); _selectedStep = SetupWorkflow.StepKeys[index]; }
    private void ReturnToCurrentStep() => _selectedStep = null;
    private static string NormalizeStep(string? step) => SetupWorkflow.StepKeys.Contains(step, StringComparer.Ordinal) ? step! : "preflight";
    private static string Friendly(string value) => string.Join(' ', value.Replace('_', '-').Split('-', StringSplitOptions.RemoveEmptyEntries).Select(part => char.ToUpperInvariant(part[0]) + part[1..]));
    private static AppUiTone StatusTone(string status) => status switch { "passed" => AppUiTone.Success, "blocked" => AppUiTone.Error, "deferred" => AppUiTone.Warning, _ => AppUiTone.Neutral };
}
