@page "/settings"
@page "/settings/{Section}"
@page "/settings/{Section}/{Subsection}"
@page "/settings/{Section}/{Subsection}/{Detail}"
@rendermode InteractiveServer
@namespace MediaEngine.Web.Components.Pages
@using MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Models.ViewDTOs
@inject NavigationManager Nav
@inject DeviceContextService DeviceContext
@inject UIOrchestratorService Orchestrator
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@BrowserTitle</PageTitle>

<MediaSectionShell Title="Settings"
                   NavigationGroups="@SettingsNavigationGroups">
    <div class="settings-shell-content" @ref="_contentElement">
        <nav class="settings-mobile-navigation" aria-label="Settings page selector">
            <label class="settings-mobile-navigation__label" for="settings-mobile-page">Settings page</label>
            <div class="settings-mobile-navigation__control">
                <MudIcon Icon="@Icons.Material.Outlined.Tune" aria-hidden="true" />
                <AppNativeSelect @key="MobileNavigationValue"
                                 id="settings-mobile-page"
                                 Value="@MobileNavigationValue"
                                 OnChange="@OnMobilePageChanged"
                                 aria-label="Settings page">
                    @foreach (var option in MobileNavigationOptions)
                    {
                        <option value="@option.Value" selected="@IsMobileNavigationOptionSelected(option)">@option.Label</option>
                    }
                </AppNativeSelect>
            </div>
        </nav>

        <SidebarPageHeader Eyebrow="@GetHeroEyebrow()"
                           Title="@GetHeroTitle()"
                           Subtitle="@GetSectionDescription(_activeSection)" />

        <div @key="DeviceContext.DeviceClass" class="@PageCanvasClass">
            @if (ShouldDeferForRoleResolution)
            {
                <AppPageState Kind="AppPageStateKind.Loading"
                              Title="Checking profile permissions"
                              Class="py-8" />
            }
            else if (IsMobileRouteUnavailable)
            {
                <AppPageState Kind="AppPageStateKind.Unavailable"
                              Icon="@Icons.Material.Outlined.DesktopWindows"
                              Title="Use a larger screen for this setting"
                              Message="@MobileUnavailableMessage">
                    <Actions>
                        <AppButton Href="@MobileFallbackRoute"
                                   Label="Back to mobile settings"
                                   StartIcon="@Icons.Material.Outlined.ArrowBack" />
                    </Actions>
                </AppPageState>
            }
            else
            {
                @if (IsEngineUnavailableForCurrentSection)
                {
                    <AppAlert Severity="Severity.Error"
                              Variant="Variant.Outlined"
                              Icon="@Icons.Material.Outlined.CloudOff"
                              Class="mb-4">
                        Engine state could not be loaded. This page is read-only, and saved values have not been replaced with sample defaults.
                    </AppAlert>
                }
                @switch (_activeSection)
                {
                        case SettingsSection.Overview:
                            <UserOverviewTab />
                            break;
                        case SettingsSection.AdminOverview:
                            <OverviewTab ReviewCount="_reviewCount" Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Playback:
                            <PlaybackTab />
                            break;
                        case SettingsSection.Privacy:
                            <PrivacyHistoryTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Libraries:
                            @if (string.Equals(_activeSubsection, "new", StringComparison.OrdinalIgnoreCase))
                            {
                                <AddLibraryWizard />
                            }
                            else
                            {
                                <LibrariesTab Subsection="@_activeSubsection" DetailTab="@DetailTab" />
                            }
                            break;
                        case SettingsSection.ImportFolders:
                            <LibrariesTab Subsection="incoming" />
                            break;
                        case SettingsSection.Ingestion:
                            <IngestionTasksTab />
                            break;
                        case SettingsSection.DevHarness:
                            @RenderInternalTool(
                                "MediaEngine.Web.Components.Settings.DevHarnessTab",
                                new Dictionary<string, object?> { ["Subsection"] = _activeSubsection })
                            break;
                        case SettingsSection.Providers:
                            <MetadataSettingsPage Subsection="@_activeSubsection" Detail="@Detail" />
                            break;
                        case SettingsSection.LocalAi:
                            <LocalAiSettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Plugins:
                            <PluginSettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Delivery:
                            <PlaybackDeliverySettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Network:
                            <NetworkRemoteAccessSettings Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Access:
                            <UsersAccessSettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Server:
                            <BackupRecoveryPanel />
                            break;
                        case SettingsSection.ActivityLogs:
                            <ActivityTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Review:
                            <SettingsReviewQueueTab />
                            break;
                        case SettingsSection.ProviderTester:
                            @RenderInternalTool("MediaEngine.Web.Components.Settings.ProviderTesterToolTab")
                            break;
                        case SettingsSection.EnrichmentTester:
                            @RenderInternalTool("MediaEngine.Web.Components.Settings.EnrichmentTesterToolTab")
                            break;
                }
            }
        </div>
    </div>
</MediaSectionShell>

<CuratorsDrawer Open="@_drawerOpen"
                OpenChanged="@OnDrawerOpenChanged"
                EntityId="@_drawerEntityId"
                CurrentTitle="@_drawerTitle"
                OnCorrected="@OnDrawerCorrected" />

@code {
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? Detail { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? DetailTab { get; set; }

    private SettingsSection _activeSection = SettingsSection.Overview;
    private string _activeSubsection = string.Empty;
    private string _currentRole = "Administrator";
    private ProfileViewModel? _activeProfile;
    private bool _profileRoleLoaded;

    private int _reviewCount;
    private SystemStatusViewModel? _systemStatus;
    private bool _shellStateLoading = true;

    private bool _drawerOpen;
    private Guid _drawerEntityId;
    private string _drawerTitle = string.Empty;
    private ElementReference _contentElement;
    private bool _scrollToTopPending;
    private IReadOnlyList<SettingsTreeGroupDef> VisibleTreeGroups =>
        SettingsNav.FilteredTreeGroups(_currentRole).ToList();

    private IReadOnlyList<MediaSectionNavigationGroup> SettingsNavigationGroups =>
        VisibleTreeGroups
            .Select(group => new MediaSectionNavigationGroup(
                group.Label,
                GetVisibleTreeItems(group)
                    .Select(BuildNavigationItem)
                    .ToList()))
            .ToList();

    private IReadOnlyList<AppSelectOption> MobileNavigationOptions =>
        SettingsNavigationGroups
            .SelectMany(group => group.Items)
            .Select(item => new AppSelectOption(item.Route, item.Label, item.Icon))
            .ToList();

    private SettingsGroupDef CurrentGroup => SettingsNav.GetGroup(_activeSection);
    private string BrowserTitle => string.IsNullOrWhiteSpace(_activeSubsection)
        ? $"{GetHeroTitle()} - Tuvima Library"
        : $"{GetSubsectionLabel()} - {GetHeroTitle()} - Tuvima Library";
    private bool ShouldDeferForRoleResolution =>
        !_profileRoleLoaded && SettingsNav.GetItem(_activeSection).AdminOnly;
    private bool IsEngineUnavailableForCurrentSection =>
        !_shellStateLoading
        && _systemStatus is null
        && SettingsNav.GetItem(_activeSection).AdminOnly;
    private bool IsMobileRouteUnavailable =>
        DeviceContext.IsMobile
        && !SettingsNav.IsMobileRouteAvailable(_activeSection, _activeSubsection, Detail);
    private string PageCanvasClass => string.Join(" ", new[]
    {
        "settings-page-canvas",
        "settings-admin-panel",
        DeviceContext.IsMobile && SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.SummaryOnly
            ? "settings-mobile-summary"
            : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string MobileNavigationValue => IsMobileRouteUnavailable ? MobileFallbackRoute : SettingsNav.RouteFor(_activeSection);
    private bool IsMobileNavigationOptionSelected(AppSelectOption option) =>
        string.Equals(option.Value, MobileNavigationValue, StringComparison.OrdinalIgnoreCase);
    private string MobileUnavailableMessage => SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.DesktopOnly
        ? $"{GetHeroTitle()} is intentionally withheld from mobile because it contains complex configuration or diagnostic tools. Use a desktop or tablet for this workflow."
        : $"This part of {GetHeroTitle()} contains configuration or diagnostic tools that are safer and easier to use on a desktop or tablet. The mobile overview remains available.";
    private string MobileFallbackRoute => SettingsNav.GetMobileAvailability(_activeSection) == SettingsMobileAvailability.DesktopOnly
        ? SettingsNav.RouteFor(SettingsSection.AdminOverview)
        : SettingsNav.RouteFor(_activeSection);

    protected override async Task OnInitializedAsync()
    {
        if (DeviceContext.IsPageDisabled("settings")
            || (DeviceContext.IsPageDisabled("preferences")
                && DeviceContext.IsPageDisabled("server_settings")))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        ResolveSectionAndNormalize();
        await LoadActiveProfileRoleAsync();
        ResolveSectionAndNormalize();
        await LoadShellStateAsync();

        Orchestrator.OnReviewCountChanged += OnReviewCountChanged;
        Orchestrator.OnProfileChanged += OnProfileChanged;
        DeviceContext.OnChanged += OnDeviceContextChanged;
    }

    protected override void OnParametersSet()
    {
        ResolveSectionAndNormalize();
        _scrollToTopPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToTopPending)
        {
            return;
        }

        _scrollToTopPending = false;
        await JS.InvokeVoidAsync("scrollElementToTop", _contentElement);
    }

    public void Dispose()
    {
        Orchestrator.OnReviewCountChanged -= OnReviewCountChanged;
        Orchestrator.OnProfileChanged -= OnProfileChanged;
        DeviceContext.OnChanged -= OnDeviceContextChanged;
    }

    public void OpenCuratorsDrawer(Guid entityId, string title)
    {
        _drawerEntityId = entityId;
        _drawerTitle = title;
        _drawerOpen = true;
        StateHasChanged();
    }

    private async Task LoadShellStateAsync()
    {
        _shellStateLoading = true;

        try
        {
            _reviewCount = await Orchestrator.RefreshReviewCountAsync();
        }
        catch
        {
            _reviewCount = 0;
        }

        try
        {
            _systemStatus = await Orchestrator.GetSystemStatusAsync();
        }
        catch
        {
            _systemStatus = null;
        }

        _shellStateLoading = false;
    }

    private async Task LoadActiveProfileRoleAsync()
    {
        try
        {
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
            _currentRole = string.IsNullOrWhiteSpace(_activeProfile?.Role)
                ? "RestrictedProfile"
                : _activeProfile.Role;
        }
        catch
        {
            _activeProfile = null;
            _currentRole = "RestrictedProfile";
        }
        finally
        {
            _profileRoleLoaded = true;
        }
    }

    private void ResolveSectionAndNormalize()
    {
        var resolution = SettingsNav.ResolveRoute(Section, _currentRole);
        _activeSection = resolution.Section;

        if (!resolution.IsKnownRoute)
        {
            Nav.NavigateTo("/not-found", replace: true);
            return;
        }

        if (!resolution.RequestedSectionAllowed)
        {
            Nav.NavigateTo(resolution.CanonicalRoute, replace: true);
            return;
        }

        if (!IsItemEnabledByUiSettings(SettingsNav.GetItem(_activeSection)))
        {
            Nav.NavigateTo(SettingsNav.RouteFor(SettingsNav.FirstVisibleSection(_currentRole)), replace: true);
            return;
        }

        if (_activeSection == SettingsSection.Libraries && IsLibraryRouteSegment(Subsection))
        {
            _activeSubsection = Subsection!.Trim();
        }
        else if (_activeSection == SettingsSection.Providers && string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = "providers";
        }
        else if (string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = string.Empty;
        }
        else
        {
            var subsection = SettingsNav.ResolveSubsection(_activeSection, Subsection);
            if (subsection is null)
            {
                Nav.NavigateTo("/not-found", replace: true);
                return;
            }

            _activeSubsection = subsection.Slug;
        }

        if (!IsValidDetailRoute(_activeSection, _activeSubsection, Detail))
        {
            Nav.NavigateTo("/not-found", replace: true);
            return;
        }

        var currentPath = NormalizePath(Nav.ToBaseRelativePath(Nav.Uri));
        var targetRoute = _activeSection == SettingsSection.Libraries && IsLibraryRouteSegment(Subsection)
            ? $"/settings/libraries/{_activeSubsection}"
            : _activeSection == SettingsSection.Providers && !string.IsNullOrWhiteSpace(Detail)
            ? $"{SettingsNav.RouteFor(_activeSection, _activeSubsection)}/{Detail!.Trim().ToLowerInvariant()}"
            : string.IsNullOrWhiteSpace(Subsection)
            ? resolution.CanonicalRoute
            : SettingsNav.RouteFor(_activeSection, _activeSubsection);
        var targetPath = NormalizePath(targetRoute);

        if (!string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(targetRoute, replace: true);
        }
    }

    private static string NormalizePath(string path)
    {
        var relative = path.Split('?', '#')[0].Trim();
        if (string.IsNullOrWhiteSpace(relative))
        {
            return "/";
        }

        return "/" + relative.Trim('/').TrimEnd('/');
    }

    private static bool IsLibraryRouteSegment(string? value) =>
        string.Equals(value, "new", StringComparison.OrdinalIgnoreCase)
        || Guid.TryParse(value, out _);

    private static bool IsValidDetailRoute(SettingsSection section, string subsection, string? detail)
    {
        if (string.IsNullOrWhiteSpace(detail)) return true;
        if (section != SettingsSection.Providers) return false;
        return subsection == "providers" && IsProviderRouteKey(detail);
    }

    private static bool IsProviderRouteKey(string value) => value.All(character =>
        char.IsLetterOrDigit(character) || character is '_' or '-');

    private void OnReviewCountChanged()
    {
        _reviewCount = Orchestrator.ReviewCount;
        InvokeAsync(StateHasChanged);
    }

    private void OnProfileChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadActiveProfileRoleAsync();
            ResolveSectionAndNormalize();
            StateHasChanged();
        });
    }

    private async Task OnDrawerOpenChanged(bool open)
    {
        _drawerOpen = open;
        await Task.CompletedTask;
    }

    private void OnDrawerCorrected()
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    private IReadOnlyList<SettingsItemDef> GetVisibleTreeItems(SettingsTreeGroupDef group) =>
        SettingsNav.FilteredTreeItems(group, _currentRole)
            .Where(item => !DeviceContext.IsMobile || SettingsNav.IsVisibleOnMobile(item.Value))
            .Where(IsItemEnabledByUiSettings)
            .ToList();

    private void OnDeviceContextChanged() => InvokeAsync(StateHasChanged);

    private static MediaSectionNavigationItem BuildNavigationItem(SettingsItemDef item) =>
        new(
            item.Label,
            SettingsNav.RouteFor(item.Value),
            item.Icon,
            Exact: true);

    private bool IsItemEnabledByUiSettings(SettingsItemDef item) => item.Value switch
    {
        SettingsSection.DevHarness => DeviceContext.Settings.Features.InternalTools
            && !DeviceContext.IsFeatureDisabled("internal_tools"),
        SettingsSection.ProviderTester => DeviceContext.Settings.Features.InternalTools
            && DeviceContext.Settings.Features.ProviderTester
            && !DeviceContext.IsFeatureDisabled("internal_tools")
            && !DeviceContext.IsFeatureDisabled("provider_tester"),
        SettingsSection.EnrichmentTester => DeviceContext.Settings.Features.InternalTools
            && DeviceContext.Settings.Features.EnrichmentTester
            && !DeviceContext.IsFeatureDisabled("internal_tools")
            && !DeviceContext.IsFeatureDisabled("enrichment_tester"),
        _ => true,
    };

    private RenderFragment RenderInternalTool(
        string typeName,
        IReadOnlyDictionary<string, object?>? parameters = null) => builder =>
    {
        var componentType = typeof(Settings).Assembly.GetType(typeName, throwOnError: false);
        if (componentType is null)
        {
            builder.OpenComponent<MudText>(0);
            builder.AddAttribute(1, nameof(MudText.Typo), Typo.body1);
            builder.AddContent(2, "This internal tool is not included in this build.");
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent(0, componentType);
        if (parameters is not null)
        {
            var sequence = 1;
            foreach (var parameter in parameters)
                builder.AddAttribute(sequence++, parameter.Key, parameter.Value);
        }
        builder.CloseComponent();
    };

    private void OnMobilePageChanged(ChangeEventArgs args)
    {
        var route = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(route))
        {
            Nav.NavigateTo(route);
        }
    }

    private string GetHeroEyebrow() => CurrentGroup.Label;

    private string GetHeroTitle()
    {
        if (_activeSection != SettingsSection.Providers || string.IsNullOrWhiteSpace(Detail))
            return SettingsNav.GetItem(_activeSection).Label;
        return "Provider Configuration";
    }

    private string GetSubsectionLabel() => string.IsNullOrWhiteSpace(_activeSubsection)
        ? GetHeroTitle()
        : SettingsNav.ResolveSubsection(_activeSection, _activeSubsection)?.Label ?? GetHeroTitle();

    private string GetSectionDescription(SettingsSection section) => section switch
    {
        SettingsSection.Overview => "Manage your profile and see your personal library activity.",
        SettingsSection.Playback => "Set the defaults that shape how you watch, listen, and read.",
        SettingsSection.Privacy => "Personal history and export controls are not yet available.",
        SettingsSection.AdminOverview => "A quick look at your library, system health, and anything that needs attention.",
        SettingsSection.Libraries => "Manage structured libraries and review each profile's Personal Space bridge.",
        SettingsSection.ImportFolders => "Manage watched intake locations before media is routed into a destination library.",
        SettingsSection.Ingestion => "Monitor scans, routing, enrichment, and operational ingestion health.",
        SettingsSection.Network => "Manage how devices reach Tuvima at home and away without exposing unnecessary technical detail.",
        SettingsSection.DevHarness => "Internal tools for validation, testing, and diagnostics.",
        SettingsSection.Providers => GetMetadataDescription(),
        SettingsSection.ActivityLogs => "See meaningful system activity and important administrative changes.",
        SettingsSection.LocalAi => "Manage local intelligence features while keeping technical details out of the way.",
        SettingsSection.Plugins => "Manage installed extensions and keep plugin health under control.",
        SettingsSection.Delivery => "Manage server-side playback quality, transcoding, storage, and delivery health.",
        SettingsSection.Access => "Manage who can use Tuvima and how they sign in.",
        SettingsSection.Server => "Protect your Tuvima configuration and recover it when needed.",
        SettingsSection.Review => "Resolve items Tuvima could not identify confidently.",
        SettingsSection.ProviderTester => "Internal provider testing tool.",
        SettingsSection.EnrichmentTester => "Internal enrichment debugging tool.",
        _ => "Settings",
    };

    private string GetMetadataDescription()
    {
        if (!string.IsNullOrWhiteSpace(Detail))
        {
            return "Configure this provider and review every place it participates in ingestion.";
        }

        return _activeSubsection switch
        {
            "ingestion-flow" => "See which providers run at each stage and what they add to every media type.",
            _ => "Manage every metadata, canonical identity, and enrichment provider in one place.",
        };
    }

}
