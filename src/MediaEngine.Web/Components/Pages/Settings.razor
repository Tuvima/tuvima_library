@page "/settings"
@page "/settings/{Section}"
@page "/settings/{Section}/{Subsection}"
@rendermode InteractiveServer
@namespace MediaEngine.Web.Components.Pages
@using MediaEngine.Web.Components.Settings
@using MediaEngine.Web.Models.ViewDTOs
@inject NavigationManager Nav
@inject DeviceContextService DeviceContext
@inject UIOrchestratorService Orchestrator
@implements IDisposable

<PageTitle>@BrowserTitle</PageTitle>

<MediaSectionShell Title="Settings"
                   NavigationGroups="@SettingsNavigationGroups">
    <div class="settings-shell-content">
        <nav class="settings-mobile-navigation" aria-label="Settings page selector">
            <AppSelect Value="@SettingsNav.RouteFor(_activeSection)"
                       ValueChanged="@OnMobilePageChanged"
                       Label="Settings page"
                       LeadingIcon="@Icons.Material.Outlined.Tune"
                       Options="@MobileNavigationOptions" />
        </nav>

        <SidebarPageHeader Eyebrow="@GetHeroEyebrow()"
                           Title="@GetHeroTitle()"
                           Subtitle="@GetSectionDescription(_activeSection)"
                           Status="@GetHeaderStatusLabel()"
                           Healthy="@(_systemStatus?.IsHealthy == true)" />

        <div class="settings-page-canvas settings-admin-panel">
            @if (ShouldDeferForRoleResolution)
            {
                <AppPageState Kind="AppPageStateKind.Loading"
                              Title="Checking profile permissions"
                              Class="py-8" />
            }
            else
            {
                @if (IsEngineUnavailableForCurrentSection)
                {
                    <AppAlert Severity="Severity.Error"
                              Variant="Variant.Outlined"
                              Icon="@Icons.Material.Outlined.CloudOff"
                              Class="mb-4">
                        Engine state could not be loaded. This page is read-only, and saved values have not been replaced with sample defaults.
                    </AppAlert>
                }
                @switch (_activeSection)
                {
                        case SettingsSection.Overview:
                            <UserOverviewTab />
                            break;
                        case SettingsSection.AdminOverview:
                            <OverviewTab ReviewCount="_reviewCount" Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Playback:
                            <PlaybackTab />
                            break;
                        case SettingsSection.Privacy:
                            <PrivacyHistoryTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Libraries:
                            <LibrariesTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.DevHarness:
                            <DevHarnessTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Providers:
                            <ProviderPriorityTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.LocalAi:
                            <LocalAiSettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Plugins:
                            <PluginSettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Delivery:
                            <PlaybackDeliverySettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Access:
                            <UsersAccessSettingsTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Server:
                            <BackupRecoveryPanel />
                            break;
                        case SettingsSection.ActivityLogs:
                            <ActivityTab Subsection="@_activeSubsection" />
                            break;
                        case SettingsSection.Review:
                            <SettingsReviewQueueTab />
                            break;
                        case SettingsSection.ProviderTester:
                            <ProviderTesterToolTab />
                            break;
                        case SettingsSection.EnrichmentTester:
                            <EnrichmentTesterToolTab />
                            break;
                }
            }
        </div>
    </div>
</MediaSectionShell>

<CuratorsDrawer Open="@_drawerOpen"
                OpenChanged="@OnDrawerOpenChanged"
                EntityId="@_drawerEntityId"
                CurrentTitle="@_drawerTitle"
                OnCorrected="@OnDrawerCorrected" />

@code {
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? Subsection { get; set; }

    private SettingsSection _activeSection = SettingsSection.Overview;
    private string _activeSubsection = string.Empty;
    private string _currentRole = "Administrator";
    private ProfileViewModel? _activeProfile;
    private bool _profileRoleLoaded;

    private int _reviewCount;
    private SystemStatusViewModel? _systemStatus;
    private bool _shellStateLoading = true;

    private bool _drawerOpen;
    private Guid _drawerEntityId;
    private string _drawerTitle = string.Empty;
    private IReadOnlyList<SettingsTreeGroupDef> VisibleTreeGroups =>
        SettingsNav.FilteredTreeGroups(_currentRole).ToList();

    private IReadOnlyList<MediaSectionNavigationGroup> SettingsNavigationGroups =>
        VisibleTreeGroups
            .Select(group => new MediaSectionNavigationGroup(
                group.Label,
                GetVisibleTreeItems(group)
                    .Select(BuildNavigationItem)
                    .ToList()))
            .ToList();

    private IReadOnlyList<AppSelectOption> MobileNavigationOptions =>
        SettingsNavigationGroups
            .SelectMany(group => group.Items)
            .Select(item => new AppSelectOption(item.Route, item.Label, item.Icon))
            .ToList();

    private SettingsGroupDef CurrentGroup => SettingsNav.GetGroup(_activeSection);
    private string BrowserTitle => $"{GetSubsectionLabel()} - {GetHeroTitle()} - Tuvima Library";
    private bool ShouldDeferForRoleResolution =>
        !_profileRoleLoaded && SettingsNav.GetItem(_activeSection).AdminOnly;
    private bool IsEngineUnavailableForCurrentSection =>
        !_shellStateLoading
        && _systemStatus is null
        && SettingsNav.GetItem(_activeSection).AdminOnly;

    protected override async Task OnInitializedAsync()
    {
        if (DeviceContext.IsPageDisabled("settings")
            || (DeviceContext.IsPageDisabled("preferences")
                && DeviceContext.IsPageDisabled("server_settings")))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        ResolveSectionAndNormalize();
        await LoadActiveProfileRoleAsync();
        ResolveSectionAndNormalize();
        await LoadShellStateAsync();

        Orchestrator.OnReviewCountChanged += OnReviewCountChanged;
        Orchestrator.OnProfileChanged += OnProfileChanged;
    }

    protected override void OnParametersSet()
    {
        ResolveSectionAndNormalize();
    }

    public void Dispose()
    {
        Orchestrator.OnReviewCountChanged -= OnReviewCountChanged;
        Orchestrator.OnProfileChanged -= OnProfileChanged;
    }

    public void OpenCuratorsDrawer(Guid entityId, string title)
    {
        _drawerEntityId = entityId;
        _drawerTitle = title;
        _drawerOpen = true;
        StateHasChanged();
    }

    private async Task LoadShellStateAsync()
    {
        _shellStateLoading = true;

        try
        {
            _reviewCount = await Orchestrator.RefreshReviewCountAsync();
        }
        catch
        {
            _reviewCount = 0;
        }

        try
        {
            _systemStatus = await Orchestrator.GetSystemStatusAsync();
        }
        catch
        {
            _systemStatus = null;
        }

        _shellStateLoading = false;
    }

    private async Task LoadActiveProfileRoleAsync()
    {
        try
        {
            _activeProfile = await Orchestrator.GetActiveProfileAsync();
            _currentRole = string.IsNullOrWhiteSpace(_activeProfile?.Role)
                ? "Consumer"
                : _activeProfile.Role;
        }
        catch
        {
            _activeProfile = null;
            _currentRole = "Consumer";
        }
        finally
        {
            _profileRoleLoaded = true;
        }
    }

    private void ResolveSectionAndNormalize()
    {
        var resolution = SettingsNav.ResolveRoute(Section, _currentRole);
        _activeSection = resolution.Section;

        if (!resolution.IsKnownRoute)
        {
            Nav.NavigateTo("/not-found", replace: true);
            return;
        }

        if (!resolution.RequestedSectionAllowed)
        {
            Nav.NavigateTo(resolution.CanonicalRoute, replace: true);
            return;
        }

        if (!IsItemEnabledByUiSettings(SettingsNav.GetItem(_activeSection)))
        {
            Nav.NavigateTo(SettingsNav.RouteFor(SettingsNav.FirstVisibleSection(_currentRole)), replace: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(Subsection))
        {
            _activeSubsection = string.Empty;
        }
        else
        {
            var subsection = SettingsNav.ResolveSubsection(_activeSection, Subsection);
            if (subsection is null)
            {
                Nav.NavigateTo("/not-found", replace: true);
                return;
            }

            _activeSubsection = subsection.Slug;
        }

        var currentPath = NormalizePath(Nav.ToBaseRelativePath(Nav.Uri));
        var targetRoute = string.IsNullOrWhiteSpace(Subsection)
            ? resolution.CanonicalRoute
            : SettingsNav.RouteFor(_activeSection, _activeSubsection);
        var targetPath = NormalizePath(targetRoute);

        if (!string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(targetRoute, replace: true);
        }
    }

    private static string NormalizePath(string path)
    {
        var relative = path.Split('?', '#')[0].Trim();
        if (string.IsNullOrWhiteSpace(relative))
        {
            return "/";
        }

        return "/" + relative.Trim('/').TrimEnd('/');
    }

    private void OnReviewCountChanged()
    {
        _reviewCount = Orchestrator.ReviewCount;
        InvokeAsync(StateHasChanged);
    }

    private void OnProfileChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadActiveProfileRoleAsync();
            ResolveSectionAndNormalize();
            StateHasChanged();
        });
    }

    private async Task OnDrawerOpenChanged(bool open)
    {
        _drawerOpen = open;
        await Task.CompletedTask;
    }

    private void OnDrawerCorrected()
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    private IReadOnlyList<SettingsItemDef> GetVisibleTreeItems(SettingsTreeGroupDef group) =>
        SettingsNav.FilteredTreeItems(group, _currentRole)
            .Where(IsItemEnabledByUiSettings)
            .ToList();

    private static MediaSectionNavigationItem BuildNavigationItem(SettingsItemDef item) =>
        new(
            item.Label,
            SettingsNav.RouteFor(item.Value),
            item.Icon,
            Exact: true);

    private bool IsItemEnabledByUiSettings(SettingsItemDef item) => item.Value switch
    {
        SettingsSection.DevHarness => DeviceContext.Settings.Features.InternalTools
            && !DeviceContext.IsFeatureDisabled("internal_tools"),
        SettingsSection.ProviderTester => DeviceContext.Settings.Features.InternalTools
            && DeviceContext.Settings.Features.ProviderTester
            && !DeviceContext.IsFeatureDisabled("internal_tools")
            && !DeviceContext.IsFeatureDisabled("provider_tester"),
        SettingsSection.EnrichmentTester => DeviceContext.Settings.Features.InternalTools
            && DeviceContext.Settings.Features.EnrichmentTester
            && !DeviceContext.IsFeatureDisabled("internal_tools")
            && !DeviceContext.IsFeatureDisabled("enrichment_tester"),
        _ => true,
    };

    private void OnMobilePageChanged(string? route)
    {
        if (!string.IsNullOrWhiteSpace(route))
        {
            Nav.NavigateTo(route);
        }
    }

    private string GetHeroEyebrow() => CurrentGroup.Label;

    private string GetHeroTitle() => SettingsNav.GetItem(_activeSection).Label;

    private string GetSubsectionLabel() => string.IsNullOrWhiteSpace(_activeSubsection)
        ? GetHeroTitle()
        : SettingsNav.ResolveSubsection(_activeSection, _activeSubsection)?.Label ?? GetHeroTitle();

    private string? GetHeaderStatusLabel()
    {
        if (_activeSection != SettingsSection.AdminOverview)
            return null;

        if (_shellStateLoading)
        {
            return "Checking engine";
        }

        return _systemStatus?.IsHealthy == true ? "Engine online" : "Engine unavailable";
    }

    private static string GetSectionDescription(SettingsSection section) => section switch
    {
        SettingsSection.Overview => "Manage your profile and see your personal library activity.",
        SettingsSection.Playback => "Set the defaults that shape how you watch, listen, and read.",
        SettingsSection.Privacy => "Personal history and export controls are not yet available.",
        SettingsSection.AdminOverview => "A quick look at your library, system health, and anything that needs attention.",
        SettingsSection.Libraries => "Manage where your media lives and how each area is organized.",
        SettingsSection.DevHarness => "Internal tools for validation, testing, and diagnostics.",
        SettingsSection.Providers => "Control which providers identify and enrich each type of media.",
        SettingsSection.ActivityLogs => "See meaningful system activity and important administrative changes.",
        SettingsSection.LocalAi => "Manage local intelligence features while keeping technical details out of the way.",
        SettingsSection.Plugins => "Manage installed extensions and keep plugin health under control.",
        SettingsSection.Delivery => "Manage server-side playback quality, transcoding, storage, and delivery health.",
        SettingsSection.Access => "Manage who can use Tuvima and how they sign in.",
        SettingsSection.Server => "Protect your Tuvima configuration and recover it when needed.",
        SettingsSection.Review => "Resolve items Tuvima could not identify confidently.",
        SettingsSection.ProviderTester => "Internal provider testing tool.",
        SettingsSection.EnrichmentTester => "Internal enrichment debugging tool.",
        _ => "Settings",
    };

}
