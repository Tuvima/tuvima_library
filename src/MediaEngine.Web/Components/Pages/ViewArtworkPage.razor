@page "/view/artwork"
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Services.Editing
@inject IEngineApiClient ApiClient
@inject MediaEditorLauncherService MediaEditorLauncher
@inject UIOrchestratorService Orchestrator
@inject ISnackbar Snackbar
@implements IDisposable
@namespace MediaEngine.Web.Components.Pages

<PageTitle>Library Artwork - Tuvima Library</PageTitle>

<ViewSectionShell>
    <ViewContentPage Title="Library Artwork"
                     Subtitle="Browse covers, backgrounds, logos, stills, and people images as galleries. Open any card to add, replace, choose, or remove artwork."
                     Class="view-artwork-page">
        <HeaderActions>
            @if (_page is not null)
            {
                <span class="view-artwork-header__count">@_page.Total.ToString("N0") @(_page.Total == 1 ? "entity" : "entities")</span>
            }
        </HeaderActions>
        <ChildContent>

        <section class="view-artwork-controls" aria-label="Artwork gallery filters">
            <div class="view-artwork-tabs" role="tablist" aria-label="Entity type">
                @foreach (var option in EntityKinds)
                {
                    var active = string.Equals(_entityKind, option.Value, StringComparison.OrdinalIgnoreCase);
                    <button type="button" role="tab" aria-selected="@active" class="view-artwork-tab@(active ? " is-active" : string.Empty)" @onclick="(() => SelectEntityKindAsync(option.Value))">
                        <MudIcon Icon="@option.Icon" />
                        <span>@option.Label</span>
                    </button>
                }
            </div>

            <div class="view-artwork-filters">
                <label class="view-artwork-search">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" />
                    <input type="search" value="@_search" @oninput="SearchChanged" placeholder="Search titles or people" aria-label="Search library artwork" />
                </label>
                <label class="view-artwork-type">
                    <span>Gallery</span>
                    <AppNativeSelect Value="@(_artworkType ?? string.Empty)" OnChange="ArtworkTypeChangedAsync" aria-label="Artwork type gallery">
                        @foreach (var type in ArtworkTypes)
                        {
                            <option value="@type.Value">@type.Label</option>
                        }
                    </AppNativeSelect>
                </label>
            </div>
        </section>

        @if (_loading && (_page is null || _page.Items.Count == 0))
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="Loading artwork" Message="Building galleries from your library artwork." />
        }
        else if (_page is null)
        {
            <AppErrorState Title="Artwork could not be loaded" Message="The Engine did not return the artwork library." Retry="LoadAsync" />
        }
        else if (_page.Items.Count == 0)
        {
            <AppPageState Kind="AppPageStateKind.Empty" Title="No artwork matches" Message="Try another gallery, entity type, or search." />
        }
        else
        {
            <section class="view-artwork-grid" aria-label="Library artwork">
                @foreach (var item in _page.Items)
                {
                    <button type="button" class="view-artwork-card view-artwork-card--@CardShape(item)" @onclick="(() => OpenArtworkAsync(item))" aria-label="Manage artwork for @item.DisplayTitle">
                        <span class="view-artwork-card__image">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="view-artwork-card__placeholder"><MudIcon Icon="@PlaceholderIcon(item)" /></span>
                            }
                            <span class="view-artwork-card__open"><MudIcon Icon="@Icons.Material.Outlined.Edit" /> Manage</span>
                        </span>
                        <span class="view-artwork-card__body">
                            <strong>@item.DisplayTitle</strong>
                            <span class="view-artwork-card__meta">@Metadata(item)</span>
                            <span class="view-artwork-card__types">
                                @foreach (var assetType in item.AssetTypes.Take(3))
                                {
                                    <small>@FormatAssetType(assetType)</small>
                                }
                                @if (item.AssetTypes.Count > 3)
                                {
                                    <small>+@(item.AssetTypes.Count - 3)</small>
                                }
                            </span>
                        </span>
                    </button>
                }
            </section>

            @if (_page.HasMore)
            {
                <div class="view-artwork-load-more">
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_loadingMore" OnClick="LoadMoreAsync">
                        @(_loadingMore ? "Loading…" : "Load more")
                    </AppButton>
                </div>
            }
        }
        </ChildContent>
    </ViewContentPage>
</ViewSectionShell>

@code {
    private const int PageSize = 48;
    private static readonly (string Label, string? Value, string Icon)[] EntityKinds =
    [
        ("All", null, Icons.Material.Outlined.Collections),
        ("Media", "media", Icons.Material.Outlined.MovieFilter),
        ("People", "people", Icons.Material.Outlined.People),
    ];
    private static readonly (string Label, string Value)[] ArtworkTypes =
    [
        ("All artwork", ""),
        ("Covers & posters", "CoverArt"),
        ("Backgrounds", "Background"),
        ("Logos", "Logo"),
        ("People images", "Headshot"),
        ("Episode stills", "EpisodeStill"),
        ("Season posters", "SeasonPoster"),
        ("Banners", "Banner"),
    ];

    private ArtworkLibraryPageDto? _page;
    private string? _entityKind;
    private string? _artworkType;
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _loadingMore;
    private CancellationTokenSource? _searchCts;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _page = await ApiClient.GetArtworkLibraryAsync(_entityKind, _artworkType, _search, 0, PageSize);
        _loading = false;
    }

    private async Task SelectEntityKindAsync(string? value)
    {
        if (string.Equals(_entityKind, value, StringComparison.OrdinalIgnoreCase)) return;
        _entityKind = value;
        await LoadAsync();
    }

    private async Task ArtworkTypeChangedAsync(object? value)
    {
        _artworkType = string.IsNullOrWhiteSpace(value?.ToString()) ? null : value!.ToString();
        await LoadAsync();
    }

    private void SearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        _ = DebouncedSearchAsync(_searchCts.Token);
    }

    private async Task DebouncedSearchAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct);
            await InvokeAsync(LoadAsync);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_page is null || !_page.HasMore || _loadingMore) return;
        _loadingMore = true;
        var next = await ApiClient.GetArtworkLibraryAsync(_entityKind, _artworkType, _search, _page.Items.Count, PageSize);
        if (next is not null)
        {
            _page = next with { Items = [.. _page.Items, .. next.Items], Offset = 0 };
        }
        _loadingMore = false;
    }

    private async Task OpenArtworkAsync(ArtworkLibraryItemDto item)
    {
        try
        {
            var profile = await Orchestrator.GetActiveProfileAsync();
            var applied = await MediaEditorLauncher.OpenAsync(new MediaEditorLaunchRequest
            {
                EntityIds = [item.EntityId],
                LaunchEntityId = item.EntityId,
                LaunchEntityKind = item.EntityType,
                ActiveProfileId = profile?.Id,
                Mode = SharedMediaEditorMode.Normal,
                InitialTab = "artwork",
                IdentityIntent = MediaEditorIdentityIntent.ConfirmArtwork,
                MediaType = item.MediaType,
                HeaderTitle = item.DisplayTitle,
                HeaderSubtitle = item.EntityType == "Person" ? item.Subtitle : item.MediaType,
                CoverUrl = item.ImageUrl,
                OnArtworkChanged = LoadAsync,
                PreviewItems =
                [
                    new MediaEditorPreviewItem
                    {
                        EntityId = item.EntityId,
                        Title = item.DisplayTitle,
                        CoverUrl = item.ImageUrl,
                        MediaType = item.MediaType,
                    },
                ],
            });
            if (applied)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Artwork editor could not open: {ex.Message}", Severity.Error);
        }
    }

    private static string CardShape(ArtworkLibraryItemDto item) =>
        item.EntityType == "Person" || string.Equals(item.PrimaryAssetType, "Headshot", StringComparison.OrdinalIgnoreCase)
            ? "person"
            : item.PrimaryAssetType == "Logo"
                ? "logo"
                : item.PrimaryAssetType is "Background" or "Banner" or "EpisodeStill" or "SeasonThumb"
                    ? "wide"
                    : "portrait";

    private static string PlaceholderIcon(ArtworkLibraryItemDto item) => item.EntityType == "Person"
        ? Icons.Material.Outlined.Person
        : Icons.Material.Outlined.Image;

    private static string Metadata(ArtworkLibraryItemDto item)
    {
        if (item.EntityType == "Person")
        {
            var imageText = item.VariantCount > 0
                ? $"{item.VariantCount} managed {(item.VariantCount == 1 ? "image" : "images")}"
                : item.UsesLegacyPersonImage ? "Provider image" : "No artwork yet";
            return item.OwnedWorkCount > 0 ? $"{imageText} · {item.OwnedWorkCount} owned works" : imageText;
        }

        var identity = string.Join(" · ", new[] { item.MediaType, item.Year }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var variants = $"{item.VariantCount} {(item.VariantCount == 1 ? "variant" : "variants")}";
        return string.IsNullOrWhiteSpace(identity) ? variants : $"{identity} · {variants}";
    }

    private static string FormatAssetType(string value) => value switch
    {
        "CoverArt" => "Cover",
        "Headshot" => "Portrait",
        "EpisodeStill" => "Episode still",
        "SeasonPoster" => "Season poster",
        "SeasonThumb" => "Season thumbnail",
        "NetworkLogo" => "Network logo",
        "StudioLogo" => "Studio logo",
        "CharacterPortrait" => "Character portrait",
        _ => value,
    };

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
