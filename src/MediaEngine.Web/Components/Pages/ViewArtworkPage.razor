@page "/view/artwork"
@page "/view/artwork/media"
@page "/view/artwork/people"
@page "/view/artwork/universes"
@page "/view/artwork/assets"
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.Artwork
@using Microsoft.AspNetCore.Components.Routing
@inject IEngineApiClient ApiClient
@inject MediaEditorLauncherService MediaEditorLauncher
@inject UIOrchestratorService Orchestrator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@implements IDisposable
@namespace MediaEngine.Web.Components.Pages

<PageTitle>Library Artwork - Tuvima Library</PageTitle>

<ViewSectionShell>
    <ViewContentPage Title="Library Artwork"
                     Subtitle="Browse covers, backgrounds, logos, people images, and automatic series artwork. Open any entity to manage its artwork."
                     Class="view-artwork-page">
        <HeaderActions>
            @if (_page is not null || _assetPage is not null)
            {
                var total = _assetPage?.Total ?? _page?.Total ?? 0;
                <span class="view-artwork-header__count">@total.ToString("N0") @(IsAssetView ? (total == 1 ? "image" : "images") : (total == 1 ? "entity" : "entities"))</span>
            }
        </HeaderActions>
        <ChildContent>

        <section class="view-artwork-controls" aria-label="Artwork gallery filters">
            <div class="view-artwork-tabs" role="tablist" aria-label="Entity type">
                @foreach (var option in EntityKinds)
                {
                    var active = string.Equals(_entityKind, option.Value, StringComparison.OrdinalIgnoreCase);
                    <AppNativeButton Type="button" role="tab" aria-selected="@active" Class="@($"view-artwork-tab{(active ? " is-active" : string.Empty)}")" OnClick="(() => SelectEntityKindAsync(option.Value))">
                        <MudIcon Icon="@option.Icon" />
                        <span>@option.Label</span>
                    </AppNativeButton>
                }
            </div>

            @if (!IsPeopleView && !IsUniverseView && !IsAssetView)
            {
                <div class="view-artwork-browse-row">
                    <div class="view-artwork-control-group">
                        <span>Browse as</span>
                        <AppBrowseModeSelector Options="@BrowseModes"
                                               Value="@_browseAs"
                                               ValueChanged="SelectBrowseModeAsync"
                                               AriaLabel="Browse artwork as" />
                    </div>
                    <div class="view-artwork-control-group">
                        <span>Media type</span>
                        <AppBrowseModeSelector Options="@AvailableMediaTypes"
                                               Value="@_mediaType"
                                               ValueChanged="SelectMediaTypeAsync"
                                               AriaLabel="Filter artwork by media type" />
                    </div>
                </div>
            }
            else if (IsPeopleView)
            {
                <div class="view-artwork-control-group">
                    <span>People</span>
                    <AppBrowseModeSelector Options="@PeopleArtworkStates"
                                           Value="@_artworkState"
                                           ValueChanged="SelectArtworkStateAsync"
                                           AriaLabel="Filter people by artwork availability" />
                </div>
            }

            <div class="view-artwork-filters">
                <label class="view-artwork-search">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" />
                    <AppNativeInput Type="search" Value="@_search" OnInput="SearchChanged" Placeholder="Search titles or people" AriaLabel="Search library artwork" />
                </label>
                <label class="view-artwork-type">
                    <span>Gallery</span>
                    <AppNativeSelect Value="@(_artworkType ?? string.Empty)" OnChange="ArtworkTypeChangedAsync" aria-label="Artwork type gallery">
                        @foreach (var type in ArtworkTypes)
                        {
                            <option value="@type.Value">@type.Label</option>
                        }
                    </AppNativeSelect>
                </label>
                @if (!IsAssetView)
                {
                    <label class="view-artwork-type">
                        <span>Sort</span>
                        <AppNativeSelect Value="@_sort" OnChange="SortChangedAsync" aria-label="Sort artwork gallery">
                            @foreach (var option in SortOptions) { <option value="@option.Value">@option.Label</option> }
                        </AppNativeSelect>
                    </label>
                    <label class="view-artwork-type">
                        <span>Tile size</span>
                        <AppNativeSelect Value="@_tileSize" OnChange="TileSizeChanged" aria-label="Artwork tile size">
                            @foreach (var option in TileSizes) { <option value="@option.Value">@option.Label</option> }
                        </AppNativeSelect>
                    </label>
                }
            </div>
        </section>

        @if (_loading && ((_page is null || _page.Items.Count == 0) && (_assetPage is null || _assetPage.Items.Count == 0)))
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="Loading artwork" Message="Building galleries from your library artwork." />
        }
        else if (IsAssetView && _assetPage is not null)
        {
            @if (_assetPage.Items.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Empty" Title="No images match" Message="Try another artwork role or search." />
            }
            else
            {
                <section class="view-artwork-grid view-artwork-grid--assets view-artwork-grid--@_tileSize" aria-label="All library images">
                    @foreach (var asset in _assetPage.Items)
                    {
                        var context = asset.Contexts.FirstOrDefault();
                        <AppNativeButton Type="button" Class="@($"view-artwork-card view-artwork-card--{AssetShape(asset)}")" OnClick="(() => OpenAssetAsync(asset))" AriaLabel="@($"Open {AssetTitle(asset)}")">
                            <span class="view-artwork-card__image"><img src="@asset.ThumbnailUrl" alt="" loading="lazy" /><span class="view-artwork-card__open"><MudIcon Icon="@Icons.Material.Outlined.OpenInFull" /> Open</span></span>
                            <span class="view-artwork-card__body"><strong>@AssetTitle(asset)</strong><span class="view-artwork-card__meta">@string.Join(" · ", new[] { context?.Role, context?.MediaType, context?.Year, asset.SourceProvider }.Where(value => !string.IsNullOrWhiteSpace(value)))</span></span>
                        </AppNativeButton>
                    }
                </section>
                @if (_assetPage.HasMore) { <div class="view-artwork-load-more"><AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_loadingMore" OnClick="LoadMoreAssetsAsync">@(_loadingMore ? "Loading…" : "Load more")</AppButton></div> }
            }
        }
        else if (_page is null)
        {
            <AppErrorState Title="Artwork could not be loaded" Message="The Engine did not return the artwork library." Retry="LoadAsync" />
        }
        else if (_page.Items.Count == 0)
        {
            <AppPageState Kind="AppPageStateKind.Empty" Title="No artwork matches" Message="Try another gallery, entity type, or search." />
        }
        else
        {
            <section class="view-artwork-grid view-artwork-grid--@_tileSize" aria-label="Library artwork">
                @foreach (var item in _page.Items)
                {
                    <AppNativeButton Type="button" Class="@($"view-artwork-card view-artwork-card--{CardShape(item)}")" OnClick="(() => OpenArtworkAsync(item))" AriaLabel="@($"Manage artwork for {item.DisplayTitle}")">
                        <span class="view-artwork-card__image">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="" loading="lazy" />
                            }
                            else if (item.ResolutionMode == ArtworkResolutionMode.AutomaticGroup && item.PreviewItems.Count > 0)
                            {
                                <MediaArtworkGroupPreview Items="@PreviewItems(item)"
                                                          TotalCount="@item.OwnedWorkCount"
                                                          AriaLabel="@($"Automatic artwork for {item.DisplayTitle}")"
                                                          Layout="MediaArtworkGroupPreviewLayout.Adaptive"
                                                          ShowOverflowCount="false" />
                                <span class="view-artwork-card__automatic">Automatic artwork</span>
                            }
                            else
                            {
                                <span class="view-artwork-card__placeholder"><MudIcon Icon="@PlaceholderIcon(item)" /></span>
                            }
                            @if (item.VariantCount > 0)
                            {
                                <span class="view-artwork-card__count"><MudIcon Icon="@Icons.Material.Outlined.Collections" /> @item.VariantCount images</span>
                            }
                            <span class="view-artwork-card__open"><MudIcon Icon="@Icons.Material.Outlined.Edit" /> @OpenLabel(item)</span>
                        </span>
                        <span class="view-artwork-card__body">
                            <strong>@item.DisplayTitle</strong>
                            <span class="view-artwork-card__meta">@Metadata(item)</span>
                        </span>
                    </AppNativeButton>
                }
            </section>

            @if (_page.HasMore)
            {
                <div class="view-artwork-load-more">
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_loadingMore" OnClick="LoadMoreAsync">
                        @(_loadingMore ? "Loading…" : "Load more")
                    </AppButton>
                </div>
            }
        }
        </ChildContent>
    </ViewContentPage>
</ViewSectionShell>

@code {
    private const int PageSize = 48;
    private static readonly (string Label, string? Value, string Icon)[] EntityKinds =
    [
        ("Media", "media", Icons.Material.Outlined.MovieFilter),
        ("People", "people", Icons.Material.Outlined.People),
        ("Universes", "universes", Icons.Material.Outlined.Public),
        ("All Images", "assets", Icons.Material.Outlined.PhotoLibrary),
    ];
    private static readonly IReadOnlyList<BrowseGroupingOption> BrowseModes =
    [
        new("all", "All", Icons.Material.Outlined.Collections),
        new("titles", "Titles", Icons.Material.Outlined.LocalMovies),
        new("series", "Series / Groups", Icons.Material.Outlined.VideoLibrary),
        new("tvshows", "TV Shows", Icons.Material.Outlined.Tv),
        new("albums", "Albums", Icons.Material.Outlined.Album),
    ];
    private static readonly IReadOnlyList<BrowseGroupingOption> AllMediaTypes =
    [
        new("all", "All media", Icons.Material.Outlined.Apps),
        new("movies", "Movies", Icons.Material.Outlined.Movie),
        new("tv", "TV Shows", Icons.Material.Outlined.Tv),
        new("books", "Books", Icons.Material.Outlined.MenuBook),
        new("audiobooks", "Audiobooks", Icons.Material.Outlined.Headphones),
        new("music", "Music", Icons.Material.Outlined.Album),
        new("comics", "Comics", Icons.Material.Outlined.AutoStories),
    ];
    private static readonly IReadOnlyList<BrowseGroupingOption> PeopleArtworkStates =
    [
        new("all", "All People", Icons.Material.Outlined.People),
        new("has", "Has Artwork", Icons.Material.Outlined.Image),
        new("missing", "Missing Artwork", Icons.Material.Outlined.HideImage),
    ];
    private static readonly (string Label, string Value)[] SortOptions =
    [
        ("Title A–Z", "title-asc"), ("Title Z–A", "title-desc"),
        ("Newest year", "year-newest"), ("Most images", "images-most"),
    ];
    private static readonly (string Label, string Value)[] TileSizes =
    [
        ("Small", "small"), ("Medium", "medium"), ("Large", "large"),
    ];
    private static readonly (string Label, string Value)[] ArtworkTypes =
    [
        ("All artwork", ""),
        ("Covers & posters", "CoverArt"),
        ("Backgrounds", "Background"),
        ("Logos", "Logo"),
        ("People images", "Headshot"),
        ("Episode stills", "EpisodeStill"),
        ("Season posters", "SeasonPoster"),
        ("Banners", "Banner"),
    ];

    private ArtworkBrowsePageDto? _page;
    private ArtworkAssetPageDto? _assetPage;
    private string? _entityKind = "media";
    private string? _artworkType;
    private string _browseAs = "all";
    private string _mediaType = "all";
    private string _artworkState = "all";
    private string _sort = "title-asc";
    private string _tileSize = "medium";
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _loadingMore;
    private int _loadGeneration;
    private CancellationTokenSource? _searchCts;

    protected override Task OnInitializedAsync()
    {
        _entityKind = KindFromLocation(Navigation.Uri);
        Navigation.LocationChanged += HandleLocationChanged;
        return LoadAsync();
    }

    private static string KindFromLocation(string location)
    {
        var path = new Uri(location, UriKind.Absolute).AbsolutePath.TrimEnd('/');
        return path.EndsWith("/assets", StringComparison.OrdinalIgnoreCase)
            ? "assets"
            : path.EndsWith("/people", StringComparison.OrdinalIgnoreCase)
            ? "people"
            : path.EndsWith("/universes", StringComparison.OrdinalIgnoreCase)
                ? "universes"
                : "media";
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var next = KindFromLocation(args.Location);
        if (string.Equals(next, _entityKind, StringComparison.OrdinalIgnoreCase)) return;
        _entityKind = next;
        _mediaType = "all";
        _ = InvokeAsync(LoadAsync);
    }

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        var entityKind = _entityKind;
        var artworkType = _artworkType;
        var search = _search;
        var entityOnly = string.Equals(entityKind, "people", StringComparison.OrdinalIgnoreCase)
            || string.Equals(entityKind, "universes", StringComparison.OrdinalIgnoreCase);
        var browseAs = entityOnly ? null : _browseAs;
        var mediaType = entityOnly || _mediaType == "all"
            ? null
            : _mediaType;
        _loading = true;
        _loadingMore = false;
        if (string.Equals(entityKind, "assets", StringComparison.OrdinalIgnoreCase))
        {
            _page = null;
            _assetPage = await ApiClient.GetArtworkAssetsAsync(search, artworkType, offset: 0, limit: PageSize);
            if (generation == _loadGeneration) _loading = false;
            return;
        }
        _assetPage = null;
        var page = await ApiClient.GetArtworkLibraryAsync(
            entityKind,
            artworkType,
            search,
            browseAs,
            mediaType,
            IsPeopleView ? _artworkState : null,
            _sort,
            0,
            PageSize);
        if (generation != _loadGeneration)
        {
            return;
        }

        _page = page;
        _loading = false;
    }

    private Task SelectEntityKindAsync(string? value)
    {
        if (string.Equals(_entityKind, value, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        var route = value switch
        {
            "people" => "/view/artwork/people",
            "universes" => "/view/artwork/universes",
            "assets" => "/view/artwork/assets",
            _ => "/view/artwork",
        };
        Navigation.NavigateTo(route);
        return Task.CompletedTask;
    }

    private async Task SelectBrowseModeAsync(string value)
    {
        if (string.Equals(_browseAs, value, StringComparison.OrdinalIgnoreCase)) return;
        _browseAs = value;
        if (!AvailableMediaTypes.Any(option => string.Equals(option.Value, _mediaType, StringComparison.OrdinalIgnoreCase)))
        {
            _mediaType = "all";
        }
        await LoadAsync();
    }

    private async Task SelectMediaTypeAsync(string value)
    {
        if (string.Equals(_mediaType, value, StringComparison.OrdinalIgnoreCase)) return;
        _mediaType = value;
        await LoadAsync();
    }

    private async Task SelectArtworkStateAsync(string value)
    {
        if (string.Equals(_artworkState, value, StringComparison.OrdinalIgnoreCase)) return;
        _artworkState = value;
        await LoadAsync();
    }

    private async Task SortChangedAsync(object? value)
    {
        _sort = value?.ToString() ?? "title-asc";
        await LoadAsync();
    }

    private void TileSizeChanged(object? value) => _tileSize = value?.ToString() ?? "medium";

    private async Task ArtworkTypeChangedAsync(object? value)
    {
        _artworkType = string.IsNullOrWhiteSpace(value?.ToString()) ? null : value!.ToString();
        await LoadAsync();
    }

    private void SearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        _ = DebouncedSearchAsync(_searchCts.Token);
    }

    private async Task DebouncedSearchAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct);
            await InvokeAsync(LoadAsync);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_page is null || !_page.HasMore || _loadingMore) return;
        var generation = _loadGeneration;
        var currentPage = _page;
        _loadingMore = true;
        var next = await ApiClient.GetArtworkLibraryAsync(
            _entityKind,
            _artworkType,
            _search,
            IsPeopleView || IsUniverseView ? null : _browseAs,
            IsPeopleView || IsUniverseView || _mediaType == "all" ? null : _mediaType,
            IsPeopleView ? _artworkState : null,
            _sort,
            currentPage.Items.Count,
            PageSize);
        if (generation == _loadGeneration && next is not null)
        {
            _page = next with { Items = [.. currentPage.Items, .. next.Items], Offset = 0 };
        }
        if (generation == _loadGeneration)
        {
            _loadingMore = false;
        }
    }

    private async Task LoadMoreAssetsAsync()
    {
        if (_assetPage is null || !_assetPage.HasMore || _loadingMore) return;
        var generation = _loadGeneration;
        var current = _assetPage;
        _loadingMore = true;
        var next = await ApiClient.GetArtworkAssetsAsync(_search, _artworkType, offset: current.Items.Count, limit: PageSize);
        if (generation == _loadGeneration && next is not null)
            _assetPage = next with { Items = [.. current.Items, .. next.Items], Offset = 0 };
        if (generation == _loadGeneration) _loadingMore = false;
    }

    private async Task OpenAssetAsync(ArtworkAssetDto asset)
    {
        var context = asset.Contexts.FirstOrDefault();
        if (context is null) return;
        var item = new ArtworkLibraryItemDto(context.EntityId, context.EntityType, context.EntityLabel,
            context.MediaType, context.Year, context.Role, asset.ContentUrl, context.Role, [context.Role ?? "Primary"], 1, 0, false)
        {
            ResolutionMode = ArtworkResolutionMode.Explicit,
        };
        await OpenArtworkAsync(item);
    }

    private async Task OpenArtworkAsync(ArtworkLibraryItemDto item)
    {
        try
        {
            var profile = await Orchestrator.GetActiveProfileAsync();
            var dialog = await DialogService.ShowAsync<ArtworkWorkspaceDialog>(
                "Library artwork",
                new DialogParameters
                {
                    { nameof(ArtworkWorkspaceDialog.Item), item },
                    { nameof(ArtworkWorkspaceDialog.ActiveProfileId), profile?.Id },
                },
                new DialogOptions
                {
                    CloseButton = false,
                    NoHeader = true,
                    MaxWidth = MaxWidth.ExtraLarge,
                    FullWidth = true,
                    BackdropClick = false,
                    CloseOnEscapeKey = true,
                });
            if (dialog is not null)
            {
                var result = await dialog.Result;
                if (result is not null && !result.Canceled)
                {
                    await LoadAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Artwork editor could not open: {ex.Message}", Severity.Error);
        }
    }

    private static string CardShape(ArtworkLibraryItemDto item) =>
        item.IsStructural ? "group" :
        item.EntityType == "Person" || string.Equals(item.PrimaryAssetType, "Headshot", StringComparison.OrdinalIgnoreCase)
            ? "person"
            : item.PrimaryAssetType == "Logo"
                ? "logo"
                : item.PrimaryAssetType is "Background" or "Banner" or "EpisodeStill" or "SeasonThumb"
                    ? "wide"
                    : "portrait";

    private static string PlaceholderIcon(ArtworkLibraryItemDto item) => item.EntityType == "Person"
        ? Icons.Material.Outlined.Person
        : Icons.Material.Outlined.Image;

    private static string Metadata(ArtworkLibraryItemDto item)
    {
        if (item.IsStructural)
        {
            var groupIdentity = string.Join(" · ", new[] { item.Subtitle, item.Year }.Where(value => !string.IsNullOrWhiteSpace(value)));
            var artwork = item.ResolutionMode == ArtworkResolutionMode.AutomaticGroup
                ? "Automatic artwork"
                : item.ResolutionMode == ArtworkResolutionMode.Explicit
                    ? $"{item.VariantCount} managed {(item.VariantCount == 1 ? "image" : "images")}"
                    : "No artwork yet";
            var owned = $"{item.OwnedWorkCount} owned {(item.OwnedWorkCount == 1 ? "item" : "items")}";
            return string.Join(" · ", new[] { groupIdentity, owned, artwork }.Where(value => !string.IsNullOrWhiteSpace(value)));
        }

        if (item.EntityType == "Person")
        {
            var imageText = item.VariantCount > 0
                ? $"{item.VariantCount} managed {(item.VariantCount == 1 ? "image" : "images")}"
                : item.UsesLegacyPersonImage ? "Provider image" : "No artwork yet";
            return string.Join(" · ", new[]
            {
                item.Subtitle,
                imageText,
                item.OwnedWorkCount > 0 ? $"{item.OwnedWorkCount} owned works" : null,
            }.Where(value => !string.IsNullOrWhiteSpace(value)));
        }

        var identity = string.Join(" · ", new[] { item.MediaType, item.Year }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var variants = $"{item.VariantCount} {(item.VariantCount == 1 ? "variant" : "variants")}";
        return string.IsNullOrWhiteSpace(identity) ? variants : $"{identity} · {variants}";
    }

    private static string FormatAssetType(string value) => value switch
    {
        "CoverArt" => "Cover",
        "Headshot" => "Portrait",
        "EpisodeStill" => "Episode still",
        "SeasonPoster" => "Season poster",
        "SeasonThumb" => "Season thumbnail",
        "NetworkLogo" => "Network logo",
        "StudioLogo" => "Studio logo",
        "CharacterPortrait" => "Character portrait",
        _ => value,
    };

    private bool IsPeopleView => string.Equals(_entityKind, "people", StringComparison.OrdinalIgnoreCase);
    private bool IsUniverseView => string.Equals(_entityKind, "universes", StringComparison.OrdinalIgnoreCase);
    private bool IsAssetView => string.Equals(_entityKind, "assets", StringComparison.OrdinalIgnoreCase);
    private static string AssetTitle(ArtworkAssetDto asset) => asset.Contexts.FirstOrDefault()?.EntityLabel ?? "Library artwork";
    private static string AssetShape(ArtworkAssetDto asset) => asset.Aspect switch { "LandscapeWide" or "BannerStrip" => "wide", "Square" => "person", _ => "portrait" };

    private IReadOnlyList<BrowseGroupingOption> AvailableMediaTypes => _browseAs switch
    {
        "series" => AllMediaTypes.Where(option => option.Value is "all" or "movies" or "books" or "audiobooks" or "comics").ToList(),
        "tvshows" => AllMediaTypes.Where(option => option.Value is "all" or "tv").ToList(),
        "albums" => AllMediaTypes.Where(option => option.Value is "all" or "music").ToList(),
        _ => AllMediaTypes,
    };

    private static IReadOnlyList<ArtworkStackItem> PreviewItems(ArtworkLibraryItemDto item) => item.PreviewItems
        .Select(preview => new ArtworkStackItem
        {
            Id = preview.AssetId?.ToString("D") ?? preview.WorkId.ToString("D"),
            WorkId = preview.WorkId,
            AssetId = preview.AssetId,
            Title = preview.Title,
            ImageUrl = preview.ImageUrl,
            MediaType = preview.MediaType ?? item.MediaType ?? string.Empty,
            Shape = preview.Shape.ToLowerInvariant() switch
            {
                "square" => ArtworkShape.Square,
                "wide" => ArtworkShape.Wide,
                _ => ArtworkShape.Portrait,
            },
            Position = preview.Position,
        })
        .ToList();

    private static string OpenLabel(ArtworkLibraryItemDto item) => "Manage";

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
