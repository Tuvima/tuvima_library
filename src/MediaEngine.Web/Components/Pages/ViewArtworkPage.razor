@page "/view/artwork"
@using MediaEngine.Contracts.Artwork
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Components.Browse
@using MediaEngine.Web.Components.Artwork
@inject IEngineApiClient ApiClient
@inject MediaEditorLauncherService MediaEditorLauncher
@inject UIOrchestratorService Orchestrator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable
@namespace MediaEngine.Web.Components.Pages

<PageTitle>Library Artwork - Tuvima Library</PageTitle>

<ViewSectionShell>
    <ViewContentPage Title="Library Artwork"
                     Subtitle="Browse covers, backgrounds, logos, people images, and automatic series artwork. Open any entity to manage its artwork."
                     Class="view-artwork-page">
        <HeaderActions>
            @if (_page is not null)
            {
                <span class="view-artwork-header__count">@_page.Total.ToString("N0") @(_page.Total == 1 ? "entity" : "entities")</span>
            }
        </HeaderActions>
        <ChildContent>

        <section class="view-artwork-controls" aria-label="Artwork gallery filters">
            <div class="view-artwork-tabs" role="tablist" aria-label="Entity type">
                @foreach (var option in EntityKinds)
                {
                    var active = string.Equals(_entityKind, option.Value, StringComparison.OrdinalIgnoreCase);
                    <button type="button" role="tab" aria-selected="@active" class="view-artwork-tab@(active ? " is-active" : string.Empty)" @onclick="(() => SelectEntityKindAsync(option.Value))">
                        <MudIcon Icon="@option.Icon" />
                        <span>@option.Label</span>
                    </button>
                }
            </div>

            @if (!IsPeopleView)
            {
                <div class="view-artwork-browse-row">
                    <div class="view-artwork-control-group">
                        <span>Browse as</span>
                        <AppBrowseModeSelector Options="@BrowseModes"
                                               Value="@_browseAs"
                                               ValueChanged="SelectBrowseModeAsync"
                                               AriaLabel="Browse artwork as" />
                    </div>
                    <div class="view-artwork-control-group">
                        <span>Media type</span>
                        <AppBrowseModeSelector Options="@AvailableMediaTypes"
                                               Value="@_mediaType"
                                               ValueChanged="SelectMediaTypeAsync"
                                               AriaLabel="Filter artwork by media type" />
                    </div>
                </div>
            }

            <div class="view-artwork-filters">
                <label class="view-artwork-search">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" />
                    <input type="search" value="@_search" @oninput="SearchChanged" placeholder="Search titles or people" aria-label="Search library artwork" />
                </label>
                <label class="view-artwork-type">
                    <span>Gallery</span>
                    <AppNativeSelect Value="@(_artworkType ?? string.Empty)" OnChange="ArtworkTypeChangedAsync" aria-label="Artwork type gallery">
                        @foreach (var type in ArtworkTypes)
                        {
                            <option value="@type.Value">@type.Label</option>
                        }
                    </AppNativeSelect>
                </label>
            </div>
        </section>

        @if (_loading && (_page is null || _page.Items.Count == 0))
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="Loading artwork" Message="Building galleries from your library artwork." />
        }
        else if (_page is null)
        {
            <AppErrorState Title="Artwork could not be loaded" Message="The Engine did not return the artwork library." Retry="LoadAsync" />
        }
        else if (_page.Items.Count == 0)
        {
            <AppPageState Kind="AppPageStateKind.Empty" Title="No artwork matches" Message="Try another gallery, entity type, or search." />
        }
        else
        {
            <section class="view-artwork-grid" aria-label="Library artwork">
                @foreach (var item in _page.Items)
                {
                    <button type="button" class="view-artwork-card view-artwork-card--@CardShape(item)" @onclick="(() => OpenArtworkAsync(item))" aria-label="Manage artwork for @item.DisplayTitle">
                        <span class="view-artwork-card__image">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="" loading="lazy" />
                            }
                            else if (item.ResolutionMode == ArtworkResolutionMode.AutomaticGroup && item.PreviewItems.Count > 0)
                            {
                                <MediaArtworkGroupPreview Items="@PreviewItems(item)"
                                                          TotalCount="@item.OwnedWorkCount"
                                                          AriaLabel="@($"Automatic artwork for {item.DisplayTitle}")"
                                                          Layout="MediaArtworkGroupPreviewLayout.Adaptive"
                                                          ShowOverflowCount="false" />
                                <span class="view-artwork-card__automatic">Automatic artwork</span>
                            }
                            else
                            {
                                <span class="view-artwork-card__placeholder"><MudIcon Icon="@PlaceholderIcon(item)" /></span>
                            }
                            <span class="view-artwork-card__open"><MudIcon Icon="@Icons.Material.Outlined.Edit" /> @OpenLabel(item)</span>
                        </span>
                        <span class="view-artwork-card__body">
                            <strong>@item.DisplayTitle</strong>
                            <span class="view-artwork-card__meta">@Metadata(item)</span>
                            <span class="view-artwork-card__types">
                                @foreach (var assetType in item.AssetTypes.Take(3))
                                {
                                    <small>@FormatAssetType(assetType)</small>
                                }
                                @if (item.AssetTypes.Count > 3)
                                {
                                    <small>+@(item.AssetTypes.Count - 3)</small>
                                }
                            </span>
                        </span>
                    </button>
                }
            </section>

            @if (_page.HasMore)
            {
                <div class="view-artwork-load-more">
                    <AppButton ButtonStyle="AppButtonStyle.Outlined" Disabled="@_loadingMore" OnClick="LoadMoreAsync">
                        @(_loadingMore ? "Loading…" : "Load more")
                    </AppButton>
                </div>
            }
        }
        </ChildContent>
    </ViewContentPage>
</ViewSectionShell>

@code {
    private const int PageSize = 48;
    private static readonly (string Label, string? Value, string Icon)[] EntityKinds =
    [
        ("Media", "media", Icons.Material.Outlined.MovieFilter),
        ("People", "people", Icons.Material.Outlined.People),
    ];
    private static readonly IReadOnlyList<BrowseGroupingOption> BrowseModes =
    [
        new("all", "All", Icons.Material.Outlined.Collections),
        new("titles", "Titles", Icons.Material.Outlined.LocalMovies),
        new("series", "Series / Groups", Icons.Material.Outlined.VideoLibrary),
        new("tvshows", "TV Shows", Icons.Material.Outlined.Tv),
        new("albums", "Albums", Icons.Material.Outlined.Album),
    ];
    private static readonly IReadOnlyList<BrowseGroupingOption> AllMediaTypes =
    [
        new("all", "All media", Icons.Material.Outlined.Apps),
        new("movies", "Movies", Icons.Material.Outlined.Movie),
        new("tv", "TV Shows", Icons.Material.Outlined.Tv),
        new("books", "Books", Icons.Material.Outlined.MenuBook),
        new("audiobooks", "Audiobooks", Icons.Material.Outlined.Headphones),
        new("music", "Music", Icons.Material.Outlined.Album),
        new("comics", "Comics", Icons.Material.Outlined.AutoStories),
    ];
    private static readonly (string Label, string Value)[] ArtworkTypes =
    [
        ("All artwork", ""),
        ("Covers & posters", "CoverArt"),
        ("Backgrounds", "Background"),
        ("Logos", "Logo"),
        ("People images", "Headshot"),
        ("Episode stills", "EpisodeStill"),
        ("Season posters", "SeasonPoster"),
        ("Banners", "Banner"),
    ];

    private ArtworkLibraryPageDto? _page;
    private string? _entityKind = "media";
    private string? _artworkType;
    private string _browseAs = "all";
    private string _mediaType = "all";
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _loadingMore;
    private int _loadGeneration;
    private CancellationTokenSource? _searchCts;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        var entityKind = _entityKind;
        var artworkType = _artworkType;
        var search = _search;
        var browseAs = string.Equals(entityKind, "people", StringComparison.OrdinalIgnoreCase) ? null : _browseAs;
        var mediaType = string.Equals(entityKind, "people", StringComparison.OrdinalIgnoreCase) || _mediaType == "all"
            ? null
            : _mediaType;
        _loading = true;
        _loadingMore = false;
        var page = await ApiClient.GetArtworkLibraryAsync(
            entityKind,
            artworkType,
            search,
            browseAs,
            mediaType,
            0,
            PageSize);
        if (generation != _loadGeneration)
        {
            return;
        }

        _page = page;
        _loading = false;
    }

    private async Task SelectEntityKindAsync(string? value)
    {
        if (string.Equals(_entityKind, value, StringComparison.OrdinalIgnoreCase)) return;
        _entityKind = value;
        if (IsPeopleView)
        {
            _mediaType = "all";
        }
        await LoadAsync();
    }

    private async Task SelectBrowseModeAsync(string value)
    {
        if (string.Equals(_browseAs, value, StringComparison.OrdinalIgnoreCase)) return;
        _browseAs = value;
        if (!AvailableMediaTypes.Any(option => string.Equals(option.Value, _mediaType, StringComparison.OrdinalIgnoreCase)))
        {
            _mediaType = "all";
        }
        await LoadAsync();
    }

    private async Task SelectMediaTypeAsync(string value)
    {
        if (string.Equals(_mediaType, value, StringComparison.OrdinalIgnoreCase)) return;
        _mediaType = value;
        await LoadAsync();
    }

    private async Task ArtworkTypeChangedAsync(object? value)
    {
        _artworkType = string.IsNullOrWhiteSpace(value?.ToString()) ? null : value!.ToString();
        await LoadAsync();
    }

    private void SearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        _ = DebouncedSearchAsync(_searchCts.Token);
    }

    private async Task DebouncedSearchAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct);
            await InvokeAsync(LoadAsync);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_page is null || !_page.HasMore || _loadingMore) return;
        var generation = _loadGeneration;
        var currentPage = _page;
        _loadingMore = true;
        var next = await ApiClient.GetArtworkLibraryAsync(
            _entityKind,
            _artworkType,
            _search,
            IsPeopleView ? null : _browseAs,
            IsPeopleView || _mediaType == "all" ? null : _mediaType,
            currentPage.Items.Count,
            PageSize);
        if (generation == _loadGeneration && next is not null)
        {
            _page = next with { Items = [.. currentPage.Items, .. next.Items], Offset = 0 };
        }
        if (generation == _loadGeneration)
        {
            _loadingMore = false;
        }
    }

    private async Task OpenArtworkAsync(ArtworkLibraryItemDto item)
    {
        try
        {
            var profile = await Orchestrator.GetActiveProfileAsync();
            if (item.IsStructural && string.Equals(item.EntityType, "Collection", StringComparison.OrdinalIgnoreCase))
            {
                var dialog = await DialogService.ShowAsync<ArtworkWorkspaceDialog>(
                    "Manage structural artwork",
                    new DialogParameters
                    {
                        { nameof(ArtworkWorkspaceDialog.Item), item },
                        { nameof(ArtworkWorkspaceDialog.ActiveProfileId), profile?.Id },
                    },
                    new DialogOptions
                    {
                        CloseButton = false,
                        NoHeader = true,
                        MaxWidth = MaxWidth.ExtraLarge,
                        FullWidth = true,
                        BackdropClick = false,
                        CloseOnEscapeKey = true,
                    });
                if (dialog is not null)
                {
                    var result = await dialog.Result;
                    if (result is not null && !result.Canceled)
                    {
                        await LoadAsync();
                    }
                }
                return;
            }

            var applied = await MediaEditorLauncher.OpenAsync(new MediaEditorLaunchRequest
            {
                EntityIds = [item.EntityId],
                LaunchEntityId = item.EntityId,
                LaunchEntityKind = item.EntityType,
                ActiveProfileId = profile?.Id,
                Mode = SharedMediaEditorMode.Normal,
                InitialTab = "artwork",
                IdentityIntent = MediaEditorIdentityIntent.ConfirmArtwork,
                MediaType = item.MediaType,
                HeaderTitle = item.DisplayTitle,
                HeaderSubtitle = item.EntityType == "Person" ? item.Subtitle : item.MediaType,
                CoverUrl = item.ImageUrl,
                OnArtworkChanged = LoadAsync,
                PreviewItems =
                [
                    new MediaEditorPreviewItem
                    {
                        EntityId = item.EntityId,
                        Title = item.DisplayTitle,
                        CoverUrl = item.ImageUrl,
                        MediaType = item.MediaType,
                    },
                ],
            });
            if (applied)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Artwork editor could not open: {ex.Message}", Severity.Error);
        }
    }

    private static string CardShape(ArtworkLibraryItemDto item) =>
        item.IsStructural ? "group" :
        item.EntityType == "Person" || string.Equals(item.PrimaryAssetType, "Headshot", StringComparison.OrdinalIgnoreCase)
            ? "person"
            : item.PrimaryAssetType == "Logo"
                ? "logo"
                : item.PrimaryAssetType is "Background" or "Banner" or "EpisodeStill" or "SeasonThumb"
                    ? "wide"
                    : "portrait";

    private static string PlaceholderIcon(ArtworkLibraryItemDto item) => item.EntityType == "Person"
        ? Icons.Material.Outlined.Person
        : Icons.Material.Outlined.Image;

    private static string Metadata(ArtworkLibraryItemDto item)
    {
        if (item.IsStructural)
        {
            var groupIdentity = string.Join(" · ", new[] { item.Subtitle, item.Year }.Where(value => !string.IsNullOrWhiteSpace(value)));
            var artwork = item.ResolutionMode == ArtworkResolutionMode.AutomaticGroup
                ? "Automatic artwork"
                : item.ResolutionMode == ArtworkResolutionMode.Explicit
                    ? $"{item.VariantCount} managed {(item.VariantCount == 1 ? "image" : "images")}"
                    : "No artwork yet";
            var owned = $"{item.OwnedWorkCount} owned {(item.OwnedWorkCount == 1 ? "item" : "items")}";
            return string.Join(" · ", new[] { groupIdentity, owned, artwork }.Where(value => !string.IsNullOrWhiteSpace(value)));
        }

        if (item.EntityType == "Person")
        {
            var imageText = item.VariantCount > 0
                ? $"{item.VariantCount} managed {(item.VariantCount == 1 ? "image" : "images")}"
                : item.UsesLegacyPersonImage ? "Provider image" : "No artwork yet";
            return item.OwnedWorkCount > 0 ? $"{imageText} · {item.OwnedWorkCount} owned works" : imageText;
        }

        var identity = string.Join(" · ", new[] { item.MediaType, item.Year }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var variants = $"{item.VariantCount} {(item.VariantCount == 1 ? "variant" : "variants")}";
        return string.IsNullOrWhiteSpace(identity) ? variants : $"{identity} · {variants}";
    }

    private static string FormatAssetType(string value) => value switch
    {
        "CoverArt" => "Cover",
        "Headshot" => "Portrait",
        "EpisodeStill" => "Episode still",
        "SeasonPoster" => "Season poster",
        "SeasonThumb" => "Season thumbnail",
        "NetworkLogo" => "Network logo",
        "StudioLogo" => "Studio logo",
        "CharacterPortrait" => "Character portrait",
        _ => value,
    };

    private bool IsPeopleView => string.Equals(_entityKind, "people", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<BrowseGroupingOption> AvailableMediaTypes => _browseAs switch
    {
        "series" => AllMediaTypes.Where(option => option.Value is "all" or "movies" or "books" or "audiobooks" or "comics").ToList(),
        "tvshows" => AllMediaTypes.Where(option => option.Value is "all" or "tv").ToList(),
        "albums" => AllMediaTypes.Where(option => option.Value is "all" or "music").ToList(),
        _ => AllMediaTypes,
    };

    private static IReadOnlyList<ArtworkStackItem> PreviewItems(ArtworkLibraryItemDto item) => item.PreviewItems
        .Select(preview => new ArtworkStackItem
        {
            Id = preview.AssetId?.ToString("D") ?? preview.WorkId.ToString("D"),
            WorkId = preview.WorkId,
            AssetId = preview.AssetId,
            Title = preview.Title,
            ImageUrl = preview.ImageUrl,
            MediaType = preview.MediaType ?? item.MediaType ?? string.Empty,
            Shape = preview.Shape.ToLowerInvariant() switch
            {
                "square" => ArtworkShape.Square,
                "wide" => ArtworkShape.Wide,
                _ => ArtworkShape.Portrait,
            },
            Position = preview.Position,
        })
        .ToList();

    private static string OpenLabel(ArtworkLibraryItemDto item) => "Manage";

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
