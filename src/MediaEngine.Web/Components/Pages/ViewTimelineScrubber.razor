@using System.Globalization
@using MediaEngine.Contracts.LocalAssets
@namespace MediaEngine.Web.Components.Pages
<AppTimelineNavigator Periods="@Periods" ActiveKey="@ActiveYear" ActiveChildKey="@ActiveMonth" ChildLabel="Months" OnJump="JumpAsync" />
@code {
    [Parameter] public IReadOnlyList<ViewTimelineBucketDto> Buckets { get; set; } = [];
    [Parameter] public int? ActiveYear { get; set; }
    [Parameter] public int? ActiveMonth { get; set; }
    [Parameter] public EventCallback<ViewTimelineBucketDto> OnJump { get; set; }
    private IReadOnlyList<TimelinePeriod> Periods => Buckets.Where(b => b.AssetCount > 0).GroupBy(b => b.Year).OrderByDescending(g => g.Key)
        .Select(g => new TimelinePeriod(g.Key, g.Key.ToString(), g.Sum(b => b.AssetCount),
            g.OrderByDescending(b => b.Month).Select(b => new TimelinePeriod(b.Month, CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(b.Month), b.AssetCount)).ToList())).ToList();
    private Task JumpAsync(TimelinePeriod period) {
        var bucket = period.Key <= 12 ? Buckets.FirstOrDefault(b => b.Year == ActiveYear && b.Month == period.Key)
            : Buckets.Where(b => b.Year == period.Key && b.AssetCount > 0).OrderByDescending(b => b.Month).FirstOrDefault();
        return bucket is null ? Task.CompletedTask : OnJump.InvokeAsync(bucket);
    }
}
