@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Models.ViewDTOs
@namespace MediaEngine.Web.Components.Pages
@inject IEngineApiClient ApiClient
@inject ISnackbar Snackbar

<MediaViewerShell Item="@ViewerItem"
                  Capabilities="@ViewerCapabilities"
                  HasPrevious="@HasPrevious"
                  HasNext="@HasNext"
                  Galleries="@ManualGalleries"
                  OnClose="@OnClose"
                  OnPrevious="@OnPrevious"
                  OnNext="@OnNext"
                  OnFavorite="@OnFavorite"
                  OnArchive="@OnArchive"
                  OnRestore="@OnRestore"
                  OnTrash="@OnTrash"
                  OnAddToGallery="@OnAddToGallery">
    <ContextActions>
        @if (!string.IsNullOrWhiteSpace(MotionUrl))
        {
            <AppIconButton Icon="@(_showMotion ? Icons.Material.Outlined.Photo : Icons.Material.Outlined.MotionPhotosOn)"
                           Tooltip="@(_showMotion ? "Show still" : "Play motion")"
                           AriaLabel="@(_showMotion ? "Show Live Photo still" : "Play Live Photo motion")"
                           OnClick="ToggleMotion" />
        }
    </ContextActions>
    <InfoContent>
        <section class="view-viewer-info__section">
            <h3>Details</h3>
            @if (CanEdit)
            {
                <AppTextarea Label="Description" Value="@_description" ValueChanged="@(value => _description = value)" Lines="3" Placeholder="Add a description…" Class="view-viewer-info__field" />
                <AppNativeButton Type="button" Class="view-viewer-info__save" Disabled="@_saving" OnClick="@(_ => SaveDescriptionAsync())">Save description</AppNativeButton>
            }
            else if (!string.IsNullOrWhiteSpace(Item.Description)) { <p>@Item.Description</p> }
            <dl>
                <div><dt>Captured</dt><dd><time datetime="@Captured.ToString("O")">@Captured.ToLocalTime().ToString("f")</time></dd></div>
                <div><dt>File name</dt><dd>@Item.FileName</dd></div>
                <div><dt>Format</dt><dd>@Item.MimeType</dd></div>
                @if (Item.Width is > 0 && Item.Height is > 0) { <div><dt>Resolution</dt><dd>@Item.Width × @Item.Height</dd></div> }
                @if (Item.DurationSeconds is > 0) { <div><dt>Duration</dt><dd>@FormatDuration(Item.DurationSeconds.Value)</dd></div> }
                @if (TotalBytes > 0) { <div><dt>Size</dt><dd>@FormatBytes(TotalBytes)</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Device)) { <div><dt>Device</dt><dd>@Device</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Item.LensModel)) { <div><dt>Lens</dt><dd>@Item.LensModel</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Item.ExposureTime)) { <div><dt>Exposure</dt><dd>@Item.ExposureTime</dd></div> }
                @if (Item.Aperture is > 0) { <div><dt>Aperture</dt><dd>ƒ/@Item.Aperture.Value.ToString("0.#")</dd></div> }
                @if (Item.Iso is > 0) { <div><dt>ISO</dt><dd>@Item.Iso</dd></div> }
                @if (Item.FocalLengthMm is > 0) { <div><dt>Focal length</dt><dd>@Item.FocalLengthMm.Value.ToString("0.#") mm</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Item.VideoCodec)) { <div><dt>Video codec</dt><dd>@Item.VideoCodec</dd></div> }
                @if (Item.FrameRate is > 0) { <div><dt>Frame rate</dt><dd>@Item.FrameRate.Value.ToString("0.###") fps</dd></div> }
            </dl>
        </section>
        @if (CanEdit || !string.IsNullOrWhiteSpace(LocationLabel) || (Item.Latitude.HasValue && Item.Longitude.HasValue))
        {
            <section class="view-viewer-info__section"><h3>Location</h3>
            @if (CanEdit)
            {
                <div class="view-viewer-info__location-grid">
                    <label class="view-viewer-info__field"><span>Place</span><AppNativeInput Value="@_locationName" ValueChanged="@(value => _locationName = value?.ToString())" /></label>
                    <label class="view-viewer-info__field"><span>City</span><AppNativeInput Value="@_locationCity" ValueChanged="@(value => _locationCity = value?.ToString())" /></label>
                    <label class="view-viewer-info__field"><span>Region</span><AppNativeInput Value="@_locationRegion" ValueChanged="@(value => _locationRegion = value?.ToString())" /></label>
                    <label class="view-viewer-info__field"><span>Country</span><AppNativeInput Value="@_locationCountry" ValueChanged="@(value => _locationCountry = value?.ToString())" /></label>
                    <label class="view-viewer-info__field"><span>Latitude</span><AppNativeInput inputmode="decimal" Value="@_latitude" ValueChanged="@(value => _latitude = value?.ToString())" /></label>
                    <label class="view-viewer-info__field"><span>Longitude</span><AppNativeInput inputmode="decimal" Value="@_longitude" ValueChanged="@(value => _longitude = value?.ToString())" /></label>
                </div>
                <div class="view-viewer-info__button-row"><AppNativeButton Type="button" Class="view-viewer-info__save" Disabled="@_saving" OnClick="@(_ => SaveLocationAsync())">Save location</AppNativeButton>@if (Item.EmbeddedLatitude.HasValue && Item.EmbeddedLongitude.HasValue && Item.LocationUserOverride) { <AppNativeButton Type="button" Class="view-viewer-info__reset" Disabled="@_saving" OnClick="@(_ => ResetLocationAsync())">Use embedded location</AppNativeButton> }</div>
            }
            <dl>
                @if (!string.IsNullOrWhiteSpace(LocationLabel)) { <div><dt>Place</dt><dd>@LocationLabel</dd></div> }
                @if (Item.Latitude.HasValue && Item.Longitude.HasValue) { <div><dt>Coordinates</dt><dd>@Item.Latitude.Value.ToString("0.#####"), @Item.Longitude.Value.ToString("0.#####")</dd></div> }
            </dl></section>
        }
        <section class="view-viewer-info__section"><h3>People</h3><p class="view-viewer-info__empty">No people tagged</p></section>
        @if (CanEdit || Item.Tags.Count > 0) { <section class="view-viewer-info__section"><h3>Tags</h3>@if (CanEdit) { <label class="view-viewer-info__field"><span>Comma separated</span><AppNativeInput Value="@_tags" ValueChanged="@(value => _tags = value?.ToString())" Placeholder="family, vacation, birthday" /></label><AppNativeButton Type="button" Class="view-viewer-info__save" Disabled="@_saving" OnClick="@(_ => SaveTagsAsync())">Save tags</AppNativeButton> }<div class="view-viewer-info__tags">@foreach (var tag in Item.Tags) { <span>@tag</span> }</div></section> }
        <section class="view-viewer-info__section"><h3>Files &amp; source</h3><div class="view-viewer-info__files">@foreach (var file in Item.Files) { <div><strong>@FileRole(file.Role)</strong><span>@file.MimeType · @FormatBytes(file.ByteSize)</span></div> }</div><p>@Item.SourceCount source@(Item.SourceCount == 1 ? string.Empty : "s")</p></section>
    </InfoContent>
</MediaViewerShell>

@code {
    [Parameter, EditorRequired] public LocalAssetDto Item { get; set; } = default!;
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public string ContentUrl { get; set; } = "";
    [Parameter] public string OriginalUrl { get; set; } = "";
    [Parameter] public string ThumbnailUrl { get; set; } = "";
    [Parameter] public string? MotionUrl { get; set; }
    [Parameter] public string? PositionLabel { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> ManualGalleries { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnItemUpdated { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManage { get; set; }
    private Guid _editingItemId; private string? _description, _tags, _locationName, _locationCity, _locationRegion, _locationCountry, _latitude, _longitude; private bool _saving, _showMotion;
    private string Title => string.IsNullOrWhiteSpace(Item.Title) ? Item.FileName : Item.Title;
    private DateTimeOffset Captured => Item.CapturedAt ?? Item.CreatedAt;
    private long TotalBytes => Item.Files.Sum(file => file.ByteSize);
    private string Device => string.Join(' ', new[] { Item.DeviceMake, Item.DeviceModel }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string LocationLabel => string.Join(", ", new[] { Item.LocationName, Item.LocationCity, Item.LocationRegion, Item.LocationCountry }.Where(value => !string.IsNullOrWhiteSpace(value)));
    protected override void OnParametersSet()
    {
        if (_editingItemId == Item.Id) return;
        _editingItemId = Item.Id; _showMotion = false; _description = Item.Description; _tags = string.Join(", ", Item.Tags);
        _locationName = Item.LocationName; _locationCity = Item.LocationCity; _locationRegion = Item.LocationRegion; _locationCountry = Item.LocationCountry;
        _latitude = Item.Latitude?.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture);
        _longitude = Item.Longitude?.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture);
    }
    private async Task ApplyAsync(Task<LocalAssetDto?> operation)
    {
        _saving = true;
        var updated = await operation;
        _saving = false;
        if (updated is null) { Snackbar.Add(ApiClient.LastError ?? "The item could not be updated.", Severity.Error); return; }
        await OnItemUpdated.InvokeAsync(updated);
        Snackbar.Add("Item details updated.", Severity.Success);
    }
    private Task SaveDescriptionAsync() => ApplyAsync(ApiClient.UpdateViewItemDescriptionAsync(Item.Id, _description));
    private Task SaveTagsAsync() => ApplyAsync(ApiClient.UpdateViewItemTagsAsync(Item.Id, (_tags ?? string.Empty).Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)));
    private Task SaveLocationAsync()
    {
        if (!double.TryParse(_latitude, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var latitude)
            || !double.TryParse(_longitude, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var longitude))
        { Snackbar.Add("Enter valid latitude and longitude values.", Severity.Warning); return Task.CompletedTask; }
        return ApplyAsync(ApiClient.UpdateViewItemLocationAsync(Item.Id, new(latitude, longitude, _locationName, _locationCity, _locationRegion, _locationCountry)));
    }
    private Task ResetLocationAsync() => ApplyAsync(ApiClient.UpdateViewItemLocationAsync(Item.Id, new(null, null, ResetToEmbedded: true)));
    private void ToggleMotion() => _showMotion = !_showMotion;
    private MediaViewerItem ViewerItem => new(
        Item.Id.ToString("D"),
        _showMotion ? MediaViewerKind.Video
            : Item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Video
            : Item.MimeType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Audio
            : Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Image
            : MediaViewerKind.Document,
        Title,
        Captured.ToLocalTime().ToString("f"),
        _showMotion ? MotionUrl! : Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ? ContentUrl : OriginalUrl,
        OriginalUrl,
        ThumbnailUrl,
        PositionLabel,
        Title);
    private MediaViewerCapabilities ViewerCapabilities => new(
        CanFavorite: CanManage,
        IsFavorite: Item.Favorite,
        CanAddToGallery: ManualGalleries.Count > 0,
        CanDownload: true,
        CanArchive: CanManage && !Item.ArchivedAt.HasValue && !Item.TrashedAt.HasValue,
        CanRestore: CanManage && (Item.ArchivedAt.HasValue || Item.TrashedAt.HasValue),
        CanTrash: CanManage && !Item.TrashedAt.HasValue,
        CanShowInfo: true,
        CanZoom: Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase),
        CanPlay: Item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase),
        CanSlideshow: HasNext);
    private static string FileRole(string role) => role.Replace('_', ' ').ToUpperInvariant();
    private static string FormatDuration(double seconds) => TimeSpan.FromSeconds(seconds).TotalHours >= 1 ? TimeSpan.FromSeconds(seconds).ToString(@"h\:mm\:ss") : TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");
    private static string FormatBytes(long bytes) { string[] units = ["B", "KB", "MB", "GB", "TB"]; var value = (double)bytes; var unit = 0; while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; } return $"{value:0.#} {units[unit]}"; }
}
