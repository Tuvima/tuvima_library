@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Web.Models.ViewDTOs
@namespace MediaEngine.Web.Components.Pages
@inject IEngineApiClient ApiClient
@inject ISnackbar Snackbar
@inject ViewWorkspaceService Workspace

<MediaViewerShell Item="@ViewerItem"
                  Capabilities="@ViewerCapabilities"
                  HasPrevious="@HasPrevious"
                  HasNext="@HasNext"
                  Galleries="@ManualGalleries"
                  OnClose="@OnClose"
                  OnPrevious="@OnPrevious"
                  OnNext="@OnNext"
                  OnFavorite="@OnFavorite"
                  OnArchive="@OnArchive"
                  OnRestore="@OnRestore"
                  OnTrash="@OnTrash"
                  OnAddToGallery="@OnAddToGallery"
                  InfoInitiallyOpen="@Workspace.ViewerInfoOpen"
                  InfoOpenChanged="InfoOpenChangedAsync">
    <ContextActions>
        @if (!string.IsNullOrWhiteSpace(MotionUrl))
        {
            <AppIconButton Icon="@(_showMotion ? Icons.Material.Outlined.Photo : Icons.Material.Outlined.MotionPhotosOn)"
                           Tooltip="@(_showMotion ? "Show still" : "Play motion")"
                           AriaLabel="@(_showMotion ? "Show Live Photo still" : "Play Live Photo motion")"
                           OnClick="ToggleMotion" />
        }
    </ContextActions>
    <InfoContent>
        <section class="view-viewer-info__section">
            <div class="view-viewer-info__heading"><h3>Description</h3></div>
            @if (CanEdit)
            {
                <AppTextarea Label="Description" Value="@_description" ValueChanged="@(value => _description = value)" Lines="3" Placeholder="Add a description…" Class="view-viewer-info__field" />
                <AppNativeButton Type="button" Class="view-viewer-info__save" Disabled="@_saving" OnClick="@(_ => SaveDescriptionAsync())">Save description</AppNativeButton>
            }
            else if (!string.IsNullOrWhiteSpace(Item.Description)) { <p>@Item.Description</p> }
            else { <p class="view-viewer-info__empty-copy">No description</p> }
        </section>
        <section class="view-viewer-info__section">
            <div class="view-viewer-info__heading"><h3>Details</h3></div>
            <dl>
                <div class="view-viewer-info__editable-row"><dt><MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" /> Captured</dt><dd><time datetime="@Captured.ToString("O")">@Captured.ToLocalTime().ToString("f")</time>@if (CanEdit) { <AppIconButton Icon="@Icons.Material.Outlined.Edit" Tooltip="Edit captured date" AriaLabel="Edit captured date" OnClick="ToggleDateEditor" /> }</dd></div>
                @if (_editingDate)
                {
                    <div class="view-viewer-info__inline-editor"><AppNativeInput Type="datetime-local" Value="@_capturedAt" ValueChanged="@(value => _capturedAt = value?.ToString())" aria-label="Captured date and time" /><div class="view-viewer-info__button-row"><AppNativeButton Type="button" Disabled="@_saving" OnClick="@(_ => SaveCapturedAtAsync())">Save</AppNativeButton>@if (Item.EmbeddedCapturedAt.HasValue && Item.CapturedAtUserOverride) { <AppNativeButton Type="button" Class="view-viewer-info__reset" Disabled="@_saving" OnClick="@(_ => ResetCapturedAtAsync())">Use original</AppNativeButton> }<AppNativeButton Type="button" Class="view-viewer-info__reset" OnClick="@(_ => ToggleDateEditor())">Cancel</AppNativeButton></div></div>
                }
                <div><dt>File name</dt><dd>@Item.FileName</dd></div>
                <div><dt>Format</dt><dd>@Item.MimeType</dd></div>
                @if (Item.Width is > 0 && Item.Height is > 0) { <div><dt>Resolution</dt><dd>@Item.Width × @Item.Height</dd></div> }
                @if (Item.DurationSeconds is > 0) { <div><dt>Duration</dt><dd>@FormatDuration(Item.DurationSeconds.Value)</dd></div> }
                @if (TotalBytes > 0) { <div><dt>Size</dt><dd>@FormatBytes(TotalBytes)</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Device)) { <div><dt>Device</dt><dd>@Device</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Item.LensModel)) { <div><dt>Lens</dt><dd>@Item.LensModel</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Item.ExposureTime)) { <div><dt>Exposure</dt><dd>@Item.ExposureTime</dd></div> }
                @if (Item.Aperture is > 0) { <div><dt>Aperture</dt><dd>ƒ/@Item.Aperture.Value.ToString("0.#")</dd></div> }
                @if (Item.Iso is > 0) { <div><dt>ISO</dt><dd>@Item.Iso</dd></div> }
                @if (Item.FocalLengthMm is > 0) { <div><dt>Focal length</dt><dd>@Item.FocalLengthMm.Value.ToString("0.#") mm</dd></div> }
                @if (!string.IsNullOrWhiteSpace(Item.VideoCodec)) { <div><dt>Video codec</dt><dd>@Item.VideoCodec</dd></div> }
                @if (Item.FrameRate is > 0) { <div><dt>Frame rate</dt><dd>@Item.FrameRate.Value.ToString("0.###") fps</dd></div> }
            </dl>
        </section>
        @if (CanEdit || !string.IsNullOrWhiteSpace(LocationLabel) || (Item.Latitude.HasValue && Item.Longitude.HasValue))
        {
            <section class="view-viewer-info__section">
            <div class="view-viewer-info__heading"><h3>Location</h3>@if (CanEdit) { <AppIconButton Icon="@Icons.Material.Outlined.Edit" Tooltip="Edit location" AriaLabel="Edit location" OnClick="ToggleLocationEditor" /> }</div>
            @if (!string.IsNullOrWhiteSpace(LocationLabel)) { <p>@LocationLabel</p> }
            @if (HasLocation)
            {
                <div class="view-viewer-info__map"><iframe title="Map showing @LocationLabel" src="@MapUrl" loading="lazy"></iframe><span><MudIcon Icon="@Icons.Material.Filled.LocationOn" /></span></div>
            }
            else if (!_editingLocation) { <p class="view-viewer-info__empty-copy">No location</p> }
            @if (_editingLocation)
            {
                <div class="view-viewer-info__location-editor">
                    <AppAutocomplete TItem="ViewPlaceDto" Label="Search identified places" Value="@_selectedPlace" ValueChanged="PlaceSelected" SearchFunc="SearchPlacesAsync" ToStringFunc="@(place => place?.Name ?? string.Empty)" Placeholder="Search places" ResetValueOnEmptyText="true" />
                    @if (HasDraftLocation)
                    {
                        <div class="view-viewer-info__map is-editing"><iframe title="Location editor map" src="@DraftMapUrl"></iframe><span><MudIcon Icon="@Icons.Material.Filled.LocationOn" /></span></div>
                        <div class="view-viewer-info__coordinates">
                            <label class="view-viewer-info__field"><span>Latitude</span><AppNativeInput inputmode="decimal" Value="@_latitude" ValueChanged="@(value => LocationCoordinateChanged(value, true))" aria-label="Latitude" /></label>
                            <label class="view-viewer-info__field"><span>Longitude</span><AppNativeInput inputmode="decimal" Value="@_longitude" ValueChanged="@(value => LocationCoordinateChanged(value, false))" aria-label="Longitude" /></label>
                        </div>
                    }
                </div>
                <div class="view-viewer-info__button-row"><AppNativeButton Type="button" Class="view-viewer-info__save" Disabled="@(_saving || !HasDraftLocation)" OnClick="@(_ => SaveLocationAsync())">Save location</AppNativeButton>@if (Item.EmbeddedLatitude.HasValue && Item.EmbeddedLongitude.HasValue && Item.LocationUserOverride) { <AppNativeButton Type="button" Class="view-viewer-info__reset" Disabled="@_saving" OnClick="@(_ => ResetLocationAsync())">Use original</AppNativeButton> }<AppNativeButton Type="button" Class="view-viewer-info__reset" OnClick="@(_ => ToggleLocationEditor())">Cancel</AppNativeButton></div>
            }
            </section>
        }
        <section class="view-viewer-info__section"><div class="view-viewer-info__heading"><h3>People</h3></div>@if (CanEdit) { <AppAutocomplete TItem="string" Value="@_personToAdd" ValueChanged="PersonSelected" SearchFunc="SearchPeopleAsync" Placeholder="Add identified people…" ResetValueOnEmptyText="true" /> }<div class="view-viewer-info__tags">@foreach (var person in _people) { <span>@person@if (CanEdit) { <AppIconButton Icon="@Icons.Material.Outlined.Close" Size="AppControlSize.Compact" Class="view-viewer-info__chip-remove" Tooltip="@($"Remove {person}")" AriaLabel="@($"Remove {person}")" OnClick="@(() => RemovePersonAsync(person))" /> }</span> }</div>@if (_people.Count == 0) { <p class="view-viewer-info__empty-copy">No identified people</p> }</section>
        <section class="view-viewer-info__section"><div class="view-viewer-info__heading"><h3>Tags</h3></div>@if (CanEdit) { <AppAutocomplete TItem="string" Value="@_tagToAdd" ValueChanged="TagSelected" SearchFunc="SearchTagsAsync" Placeholder="Add tags…" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" /> }<div class="view-viewer-info__tags">@foreach (var tag in _tagValues) { <span>@tag@if (CanEdit) { <AppIconButton Icon="@Icons.Material.Outlined.Close" Size="AppControlSize.Compact" Class="view-viewer-info__chip-remove" Tooltip="@($"Remove {tag}")" AriaLabel="@($"Remove {tag}")" OnClick="@(() => RemoveTagAsync(tag))" /> }</span> }</div>@if (_tagValues.Count == 0) { <p class="view-viewer-info__empty-copy">No tags</p> }</section>
        <section class="view-viewer-info__section"><div class="view-viewer-info__heading"><h3>Source files</h3></div><div class="view-viewer-info__files">@foreach (var file in DisplayFiles) { <div><MudIcon Icon="@Icons.Material.Outlined.InsertPhoto" /><span><strong>@(file.FileName ?? Item.FileName)</strong><small>@FileRole(file.Role) · @file.MimeType · @FormatBytes(file.ByteSize)</small></span></div> }</div>@if (Item.SourceCount > 1) { <p>@Item.SourceCount observed sources</p> }</section>
    </InfoContent>
</MediaViewerShell>

@code {
    [Parameter, EditorRequired] public LocalAssetDto Item { get; set; } = default!;
    [Parameter] public bool HasPrevious { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public string ContentUrl { get; set; } = "";
    [Parameter] public string OriginalUrl { get; set; } = "";
    [Parameter] public string ThumbnailUrl { get; set; } = "";
    [Parameter] public string? MotionUrl { get; set; }
    [Parameter] public string? PositionLabel { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> ManualGalleries { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }
    [Parameter] public EventCallback<LocalAssetDto> OnItemUpdated { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManage { get; set; }
    private Guid _editingItemId; private string? _description, _locationName, _locationCity, _locationRegion, _locationCountry, _latitude, _longitude, _capturedAt, _personToAdd, _tagToAdd; private bool _saving, _showMotion, _editingDate, _editingLocation; private ViewPlaceDto? _selectedPlace; private List<string> _people = []; private List<string> _tagValues = [];
    private string Title => string.IsNullOrWhiteSpace(Item.Title) ? Item.FileName : Item.Title;
    private DateTimeOffset Captured => Item.CapturedAt ?? Item.CreatedAt;
    private long TotalBytes => DisplayFiles.Sum(file => file.ByteSize);
    private IReadOnlyList<LocalAssetFileDto> DisplayFiles
    {
        get
        {
            var sourceFiles = Item.Files.Where(file => !string.Equals(file.Role, "derivative", StringComparison.OrdinalIgnoreCase))
                .DistinctBy(file => file.Id).ToList();
            var compound = sourceFiles.Any(file => file.Role is "live_photo_video" or "raw" or "jpeg" or "sidecar" or "audio_companion");
            return compound ? sourceFiles : sourceFiles.Take(1).ToList();
        }
    }
    private string Device => string.Join(' ', new[] { Item.DeviceMake, Item.DeviceModel }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string LocationLabel => string.Join(", ", new[] { Item.LocationName, Item.LocationCity, Item.LocationRegion, Item.LocationCountry }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private bool HasLocation => Item.Latitude.HasValue && Item.Longitude.HasValue;
    private bool HasDraftLocation => TryCoordinates(out _, out _);
    private string MapUrl => BuildMapUrl(Item.Latitude, Item.Longitude);
    private string DraftMapUrl => TryCoordinates(out var latitude, out var longitude) ? BuildMapUrl(latitude, longitude) : string.Empty;
    protected override void OnParametersSet()
    {
        if (_editingItemId == Item.Id) return;
        _editingItemId = Item.Id; _showMotion = false; _editingDate = false; _editingLocation = false; _description = Item.Description;
        _tagValues = [.. Item.Tags]; _people = [.. (Item.People ?? [])];
        _capturedAt = Captured.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
        _locationName = Item.LocationName; _locationCity = Item.LocationCity; _locationRegion = Item.LocationRegion; _locationCountry = Item.LocationCountry;
        _latitude = Item.Latitude?.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture);
        _longitude = Item.Longitude?.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture);
    }
    private async Task ApplyAsync(Task<LocalAssetDto?> operation)
    {
        _saving = true;
        var updated = await operation;
        _saving = false;
        if (updated is null) { Snackbar.Add(ApiClient.LastError ?? "The item could not be updated.", Severity.Error); return; }
        await OnItemUpdated.InvokeAsync(updated);
        Snackbar.Add("Item details updated.", Severity.Success);
    }
    private Task SaveDescriptionAsync() => ApplyAsync(ApiClient.UpdateViewItemDescriptionAsync(Item.Id, _description));
    private void ToggleDateEditor() => _editingDate = !_editingDate;
    private async Task SaveCapturedAtAsync()
    {
        if (!DateTime.TryParse(_capturedAt, System.Globalization.CultureInfo.CurrentCulture,
                System.Globalization.DateTimeStyles.AllowWhiteSpaces, out var local))
        { Snackbar.Add("Enter a valid captured date and time.", Severity.Warning); return; }
        local = DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
        await ApplyAsync(ApiClient.UpdateViewItemCapturedAtAsync(Item.Id,
            new(new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local)))));
        _editingDate = false;
    }
    private async Task ResetCapturedAtAsync() { await ApplyAsync(ApiClient.UpdateViewItemCapturedAtAsync(Item.Id, new(null, true))); _editingDate = false; }
    private void ToggleLocationEditor() => _editingLocation = !_editingLocation;
    private async Task SaveLocationAsync()
    {
        if (!double.TryParse(_latitude, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var latitude)
            || !double.TryParse(_longitude, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var longitude))
        { Snackbar.Add("Choose a valid map location.", Severity.Warning); return; }
        await ApplyAsync(ApiClient.UpdateViewItemLocationAsync(Item.Id, new(latitude, longitude, _locationName, _locationCity, _locationRegion, _locationCountry)));
        _editingLocation = false;
    }
    private async Task ResetLocationAsync() { await ApplyAsync(ApiClient.UpdateViewItemLocationAsync(Item.Id, new(null, null, ResetToEmbedded: true))); _editingLocation = false; }
    private Task LocationCoordinateChanged(object? value, bool latitude)
    {
        if (latitude) _latitude = value?.ToString();
        else _longitude = value?.ToString();
        StateHasChanged();
        return Task.CompletedTask;
    }
    private async Task<IEnumerable<ViewPlaceDto>> SearchPlacesAsync(string? search, CancellationToken ct)
    {
        var page = await ApiClient.GetViewPlacesAsync(new(Workspace.ScopeKind, Workspace.ScopeProfileId, search, Limit: 20), ct);
        return page?.Items ?? [];
    }
    private Task PlaceSelected(ViewPlaceDto? place)
    {
        _selectedPlace = place;
        if (place is null) return Task.CompletedTask;
        _latitude = place.Latitude.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
        _longitude = place.Longitude.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
        _locationName = place.Name;
        return Task.CompletedTask;
    }
    private async Task<IEnumerable<string>> SearchPeopleAsync(string? search, CancellationToken ct)
    {
        var page = await ApiClient.GetViewPeopleAsync(new(Workspace.ScopeKind, Workspace.ScopeProfileId, search, Limit: 40), ct);
        return page?.Items.Select(person => person.DisplayName).Where(person => !_people.Contains(person, StringComparer.OrdinalIgnoreCase)) ?? [];
    }
    private async Task PersonSelected(string? person)
    {
        _personToAdd = null;
        if (string.IsNullOrWhiteSpace(person) || _people.Contains(person, StringComparer.OrdinalIgnoreCase)) return;
        _people.Add(person.Trim());
        await ApplyAsync(ApiClient.UpdateViewItemPeopleAsync(Item.Id, _people));
    }
    private async Task RemovePersonAsync(string person) { _people.RemoveAll(value => string.Equals(value, person, StringComparison.OrdinalIgnoreCase)); await ApplyAsync(ApiClient.UpdateViewItemPeopleAsync(Item.Id, _people)); }
    private async Task<IEnumerable<string>> SearchTagsAsync(string? search, CancellationToken ct) => await ApiClient.GetViewTagSuggestionsAsync(search, 30, ct);
    private async Task TagSelected(string? tag)
    {
        _tagToAdd = null;
        if (string.IsNullOrWhiteSpace(tag) || _tagValues.Contains(tag, StringComparer.OrdinalIgnoreCase)) return;
        _tagValues.Add(tag.Trim());
        await ApplyAsync(ApiClient.UpdateViewItemTagsAsync(Item.Id, _tagValues));
    }
    private async Task RemoveTagAsync(string tag) { _tagValues.RemoveAll(value => string.Equals(value, tag, StringComparison.OrdinalIgnoreCase)); await ApplyAsync(ApiClient.UpdateViewItemTagsAsync(Item.Id, _tagValues)); }
    private async Task InfoOpenChangedAsync(bool open)
    {
        if (!await Workspace.SetViewerInfoOpenAsync(open))
            Snackbar.Add("The viewer preference could not be saved.", Severity.Warning);
    }
    private void ToggleMotion() => _showMotion = !_showMotion;
    private MediaViewerItem ViewerItem => new(
        Item.Id.ToString("D"),
        _showMotion ? MediaViewerKind.Video
            : Item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Video
            : Item.MimeType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Audio
            : Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ? MediaViewerKind.Image
            : MediaViewerKind.Document,
        Title,
        Captured.ToLocalTime().ToString("f"),
        _showMotion ? MotionUrl! : Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ? ContentUrl : OriginalUrl,
        OriginalUrl,
        ThumbnailUrl,
        PositionLabel,
        Title);
    private MediaViewerCapabilities ViewerCapabilities => new(
        CanFavorite: CanManage,
        IsFavorite: Item.Favorite,
        CanAddToGallery: ManualGalleries.Count > 0,
        CanDownload: true,
        CanArchive: CanManage && !Item.ArchivedAt.HasValue && !Item.TrashedAt.HasValue,
        CanRestore: CanManage && (Item.ArchivedAt.HasValue || Item.TrashedAt.HasValue),
        CanTrash: CanManage && !Item.TrashedAt.HasValue,
        CanShowInfo: true,
        CanZoom: Item.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase),
        CanPlay: Item.MimeType.StartsWith("video/", StringComparison.OrdinalIgnoreCase),
        CanSlideshow: HasNext);
    private static string FileRole(string role) => role.Replace('_', ' ').ToUpperInvariant();
    private bool TryCoordinates(out double latitude, out double longitude)
    {
        var hasLatitude = double.TryParse(_latitude, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out latitude);
        var hasLongitude = double.TryParse(_longitude, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out longitude);
        return hasLatitude && hasLongitude;
    }
    private static string BuildMapUrl(double? latitude, double? longitude)
    {
        if (!latitude.HasValue || !longitude.HasValue) return string.Empty;
        var lat = latitude.Value; var lon = longitude.Value; const double span = .025;
        var c = System.Globalization.CultureInfo.InvariantCulture;
        return $"https://www.openstreetmap.org/export/embed.html?bbox={(lon-span).ToString(c)}%2C{(lat-span).ToString(c)}%2C{(lon+span).ToString(c)}%2C{(lat+span).ToString(c)}&layer=mapnik&marker={lat.ToString(c)}%2C{lon.ToString(c)}";
    }
    private static string FormatDuration(double seconds) => TimeSpan.FromSeconds(seconds).TotalHours >= 1 ? TimeSpan.FromSeconds(seconds).ToString(@"h\:mm\:ss") : TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");
    private static string FormatBytes(long bytes) { string[] units = ["B", "KB", "MB", "GB", "TB"]; var value = (double)bytes; var unit = 0; while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; } return $"{value:0.#} {units[unit]}"; }
}
