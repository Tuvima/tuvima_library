@using MediaEngine.Contracts.LocalAssets
@namespace MediaEngine.Web.Components.Pages
<section class="view-selection-toolbar" role="toolbar" aria-label="Selected photo actions">
    <header><strong>@Count selected</strong><AppNativeButton Type="button" Class="view-selection-toolbar__close" AriaLabel="Clear photo selection" OnClick="@(_ => OnClear.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.Close" /></AppNativeButton></header>
    <div class="view-selection-toolbar__actions">
        <label class="view-selection-toolbar__gallery"><MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary" /><AppNativeSelect Value="@string.Empty" OnChange="GalleryChanged" aria-label="Add selected items to Gallery"><option value="">Add to Gallery</option>@foreach (var gallery in ManualGalleries) { <option value="@gallery.Id">@gallery.Name</option> }</AppNativeSelect></label>
        <span class="view-selection-toolbar__divider"></span>
        <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnFavorite.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.FavoriteBorder" />Favorite</AppNativeButton>
        @if (ShowRestore) { <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnRestore.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.Restore" />Restore</AppNativeButton> } else { <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnArchive.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" />Archive</AppNativeButton> }
        @if (ShowTrash) { <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnTrash.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" />Trash</AppNativeButton> }
        <AppNativeButton Type="button" Class="view-selection-toolbar__action" OnClick="@(_ => OnClear.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.Close" />Clear</AppNativeButton>
    </div>
</section>
@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public IReadOnlyList<ViewGalleryDto> ManualGalleries { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnFavorite { get; set; }
    [Parameter] public bool ShowRestore { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public bool ShowTrash { get; set; } = true;
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnTrash { get; set; }
    [Parameter] public EventCallback<Guid> OnAddToGallery { get; set; }
    private Task GalleryChanged(ChangeEventArgs args) => Guid.TryParse(args.Value?.ToString(), out var id) ? OnAddToGallery.InvokeAsync(id) : Task.CompletedTask;
}
