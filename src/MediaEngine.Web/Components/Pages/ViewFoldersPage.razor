@page "/view/folders"
@using MediaEngine.Contracts.LocalAssets
@using MediaEngine.Domain.PersonalMedia
@inject IEngineApiClient ApiClient
@inject ViewWorkspaceService Workspace
@inject UIOrchestratorService Orchestrator
@inject ViewMediaGrantService MediaGrants
@inject NavigationManager Navigation
@implements IDisposable
@namespace MediaEngine.Web.Components.Pages

<PageTitle>Folders - Tuvima</PageTitle>
<ViewSectionShell>
    <div class="view-folders-page">
        <header class="view-folders-header">
            <div><span>View</span><h1>Folders</h1><p>Browse files by their real source and folder structure.</p></div>
            @if (Workspace.Scopes is not null)
            {
                <label><span>Scope</span><AppNativeSelect Value="@SelectedScopeValue" OnChange="ScopeChangedAsync" aria-label="Authorized folder scope">@foreach (var scope in Workspace.Scopes.AvailableScopes) { <option value="@ScopeValue(scope.Kind, scope.ProfileId)">@scope.Label</option> }</AppNativeSelect></label>
            }
        </header>

        @if (_loading) { <AppPageState Kind="AppPageStateKind.Loading" Title="Loading folders" Message="Reading the indexed folder structure." /> }
        else if (_page is null) { <AppErrorState Title="Folders could not be loaded" Message="The Engine did not return the authorized folder view." Retry="LoadAsync" /> }
        else
        {
            @if (_page.SourceId is null)
            {
                @if (_page.PinnedFolders.Count > 0)
                {
                    <section class="view-folder-pins" aria-labelledby="pinned-folders-heading">
                        <h2 id="pinned-folders-heading">Pinned folders</h2>
                        <div>
                            @foreach (var pin in _page.PinnedFolders)
                            {
                                <AppNativeButton Type="button" Class="view-folder-pin" OnClick="@(_ => OpenPinned(pin))"><MudIcon Icon="@Icons.Material.Outlined.PushPin" /><span><strong>@pin.Label</strong><small>@PinnedLocation(pin)</small></span></AppNativeButton>
                            }
                        </div>
                    </section>
                }
                <section class="view-folder-sources" aria-label="View folder sources">
                    @foreach (var source in _page.Sources)
                    {
                        <AppNativeButton Type="button" Class="view-folder-source" OnClick="@(_ => OpenSource(source.SourceId))">
                            <span class="view-folder-source__icon"><MudIcon Icon="@Icons.Material.Outlined.Folder" /></span>
                            <span><strong>@source.Name</strong><small>@source.OwnerName · @(source.StorageMode == "linked" ? "Linked — outside Shared" : "Managed")</small><em>@source.ItemCount items · @(source.IncludeInTimeline ? "Shown in Timeline" : "Folders only")</em></span>
                            <AppStatusBadge Text="@(source.Available ? "Available" : "Offline")" Tone="@(source.Available ? AppUiTone.Success : AppUiTone.Warning)" />
                        </AppNativeButton>
                    }
                </section>
                @if (_page.Sources.Count == 0) { <AppPageState Kind="AppPageStateKind.Empty" Title="No folder sources" Message="An administrator can add a source from Libraries > View." /> }
            }
            else
            {
                <nav class="view-folder-breadcrumbs" aria-label="Folder breadcrumb">
                    <AppNativeButton Type="button" OnClick="@(_ => OpenRoot())">Folders</AppNativeButton>
                    @foreach (var crumb in _page.Breadcrumbs)
                    {
                        <span>/</span><AppNativeButton Type="button" OnClick="@(_ => OpenFolder(crumb.RelativePath))">@crumb.Label</AppNativeButton>
                    }
                </nav>
                <section class="view-folder-tools" aria-label="Folder controls">
                    <label><MudIcon Icon="@Icons.Material.Outlined.Search" /><AppNativeInput Type="search" Value="@_search" ValueChanged="SearchChanged" Placeholder="Search this source" AriaLabel="Search this folder source" /></label>
                    <AppSwitchRow Label="Include subfolders" Value="@_recursive" ValueChanged="RecursiveChanged" />
                    @if (!IsSharedSource)
                    {
                        <AppButton Label="@(_page.Pinned ? "Unpin folder" : "Pin folder")" StartIcon="@Icons.Material.Outlined.PushPin" ButtonStyle="AppButtonStyle.Text" Size="AppControlSize.Compact" OnClick="TogglePinAsync" />
                    }
                    @if (CanSetTimelinePolicy)
                    {
                        <label class="view-folder-timeline-policy"><span>Photos timeline</span><AppNativeSelect Value="@TimelinePolicyValue" OnChange="TimelinePolicyChangedAsync" aria-label="Folder Timeline policy"><option value="inherit">Inherit (@(_page.EffectiveIncludeInTimeline ? "shown" : "folders only"))</option><option value="include">Show this branch</option><option value="exclude">Folders only</option></AppNativeSelect></label>
                    }
                </section>
                @if (_page.Folders.Count > 0)
                {
                    <section class="view-folder-nodes" aria-label="Subfolders">
                        @foreach (var folder in _page.Folders)
                        {
                            <AppNativeButton Type="button" Class="view-folder-node" OnClick="@(_ => OpenFolder(folder.RelativePath))"><MudIcon Icon="@Icons.Material.Outlined.Folder" /><span><strong>@folder.Name</strong><small>@folder.ItemCount indexed files</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></AppNativeButton>
                        }
                    </section>
                }
                @if (_page.Items.Count > 0)
                {
                    <section class="view-folder-items" aria-label="Files">
                        @foreach (var item in _page.Items)
                        {
                            <article><img src="@ThumbnailUrl(item)" alt="" loading="lazy" /><span><strong>@(item.Title ?? item.FileName)</strong><small>@item.FileName · @item.MediaKind</small></span></article>
                        }
                    </section>
                    @if (_page.HasMore) { <AppButton Label="Load more" ButtonStyle="AppButtonStyle.Outlined" Disabled="@_loadingMore" OnClick="LoadMoreAsync" /> }
                }
                else if (_page.Folders.Count == 0) { <AppPageState Kind="AppPageStateKind.Empty" Title="This folder is empty" Message="Indexed media in this folder will appear here." /> }
            }
        }
    </div>
</ViewSectionShell>

@code {
    [SupplyParameterFromQuery(Name = "source")] public Guid? SourceId { get; set; }
    [SupplyParameterFromQuery(Name = "path")] public string? RelativePath { get; set; }
    private ViewFolderPageDto? _page;
    private Guid? _profileId;
    private bool _loading = true, _loadingMore, _recursive;
    private string _search = string.Empty;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        _profileId = (await Orchestrator.GetActiveProfileAsync())?.Id;
        await Workspace.InitializeAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loading && (_page?.SourceId != SourceId || !string.Equals(_page?.RelativePath, RelativePath ?? string.Empty, StringComparison.OrdinalIgnoreCase)))
            await LoadAsync();
    }

    private ViewFolderQueryOptions Query(int offset = 0) => new(Workspace.ScopeKind, Workspace.ScopeProfileId,
        SourceId, RelativePath, _recursive, _search, offset, 100);
    private async Task LoadAsync() { _loading = true; _page = await ApiClient.GetViewFoldersAsync(Query()); _loading = false; }
    private async Task LoadMoreAsync()
    {
        if (_page is null) return;
        _loadingMore = true;
        var next = await ApiClient.GetViewFoldersAsync(Query(_page.Offset + _page.Items.Count));
        if (next is not null) _page = next with { Items = [.. _page.Items, .. next.Items] };
        _loadingMore = false;
    }
    private void OpenRoot() => Navigation.NavigateTo("/view/folders");
    private void OpenSource(Guid id) => Navigation.NavigateTo($"/view/folders?source={id:D}");
    private void OpenFolder(string path) => Navigation.NavigateTo($"/view/folders?source={SourceId:D}&path={Uri.EscapeDataString(path)}");
    private void OpenPinned(ViewFolderPinDto pin) => Navigation.NavigateTo($"/view/folders?source={pin.SourceId:D}&path={Uri.EscapeDataString(pin.RelativePath)}");
    private static string PinnedLocation(ViewFolderPinDto pin) => string.IsNullOrEmpty(pin.RelativePath)
        ? pin.SourceName : $"{pin.SourceName} / {pin.RelativePath}";
    private string RequestScope => Workspace.ScopeKind.ToString().ToLowerInvariant();
    private static readonly Guid SharedLibrarySourceId = Guid.Parse("ffffffff-ffff-ffff-ffff-fffffffffff1");
    private bool IsSharedSource => SourceId == SharedLibrarySourceId;
    private ViewFolderSourceDto? CurrentSource => _page?.Sources.FirstOrDefault(source => source.SourceId == SourceId);
    private bool CanSetTimelinePolicy => !IsSharedSource && CurrentSource?.OwnerProfileId == _profileId;
    private string TimelinePolicyValue => _page?.IncludeInTimelineOverride switch { true => "include", false => "exclude", _ => "inherit" };
    private async Task TogglePinAsync()
    {
        if (_page?.SourceId is not { } sourceId) return;
        var request = new ViewFolderPinRequest(sourceId, _page.RelativePath, !_page.Pinned,
            RequestScope, Workspace.ScopeProfileId);
        if (await ApiClient.SetViewFolderPinAsync(request)) await LoadAsync();
    }
    private async Task TimelinePolicyChangedAsync(ChangeEventArgs args)
    {
        if (_page?.SourceId is not { } sourceId) return;
        bool? value = args.Value?.ToString() switch { "include" => true, "exclude" => false, _ => null };
        var request = new ViewFolderTimelinePolicyRequest(sourceId, _page.RelativePath, value,
            RequestScope, Workspace.ScopeProfileId);
        if (await ApiClient.SetViewFolderTimelinePolicyAsync(request)) await LoadAsync();
    }
    private async Task RecursiveChanged(bool value) { _recursive = value; await LoadAsync(); }
    private async Task SearchChanged(object? value)
    {
        _search = value?.ToString() ?? string.Empty;
        _searchCts?.Cancel(); _searchCts?.Dispose();
        var pending = _searchCts = new CancellationTokenSource();
        try { await Task.Delay(250, pending.Token); await LoadAsync(); } catch (OperationCanceledException) { }
    }
    private async Task ScopeChangedAsync(ChangeEventArgs args)
    {
        var parts = args.Value?.ToString()?.Split(':', 2) ?? [];
        if (parts.Length == 0 || !Enum.TryParse<ViewScopeKind>(parts[0], true, out var kind)) return;
        Guid? profile = parts.Length == 2 && Guid.TryParse(parts[1], out var parsed) ? parsed : null;
        if (await Workspace.SelectScopeAsync(kind, profile)) OpenRoot();
    }
    private string SelectedScopeValue => ScopeValue(Workspace.ScopeKind, Workspace.ScopeProfileId);
    private static string ScopeValue(ViewScopeKind kind, Guid? profile) => $"{kind}:{(kind == ViewScopeKind.Profile ? profile?.ToString("D") : null)}";
    private string ThumbnailUrl(LocalAssetDto item)
    {
        if (!_profileId.HasValue) return string.Empty;
        return $"/view-media/{MediaGrants.Create(_profileId.Value, item.LibraryId, item.Id, ViewMediaResourceKind.Thumbnail).Value}";
    }
    public void Dispose() { _searchCts?.Cancel(); _searchCts?.Dispose(); }
}
