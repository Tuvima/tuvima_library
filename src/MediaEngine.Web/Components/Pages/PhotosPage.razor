@page "/photos"
@using System.Globalization
@using MediaEngine.Contracts.Photos
@inject IEngineApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@namespace MediaEngine.Web.Components.Pages

<div class="photos-page">
    <header class="photos-header">
        <div class="photos-header__identity">
            <span class="photos-header__icon"><MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary" /></span>
            <div>
                <MudText Typo="Typo.h3" Class="photos-header__title">Photos</MudText>
                <MudText Typo="Typo.body2">Your private, local timeline. Originals stay in their folders.</MudText>
            </div>
        </div>
        <div class="photos-header__actions">
            <AppButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                       OnClick="ToggleAlbumCreator">New album</AppButton>
            <AppButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Sync"
                       Disabled="@_scanning" OnClick="ScanAsync">
                @(_scanning ? "Indexing..." : "Scan libraries")
            </AppButton>
        </div>
    </header>

    <div class="photos-toolbar">
        <div class="photos-tabs" role="tablist" aria-label="Photo views">
            <AppNativeButton Type="button" Class="@TabClass("timeline")"
                             AriaLabel="Photos" OnClick="@(_ => SetViewAsync("timeline"))">
                <MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary" /><span>Photos</span>
            </AppNativeButton>
            <AppNativeButton Type="button" Class="@TabClass("favorites")"
                             AriaLabel="Favorites" OnClick="@(_ => SetViewAsync("favorites"))">
                <MudIcon Icon="@Icons.Material.Outlined.FavoriteBorder" /><span>Favorites</span>
            </AppNativeButton>
            <AppNativeButton Type="button" Class="@TabClass("albums")"
                             AriaLabel="Albums" OnClick="@(_ => SetViewAsync("albums"))">
                <MudIcon Icon="@Icons.Material.Outlined.PhotoAlbum" /><span>Albums</span>
            </AppNativeButton>
            <AppNativeButton Type="button" Class="@TabClass("hidden")"
                             AriaLabel="Hidden" OnClick="@(_ => SetViewAsync("hidden"))">
                <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" /><span>Hidden</span>
            </AppNativeButton>
        </div>
        <label class="photos-search">
            <MudIcon Icon="@Icons.Material.Outlined.Search" />
            <AppNativeInput Type="search" Value="@_search" ValueChanged="SearchChanged"
                            Placeholder="Search file names" AriaLabel="Search photos" />
        </label>
        <div class="photos-toolbar__summary">
            @if (_selected.Count > 0)
            {
                <strong>@_selected.Count selected</strong>
                @if (_albums.Count > 0)
                {
                    <AppNativeSelect Value="@_targetAlbumId" ValueChanged="TargetAlbumChanged" AriaLabel="Choose album">
                        <option value="">Choose album</option>
                        @foreach (var album in _albums)
                        {
                            <option value="@album.Id">@album.Name</option>
                        }
                    </AppNativeSelect>
                    <AppButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(!_targetAlbumId.HasValue)" OnClick="AddSelectionToAlbumAsync">Add</AppButton>
                }
                <AppButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" OnClick="ClearSelection">Clear</AppButton>
            }
            else if (_page is not null)
            {
                <span>@CountLabel(_page.Total, "photo")</span>
            }
        </div>
    </div>

    @if (_showAlbumCreator)
    {
        <section class="photos-album-creator" aria-label="Create album">
            <AppTextField T="string" @bind-Value="_newAlbumName" Label="Album name" Placeholder="Summer road trip" />
            <AppButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(string.IsNullOrWhiteSpace(_newAlbumName))"
                       OnClick="CreateAlbumAsync">Create album</AppButton>
            <AppButton Variant="Variant.Text" Color="Color.Default" OnClick="ToggleAlbumCreator">Cancel</AppButton>
        </section>
    }

    @if (_albums.Count > 0 && _activeView is "albums")
    {
        <section class="photos-albums" aria-label="Photo albums">
            @foreach (var album in _albums)
            {
                <AppNativeButton Type="button" Class="@AlbumClass(album.Id)"
                                 AriaLabel="@($"Open {album.Name} album")" OnClick="@(_ => OpenAlbumAsync(album.Id))">
                    <span class="photos-album__cover">
                        @if (!string.IsNullOrWhiteSpace(album.CoverThumbnailUrl))
                        {
                            <img src="@PhotoUrl(album.CoverThumbnailUrl)" alt="" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.PhotoAlbum" />
                        }
                    </span>
                    <span class="photos-album__copy">
                        <strong>@album.Name</strong>
                        <small>@CountLabel(album.ItemCount, "item")</small>
                    </span>
                </AppNativeButton>
            }
        </section>
    }

    @if (_loading)
    {
        <div class="photos-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>Loading your timeline...</span></div>
    }
    else if (_page is null)
    {
        <AppAlert Severity="Severity.Warning" Variant="Variant.Outlined">The photo library could not be loaded from the Engine.</AppAlert>
    }
    else if (_page.Items.Count == 0)
    {
        <section class="photos-empty">
            <span class="photos-empty__icon"><MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate" /></span>
            <MudText Typo="Typo.h5">@EmptyTitle</MudText>
            <MudText Typo="Typo.body1">@EmptyMessage</MudText>
            <div class="photos-empty__actions">
                <AppButton Href="/settings/libraries" Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Outlined.FolderOpen">Configure folders</AppButton>
                <AppButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Sync"
                           Disabled="@_scanning" OnClick="ScanAsync">Scan libraries</AppButton>
            </div>
        </section>
    }
    else
    {
        <main class="photos-timeline">
            @foreach (var month in MonthGroups)
            {
                <section class="photos-month" aria-labelledby="@MonthId(month.Key)">
                    <div class="photos-month__heading">
                        <h2 id="@MonthId(month.Key)">@month.Key.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</h2>
                        <span>@CountLabel(month.Count(), "item")</span>
                    </div>
                    <div class="photos-grid">
                        @foreach (var photo in month)
                        {
                            <article class="photo-tile @(_selected.Contains(photo.Id) ? "is-selected" : null)">
                                <AppNativeButton Type="button" Class="photo-tile__surface"
                                                 AriaLabel="@($"Open {photo.FileName}")"
                                                 OnClick="@(_ => OpenPhoto(photo))">
                                    <img src="@PhotoUrl(photo.ThumbnailUrl)" alt="@photo.FileName" loading="lazy" />
                                </AppNativeButton>
                                <AppNativeButton Type="button" Class="photo-tile__select"
                                                 AriaLabel="@($"Select {photo.FileName}")"
                                                 OnClick="@(_ => ToggleSelection(photo.Id))">
                                    <MudIcon Icon="@(_selected.Contains(photo.Id) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)" />
                                </AppNativeButton>
                                @if (photo.Favorite)
                                {
                                    <span class="photo-tile__favorite" aria-label="Favorite"><MudIcon Icon="@Icons.Material.Filled.Favorite" /></span>
                                }
                                @if (photo.DuplicateCount > 1)
                                {
                                    <span class="photo-tile__duplicates" title="Identical files found"><MudIcon Icon="@Icons.Material.Outlined.ContentCopy" /> @photo.DuplicateCount</span>
                                }
                            </article>
                        }
                    </div>
                </section>
            }
        </main>

        @if (_page.HasMore)
        {
            <div class="photos-load-more">
                <AppButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@_loadingMore" OnClick="LoadMoreAsync">
                    @(_loadingMore ? "Loading..." : "Load more")
                </AppButton>
            </div>
        }
    }
</div>

@if (_activePhoto is not null)
{
    <div class="photo-viewer" role="dialog" aria-modal="true" aria-label="Photo viewer" @onclick="ClosePhoto">
        <header class="photo-viewer__bar" @onclick:stopPropagation="true">
            <div>
                <strong>@_activePhoto.FileName</strong>
                <small>@_activePhoto.CapturedAt.ToLocalTime().ToString("MMMM d, yyyy · h:mm tt", CultureInfo.CurrentCulture)</small>
                @if (!string.IsNullOrWhiteSpace(PhotoTechnicalSummary(_activePhoto)))
                {
                    <small>@PhotoTechnicalSummary(_activePhoto)</small>
                }
            </div>
            <div class="photo-viewer__actions">
                <AppNativeButton Type="button" Class="photo-viewer__action" AriaLabel="Toggle favorite" OnClick="@(_ => ToggleFavoriteAsync(_activePhoto))">
                    <MudIcon Icon="@(_activePhoto.Favorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)" />
                </AppNativeButton>
                <a class="photo-viewer__action" href="@PhotoUrl(_activePhoto.ContentUrl)" target="_blank" aria-label="Open original">
                    <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" />
                </a>
                <AppNativeButton Type="button" Class="photo-viewer__action" AriaLabel="@(_activePhoto.Hidden ? "Restore photo" : "Hide photo")" OnClick="@(_ => ToggleHiddenAsync(_activePhoto))">
                    <MudIcon Icon="@(_activePhoto.Hidden ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff)" />
                </AppNativeButton>
                <AppNativeButton Type="button" Class="photo-viewer__action" AriaLabel="Close photo" OnClick="@(_ => ClosePhoto())">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" />
                </AppNativeButton>
            </div>
        </header>
        <img class="photo-viewer__image" src="@PhotoUrl(_activePhoto.ContentUrl)" alt="@_activePhoto.FileName" @onclick:stopPropagation="true" />
    </div>
}

@code {
    private PhotoPageDto? _page;
    private IReadOnlyList<PhotoAlbumDto> _albums = [];
    private readonly HashSet<Guid> _selected = [];
    private CancellationTokenSource? _searchCts;
    private PhotoAssetDto? _activePhoto;
    private Guid? _activeAlbumId;
    private Guid? _targetAlbumId;
    private string _activeView = "timeline";
    private string _search = string.Empty;
    private string _newAlbumName = string.Empty;
    private bool _loading = true;
    private bool _loadingMore;
    private bool _scanning;
    private bool _showAlbumCreator;

    private IEnumerable<IGrouping<DateTimeOffset, PhotoAssetDto>> MonthGroups =>
        (_page?.Items ?? []).GroupBy(photo => new DateTimeOffset(
            photo.CapturedAt.Year, photo.CapturedAt.Month, 1, 0, 0, 0, photo.CapturedAt.Offset));

    private string EmptyTitle => _activeView switch
    {
        "favorites" => "No favorites yet",
        "albums" when _activeAlbumId.HasValue => "This album is empty",
        "hidden" => "No hidden photos",
        _ => "Bring your photos together",
    };

    private string EmptyMessage => _activeView switch
    {
        "favorites" => "Favorite photos from the timeline and they will collect here.",
        "albums" when _activeAlbumId.HasValue => "Select photos from the timeline to add them to this album.",
        "hidden" => "Photos you hide from the main timeline will collect here.",
        _ => "Add a Photos library folder, then scan to build a private timeline without cloud uploads.",
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadAlbumsAsync());
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _page = await ApiClient.GetPhotosAsync(
            search: _search,
            favorites: _activeView == "favorites",
            includeHidden: _activeView == "hidden",
            albumId: _activeView == "albums" ? _activeAlbumId : null);
        _loading = false;
    }

    private async Task LoadAlbumsAsync() => _albums = await ApiClient.GetPhotoAlbumsAsync();

    private async Task SetViewAsync(string view)
    {
        _activeView = view;
        if (view != "albums") _activeAlbumId = null;
        ClearSelection();
        await LoadAsync();
    }

    private async Task OpenAlbumAsync(Guid id)
    {
        _activeAlbumId = id;
        await LoadAsync();
    }

    private async Task SearchChanged(object? value)
    {
        _search = value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, _searchCts.Token);
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task ScanAsync()
    {
        _scanning = true;
        var result = await ApiClient.ScanPhotosAsync();
        _scanning = false;
        if (result is null)
        {
            Snackbar.Add("Photo scan could not be started.", Severity.Error);
            return;
        }
        Snackbar.Add(
            $"Indexed {CountLabel(result.PhotosAdded, "new photo")}; found {CountLabel(result.DuplicatesFound, "duplicate")}.",
            Severity.Success);
        await LoadAsync();
    }

    private async Task LoadMoreAsync()
    {
        if (_page is null) return;
        _loadingMore = true;
        var next = await ApiClient.GetPhotosAsync(
            _page.Items.Count, _page.Limit, _search, _activeView == "favorites",
            includeHidden: _activeView == "hidden",
            albumId: _activeView == "albums" ? _activeAlbumId : null);
        if (next is not null)
            _page = next with { Items = _page.Items.Concat(next.Items).ToList() };
        _loadingMore = false;
    }

    private void OpenPhoto(PhotoAssetDto photo) => _activePhoto = photo;
    private void ClosePhoto() => _activePhoto = null;
    private void ToggleSelection(Guid id) { if (!_selected.Add(id)) _selected.Remove(id); }
    private void ClearSelection() { _selected.Clear(); _targetAlbumId = null; }
    private void ToggleAlbumCreator() => _showAlbumCreator = !_showAlbumCreator;

    private Task TargetAlbumChanged(object? value)
    {
        _targetAlbumId = Guid.TryParse(value?.ToString(), out var id) ? id : null;
        return Task.CompletedTask;
    }

    private async Task CreateAlbumAsync()
    {
        var album = await ApiClient.CreatePhotoAlbumAsync(_newAlbumName);
        if (album is null) { Snackbar.Add("Album could not be created.", Severity.Error); return; }
        _newAlbumName = string.Empty;
        _showAlbumCreator = false;
        await LoadAlbumsAsync();
        Snackbar.Add($"Created {album.Name}.", Severity.Success);
    }

    private async Task AddSelectionToAlbumAsync()
    {
        if (!_targetAlbumId.HasValue || _selected.Count == 0) return;
        var added = await ApiClient.AddPhotosToAlbumAsync(_targetAlbumId.Value, _selected.ToList());
        Snackbar.Add($"Added {CountLabel(added, "photo")} to the album.", added > 0 ? Severity.Success : Severity.Info);
        ClearSelection();
        await LoadAlbumsAsync();
    }

    private async Task ToggleFavoriteAsync(PhotoAssetDto photo)
    {
        var value = !photo.Favorite;
        if (!await ApiClient.SetPhotoFavoriteAsync(photo.Id, value)) return;
        var updated = photo with { Favorite = value };
        _activePhoto = updated;
        if (_page is not null)
            _page = _page with { Items = _page.Items.Select(item => item.Id == photo.Id ? updated : item).ToList() };
    }

    private async Task ToggleHiddenAsync(PhotoAssetDto photo)
    {
        var hidden = !photo.Hidden;
        if (!await ApiClient.SetPhotoHiddenAsync(photo.Id, hidden)) return;
        _activePhoto = null;
        if (_page is not null)
            _page = _page with
            {
                Items = _page.Items.Where(item => item.Id != photo.Id).ToList(),
                Total = Math.Max(0, _page.Total - 1),
            };
        Snackbar.Add(hidden ? "Photo hidden from the main timeline." : "Photo restored to the main timeline.", Severity.Success);
    }

    private string PhotoUrl(string path) => ApiClient.ToAbsoluteEngineUrl(path);
    private static string CountLabel(int count, string singular) =>
        $"{count.ToString("N0", CultureInfo.CurrentCulture)} {(count == 1 ? singular : singular + "s")}";

    private static string PhotoTechnicalSummary(PhotoAssetDto photo)
    {
        var parts = new List<string>();
        if (photo.Width.HasValue && photo.Height.HasValue)
            parts.Add($"{photo.Width} × {photo.Height}");
        var camera = string.Join(' ', new[] { photo.CameraMake, photo.CameraModel }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
        if (!string.IsNullOrWhiteSpace(camera)) parts.Add(camera);
        if (photo.Latitude.HasValue && photo.Longitude.HasValue) parts.Add("Location available");
        return string.Join(" · ", parts);
    }
    private string TabClass(string view) => $"photos-tab{(_activeView == view ? " is-active" : string.Empty)}";
    private string AlbumClass(Guid id) => $"photos-album{(_activeAlbumId == id ? " is-active" : string.Empty)}";
    private static string MonthId(DateTimeOffset month) => $"photos-{month:yyyy-MM}";
}
