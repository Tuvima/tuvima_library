@page "/operations/ingestion"
@page "/operations/recently-added"
@page "/operations/needs-review"
@page "/operations/activity"
@page "/operations/timeline"
@rendermode InteractiveServer
@namespace MediaEngine.Web.Components.Pages
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        var current = Nav.ToAbsoluteUri(Nav.Uri);
        var target = current.AbsolutePath.ToLowerInvariant() switch
        {
            "/operations/ingestion" => "/settings/ingestion",
            "/operations/needs-review" => "/settings/recently-added",
            _ => "/settings/recently-added",
        };

        var query = current.Query;
        if (current.AbsolutePath.Equals("/operations/needs-review", StringComparison.OrdinalIgnoreCase)
            && !query.Contains("review=", StringComparison.OrdinalIgnoreCase))
        {
            query = string.IsNullOrWhiteSpace(query)
                ? "?review=expanded"
                : $"{query}&review=expanded";
        }

        Nav.NavigateTo($"{target}{query}", replace: true);
    }
}
