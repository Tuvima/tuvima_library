@page "/view/places"
@namespace MediaEngine.Web.Components.Pages

<PageTitle>Places - Tuvima</PageTitle>

<ViewSectionShell>
    <div class="view-feature-page">
        <header class="view-feature-page__header">
            <div>
                <span>View</span>
                <h1>Places</h1>
                <p>Explore personal photos by the location metadata already stored in their files.</p>
            </div>
        </header>

        <AppPageState Kind="AppPageStateKind.Empty"
                      Title="No places to show yet"
                      Message="Location groups will appear here after the Places query and privacy-safe map capability are connected." />
    </div>
</ViewSectionShell>
