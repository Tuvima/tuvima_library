@namespace MediaEngine.Web.Components.Settings
@using System.Globalization
@using MediaEngine.Contracts.System
@using MediaEngine.Web.Components.Library
@using MediaEngine.Web.Models.ViewDTOs
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject UniverseStateContainer StateContainer
@inject IJSRuntime JS
@implements IDisposable

<div class="tl-page admin-overview-page">
    @if (_reminderLoaded && !_optionalSetupReminderDismissed)
    {
        <section class="admin-optional-setup" aria-label="Optional setup reminder">
            <MudIcon Icon="@Icons.Material.Outlined.TipsAndUpdates" aria-hidden="true" />
            <div><strong>Continue optional setup when you are ready</strong><p>Local AI starts disabled, and remote access stays home-only. Neither is required to use your library.</p><div class="admin-card-actions"><AppButton Href="/settings/ai" Label="Set up Local AI" Size="AppControlSize.Compact" /><AppButton Href="/settings/network/remote" Label="Set up remote access" Size="AppControlSize.Compact" /></div></div>
            <AppIconButton Icon="@Icons.Material.Outlined.Close" Tooltip="Dismiss reminder" AriaLabel="Dismiss optional setup reminder" OnClick="DismissOptionalSetupReminderAsync" />
        </section>
    }
    <div class="admin-overview-toolbar">
        <div>
            <MudText Typo="Typo.caption" Class="admin-overview-muted">Last updated @FormatClock(_lastUpdated)</MudText>
        </div>
        <div class="admin-overview-actions">
            <AppButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       Disabled="@_loading"
                       OnClick="LoadAsync">
                Refresh
            </AppButton>
            <AppButton Variant="Variant.Filled"
                       Size="Size.Small"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.PlayArrow"
                       Disabled="@(_loading || _startingIngestion || _currentRun.IsActive)"
                       OnClick="StartIngestionAsync">
                New ingestion
            </AppButton>
        </div>
    </div>

    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading"
                      Title="Loading system overview"
                      Message="Checking library, readiness, backup, playback, and activity state." />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@Icons.Material.Outlined.CloudOff"
                      Title="System overview is unavailable"
                      Message="@_error" />
    }
    else
    {
    <AppPanel Elevation="0" Class="tl-card admin-library-summary">
        <div class="admin-overview-card__header">
            <div>
                <MudText Typo="Typo.h6">Library summary</MudText>
                <MudText Typo="Typo.body2" Class="admin-overview-muted">@DisplayFormat.FormatCount(_libraryTotal) items across your catalogued media.</MudText>
            </div>
            <AppButton Href="/settings/libraries" Label="Manage libraries" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ChevronRight" />
        </div>

            <div class="admin-library-breakdown" aria-label="Library media type breakdown">
                @foreach (var media in MediaBreakdown)
                {
                    <div class="admin-library-media">
                        <span class="admin-library-media__label"><MudIcon Icon="@media.Icon" aria-hidden="true" />@media.Label</span>
                        <span class="admin-library-media__count">@DisplayFormat.FormatCount(media.Count)</span>
                        <span class="admin-library-media__percent">@FormatPercent(media.Percent)</span>
                    </div>
                }
            </div>

            <div class="admin-composition-bar" aria-label="Library composition by media type">
                @if (MediaBreakdown.Any(item => item.Count > 0))
                {
                    @foreach (var media in MediaBreakdown.Where(item => item.Count > 0))
                    {
                        <AppCssElement Tag="span" Class="admin-composition-bar__segment"
                              title="@($"{media.Label}: {media.Percent:0.#}%")"
                              Css="@SegmentStyle(media)"></AppCssElement>
                    }
                }
                else
                {
                    <span class="admin-composition-bar__empty"></span>
                }
            </div>

    </AppPanel>

    @if (_pendingReviewCount > 0 || HasSystemExceptions)
    {
        <div class="admin-overview-primary-grid">
            @if (_pendingReviewCount > 0)
            {
                <AppPanel Elevation="0" Class="tl-card admin-overview-card admin-overview-card--attention">
                    <div class="admin-overview-card__header"><MudText Typo="Typo.h6">Needs attention</MudText></div>
                <div class="admin-attention-copy">
                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
                    <div><strong>@AttentionTitle</strong><p>These items could not be identified confidently.</p></div>
                </div>
                    <div class="admin-card-actions">
                        <AppButton Href="/settings/review"
                                   Label="Review items"
                                   ButtonStyle="AppButtonStyle.Filled"
                                   Tone="AppUiTone.Primary" />
                    </div>
                </AppPanel>
            }

            @if (HasSystemExceptions)
            {
                <AppPanel Elevation="0" Class="tl-card admin-overview-card">
                    <div class="admin-overview-card__header">
                        <MudText Typo="Typo.h6">System exceptions</MudText>
                    </div>

                    <div class="admin-system-status" role="list" aria-label="System exceptions">
                    @foreach (var check in ReadinessIssues)
                    {
                        <a class="admin-system-status__row" role="listitem" href="@ReadinessRoute(check.Category)">
                            <span class="admin-system-status__icon"><MudIcon Icon="@ReadinessIcon(check.Category)" /></span>
                            <span><strong>@ReadinessLabel(check.Name)</strong><small>@check.Description</small></span>
                            <AppStatusBadge Text="@ReadinessStatus(check.Status)" Tone="@ReadinessTone(check.Status)" />
                        </a>
                    }
                    @if (_currentRun.Failed > 0)
                    {
                        <a class="admin-system-status__row" role="listitem" href="/settings/ingestion">
                            <span class="admin-system-status__icon"><MudIcon Icon="@Icons.Material.Outlined.SyncProblem" /></span>
                            <span><strong>Media processing</strong><small>@IngestionStatusDetail</small></span>
                            <AppStatusBadge Text="Needs attention" Tone="AppUiTone.Warning" />
                        </a>
                    }
                    @if (_backups.Count == 0)
                    {
                        <a class="admin-system-status__row" role="listitem" href="/settings/backup-recovery">
                            <span class="admin-system-status__icon"><MudIcon Icon="@Icons.Material.Outlined.Backup" /></span>
                            <span><strong>No recovery point</strong><small>Create a backup before significant configuration changes.</small></span>
                            <AppStatusBadge Text="Action needed" Tone="AppUiTone.Warning" />
                        </a>
                    }
                    </div>
                </AppPanel>
            }
        </div>
    }

    <AppPanel Elevation="0" Class="tl-card admin-overview-card admin-recent-activity">
        <div class="admin-overview-card__header">
            <MudText Typo="Typo.h6">Recent Activity</MudText>
            <AppButton Href="/settings/activity" Label="View activity" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ChevronRight" />
        </div>
        @if (_recentActivity.Count == 0)
        {
            <div class="admin-empty-state">
                <MudIcon Icon="@Icons.Material.Outlined.History" />
                <div>
                    <MudText Typo="Typo.subtitle2">No recent activity</MudText>
                    <MudText Typo="Typo.body2" Class="admin-overview-muted">Meaningful library and system updates will appear here.</MudText>
                </div>
            </div>
        }
        else
        {
            <div class="admin-activity-table" role="table" aria-label="Recent activity">
                <div class="admin-activity-table__head" role="row"><span>Activity</span><span>When</span></div>
                @foreach (var activity in _recentActivity.Take(5))
                {
                    <div class="admin-activity-table__row" role="row">
                        <span>@ActivityText(activity)</span>
                        <time datetime="@activity.OccurredAt">@FormatRelative(activity.OccurredAt)</time>
                    </div>
                }
            </div>
        }
    </AppPanel>
    }
</div>

@code {
    [Parameter] public int ReviewCount { get; set; }
    [Parameter] public string Subsection { get; set; } = "library";

    private bool _loading = true;
    private bool _startingIngestion;
    private bool _reminderLoaded;
    private bool _optionalSetupReminderDismissed;
    private string? _error;
    private DateTimeOffset? _lastUpdated;

    private LibraryOverviewDto? _overview;
    private IReadOnlyList<IngestionBatchResponse> _recentRuns = [];
    private List<ActivityEntryResponse> _recentActivity = [];
    private IReadOnlyList<BackupArchiveDto> _backups = [];
    private StartupReadinessResponse? _readiness;
    private OverviewRun _currentRun = OverviewRun.Empty;

    private int _pendingReviewCount;

    private string AttentionTitle =>
        $"{DisplayFormat.FormatCount(_pendingReviewCount)} item{(_pendingReviewCount == 1 ? "" : "s")} need review";

    private IReadOnlyList<StartupReadinessCheckResponse> ReadinessIssues =>
        _readiness?.Checks
            .Where(check => !string.Equals(check.Status, "ready", StringComparison.OrdinalIgnoreCase))
            .ToList() ?? [];

    private bool HasSystemExceptions => ReadinessIssues.Count > 0 || _currentRun.Failed > 0 || _backups.Count == 0;

    private string IngestionStatusDetail => _currentRun.IsActive
        ? $"{DisplayFormat.FormatCount(_currentRun.Processed)} of {DisplayFormat.FormatCount(_currentRun.Total)} files processed"
        : _currentRun.IdleDetail;

    private int _libraryTotal
    {
        get
        {
            if (_overview?.MediaTypeCounts.Count > 0)
            {
                return MediaBreakdown.Sum(item => item.Count);
            }

            return _overview?.TotalItems ?? 0;
        }
    }

    private IReadOnlyList<MediaBreakdownItem> MediaBreakdown
    {
        get
        {
            var counts = _overview?.MediaTypeCounts ?? [];
            var items = new[]
            {
                MediaItem("Books", counts, Icons.Material.Outlined.MenuBook),
                MediaItem("Audiobooks", counts, Icons.Material.Outlined.Headphones),
                MediaItem("Movies", counts, Icons.Material.Outlined.Movie),
                MediaItem("TV Episodes", counts, Icons.Material.Outlined.Tv),
                MediaItem("Music", counts, Icons.Material.Outlined.MusicNote),
                MediaItem("Comics", counts, Icons.Material.Outlined.AutoStories),
            };

            var total = items.Sum(item => item.Count);
            if (total <= 0)
            {
                return items;
            }

            return items
                .Select(item => item with { Percent = item.Count * 100d / total })
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        StateContainer.OnStateChanged += OnRealtimeStateChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _optionalSetupReminderDismissed = string.Equals(await JS.InvokeAsync<string?>("localStorage.getItem", "tuvima.optional-setup-reminder.dismissed.v1"), "true", StringComparison.Ordinal); }
        catch { _optionalSetupReminderDismissed = false; }
        _reminderLoaded = true;
        StateHasChanged();
    }

    private async Task DismissOptionalSetupReminderAsync()
    {
        _optionalSetupReminderDismissed = true;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "tuvima.optional-setup-reminder.dismissed.v1", "true"); }
        catch (JSException) { _optionalSetupReminderDismissed = true; }
    }

    public void Dispose()
    {
        StateContainer.OnStateChanged -= OnRealtimeStateChanged;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var overviewTask = ApiClient.GetLibraryOverviewAsync();
            var runsTask = Orchestrator.GetIngestionBatchesAsync(6);
            var activityTask = Orchestrator.GetRecentActivityAsync(25);
            var backupsTask = ApiClient.GetBackupsAsync();
            var readinessTask = ApiClient.GetStartupReadinessAsync();

            await Task.WhenAll(overviewTask, runsTask, activityTask, backupsTask, readinessTask);

            _overview = await overviewTask;
            _recentRuns = await runsTask;
            _recentActivity = await activityTask;
            _backups = await backupsTask;
            _readiness = await readinessTask;

            Recompute();
            _lastUpdated = DateTimeOffset.Now;
        }
        catch (Exception ex)
        {
            _error = $"Overview data could not load: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ReadinessLabel(string name) => name.Replace('_', ' ');

    private static string ReadinessStatus(string status) => status switch
    {
        "ready" => "Ready",
        "degraded" => "Degraded",
        _ => "Blocked",
    };

    private static AppUiTone ReadinessTone(string status) => status switch
    {
        "ready" => AppUiTone.Success,
        "degraded" => AppUiTone.Warning,
        _ => AppUiTone.Error,
    };

    private static string ReadinessIcon(string category) => category switch
    {
        "database" => Icons.Material.Outlined.Storage,
        "configuration" => Icons.Material.Outlined.Settings,
        "storage" => Icons.Material.Outlined.Folder,
        "models" => Icons.Material.Outlined.Memory,
        "providers" => Icons.Material.Outlined.Hub,
        "workers" => Icons.Material.Outlined.Engineering,
        _ => Icons.Material.Outlined.MonitorHeart,
    };

    private static string ReadinessRoute(string category) => category.ToLowerInvariant() switch
    {
        "models" => "/settings/ai/models",
        "providers" => "/settings/metadata/providers",
        "workers" => "/settings/ingestion",
        "storage" => "/settings/libraries",
        "configuration" => "/settings/libraries",
        "database" => "/settings/backup-recovery",
        _ => "/settings/system",
    };

    private async Task StartIngestionAsync()
    {
        _startingIngestion = true;
        try
        {
            await Orchestrator.TriggerRescanAsync();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"A new ingestion could not start: {ex.Message}";
        }
        finally
        {
            _startingIngestion = false;
        }
    }

    private void OnRealtimeStateChanged()
    {
        Recompute();
        InvokeAsync(StateHasChanged);
    }

    private void Recompute()
    {
        _pendingReviewCount = Math.Max(ReviewCount, _overview?.ReviewTotal ?? 0);

        _currentRun = BuildCurrentRun();
    }

    private OverviewRun BuildCurrentRun()
    {
        var batchProgress = StateContainer.BatchProgress;
        if (batchProgress is not null)
        {
            return new OverviewRun(
                IsActive: true,
                Status: "Processing",
                Progress: batchProgress.ProgressPercent,
                Processed: batchProgress.FilesProcessed,
                Total: batchProgress.FilesTotal,
                Library: "Current batch",
                CurrentItem: StringHelpers.FirstNonBlankOr("", batchProgress.CurrentFileTitle, batchProgress.RecentTitles?.FirstOrDefault(), "Processing item"),
                Stage: StringHelpers.FirstNonBlankOr("", batchProgress.CurrentStage, batchProgress.LifecycleStage, "Processing"),
                StartedBy: "Engine",
                Elapsed: "In progress",
                Remaining: batchProgress.EstimatedSecondsRemaining.HasValue
                    ? DisplayFormat.FormatDurationHoursMinutes(TimeSpan.FromSeconds(batchProgress.EstimatedSecondsRemaining.Value))
                    : "Calculating",
                Queued: batchProgress.FilesQueued,
                Failed: batchProgress.FilesFailed,
                IdleDetail: "");
        }

        var signalProgress = StateContainer.IngestionProgress;
        if (signalProgress is not null)
        {
            var percent = signalProgress.TotalCount > 0
                ? signalProgress.ProcessedCount * 100d / signalProgress.TotalCount
                : 0;

            return new OverviewRun(
                IsActive: true,
                Status: signalProgress.Stage,
                Progress: percent,
                Processed: signalProgress.ProcessedCount,
                Total: signalProgress.TotalCount,
                Library: "Watch folder",
                CurrentItem: StringHelpers.FirstNonBlankOr("", signalProgress.CurrentFile, "Scanning"),
                Stage: signalProgress.Stage,
                StartedBy: "Engine",
                Elapsed: "In progress",
                Remaining: signalProgress.TotalCount > 0 ? "Calculating" : "Discovering files",
                Queued: Math.Max(0, signalProgress.TotalCount - signalProgress.ProcessedCount),
                Failed: 0,
                IdleDetail: "");
        }

        var activeRun = _recentRuns.FirstOrDefault(run => IsActiveRunStatus(run.Status) && !IsRunEffectivelyComplete(run));
        if (activeRun is not null)
        {
            var progress = activeRun.FilesTotal > 0
                ? activeRun.FilesProcessed * 100d / activeRun.FilesTotal
                : 0;

            return new OverviewRun(
                IsActive: true,
                Status: FormatStatus(activeRun.Status),
                Progress: progress,
                Processed: activeRun.FilesProcessed,
                Total: activeRun.FilesTotal,
                Library: RunLibrary(activeRun),
                CurrentItem: "Current item unavailable",
                Stage: RunStage(activeRun),
                StartedBy: "Engine",
                Elapsed: DisplayFormat.FormatDurationHoursMinutes(DateTimeOffset.UtcNow - activeRun.StartedAt.ToUniversalTime()),
                Remaining: "Calculating",
                Queued: Math.Max(0, activeRun.FilesTotal - activeRun.FilesProcessed),
                Failed: activeRun.FilesFailed,
                IdleDetail: "");
        }

        var lastRun = _recentRuns.FirstOrDefault();
        return OverviewRun.Empty with
        {
            Failed = _recentRuns.Sum(run => run.FilesFailed),
            IdleDetail = lastRun is null
                ? "No recent run data is available."
                : $"Last run {FormatStatus(lastRun.Status).ToLowerInvariant()} {FormatRelative(lastRun.StartedAt)}."
        };
    }

    private static MediaBreakdownItem MediaItem(string label, Dictionary<string, int> counts, string icon) =>
        new(label, CountFor(counts, label), 0, icon);

    private static int CountFor(Dictionary<string, int> counts, string label)
    {
        string[] aliases = label switch
        {
            "Books" => new[] { "book", "books", "epub" },
            "Audiobooks" => new[] { "audiobook", "audiobooks", "m4b" },
            "Movies" => new[] { "movie", "movies", "film", "video" },
            "TV Episodes" => new[] { "tv", "tv episode", "tv episodes", "episode", "episodes" },
            "Music" => new[] { "music", "track", "tracks", "song", "songs", "album" },
            "Comics" => new[] { "comic", "comics", "cbz", "cbr" },
            _ => new[] { label },
        };

        var normalizedAliases = aliases.Select(NormalizeMediaKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return counts
            .Where(kv => normalizedAliases.Contains(NormalizeMediaKey(kv.Key)))
            .Sum(kv => kv.Value);
    }

    private static string NormalizeMediaKey(string value) =>
        new(value
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());

    private static string SegmentStyle(MediaBreakdownItem item) =>
        $"width: {Math.Max(item.Percent, 1).ToString("0.###", CultureInfo.InvariantCulture)}%; background: {item.Color};";

    private static string FormatPercent(double value) =>
        value <= 0 ? "0%" : $"{Math.Round(value):0}%";

    private static string FormatClock(DateTimeOffset? value) =>
        value.HasValue ? value.Value.ToLocalTime().ToString("h:mm tt", CultureInfo.CurrentCulture) : "not yet";

    private static string FormatRelative(string value) =>
        DateTimeOffset.TryParse(value, out var parsed) ? FormatRelative(parsed) : "recently";

    private static string FormatRelative(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        return elapsed.TotalMinutes switch
        {
            < 1 => "just now",
            < 60 => $"{(int)elapsed.TotalMinutes}m ago",
            < 1440 => $"{(int)elapsed.TotalHours}h ago",
            _ => $"{(int)elapsed.TotalDays}d ago",
        };
    }

    private static string ActivityText(ActivityEntryResponse activity) =>
        StringHelpers.FirstNonBlankOr("", activity.Detail, FormatTrigger(activity.ActionType), "Library activity");

    private static string FormatTrigger(string trigger)
    {
        if (string.IsNullOrWhiteSpace(trigger))
        {
            return "Review";
        }

        var text = trigger.Replace("_", " ").Replace("-", " ");
        var chars = text.SelectMany((c, i) =>
            i > 0 && char.IsUpper(c) && !char.IsWhiteSpace(text[i - 1])
                ? new[] { ' ', c }
                : new[] { c });
        return new string(chars.ToArray()).Trim();
    }

    private static string FormatStatus(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "Unknown";
        }

        return FormatTrigger(status);
    }

    private static bool IsActiveRunStatus(string status) =>
        status.Contains("processing", StringComparison.OrdinalIgnoreCase)
        || status.Contains("running", StringComparison.OrdinalIgnoreCase)
        || status.Contains("queued", StringComparison.OrdinalIgnoreCase)
        || status.Contains("active", StringComparison.OrdinalIgnoreCase);

    private static bool IsRunEffectivelyComplete(IngestionBatchResponse run) =>
        run.FilesTotal > 0
        && run.FilesProcessed >= run.FilesTotal
        && !run.Status.Contains("fail", StringComparison.OrdinalIgnoreCase);

    private static string RunLibrary(IngestionBatchResponse run) =>
        StringHelpers.FirstNonBlankOr("", run.Category, ShortPath(run.SourcePath), "Library");

    private static string RunStage(IngestionBatchResponse run)
    {
        if (run.FilesFailed > 0)
        {
            return "Failed";
        }

        if (run.FilesReview > 0)
        {
            return "Review";
        }

        if (run.FilesProcessed < run.FilesTotal)
        {
            return "Processing";
        }

        return "Complete";
    }

    private static string ShortPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        var trimmed = path.TrimEnd('\\', '/');
        var index = Math.Max(trimmed.LastIndexOf('\\'), trimmed.LastIndexOf('/'));
        return index >= 0 ? trimmed[(index + 1)..] : trimmed;
    }

    private sealed record MediaBreakdownItem(string Label, int Count, double Percent, string Icon)
    {
        public string Color => Label switch
        {
            "Books" => "#9a6dff",
            "Audiobooks" => "#c065df",
            "Movies" => "#72a5ff",
            "TV Episodes" => "#5adcf5",
            "Music" => "#50d6c4",
            "Comics" => "#ff9a45",
            _ => "#94a3b8",
        };

    }

    private sealed record OverviewRun(
        bool IsActive,
        string Status,
        double Progress,
        int Processed,
        int Total,
        string Library,
        string CurrentItem,
        string Stage,
        string StartedBy,
        string Elapsed,
        string Remaining,
        int Queued,
        int Failed,
        string IdleDetail)
    {
        public static OverviewRun Empty { get; } = new(
            false,
            "Idle",
            0,
            0,
            0,
            "None",
            "None",
            "Idle",
            "None",
            "0m",
            "None",
            0,
            0,
            "No recent run data is available.");
    }
}
