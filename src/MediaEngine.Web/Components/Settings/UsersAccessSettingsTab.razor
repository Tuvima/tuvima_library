@namespace MediaEngine.Web.Components.Settings

<div class="tl-page users-access-settings">
    <section class="users-access-settings__section"
             data-access-section="@ActiveSection"
             aria-label="@ActiveSectionLabel">
        @switch (ActiveSection)
        {
            case "security":
                <SecurityTab />
                break;
            case "linked-accounts":
                <UsersTab LinkedAccountsOnly="true" />
                break;
            case "api-keys":
                <ApiKeysTab />
                break;
            default:
            <UsersTab />
                break;
        }
    </section>
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "profiles";

    private string ActiveSection => Subsection.ToLowerInvariant() switch
    {
        "security" => "security",
        "linked-accounts" => "linked-accounts",
        "api-keys" => "api-keys",
        _ => "profiles",
    };

    private string ActiveSectionLabel => ActiveSection switch
    {
        "security" => "Authentication",
        "linked-accounts" => "Linked Accounts",
        "api-keys" => "Guest API Keys",
        _ => "Profiles & Roles",
    };
}
