@namespace MediaEngine.Web.Components.Settings

<div class="tl-page users-access-settings">
    <AppTabs ActivePanelIndex="@ActivePanelIndex"
             Class="settings-tab-strip">
        <AppTabPanel Text="Profiles & Roles" Icon="@Icons.Material.Outlined.Group">
            <UsersTab />
        </AppTabPanel>
        <AppTabPanel Text="Authentication" Icon="@Icons.Material.Outlined.AdminPanelSettings">
            <SecurityTab />
        </AppTabPanel>
        <AppTabPanel Text="Linked Accounts" Icon="@Icons.Material.Outlined.Link">
            <UsersTab LinkedAccountsOnly="true" />
        </AppTabPanel>
        <AppTabPanel Text="Guest API Keys" Icon="@Icons.Material.Outlined.Key">
            <ApiKeysTab />
        </AppTabPanel>
    </AppTabs>
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "profiles";

    private int ActivePanelIndex => Subsection.ToLowerInvariant() switch
    {
        "security" or "authentication" => 1,
        "linked" or "linked-accounts" => 2,
        "api-keys" => 3,
        _ => 0,
    };
}
