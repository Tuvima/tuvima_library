@namespace MediaEngine.Web.Components.Settings

<div class="tl-page users-access-settings">
    <div class="users-access-settings__grid">
        <AppPanel Class="users-access-settings__section users-access-settings__section--profiles">
            <SettingsSectionHeader Title="Profiles & Roles"
                                   Description="Manage user roles, permissions, and local profiles."
                                   Icon="@Icons.Material.Outlined.Group"
                                   Divider="true" />
            <UsersTab />
        </AppPanel>

        <AppPanel Class="users-access-settings__section users-access-settings__section--authentication">
            <SettingsSectionHeader Title="Authentication"
                                   Description="Review how users sign in to this Tuvima server."
                                   Icon="@Icons.Material.Outlined.AdminPanelSettings"
                                   Divider="true" />
            <SecurityTab />
        </AppPanel>

        <AppPanel Class="users-access-settings__section users-access-settings__section--linked">
            <SettingsSectionHeader Title="Linked Accounts"
                                   Description="Manage external identities associated with local profiles."
                                   Icon="@Icons.Material.Outlined.Link"
                                   Divider="true" />
            <UsersTab LinkedAccountsOnly="true" />
        </AppPanel>

        <AppPanel Class="users-access-settings__section users-access-settings__section--keys">
            <SettingsSectionHeader Title="Guest API Keys"
                                   Description="Issue and revoke keys used by approved integrations."
                                   Icon="@Icons.Material.Outlined.Key"
                                   Divider="true" />
            <ApiKeysTab />
        </AppPanel>
    </div>
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "profiles";
}
