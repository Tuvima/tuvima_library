@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject MediaEditorLauncherService MediaEditorLauncher
@inject ISnackbar Snackbar
@using MediaEngine.Web.Services.Editing

<div class="settings-review-page">
    <header class="settings-review-heading">
        <div><h2>@(_items.Count == 1 ? "1 item needs review" : $"{_items.Count} items need review")</h2><p>Items Tuvima could not identify confidently.</p></div>
        <AppButton Label="Refresh" Size="AppControlSize.Compact" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="@_loading" OnClick="LoadAsync" />
    </header>
    <div class="settings-review-filters" role="group" aria-label="Filter review queue">
        @foreach (var filter in Filters)
        {
            <AppButton Label="@($"{filter.Label}  {filter.Count}")" Size="AppControlSize.Compact" ButtonStyle="@(filter.Key == _filter ? AppButtonStyle.Filled : AppButtonStyle.Text)" Tone="@(filter.Key == _filter ? AppUiTone.Primary : AppUiTone.Neutral)" OnClick="@(() => _filter = filter.Key)" />
        }
    </div>
    @if (_loading && _items.Count == 0) { <AppPageState Kind="AppPageStateKind.Loading" Title="Loading review queue" Message="Checking for items that need a decision." /> }
    else if (!string.IsNullOrWhiteSpace(_error) && _items.Count == 0) { <AppPageState Kind="AppPageStateKind.Error" Icon="@Icons.Material.Outlined.CloudOff" Title="Review queue is unavailable" Message="@_error" /> }
    else if (_items.Count == 0) { <AppEmptyState Title="Nothing needs review" Message="Tuvima has no unresolved items waiting for you." /> }
    else
    {
        @if (_loading) { <AppProgressBar Indeterminate="true" Class="settings-review-refresh-bar" /> }
        <AppPanel Class="settings-review-list" Density="AppSurfaceDensity.Compact">
            <div class="settings-review-table-header" aria-hidden="true"><span>Item</span><span>Type</span><span>Why it is here</span><span>Waiting</span><span>Action</span></div>
            @foreach (var item in VisibleItems)
            {
                var issue = ReviewIssueClassifier.Classify(item.Trigger); var detail = ReviewIssuePresentationBuilder.Build(item);
                <article class="settings-review-row" @key="item.Id">
                    <div class="settings-review-row__item" data-label="Item"><span class="settings-review-media-icon" aria-hidden="true"><MudIcon Icon="@MediaIcon(item.MediaType)" /></span><strong>@DisplayTitle(item)</strong></div>
                    <span data-label="Type">@MediaLabel(item)</span>
                    <div class="settings-review-row__reason" data-label="Why it is here"><AppStatusBadge Text="@issue.Label" Tone="@(issue.HighPriority ? AppUiTone.Error : AppUiTone.Warning)" /><span>@detail.QueueExplanation</span></div>
                    <time data-label="Waiting" datetime="@item.CreatedAt.ToString("O")">@WaitingAge(item.CreatedAt)</time>
                    <div class="settings-review-row__actions" data-label="Action">
                        <AppButton Label="Review" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Size="AppControlSize.Compact" Disabled="@_busyIds.Contains(item.Id)" OnClick="@(() => OpenReviewEditorAsync(item))" />
                        <AppOverflowMenu AriaLabel="@($"More actions for {DisplayTitle(item)}")" Size="AppControlSize.Compact">
                            @if (IsWikidataReview(item.Trigger)) { <AppMenuItem Label="Keep provider match" Icon="@Icons.Material.Outlined.Link" OnClick="@(() => SkipUniverseAsync(item))" /> }
                            <AppMenuItem Label="Dismiss from review" Icon="@Icons.Material.Outlined.Close" OnClick="@(() => DismissAsync(item))" />
                        </AppOverflowMenu>
                    </div>
                </article>
            }
            <footer>Showing @VisibleItems.Count of @_items.Count items</footer>
        </AppPanel>
    }
</div>

@code {
    private const string All = "all"; private List<ReviewItemViewModel> _items = []; private readonly HashSet<Guid> _busyIds = []; private bool _loading = true; private string? _error; private string _filter = All;
    private IReadOnlyList<ReviewItemViewModel> VisibleItems => _items.Where(x => _filter == All || ReviewIssueClassifier.MatchesCategory(x.Trigger, _filter)).OrderBy(x => x.CreatedAt).ToList();
    private IReadOnlyList<(string Key,string Label,int Count)> Filters => [(All,"All",_items.Count),(ReviewIssueClassifier.CategoryQuickFix,"Quick fixes",Count(ReviewIssueClassifier.CategoryQuickFix)),(ReviewIssueClassifier.CategoryManualReview,"Manual review",Count(ReviewIssueClassifier.CategoryManualReview)),(ReviewIssueClassifier.CategoryNoProviderMatch,"No match",Count(ReviewIssueClassifier.CategoryNoProviderMatch)),(ReviewIssueClassifier.CategoryIncompleteMetadata,"Incomplete",Count(ReviewIssueClassifier.CategoryIncompleteMetadata)),(ReviewIssueClassifier.CategoryDuplicates,"Duplicates",Count(ReviewIssueClassifier.CategoryDuplicates))];
    private int Count(string category) => _items.Count(x => ReviewIssueClassifier.MatchesCategory(x.Trigger, category));
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading=true; _error=null; try { _items=await Orchestrator.GetPendingReviewsAsync(100); } catch (Exception ex) { _error=$"Review queue could not load: {ex.Message}"; } finally { _loading=false; } }
    private async Task DismissAsync(ReviewItemViewModel item) { _busyIds.Add(item.Id); try { if(await Orchestrator.DismissReviewAsync(item.Id)){_items.Remove(item);Snackbar.Add("Review item dismissed. Its metadata was not changed.",Severity.Success);} else Snackbar.Add("Review item could not be dismissed.",Severity.Warning); } finally {_busyIds.Remove(item.Id);} }
    private async Task SkipUniverseAsync(ReviewItemViewModel item) { _busyIds.Add(item.Id); try { if(await Orchestrator.SkipUniverseAsync(item.Id)){_items.Remove(item);Snackbar.Add("Provider match kept and canonical matching skipped.",Severity.Success);} else Snackbar.Add("The issue could not be resolved.",Severity.Warning); } finally {_busyIds.Remove(item.Id);} }
    private async Task OpenReviewEditorAsync(ReviewItemViewModel item) { _busyIds.Add(item.Id); try { var target=ReviewTargetResolver.Resolve(item.MediaType,item.Trigger); var title=DisplayTitle(item); var applied=await MediaEditorLauncher.OpenAsync(new MediaEditorLaunchRequest {EntityIds=[item.EntityId],LaunchEntityId=item.EntityId,LaunchEntityKind=StringHelpers.FirstNonBlankOr("",item.EntityType,"review"), Mode = SharedMediaEditorMode.Review, IdentityIntent=target.Intent, InitialTab = "links",InitialCanonicalTargetGroup=target.CanonicalTargetGroup, ReviewItemId = item.Id,ReviewTrigger=item.Trigger,MediaType=item.MediaType,HeaderTitle=title,HeaderSubtitle="Find match",CoverUrl=item.CoverUrl,PreviewItems=[new MediaEditorPreviewItem{EntityId=item.EntityId,Title=title,CoverUrl=item.CoverUrl,MediaType=item.MediaType}]}); if(applied){await LoadAsync();Snackbar.Add("Review changes applied.",Severity.Success);} } catch(Exception ex){Snackbar.Add($"Review editor could not open: {ex.Message}",Severity.Error);} finally {_busyIds.Remove(item.Id);} }
    private static string DisplayTitle(ReviewItemViewModel item)=>StringHelpers.FirstNonBlankOr("",item.EntityTitle,item.Detail,item.EntityId.ToString());
    private static string MediaLabel(ReviewItemViewModel item)=>StringHelpers.FirstNonBlankOr("Unknown",item.MediaType,item.EntityType).TrimEnd('s');
    private static string MediaIcon(string? mediaType){var v=(mediaType??"").ToLowerInvariant();return v.Contains("music")?Icons.Material.Outlined.MusicNote:v.Contains("audio")?Icons.Material.Outlined.Headphones:v.Contains("tv")?Icons.Material.Outlined.Tv:v.Contains("movie")?Icons.Material.Outlined.Movie:v.Contains("comic")?Icons.Material.Outlined.AutoStories:Icons.Material.Outlined.MenuBook;}
    private static bool IsWikidataReview(string? trigger)=>trigger is "WikidataBridgeFailed" or "MissingQid" or "MultipleQidMatches" or "QidNoMatch";
    private static string WaitingAge(DateTimeOffset createdAt){var age=DateTimeOffset.UtcNow-createdAt;return age.TotalDays>=1?$"{Math.Max(1,(int)age.TotalDays)}d":age.TotalHours>=1?$"{Math.Max(1,(int)age.TotalHours)}h":$"{Math.Max(1,(int)age.TotalMinutes)}m";}
}
