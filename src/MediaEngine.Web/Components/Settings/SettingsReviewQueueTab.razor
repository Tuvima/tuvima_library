@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject MediaEditorLauncherService MediaEditorLauncher
@inject ISnackbar Snackbar
@using MediaEngine.Web.Services.Editing

<div class="tl-page settings-review-page">
    <div class="settings-review-toolbar">
        <AppButton Label="Refresh"
                   Size="AppControlSize.Compact"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   Disabled="@_loading"
                   OnClick="LoadAsync" />
    </div>

    <div class="settings-review-summary" aria-label="Review queue summary">
        @foreach (var summary in SummaryCards)
        {
            @if (summary.Bucket.HasValue)
            {
                <AppNativeButton Type="button"
                                 Class="@($"settings-review-summary__card is-{summary.Tone} {(summary.Bucket == _bucketFilter ? "is-active" : string.Empty)}")"
                                 aria-pressed="@(summary.Bucket == _bucketFilter)"
                                 OnClick="@(() => SelectSummaryBucket(summary.Bucket.Value))">
                    <span class="settings-review-summary__icon"><MudIcon Icon="@summary.Icon" /></span>
                    <span class="settings-review-summary__copy">
                        <small>@summary.Label</small>
                        <strong>@summary.Value</strong>
                        <span>@summary.Description</span>
                    </span>
                </AppNativeButton>
            }
            else
            {
                <article class="@($"settings-review-summary__card is-{summary.Tone} is-informational")">
                    <span class="settings-review-summary__icon"><MudIcon Icon="@summary.Icon" /></span>
                    <span class="settings-review-summary__copy">
                        <small>@summary.Label</small>
                        <strong>@summary.Value</strong>
                        <span>@summary.Description</span>
                    </span>
                </article>
            }
        }
    </div>

    <AppPanel Density="AppSurfaceDensity.Compact" Class="settings-review-controls">
        <div class="settings-review-category-tabs" aria-label="Review categories">
            @foreach (var category in CategoryTabs)
            {
                <AppButton Label="@($"{category.Label}  {category.Count}")"
                           Size="AppControlSize.Compact"
                           ButtonStyle="@(category.Key == _categoryFilter ? AppButtonStyle.Filled : AppButtonStyle.Text)"
                           Tone="@(category.Key == _categoryFilter ? AppUiTone.Primary : AppUiTone.Neutral)"
                           OnClick="@(() => SelectCategory(category.Key))" />
            }
        </div>
        <div class="settings-review-filter-bar">
            <AppTextField @bind-Value="_query"
                          Placeholder="Search issues…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Immediate="true"
                          Class="settings-review-filter-bar__search" />
            <AppSelect T="string" @bind-Value="_mediaTypeFilter"
                       Label="Media type"
                       Options="@MediaTypeOptions"
                       Class="settings-review-filter-bar__select" />
            <AppSelect T="string" @bind-Value="_reasonFilter"
                       Label="Reason"
                       Options="@ReasonOptions"
                       Class="settings-review-filter-bar__select" />
            <AppSelect T="string" @bind-Value="_sortOrder"
                       Label="Sort"
                       Options="@SortOptions"
                       Class="settings-review-filter-bar__select" />
        </div>
    </AppPanel>

    @if (_loading && _items.Count == 0)
    {
        <AppProgressBar Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
    }
    else if (_items.Count == 0)
    {
        <AppEmptyState Title="No pending review items" Message="Tuvima has no unresolved exceptions that need your attention." />
    }
    else
    {
        <div class="settings-review-workspace @(_loading ? "is-refreshing" : null) @(_inspectorOpen ? "is-inspector-open" : null)">
            @if (_loading)
            {
                <AppProgressBar Indeterminate="true" Class="settings-review-refresh-bar" />
            }

            <section class="settings-review-list" aria-label="Pending review items">
                @if (VisibleItems.Count == 0)
                {
                    <AppEmptyState Title="No matching issues" Message="Try clearing one or more filters." />
                }
                else
                {
                    <div class="settings-review-table-header" role="row">
                        <span>Item</span>
                        <span>Media type</span>
                        <span>Issue</span>
                        <span>Age</span>
                        <span aria-hidden="true"></span>
                    </div>
                }

                @foreach (var item in VisibleItems)
                {
                    var issue = ReviewIssueClassifier.Classify(item.Trigger);
                    var details = ReviewIssuePresentationBuilder.Build(item);
                    var isSelected = SelectedItem?.Id == item.Id;
                    <div class="@($"settings-review-row {(isSelected ? "is-selected" : string.Empty)}")" @key="item.Id">
                        <AppNativeButton Type="button"
                                         Class="settings-review-row__selector"
                                         aria-pressed="@isSelected"
                                         OnClick="@(() => SelectItem(item))">
                            <span class="settings-review-row__item">
                                <span class="settings-review-row__selection" aria-hidden="true">
                                    <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" />
                                </span>
                                <span class="settings-review-media-icon" aria-hidden="true"><MudIcon Icon="@MediaIcon(item.MediaType)" /></span>
                                <span class="settings-review-row__identity">
                                    <strong>@DisplayTitle(item)</strong>
                                    <small>Detected from local media</small>
                                </span>
                            </span>
                            <span><AppChip Text="@MediaLabel(item)" Tone="AppUiTone.Primary" /></span>
                            <span class="settings-review-row__issue">
                                <AppChip Text="@issue.Label" Tone="@(issue.HighPriority ? AppUiTone.Error : AppUiTone.Warning)" />
                                <small>@details.QueueExplanation</small>
                            </span>
                            <span class="settings-review-row__age">@RelativeAge(item.CreatedAt)</span>
                            <span class="settings-review-row__cue" title="Review this item"><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></span>
                        </AppNativeButton>
                    </div>
                }
                <footer>Showing @VisibleItems.Count of @_items.Count issues</footer>
            </section>

            <aside class="settings-review-inspector" aria-live="polite">
                @if (SelectedItem is not { } selected)
                {
                    <AppEmptyState Title="Select an issue" Message="Choose an item to see why it needs review and the best next action." />
                }
                else
                {
                    var issue = ReviewIssueClassifier.Classify(selected.Trigger);
                    var details = ReviewIssuePresentationBuilder.Build(selected);
                    var selectedIndex = SelectedVisibleIndex;

                    <div class="settings-review-inspector__mobile-back">
                        <AppButton Label="Back to review queue"
                                   Size="AppControlSize.Compact"
                                   StartIcon="@Icons.Material.Outlined.ArrowBack"
                                   OnClick="CloseMobileInspector" />
                    </div>

                    <header class="settings-review-inspector__header">
                        <div class="settings-review-inspector__identity">
                            <span class="settings-review-media-icon settings-review-media-icon--inspector" aria-hidden="true"><MudIcon Icon="@MediaIcon(selected.MediaType)" /></span>
                            <div>
                                <h3>@DisplayTitle(selected)</h3>
                                <small>@MediaLabel(selected) · Detected @RelativeAgeLong(selected.CreatedAt)</small>
                            </div>
                        </div>
                        <div class="settings-review-inspector__header-actions">
                            <AppChip Text="@issue.Label" Tone="@(issue.HighPriority ? AppUiTone.Error : AppUiTone.Warning)" />
                            <AppIconButton Icon="@Icons.Material.Outlined.Close"
                                           Size="Size.Small"
                                           Color="Color.Inherit"
                                           Tooltip="Close inspector"
                                           AriaLabel="Close inspector"
                                           OnClick="ClearSelection" />
                        </div>
                    </header>

                    <section>
                        <h4>Why this needs review</h4>
                        <p>@details.Summary</p>
                    </section>

                    <section>
                        <h4>What went wrong</h4>
                        <ul class="settings-review-inspector__reasons">
                            @foreach (var reason in details.FailureReasons)
                            {
                                <li><MudIcon Icon="@Icons.Material.Outlined.Close" aria-hidden="true" /><span>@reason</span></li>
                            }
                        </ul>
                    </section>

                    <section>
                        <h4>What Tuvima knows</h4>
                        <dl class="settings-review-inspector__facts">
                            @foreach (var fact in details.KnownFacts)
                            {
                                <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div>
                            }
                            <div><dt>Detected</dt><dd>@RelativeAgeLong(selected.CreatedAt)</dd></div>
                        </dl>
                    </section>

                    <section class="settings-review-guidance">
                        <span class="settings-review-guidance__icon"><MudIcon Icon="@Icons.Material.Outlined.Lightbulb" /></span>
                        <div><h4>What you can do</h4><p>@details.Guidance</p></div>
                    </section>

                    @if (HasTechnicalDetails(selected))
                    {
                        <div class="settings-review-technical">
                            <AppNativeButton Type="button"
                                             Class="@($"settings-review-technical__toggle {(_showTechnicalDetails ? "is-open" : string.Empty)}")"
                                             aria-expanded="@_showTechnicalDetails"
                                             OnClick="@(() => _showTechnicalDetails = !_showTechnicalDetails)">
                                <span>@(_showTechnicalDetails ? "Hide technical details" : "Show technical details")</span>
                                <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" />
                            </AppNativeButton>
                            @if (_showTechnicalDetails)
                            {
                                <dl>
                                    @if (!string.IsNullOrWhiteSpace(selected.Detail))
                                    {
                                        <div><dt>Pipeline detail</dt><dd>@selected.Detail</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selected.SourceCapabilityId))
                                    {
                                        <div><dt>Capability</dt><dd>@selected.SourceCapabilityId</dd></div>
                                    }
                                    @if (selected.SourceOperationId.HasValue)
                                    {
                                        <div><dt>Operation ID</dt><dd>@selected.SourceOperationId</dd></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selected.CandidatesJson))
                                    {
                                        <div><dt>Candidate evidence</dt><dd>Captured for comparison in the focused review.</dd></div>
                                    }
                                </dl>
                            }
                        </div>
                    }

                    <section class="settings-review-recommended">
                        <h4>Recommended next step</h4>
                        <div class="settings-review-inspector__actions">
                            <AppButton Label="Find match"
                                       ButtonStyle="AppButtonStyle.Filled"
                                       Tone="AppUiTone.Primary"
                                       StartIcon="@Icons.Material.Outlined.Search"
                                       Disabled="@_busyIds.Contains(selected.Id)"
                                       OnClick="@(() => OpenReviewEditorAsync(selected))" />
                            @if (IsWikidataReview(selected.Trigger))
                            {
                                <AppButton Label="Keep provider match"
                                           Disabled="@_busyIds.Contains(selected.Id)"
                                           OnClick="@(() => SkipUniverseAsync(selected))" />
                            }
                            @if (_dismissConfirmationId == selected.Id)
                            {
                                <div class="settings-review-dismiss-confirmation" role="alert">
                                    <p>Dismissing this issue removes it from Needs Review but does not change the item's metadata.</p>
                                    <div>
                                        <AppButton Label="Cancel" Size="AppControlSize.Compact" OnClick="CancelDismiss" />
                                        <AppButton Label="Confirm dismissal"
                                                   Size="AppControlSize.Compact"
                                                   Tone="AppUiTone.Error"
                                                   Disabled="@_busyIds.Contains(selected.Id)"
                                                   OnClick="@(() => DismissAsync(selected))" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <AppButton Label="Dismiss issue"
                                           Tone="AppUiTone.Error"
                                           StartIcon="@Icons.Material.Outlined.DeleteOutline"
                                           Disabled="@_busyIds.Contains(selected.Id)"
                                           OnClick="@(() => RequestDismiss(selected))" />
                            }
                        </div>
                    </section>

                    <nav class="settings-review-inspector__navigation" aria-label="Review issue navigation">
                        <AppButton Label="Previous issue"
                                   Size="AppControlSize.Compact"
                                   StartIcon="@Icons.Material.Outlined.ChevronLeft"
                                   Disabled="@(selectedIndex <= 0)"
                                   OnClick="@(() => MoveSelection(-1))" />
                        <strong>@(selectedIndex + 1) of @VisibleItems.Count</strong>
                        <AppButton Label="Next issue"
                                   Size="AppControlSize.Compact"
                                   EndIcon="@Icons.Material.Outlined.ChevronRight"
                                   Disabled="@(selectedIndex < 0 || selectedIndex >= VisibleItems.Count - 1)"
                                   OnClick="@(() => MoveSelection(1))" />
                    </nav>
                }
            </aside>
        </div>
    }
</div>

@code {
    private const string AllFilter = "all";
    private List<ReviewItemViewModel> _items = [];
    private readonly HashSet<Guid> _busyIds = [];
    private bool _loading = true;
    private bool _inspectorOpen;
    private bool _showTechnicalDetails;
    private string? _error;
    private Guid? _selectedId;
    private Guid? _dismissConfirmationId;
    private string _query = string.Empty;
    private string _mediaTypeFilter = AllFilter;
    private string _reasonFilter = AllFilter;
    private string _sortOrder = "oldest";
    private ReviewIssueBucket _bucketFilter = ReviewIssueBucket.All;
    private string _categoryFilter = ReviewIssueClassifier.CategoryAll;

    private ReviewItemViewModel? SelectedItem => _items.FirstOrDefault(item => item.Id == _selectedId);
    private IReadOnlyList<ReviewItemViewModel> VisibleItems => FilterItems().ToList();
    private int SelectedVisibleIndex => _selectedId is { } id ? VisibleItems.ToList().FindIndex(item => item.Id == id) : -1;

    private IEnumerable<ReviewItemViewModel> FilterItems()
    {
        var query = _query.Trim();
        var filtered = _items
            .Where(item => _bucketFilter == ReviewIssueBucket.All || ReviewIssueClassifier.Classify(item.Trigger).Bucket == _bucketFilter)
            .Where(item => ReviewIssueClassifier.MatchesCategory(item.Trigger, _categoryFilter))
            .Where(item => _mediaTypeFilter == AllFilter || string.Equals(item.MediaType, _mediaTypeFilter, StringComparison.OrdinalIgnoreCase))
            .Where(item => _reasonFilter == AllFilter || string.Equals(item.Trigger, _reasonFilter, StringComparison.OrdinalIgnoreCase))
            .Where(item => string.IsNullOrWhiteSpace(query) || SearchValues(item).Any(value => value.Contains(query, StringComparison.OrdinalIgnoreCase)));
        return _sortOrder == "newest" ? filtered.OrderByDescending(item => item.CreatedAt) : filtered.OrderBy(item => item.CreatedAt);
    }

    private static IEnumerable<string> SearchValues(ReviewItemViewModel item) =>
        new[] { DisplayTitle(item), item.Trigger, item.MediaType ?? string.Empty, item.EntityType }
            .Concat(item.DetectedFacts.Values)
            .Concat(item.BridgeIdentifiers.Values);

    private IReadOnlyList<ReviewSummaryCard> SummaryCards =>
    [
        new("Needing review", _items.Count.ToString(), Icons.Material.Outlined.AssignmentLate, "Across all media types", "open", ReviewIssueBucket.All),
        new("High priority", Count(ReviewIssueBucket.HighPriority).ToString(), Icons.Material.Outlined.Flag, "Needs your attention", "priority", ReviewIssueBucket.HighPriority),
        new("Oldest waiting", OldestWaiting, Icons.Material.Outlined.Schedule, "Since it entered the queue", "oldest", null),
    ];

    private string OldestWaiting => _items.Count == 0 ? "—" : WaitingAge(_items.Min(item => item.CreatedAt));

    private int Count(ReviewIssueBucket bucket) => _items.Count(item => ReviewIssueClassifier.Classify(item.Trigger).Bucket == bucket);
    private int CountCategory(string category) => _items.Count(item => ReviewIssueClassifier.MatchesCategory(item.Trigger, category));

    private IReadOnlyList<(string Key, string Label, int Count)> CategoryTabs =>
    [
        (ReviewIssueClassifier.CategoryAll, "All", _items.Count),
        (ReviewIssueClassifier.CategoryQuickFix, "Quick fixes", CountCategory(ReviewIssueClassifier.CategoryQuickFix)),
        (ReviewIssueClassifier.CategoryManualReview, "Manual review", CountCategory(ReviewIssueClassifier.CategoryManualReview)),
        (ReviewIssueClassifier.CategoryNoProviderMatch, "No provider match", CountCategory(ReviewIssueClassifier.CategoryNoProviderMatch)),
        (ReviewIssueClassifier.CategoryIncompleteMetadata, "Incomplete metadata", CountCategory(ReviewIssueClassifier.CategoryIncompleteMetadata)),
        (ReviewIssueClassifier.CategoryDuplicates, "Duplicates", CountCategory(ReviewIssueClassifier.CategoryDuplicates)),
    ];

    private void SelectCategory(string key)
    {
        _categoryFilter = key;
        _bucketFilter = ReviewIssueBucket.All;
        EnsureVisibleSelection();
    }

    private void SelectSummaryBucket(ReviewIssueBucket bucket)
    {
        _bucketFilter = bucket;
        _categoryFilter = ReviewIssueClassifier.CategoryAll;
        EnsureVisibleSelection();
    }

    private void EnsureVisibleSelection()
    {
        var visible = VisibleItems;
        if (_selectedId is null || !visible.Any(item => item.Id == _selectedId))
            _selectedId = visible.FirstOrDefault()?.Id;
        _dismissConfirmationId = null;
    }

    private IReadOnlyList<AppSelectOption> MediaTypeOptions => [new(AllFilter, "All media types"), .. _items.Select(item => item.MediaType).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).Select(value => new AppSelectOption(value!, value!))];
    private IReadOnlyList<AppSelectOption> ReasonOptions => [new(AllFilter, "All reasons"), .. _items.Select(item => item.Trigger).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).Select(value => new AppSelectOption(value, FormatTrigger(value)))];
    private static IReadOnlyList<AppSelectOption> SortOptions => [new("oldest", "Oldest first"), new("newest", "Newest first")];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var previous = _selectedId;
            _items = await Orchestrator.GetPendingReviewsAsync(200);
            _selectedId = _items.Any(item => item.Id == previous) ? previous : null;
            EnsureVisibleSelection();
        }
        catch (Exception ex) { _error = $"Review queue could not load: {ex.Message}"; }
        finally { _loading = false; }
    }

    private void SelectItem(ReviewItemViewModel item)
    {
        _selectedId = item.Id;
        _dismissConfirmationId = null;
        _inspectorOpen = true;
    }

    private void ClearSelection()
    {
        _selectedId = null;
        _dismissConfirmationId = null;
        _inspectorOpen = false;
    }

    private void CloseMobileInspector() => _inspectorOpen = false;
    private void RequestDismiss(ReviewItemViewModel item) => _dismissConfirmationId = item.Id;
    private void CancelDismiss() => _dismissConfirmationId = null;

    private void MoveSelection(int delta)
    {
        var visible = VisibleItems;
        var current = SelectedVisibleIndex;
        var next = Math.Clamp(current + delta, 0, Math.Max(0, visible.Count - 1));
        if (visible.Count > 0)
            SelectItem(visible[next]);
    }

    private async Task DismissAsync(ReviewItemViewModel item)
    {
        var visible = VisibleItems;
        var oldIndex = visible.ToList().FindIndex(candidate => candidate.Id == item.Id);
        _busyIds.Add(item.Id);
        try
        {
            if (await Orchestrator.DismissReviewAsync(item.Id))
            {
                _items.Remove(item);
                _dismissConfirmationId = null;
                var remaining = VisibleItems;
                _selectedId = remaining.Count == 0 ? null : remaining[Math.Min(Math.Max(oldIndex, 0), remaining.Count - 1)].Id;
                Snackbar.Add("Review item dismissed. Its metadata was not changed.", Severity.Success);
            }
            else Snackbar.Add("Review item could not be dismissed.", Severity.Warning);
        }
        finally { _busyIds.Remove(item.Id); }
    }

    private async Task OpenReviewEditorAsync(ReviewItemViewModel item)
    {
        _busyIds.Add(item.Id);
        try
        {
            var target = ReviewTargetResolver.Resolve(item.MediaType, item.Trigger);
            var title = DisplayTitle(item);
            var applied = await MediaEditorLauncher.OpenAsync(new MediaEditorLaunchRequest
            {
                EntityIds = [item.EntityId],
                LaunchEntityId = item.EntityId,
                LaunchEntityKind = StringHelpers.FirstNonBlankOr("", item.EntityType, "review"),
                Mode = SharedMediaEditorMode.Review,
                IdentityIntent = target.Intent,
                InitialTab = "links",
                InitialCanonicalTargetGroup = target.CanonicalTargetGroup,
                ReviewItemId = item.Id,
                ReviewTrigger = item.Trigger,
                MediaType = item.MediaType,
                HeaderTitle = title,
                HeaderSubtitle = "Find match",
                CoverUrl = item.CoverUrl,
                PreviewItems = [new MediaEditorPreviewItem { EntityId = item.EntityId, Title = title, CoverUrl = item.CoverUrl, MediaType = item.MediaType }],
            });
            if (applied) { await LoadAsync(); Snackbar.Add("Review changes applied.", Severity.Success); }
        }
        catch (Exception ex) { Snackbar.Add($"Review editor could not open: {ex.Message}", Severity.Error); }
        finally { _busyIds.Remove(item.Id); }
    }

    private async Task SkipUniverseAsync(ReviewItemViewModel item)
    {
        _busyIds.Add(item.Id);
        try
        {
            if (await Orchestrator.SkipUniverseAsync(item.Id))
            {
                _items.Remove(item);
                EnsureVisibleSelection();
                Snackbar.Add("Provider match kept and canonical matching skipped.", Severity.Success);
            }
            else Snackbar.Add("The issue could not be resolved.", Severity.Warning);
        }
        finally { _busyIds.Remove(item.Id); }
    }

    private static string DisplayTitle(ReviewItemViewModel item) => StringHelpers.FirstNonBlankOr("", item.EntityTitle, item.Detail, item.EntityId.ToString());
    private static string MediaLabel(ReviewItemViewModel item) =>
        StringHelpers.FirstNonBlankOr("Unknown", item.MediaType, item.EntityType)
            .Replace("Audiobooks", "Audiobook", StringComparison.OrdinalIgnoreCase)
            .Replace("Movies", "Movie", StringComparison.OrdinalIgnoreCase)
            .Replace("Books", "Book", StringComparison.OrdinalIgnoreCase)
            .Replace("Comics", "Comic", StringComparison.OrdinalIgnoreCase);

    private static string MediaIcon(string? mediaType)
    {
        var media = mediaType ?? string.Empty;
        if (media.Contains("music", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Outlined.MusicNote;
        if (media.Contains("audio", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Outlined.Headphones;
        if (media.Contains("tv", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Outlined.Tv;
        if (media.Contains("movie", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Outlined.Movie;
        if (media.Contains("comic", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Outlined.AutoStories;
        return Icons.Material.Outlined.MenuBook;
    }

    private static bool HasTechnicalDetails(ReviewItemViewModel item) =>
        !string.IsNullOrWhiteSpace(item.Detail)
        || !string.IsNullOrWhiteSpace(item.SourceCapabilityId)
        || item.SourceOperationId.HasValue
        || !string.IsNullOrWhiteSpace(item.CandidatesJson);

    private static string FormatTrigger(string trigger) => string.IsNullOrWhiteSpace(trigger) ? "Review" : string.Concat(trigger.Select((c, i) => i > 0 && char.IsUpper(c) ? $" {c}" : c.ToString())).Replace('_', ' ');

    private static bool IsWikidataReview(string? trigger) => trigger is "WikidataBridgeFailed" or "MissingQid" or "MultipleQidMatches" or "QidNoMatch";

    private static string RelativeAge(DateTimeOffset createdAt)
    {
        var elapsed = DateTimeOffset.UtcNow - createdAt;
        return elapsed.TotalMinutes switch { < 1 => "now", < 60 => $"{(int)elapsed.TotalMinutes}m", < 1440 => $"{(int)elapsed.TotalHours}h", _ => $"{(int)elapsed.TotalDays}d" };
    }

    private static string RelativeAgeLong(DateTimeOffset createdAt)
    {
        var elapsed = DateTimeOffset.UtcNow - createdAt;
        return elapsed.TotalMinutes switch
        {
            < 1 => "just now",
            < 60 => $"{Math.Max(1, (int)elapsed.TotalMinutes)} minute{(elapsed.TotalMinutes < 2 ? string.Empty : "s")} ago",
            < 1440 => $"{Math.Max(1, (int)elapsed.TotalHours)} hour{(elapsed.TotalHours < 2 ? string.Empty : "s")} ago",
            _ => $"{Math.Max(1, (int)elapsed.TotalDays)} day{(elapsed.TotalDays < 2 ? string.Empty : "s")} ago",
        };
    }

    private static string WaitingAge(DateTimeOffset createdAt)
    {
        var elapsed = DateTimeOffset.UtcNow - createdAt;
        if (elapsed.TotalHours < 1) return $"{Math.Max(1, (int)elapsed.TotalMinutes)} min";
        if (elapsed.TotalDays < 1) return $"{Math.Max(1, (int)elapsed.TotalHours)} hr";
        var days = Math.Max(1, (int)elapsed.TotalDays);
        return $"{days} day{(days == 1 ? string.Empty : "s")}";
    }

    private sealed record ReviewSummaryCard(
        string Label,
        string Value,
        string Icon,
        string Description,
        string Tone,
        ReviewIssueBucket? Bucket);
}
