@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Web.Services.Integration
@using Microsoft.AspNetCore.WebUtilities
@inject IngestionLiveDashboardState Dashboard
@inject DeviceContextService DeviceContext
@inject NavigationManager Nav
@inject IEngineApiClient Api
@implements IAsyncDisposable

<div class="tl-page ingestion-operations">
    @if (IsPagedView)
    {
        <IngestionMediaPagedView Mode="@PagedViewMode" OnOpen="OpenDrawer" />
    }
    else if (Dashboard.IsLoading && Dashboard.Presentation is null)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading ingestion status" />
    }
    else if (Dashboard.Presentation is null)
    {
        <AppPageState Kind="AppPageStateKind.Error" Icon="@Icons.Material.Outlined.CloudOff" Title="Ingestion status is unavailable" Message="The Engine did not return a media ingestion summary." />
    }
    else
    {
        <div class="ingestion-operations__toolbar">
            @if (!DeviceContext.IsMobile)
            {
                <MudTooltip Text="Start an extra scan of every watched folder. Automatic watching continues in the background." Placement="Placement.Bottom">
                    <AppButton Label="Scan All Folders" StartIcon="@Icons.Material.Outlined.FolderOpen" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(Dashboard.IsLoading || Dashboard.IsScanStarting || Model.IsRunning)" Loading="@Dashboard.IsScanStarting" OnClick="ScanNowAsync" />
                </MudTooltip>
            }
        </div>

        <div class="ingestion-summary-layout">
            <AppPanel Class="@($"tl-card ingestion-current is-{Model.Status}")" aria-live="polite">
                <div class="ingestion-current__top">
                    <span class="ingestion-current__icon" aria-hidden="true"><MudIcon Icon="@CurrentIcon" /></span>
                    <div class="ingestion-current__copy">
                        <h2>@(Model.IsRunning ? "Adding media" : "Library is up to date")</h2>
                        <p>@SummaryLine</p>
                        @if (Model.IsRunning)
                        {
                            <div class="ingestion-current__progress">
                                <AppProgressBar Indeterminate="@(!HasFileIntakeProgress)" Value="@FileIntakeProgress" ShowValue="false" />
                                <span>@FileIntakeLabel</span>
                            </div>
                        }
                    </div>
                    <dl class="ingestion-current__facts">
                        <div><dt>@(Model.IsRunning ? "Elapsed" : "Last activity")</dt><dd>@TimingLabel</dd></div>
                        <div><dt>Active now</dt><dd>@Model.ActiveOperations.ToString("N0")</dd></div>
                        <div><dt>Queued</dt><dd>@Model.QueuedOperations.ToString("N0")</dd></div>
                        <div><dt>Waiting to retry</dt><dd>@Model.RetryWaitingOperations.ToString("N0")</dd></div>
                    </dl>
                </div>
                @if (Model.IsRunning)
                {
                    <details class="ingestion-processing-details">
                        <summary>Processing details</summary>
                        <p>Tuvima is handling @Model.ActiveOperations.ToString("N0") active and @Model.QueuedOperations.ToString("N0") queued background tasks. Technical events remain available in Activity &amp; Audit.</p>
                    </details>
                }
            </AppPanel>

            @if (Model.Attention.Count > 0)
            {
                <AppPanel Class="tl-card ingestion-attention">
                    <header><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /><h3>Needs Attention</h3></header>
                    @foreach (var item in Model.Attention)
                    {
                        <a href="@item.Route"><MudIcon Icon="@AttentionIcon(item.Kind)" /><span><strong>@item.Label</strong><small>@item.Description</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a>
                    }
                </AppPanel>
            }
        </div>

        @if (Model.IsRunning)
        {
            <section class="ingestion-section" aria-labelledby="being-added-title">
                <header><div><h2 id="being-added-title">Being Added Now</h2><p><i aria-hidden="true"></i>@Model.CurrentMediaTotal.ToString("N0") items currently being processed</p></div>@if (Model.CurrentMediaTotal > Model.CurrentMedia.Count) { <AppButton Href="/settings/ingestion?view=all" Label="View all" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ArrowForward" /> }</header>
                @if (Model.CurrentMedia.Count > 0)
                {
                    <div class="ingestion-media-grid">
                        @foreach (var item in Model.CurrentMedia)
                        {
                            <IngestionMediaCard Item="item" OnOpen="OpenDrawer" @key="(item.BatchId, item.GroupId)" />
                        }
                    </div>
                }
                else
                {
                    <div class="ingestion-grouping-state"><MudIcon Icon="@Icons.Material.Outlined.Sync" /><span><strong>Discovering media</strong><small>Recognizable albums, shows, books, and movies will appear here as local metadata is read.</small></span></div>
                }
            </section>
        }

        <ActivityBatchExplorer Compact="true" />
    }
</div>

<IngestionMediaDrawer Item="@_selectedItem" Close="CloseDrawer" />

@code {
    private IngestionMediaGroupDto? _selectedItem;
    private bool _drawerRefreshInFlight;
    private int _drawerRevision;
    private string? _view;
    private IngestionPresentationSnapshotDto Model => Dashboard.Presentation!;
    private bool IsPagedView => _view == "all";
    private string PagedViewMode => "current";
    private bool HasFileIntakeProgress => Model.FilesDiscovered > 0 && Model.FilesProcessed >= 0;
    private double FileIntakeProgress => HasFileIntakeProgress ? Math.Clamp(Model.FilesProcessed * 100d / Model.FilesDiscovered, 0, 100) : 0;
    private string FileIntakeLabel => HasFileIntakeProgress ? $"File intake · {Model.FilesProcessed:N0} / {Model.FilesDiscovered:N0} files processed" : "File intake · counting discovered files";
    private string SummaryLine => Model.IsRunning
        ? $"{Model.FilesDiscovered:N0} files discovered · {Model.LibraryGroups:N0} library items · {Model.ReadyGroups:N0} ready · {Model.FinishingGroups:N0} finishing details · {Model.ReviewGroups:N0} need review"
        : $"{LastActivityCopy} · {Model.FilesProcessed:N0} files processed · {RecentCount:N0} media groups recently added";
    private int RecentCount => Model.RecentDays.Sum(day => day.TotalCount);
    private string TimingLabel => Model.IsRunning && Model.StartedAt.HasValue ? FormatDuration(DateTimeOffset.UtcNow - Model.StartedAt.Value.ToUniversalTime()) : LastActivityCopy;
    private string LastActivityCopy => Model.LastActivityAt.HasValue ? FormatRelative(Model.LastActivityAt.Value) : "No activity yet";
    private string CurrentIcon => Model.IsRunning ? Icons.Material.Outlined.Sync : Icons.Material.Outlined.CheckCircle;

    protected override async Task OnInitializedAsync()
    {
        Dashboard.OnChanged += OnDashboardChanged;
        ResolveQuery();
        await Dashboard.InitializeAsync();
    }

    protected override void OnParametersSet() => ResolveQuery();

    private void ResolveQuery()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _view = query.TryGetValue("view", out var rawView) ? rawView.FirstOrDefault()?.ToLowerInvariant() : null;
    }

    private Task ScanNowAsync() => Dashboard.ScanNowAsync();
    private Task OpenDrawer(IngestionMediaGroupDto item) { _drawerRevision++; _selectedItem = item; return Task.CompletedTask; }
    private Task CloseDrawer() { _drawerRevision++; _selectedItem = null; return Task.CompletedTask; }

    private void OnDashboardChanged()
    {
        if (_selectedItem is not null && Dashboard.Presentation is not null)
        {
            var updated = Dashboard.Presentation.CurrentMedia.FirstOrDefault(item => item.BatchId == _selectedItem.BatchId && item.GroupId == _selectedItem.GroupId);
            if (updated is not null)
                _selectedItem = updated;
            else if (!_drawerRefreshInFlight)
                _ = RefreshPinnedDrawerAsync(_selectedItem.BatchId, _selectedItem.GroupId, _drawerRevision);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshPinnedDrawerAsync(Guid batchId, Guid groupId, int revision)
    {
        _drawerRefreshInFlight = true;
        try
        {
            var updated = await Api.GetIngestionMediaGroupAsync(batchId, groupId);
            if (updated is not null
                && revision == _drawerRevision
                && _selectedItem is not null
                && _selectedItem.BatchId == batchId
                && _selectedItem.GroupId == groupId)
            {
                _selectedItem = updated;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _drawerRefreshInFlight = false;
        }
    }

    private static string AttentionIcon(string kind) => kind switch { "review" => Icons.Material.Outlined.WarningAmber, "textTracks" => Icons.Material.Outlined.Lyrics, _ => Icons.Material.Outlined.CloudQueue };
    private static string FormatDuration(TimeSpan value) => value.TotalHours >= 1 ? $"{(int)value.TotalHours}h {value.Minutes}m" : $"{Math.Max(0, (int)value.TotalMinutes)}m {Math.Max(0, value.Seconds)}s";
    private static string FormatRelative(DateTimeOffset value) { var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime(); return elapsed.TotalMinutes < 1 ? "Just now" : elapsed.TotalHours < 1 ? $"{(int)elapsed.TotalMinutes} minutes ago" : elapsed.TotalDays < 1 ? $"{(int)elapsed.TotalHours} hours ago" : value.ToLocalTime().ToString("MMM d, yyyy"); }

    public async ValueTask DisposeAsync()
    {
        _drawerRevision++;
        Dashboard.OnChanged -= OnDashboardChanged;
        await Dashboard.StopAsync();
    }
}
