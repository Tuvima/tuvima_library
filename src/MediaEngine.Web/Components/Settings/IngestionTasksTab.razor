@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Integration
@inject IngestionLiveDashboardState Dashboard
@inject DeviceContextService DeviceContext
@implements IAsyncDisposable

<div class="tl-page ingestion-operations">
    @if (!DeviceContext.IsMobile)
    {
        <div class="ingestion-operations__toolbar">
            <AppButton Href="/settings/metadata/ingestion-flow" Label="Processing settings" StartIcon="@Icons.Material.Outlined.Settings" />
            <AppButton Href="/settings/activity" Label="View activity" StartIcon="@Icons.Material.Outlined.ReceiptLong" />
            <MudTooltip Text="Start an extra scan of every watched folder. File monitoring and scheduled processing continue automatically." Placement="Placement.Bottom">
                <AppButton Label="Scan all folders" StartIcon="@Icons.Material.Outlined.PlayArrow" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(Dashboard.IsLoading || Dashboard.IsScanStarting || IsRunning)" Loading="@Dashboard.IsScanStarting" OnClick="ScanNowAsync" />
            </MudTooltip>
        </div>
    }

    @if (Dashboard.IsLoading && Dashboard.Snapshot is null)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading ingestion status" />
    }
    else if (!string.IsNullOrWhiteSpace(Dashboard.Error) && Dashboard.Snapshot is null)
    {
        <AppPageState Kind="AppPageStateKind.Error" Icon="@Icons.Material.Outlined.CloudOff" Title="Ingestion status is unavailable" Message="@Dashboard.Error" />
    }
    else
    {
        <AppPanel Class="@($"tl-card ingestion-current {CurrentStateClass}")" aria-live="polite">
            <div class="ingestion-current__top">
                <div class="ingestion-current__identity">
                    <span class="ingestion-current__pulse" aria-hidden="true"><MudIcon Icon="@CurrentIcon" /></span>
                    <div>
                        <div class="ingestion-current__kicker"><strong>@RunScopeLabel</strong></div>
                        <h2>@Model.Heading</h2>
                        <p>@CurrentHeadline</p>
                        <small class="ingestion-current__phase-summary">@CurrentPhaseSummary</small>
                    </div>
                </div>
                <div class="ingestion-current__facts-wrap">
                    <dl class="ingestion-current__facts">
                        <div><dt>Elapsed</dt><dd>@ElapsedLabel</dd></div>
                        <div><dt>Active now</dt><dd>@CurrentActiveCount.ToString("N0")</dd></div>
                        <div><dt>Queued</dt><dd>@CurrentQueuedCount.ToString("N0")</dd></div>
                        <div><dt>Waiting to retry</dt><dd>@RetryWaitingCount.ToString("N0")</dd></div>
                    </dl>
                    @if (DisplayBatch is not null)
                    {
                        <p class="ingestion-current__started">Started @DisplayBatch.StartedAt.ToLocalTime().ToString("MMM d, h:mm tt")</p>
                    }
                </div>
            </div>
        </AppPanel>

        <AppPanel Class="tl-card ingestion-pipeline">
            <div class="ingestion-stage-strip" aria-label="Ingestion stages">
                @foreach (var phase in Phases)
                {
                    <button type="button" class="@PhaseClass(phase)" aria-label="@($"Show {phase.Label} status: {phase.StatusLabel}")" @onclick="@(() => SelectPhase(phase.Key))" aria-expanded="@(_selectedPhaseKey == phase.Key)" aria-controls="ingestion-stage-detail">
                        <span class="ingestion-stage__icon" aria-hidden="true"><MudIcon Icon="@phase.Icon" /><span class="ingestion-stage__status-mark"><MudIcon Icon="@PhaseStatusIcon(phase.Status)" /></span></span>
                        <span class="ingestion-stage__copy"><strong>@phase.Label</strong><small>@phase.Description</small></span>
                    </button>
                }
            </div>

            <details class="ingestion-stage-mobile" open="@IsRunning">
                <summary>Stages <span>@ActivePhaseSummary</span></summary>
                <div class="ingestion-stage-mobile__rows">
                    @foreach (var phase in Phases)
                    {
                        <button type="button" class="@PhaseClass(phase)" aria-label="@($"Show {phase.Label} status: {phase.StatusLabel}")" @onclick="@(() => SelectPhase(phase.Key))" aria-expanded="@(_selectedPhaseKey == phase.Key)" aria-controls="ingestion-stage-detail">
                            <span class="ingestion-stage__icon" aria-hidden="true"><MudIcon Icon="@phase.Icon" /><span class="ingestion-stage__status-mark"><MudIcon Icon="@PhaseStatusIcon(phase.Status)" /></span></span>
                            <span class="ingestion-stage__copy"><strong>@phase.Label</strong><small>@phase.Description</small></span>
                        </button>
                    }
                </div>
            </details>

            <section id="ingestion-stage-detail" class="@($"ingestion-stage-detail is-phase-{SelectedPhase.Key}")" aria-label="@($"{SelectedPhase.Label} details")">
                <header><div><MudIcon Icon="@SelectedPhase.Icon" /><span><strong>@SelectedPhase.Label</strong><small>@SelectedPhaseDetail</small></span></div>@if (_hasManualPhaseSelection && IsRunning) { <AppButton Label="Follow current stage" ButtonStyle="AppButtonStyle.Text" OnClick="@FollowCurrentPhase" /> }</header>
                @if (SelectedPhaseActivities.Count > 0)
                {
                    <div class="ingestion-stage-detail__work">
                        @foreach (var activity in SelectedPhaseActivities)
                        {
                            <article>
                                <span aria-hidden="true"><MudIcon Icon="@ActivityIcon(activity.StageKey)" /></span>
                                <div><strong>@ActivityLabel(activity)</strong><small>@ActivityDescription(activity.StageKey)</small><em>@ActivityProgressCounts(activity)</em>@if (activity.TotalCount > 0) { <AppProgressBar Value="@ActivityPercent(activity)" ShowValue="false" /> }</div>
                                @if (activity.ActiveCount > 0) { <i aria-hidden="true"></i> }
                            </article>
                        }
                    </div>
                }
                else
                {
                    <dl class="ingestion-stage-detail__facts">
                        @foreach (var fact in SelectedPhaseFacts)
                        {
                            <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div>
                        }
                    </dl>
                }
            </section>
        </AppPanel>

        <section class="ingestion-metrics" aria-label="Current run outcomes">
            @foreach (var metric in OutcomeMetrics)
            {
                @if (string.IsNullOrWhiteSpace(metric.Href))
                {
                    <article class="ingestion-metric @metric.Tone"><span class="ingestion-metric__icon" aria-hidden="true"><MudIcon Icon="@metric.Icon" /></span><div><strong>@metric.Value.ToString("N0")</strong><span>@metric.Label</span><small>@RunScopeLabel</small></div></article>
                }
                else
                {
                    <a class="ingestion-metric @metric.Tone" href="@metric.Href"><span class="ingestion-metric__icon" aria-hidden="true"><MudIcon Icon="@metric.Icon" /></span><div><strong>@metric.Value.ToString("N0")</strong><span>@metric.Label</span><small>@RunScopeLabel</small></div><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a>
                }
            }
        </section>

        <div class="ingestion-overview-grid">
            <AppPanel Class="tl-card ingestion-media-mix">
                <div class="ingestion-section-heading"><div><h3>Media in this run</h3><p>@MediaMixSummary</p></div></div>
                @if (MediaMix.Count > 0)
                {
                    <div class="ingestion-media-mix__rows">
                        @foreach (var media in MediaMix)
                        {
                            <div><span><MudIcon Icon="@media.Icon" aria-hidden="true" />@media.Label</span><AppProgressBar Value="@MediaPercent(media.Count)" Class="ingestion-media-mix__bar" /><strong>@media.Count.ToString("N0")</strong></div>
                        }
                    </div>
                }
                else
                {
                    <p class="ingestion-empty-copy">Media counts will appear after files are classified.</p>
                }
            </AppPanel>

            <AppPanel Class="tl-card ingestion-next">
                <div class="ingestion-section-heading"><div><h3>Up next</h3><p>Queued work and scheduled refreshes.</p></div></div>
                <div class="ingestion-next__summary"><span aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Schedule" /></span><div><strong>@NextWorkTitle</strong><small>@NextWorkText</small></div></div>
                <details class="ingestion-next__details"><summary>Scheduled enrichment refreshes</summary><EnrichmentRefreshSchedulePanel /></details>
                @if (ReviewCount > 0 || FailedCount > 0)
                {
                    <section class="ingestion-next__attention" aria-label="Needs attention">
                        <div><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /><strong>Needs attention</strong></div>
                        @if (FailedCount > 0) { <a href="@ActivityAttentionHref"><span>@FailedCount.ToString("N0") failed @Pluralize("operation", FailedCount)</span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }
                        @if (ReviewCount > 0) { <a href="/settings/review"><span>@ReviewCount.ToString("N0") @Pluralize("item", ReviewCount) need review</span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }
                    </section>
                }
            </AppPanel>
        </div>

        <AppPanel Class="tl-card ingestion-recent">
            <div class="ingestion-section-heading"><div><h3>Recent runs</h3><p>The latest library updates and their outcomes.</p></div><AppButton Href="/settings/activity" Label="View all activity" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ChevronRight" /></div>
            @if (RecentBatches.Count > 0)
            {
                <div class="ingestion-run-list">
                    @foreach (var batch in RecentBatches)
                    {
                        <a class="ingestion-run" href="@RunActivityHref(batch)"><span class="ingestion-run__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Storage" /></span><div><strong>@BatchTitle(batch)</strong><small>@BatchSummary(batch)</small></div><time>@FormatRelative(batch.StartedAt)</time></a>
                    }
                </div>
            }
            else
            {
                <AppEmptyState Title="No ingestion activity yet" Message="New files are detected automatically. Scan all folders when you want an extra check." />
            }
        </AppPanel>
    }
</div>

@code {
    private string? _selectedPhaseKey;
    private bool _hasManualPhaseSelection;

    protected override async Task OnInitializedAsync()
    {
        Dashboard.OnChanged += OnDashboardChanged;
        await Dashboard.InitializeAsync();
        _selectedPhaseKey = CurrentPhase.Key;
    }

    private LibraryUpdateStatusViewModel Model => Dashboard.LibraryUpdateStatus;
    private bool IsRunning => Model.PageState == LibraryUpdatePageState.Running;
    private IReadOnlyList<IngestionOperationsBatchDto> RecentBatches => Dashboard.Snapshot?.RecentBatches.Take(5).ToList() ?? [];
    private IngestionOperationsBatchDto? DisplayBatch => RecentBatches.Where(batch => IsActiveStatus(batch.Status)).OrderByDescending(batch => batch.OutstandingOperations > 0).ThenByDescending(batch => Math.Max(batch.TotalFiles, batch.ProcessedFiles)).ThenByDescending(batch => batch.StartedAt).FirstOrDefault() ?? RecentBatches.FirstOrDefault();
    private IReadOnlyList<IngestionCurrentActivityDto> ActiveActivityGroups => Dashboard.CurrentActivities.Where(activity => activity.ActiveCount > 0 || activity.QueuedCount > 0).Take(8).ToList();
    private int ReviewCount => DisplayBatch?.ReviewCount ?? (IsRunning ? 0 : Model.ReviewItems);
    private int FailedCount => DisplayBatch?.FailedCount ?? (IsRunning ? 0 : Dashboard.Snapshot?.Summary.FailedJobs ?? 0);
    private int ProviderWaitCount => Dashboard.ProviderActivity.Sum(provider => Math.Max(0, provider.WaitingRequests));
    private int CurrentActiveCount => DisplayBatch is null ? Model.ActiveItems : Math.Max(0, DisplayBatch.ActiveOperations);
    private int CurrentQueuedCount => DisplayBatch is null ? Model.QueuedItems : Math.Max(0, DisplayBatch.QueuedOperations);
    private int RetryWaitingCount => Math.Max(0, DisplayBatch?.RetryWaitingOperations ?? 0);
    private string CurrentHeadline => IsRunning ? ActiveWorkHeadline : DisplayBatch?.CompletedAt is { } completedAt ? $"Last scan completed {FormatRelative(completedAt)}" : Model.MainLine;
    private string ActiveWorkHeadline => ActiveActivityGroups.Count > 0 ? string.Join(" · ", ActiveActivityGroups.Select(ActivityLabel).Distinct(StringComparer.OrdinalIgnoreCase).Take(3)) : Model.CurrentStep;
    private string RunScopeLabel => IsRunning ? "Current run" : DisplayBatch is null ? "No run yet" : "Last run";
    private string ElapsedLabel => DisplayBatch?.DurationSeconds is { } seconds ? FormatDuration(seconds) : IsRunning && DisplayBatch is not null ? FormatDuration((int)Math.Max(0, (DateTimeOffset.UtcNow - DisplayBatch.StartedAt).TotalSeconds)) : "—";
    private string CurrentActivityHref => DisplayBatch is null ? "/settings/activity" : $"/settings/activity?runId={DisplayBatch.BatchId:D}";
    private string ActivityAttentionHref => DisplayBatch is null ? "/settings/activity" : $"/settings/activity?runId={DisplayBatch.BatchId:D}&detail=attention";
    private string CurrentStateClass => $"is-{Model.PageState.ToString().ToLowerInvariant()}";
    private string CurrentPhaseSummary => IsRunning ? $"{ActivePhaseSummary} · {CurrentActiveCount:N0} active · {CurrentQueuedCount:N0} queued" : DisplayBatch is null ? "Waiting for library activity" : $"{DisplayBatch.RegisteredCount:N0} identified · {DisplayBatch.ReviewCount:N0} need review · {DisplayBatch.FailedCount:N0} failed";
    private string CurrentIcon => Model.PageState switch { LibraryUpdatePageState.Running => Icons.Material.Outlined.Sync, LibraryUpdatePageState.Failed => Icons.Material.Outlined.ErrorOutline, LibraryUpdatePageState.Interrupted => Icons.Material.Outlined.WarningAmber, LibraryUpdatePageState.StatusUnavailable => Icons.Material.Outlined.CloudOff, _ => Icons.Material.Outlined.CheckCircle };

    private IReadOnlyList<PhaseViewModel> Phases =>
    [
        Phase("discover", "Discover", "Find and read new or changed files", Icons.Material.Outlined.FolderOpen, Combine([DisplayStepStatus(0), DisplayStepStatus(1)])),
        Phase("identify", "Identify", "Match titles to trusted metadata", Icons.Material.Outlined.Search, DisplayStepStatus(2)),
        Phase("enrich", "Enrich", "Add artwork, people, and details", Icons.Material.Outlined.AutoAwesome, DisplayStepStatus(3)),
        Phase("organize", "Organize", "Update library groups and relationships", Icons.Material.Outlined.AccountTree, DisplayStepStatus(4)),
    ];
    private PhaseViewModel CurrentPhase => Phases.FirstOrDefault(phase => phase.Status == LibraryUpdateStepStatus.InProgress) ?? Phases.LastOrDefault(phase => phase.Status == LibraryUpdateStepStatus.Complete) ?? Phases[0];
    private PhaseViewModel SelectedPhase => Phases.FirstOrDefault(phase => phase.Key == _selectedPhaseKey) ?? CurrentPhase;
    private string ActivePhaseSummary => CurrentPhase.Label;
    private IReadOnlyList<IngestionCurrentActivityDto> SelectedPhaseActivities => ActiveActivityGroups.Where(activity => PhaseKeyForActivity(activity.StageKey) == SelectedPhase.Key).ToList();
    private string SelectedPhaseDetail => SelectedPhase.Key switch { "discover" => "Files entering this run and the scope being checked.", "identify" => "Titles being matched to trusted library identities.", "enrich" => "Metadata, artwork, and people being added.", _ => "Library placement, collections, and relationships being finalized." };
    private IReadOnlyList<StageFact> SelectedPhaseFacts => SelectedPhase.Key switch
    {
        "discover" => [new("Files checked", (DisplayBatch?.ProcessedFiles ?? Model.ProcessedFiles).ToString("N0")), new("Files in scope", DisplayBatch is null ? "Unavailable" : Math.Max(DisplayBatch.TotalFiles, DisplayBatch.ProcessedFiles).ToString("N0"))],
        "identify" => [new("Identified", (DisplayBatch?.RegisteredCount ?? Model.AddedOrUpdatedCount).ToString("N0")), new("Need review", ReviewCount.ToString("N0"))],
        "enrich" => [new("People enriched", (DisplayBatch?.PeopleGeneratedCount ?? 0).ToString("N0")), new("Artwork recorded", (DisplayBatch?.ArtworkDownloadedCount ?? 0).ToString("N0")), new("Metadata updated", (DisplayBatch?.MetadataUpdatedCount ?? 0).ToString("N0"))],
        _ => [new("Active", SelectedPhase.Status == LibraryUpdateStepStatus.InProgress ? CurrentActiveCount.ToString("N0") : "0"), new("Queued", SelectedPhase.Status == LibraryUpdateStepStatus.InProgress ? CurrentQueuedCount.ToString("N0") : "0")],
    };

    private IReadOnlyList<OutcomeMetric> OutcomeMetrics =>
    [
        new("Files checked", DisplayBatch?.ProcessedFiles ?? Model.ProcessedFiles, Icons.Material.Outlined.Description, "is-primary", null),
        new("Added or updated", DisplayBatch?.RegisteredCount ?? Model.AddedOrUpdatedCount, Icons.Material.Outlined.Add, "is-success", null),
        new("Need review", ReviewCount, Icons.Material.Outlined.PendingActions, "is-warning", "/settings/review"),
        new("Failed", FailedCount, Icons.Material.Outlined.ErrorOutline, "is-danger", ActivityAttentionHref),
    ];
    private IReadOnlyList<MediaMetric> MediaMix => DisplayBatch is null ? [] : new[] { new MediaMetric("Movies", DisplayBatch.MoviesCount, Icons.Material.Outlined.Movie), new MediaMetric("TV shows", DisplayBatch.TvShowsCount, Icons.Material.Outlined.Tv), new MediaMetric("Books", DisplayBatch.BooksCount, Icons.Material.Outlined.MenuBook), new MediaMetric("Audiobooks", DisplayBatch.AudiobooksCount, Icons.Material.Outlined.Headphones), new MediaMetric("Music", DisplayBatch.MusicCount, Icons.Material.Outlined.MusicNote), new MediaMetric("Comics", DisplayBatch.ComicsCount, Icons.Material.Outlined.AutoStories) }.Where(metric => metric.Count > 0).ToList();
    private string MediaMixSummary => DisplayBatch is null || MediaMix.Count == 0 ? "Media counts appear as files are classified." : $"{RunScopeLabel} · {MediaMix.Sum(metric => metric.Count):N0} items across {MediaMix.Count:N0} {Pluralize("media type", MediaMix.Count)}";
    private string NextWorkTitle => Model.QueuedItems > 0 ? $"{Model.QueuedItems:N0} queued {Pluralize("task", Model.QueuedItems)}" : ProviderWaitCount > 0 ? "Waiting for a provider" : "No queued work";
    private string NextWorkText => Model.QueuedItems > 0 ? "Tuvima will continue automatically." : ProviderWaitCount > 0 ? $"{ProviderWaitCount:N0} {Pluralize("request", ProviderWaitCount)} waiting for capacity." : "Scheduled refreshes run according to metadata policy.";

    private void SelectPhase(string key) { _selectedPhaseKey = key; _hasManualPhaseSelection = true; }
    private void FollowCurrentPhase() { _selectedPhaseKey = CurrentPhase.Key; _hasManualPhaseSelection = false; }
    private void OnDashboardChanged() { if (!_hasManualPhaseSelection) _selectedPhaseKey = CurrentPhase.Key; _ = InvokeAsync(StateHasChanged); }
    private static string PhaseKeyForActivity(string? key) => key?.ToLowerInvariant() switch { "scan" or "discover" or "file" or "ingestion" => "discover", "identity" or "wikidata" or "retail" or "match" => "identify", "relationships" or "relationship" or "universe" or "organize" or "collections" => "organize", _ => "enrich" };
    private static string PhaseStatusIcon(LibraryUpdateStepStatus status) => status switch { LibraryUpdateStepStatus.Complete => Icons.Material.Outlined.Check, LibraryUpdateStepStatus.InProgress => Icons.Material.Outlined.Sync, LibraryUpdateStepStatus.NeedsReview => Icons.Material.Outlined.WarningAmber, _ => Icons.Material.Outlined.Schedule };
    private static PhaseViewModel Phase(string key, string label, string description, string icon, LibraryUpdateStepStatus status) => new(key, label, description, icon, status, status switch { LibraryUpdateStepStatus.Complete => "Complete", LibraryUpdateStepStatus.InProgress => "Active", LibraryUpdateStepStatus.NeedsReview => "Needs review", _ => "Up next" });
    private LibraryUpdateStepStatus DisplayStepStatus(int index)
    {
        if (!IsRunning && DisplayBatch is not null && string.Equals(DisplayBatch.Status, "completed", StringComparison.OrdinalIgnoreCase))
            return DisplayBatch.ReviewCount > 0 && index == 2 ? LibraryUpdateStepStatus.NeedsReview : LibraryUpdateStepStatus.Complete;
        return StatusAt(Model.Steps, index);
    }
    private static LibraryUpdateStepStatus StatusAt(IReadOnlyList<LibraryUpdateStepViewModel> steps, int index) => index < steps.Count ? steps[index].Status : LibraryUpdateStepStatus.Pending;
    private static LibraryUpdateStepStatus Combine(IEnumerable<LibraryUpdateStepStatus> statuses) { var values = statuses.ToList(); if (values.Contains(LibraryUpdateStepStatus.InProgress)) return LibraryUpdateStepStatus.InProgress; if (values.Contains(LibraryUpdateStepStatus.NeedsReview)) return LibraryUpdateStepStatus.NeedsReview; return values.Count > 0 && values.All(status => status == LibraryUpdateStepStatus.Complete) ? LibraryUpdateStepStatus.Complete : LibraryUpdateStepStatus.Pending; }
    private string PhaseClass(PhaseViewModel phase) => $"ingestion-stage is-{phase.Status.ToString().ToLowerInvariant()} {(SelectedPhase.Key == phase.Key ? "is-selected" : null)}";
    private static string BatchTitle(IngestionOperationsBatchDto batch) => !string.IsNullOrWhiteSpace(batch.MediaType) ? $"Library scan — {batch.MediaType}" : !string.IsNullOrWhiteSpace(batch.Source) ? $"Library scan — {Path.GetFileName(batch.Source.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))}" : "Library scan";
    private static string BatchSummary(IngestionOperationsBatchDto batch) => !string.IsNullOrWhiteSpace(batch.Summary) ? batch.Summary : $"{batch.ProcessedFiles:N0} files checked · {batch.RegisteredCount:N0} added or updated";
    private static string RunActivityHref(IngestionOperationsBatchDto batch) => $"/settings/activity?runId={batch.BatchId:D}";
    private static bool IsActiveStatus(string? status) => status is not null && status.ToLowerInvariant() is "running" or "queued" or "processing" or "active";
    private static string ActivityLabel(IngestionCurrentActivityDto activity) => string.IsNullOrWhiteSpace(activity.Message) ? "Updating library details" : activity.Message;
    private static string ActivityCounts(IngestionCurrentActivityDto activity) { var parts = new List<string>(); if (activity.ActiveCount > 0) parts.Add($"{activity.ActiveCount:N0} active"); if (activity.QueuedCount > 0) parts.Add($"{activity.QueuedCount:N0} queued"); if (activity.ProcessedCount > 0) parts.Add($"{activity.ProcessedCount:N0} completed"); return parts.Count == 0 ? "In progress" : string.Join(" · ", parts); }
    private static string ActivityProgressCounts(IngestionCurrentActivityDto activity) => activity.TotalCount > 0 ? $"{Math.Min(activity.ProcessedCount, activity.TotalCount):N0} of {activity.TotalCount:N0} complete" : ActivityCounts(activity);
    private static double ActivityPercent(IngestionCurrentActivityDto activity) => activity.TotalCount > 0 ? Math.Clamp(activity.ProcessedCount * 100d / activity.TotalCount, 0, 100) : 0;
    private static string ActivityDescription(string? key) => key?.ToLowerInvariant() switch { "artwork" => "Downloading posters, covers, and supported artwork", "people" => "Matching and enriching credited people", "relationships" or "universe" => "Building series, collections, and connections", "wikidata" or "identity" => "Resolving trusted canonical identities", "metadata" => "Updating titles, facts, and descriptions", "subtitles" => "Finding and storing subtitle tracks", "lyrics" => "Finding and storing lyrics", _ => "Processing library enrichment work" };
    private static string ActivityIcon(string? key) => key?.ToLowerInvariant() switch { "artwork" => Icons.Material.Outlined.Image, "people" => Icons.Material.Outlined.People, "relationships" or "universe" => Icons.Material.Outlined.AccountTree, "wikidata" or "identity" => Icons.Material.Outlined.Search, _ => Icons.Material.Outlined.AutoAwesome };
    private double MediaPercent(int count) => Math.Max(8, count * 100d / Math.Max(1, MediaMix.Max(metric => metric.Count)));
    private static string FormatDuration(int seconds) => TimeSpan.FromSeconds(Math.Max(0, seconds)) switch { var span when span.TotalHours >= 1 => $"{(int)span.TotalHours}h {span.Minutes}m", var span when span.TotalMinutes >= 1 => $"{(int)span.TotalMinutes}m {span.Seconds}s", var span => $"{span.Seconds}s" };
    private static string FormatRelative(DateTimeOffset value) { var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime(); return elapsed.TotalMinutes switch { < 1 => "just now", < 60 => $"{(int)elapsed.TotalMinutes}m ago", < 1440 => $"{(int)elapsed.TotalHours}h ago", _ => $"{(int)elapsed.TotalDays}d ago" }; }
    private static string Pluralize(string value, int count) => count == 1 ? value : value + "s";
    private Task ScanNowAsync() => Dashboard.ScanNowAsync();
    public async ValueTask DisposeAsync() { Dashboard.OnChanged -= OnDashboardChanged; await Dashboard.StopAsync(); }

    private sealed record PhaseViewModel(string Key, string Label, string Description, string Icon, LibraryUpdateStepStatus Status, string StatusLabel);
    private sealed record StageFact(string Label, string Value);
    private sealed record OutcomeMetric(string Label, int Value, string Icon, string Tone, string? Href);
    private sealed record MediaMetric(string Label, int Count, string Icon);
}
