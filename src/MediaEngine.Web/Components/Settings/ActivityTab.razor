@namespace MediaEngine.Web.Components.Settings
@inject DeviceContextService DeviceContext

<div class="tl-page activity-page">
    <ActivityBatchExplorer />

    @if (!DeviceContext.IsMobile)
    {
        <details class="activity-page__advanced">
            <summary>Maintenance &amp; retention</summary>
            <ActivityMaintenancePanel />
        </details>
    }
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "batches";
}
