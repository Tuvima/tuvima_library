@namespace MediaEngine.Web.Components.Settings

<div class="tl-page activity-page">
    @if (ActiveSubsection == "events")
    {
        <ActivityEventsLedger />
        <ActivityMaintenancePanel />
    }
    else if (ActiveSubsection == "batches")
    {
        <ActivityBatchExplorer />
    }
    else
    {
        <ActivityPeopleAudit />
    }
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "events";

    private string ActiveSubsection => Subsection.ToLowerInvariant() switch
    {
        "batches" => "batches",
        "people" => "people",
        _ => "events",
    };
}
