@namespace MediaEngine.Web.Components.Settings

<div class="tl-page activity-page">
    <AppTabs Elevation="0"
             Rounded="true"
             ActivePanelIndex="@ActivePanelIndex"
             Class="settings-tab-strip activity-page__tabs settings-tabs--sidebar-controlled">
        <AppTabPanel Text="Batches" Icon="@Icons.Material.Outlined.FolderCopy">
            <ActivityBatchExplorer />
        </AppTabPanel>
        <AppTabPanel Text="People" Icon="@Icons.Material.Outlined.People">
            <ActivityPeopleAudit />
        </AppTabPanel>
        <AppTabPanel Text="Events" Icon="@Icons.Material.Outlined.Timeline">
            <ActivityEventsLedger />
        </AppTabPanel>
    </AppTabs>

    <ActivityMaintenancePanel />
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "batches";

    private int ActivePanelIndex => Subsection.ToLowerInvariant() switch
    {
        "people" => 1,
        "events" => 2,
        _ => 0,
    };
}
