@namespace MediaEngine.Web.Components.Settings

<div class="ingestion-settings">
    <AppPanel Class="ingestion-settings__intro">
        <MudIcon Icon="@Icons.Material.Outlined.SettingsSuggest" />
        <div>
            <h2>Ingestion behavior</h2>
            <p>Choose where Tuvima looks for media and how recognized items are matched and enriched. Live progress and history remain in Operations.</p>
        </div>
        <AppButton Href="/operations/ingestion" Label="Open live ingestion" ButtonStyle="AppButtonStyle.Outlined" EndIcon="@Icons.Material.Outlined.OpenInNew" />
    </AppPanel>

    <div class="ingestion-settings__cards">
        <a href="/settings/libraries">
            <span><MudIcon Icon="@Icons.Material.Outlined.FolderOpen" /></span>
            <strong>Folders and discovery</strong>
            <p>Configure watched folders, ownership, duplicate handling, and file-management policy.</p>
            <em>Open Libraries <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></em>
        </a>
        <a href="/settings/metadata/ingestion-flow">
            <span><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /></span>
            <strong>Matching and enrichment</strong>
            <p>Control which providers identify media and add metadata, relationships, people, and primary cover art.</p>
            <em>Open Ingestion Flow <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" /></em>
        </a>
    </div>
</div>
