@namespace MediaEngine.Web.Components.Settings
@inject IEngineApiClient ApiClient
@inject ProviderCatalogueService CatalogueService
@inject ILogger<ProviderPrioritySurface> Logger
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<NavigationLock ConfirmExternalNavigation="@HasChanges"
                OnBeforeInternalNavigation="ConfirmInternalNavigationAsync" />

<div class="source-priority-page">
    @if (_selectedCapabilityId is not null)
    {
        <header class="source-priority-editor-header">
            <div class="source-priority-breadcrumb" aria-label="Source priority location">
                <AppNativeButton Type="button" Class="source-priority-breadcrumb__link" OnClick="BackToLanding">Source Priority</AppNativeButton>
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                <span>@DisplayMediaType(_activeMediaType)</span>
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                <strong>@CurrentCapability?.Definition.Label</strong>
            </div>
            <p>Drag to reorder providers. The top available provider is used first.</p>
            <div class="source-priority-editor-header__actions">
                <AppButton Label="Reset to Defaults" StartIcon="@Icons.Material.Outlined.RestartAlt" Size="AppControlSize.Compact"
                           Disabled="@(!CanResetCurrentCapability)" OnClick="ResetCurrentCapability" />
                <AppButton Label="How it works" StartIcon="@Icons.Material.Outlined.HelpOutline" Size="AppControlSize.Compact" OnClick="@(() => _howDialogOpen = true)" />
            </div>
        </header>
    }

    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading source priority" Class="py-8" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <AppAlert Tone="AppUiTone.Warning">@_loadError</AppAlert>
    }
    else if (_selectedCapabilityId is null)
    {
        <div class="source-priority-layout">
            <MetadataSelectorRail Items="@MediaSelectorItems"
                                  SelectedId="@_activeMediaType"
                                  SelectionChanged="SelectMediaType"
                                  Title="Media types"
                                  AriaLabel="Media types"
                                  ShowIcons="true" />

            <section class="source-priority-capabilities">
                <div class="source-priority-capabilities__heading">
                    <div><h3>@DisplayMediaType(_activeMediaType)</h3><p>Configure provider priority for each supported capability.</p></div>
                    <AppButton Label="How it works" StartIcon="@Icons.Material.Outlined.HelpOutline" Size="AppControlSize.Compact" OnClick="@(() => _howDialogOpen = true)" />
                </div>
                <div class="source-priority-capability-list">
                    @foreach (var capability in CurrentCapabilities)
                    {
                        <AppNativeButton Type="button" Class="source-priority-capability-row"
                                         AriaLabel="@($"Configure {DisplayMediaType(_activeMediaType)} {capability.Definition.Label} priority")"
                                         OnClick="@(() => OpenCapability(capability.Definition.Id))">
                            <span class="source-priority-capability-row__icon"><MudIcon Icon="@capability.Definition.Icon" Size="Size.Small" /></span>
                            <span class="source-priority-capability-row__copy"><strong>@capability.Definition.Label</strong><small>@capability.Definition.Description</small></span>
                            <span class="source-priority-capability-row__count">@ProviderCount(capability) @(ProviderCount(capability) == 1 ? "source" : "sources")</span>
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                        </AppNativeButton>
                    }
                </div>
            </section>
        </div>

        <footer class="source-priority-actions source-priority-actions--landing">
            <AppButton Label="Copy from another media type" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="OpenCopyDialog" />
            <span class="source-priority-actions__spacer"></span>
            <AppButton Label="Back to Providers" OnClick="BackToProvidersAsync" />
            <AppButton Label="Reset All to Defaults" StartIcon="@Icons.Material.Outlined.RestartAlt" OnClick="ResetAllAsync" />
            <AppButton Label="@(_saving ? "Saving..." : "Save All")" StartIcon="@Icons.Material.Outlined.Save"
                       Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || !HasChanges)" OnClick="SaveAsync" />
        </footer>
    }
    else if (CurrentCapability is not null)
    {
        <section class="source-priority-editor">
            <div class="source-priority-editor__table-header" aria-hidden="true">
                <span></span><span>Order</span><span>Provider</span><span>Role</span><span>Status</span><span>Actions</span>
            </div>
            <div class="source-priority-chain" role="list" aria-label="@($"{DisplayMediaType(_activeMediaType)} {CurrentCapability.Definition.Label} provider order")">
                @for (var index = 0; index < CurrentChain.Count; index++)
                {
                    var itemIndex = index;
                    var provider = CurrentChain[index];
                    var locked = IsLockedInCurrentCapability(provider);
                    <div class="source-priority-provider-row @(locked ? "is-locked" : null)"
                         role="listitem" @ondragover:preventDefault="@(!locked)" @ondrop="@(() => DropAt(itemIndex))">
                        @if (locked)
                        {
                            <span class="source-priority-provider-row__locked"><MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" /></span>
                        }
                        else
                        {
                            <AppNativeButton Type="button" Class="source-priority-provider-row__handle"
                                             AriaLabel="@($"Drag {provider.DisplayName} to reorder")" Title="Drag to reorder"
                                             draggable="true" @ondragstart="@(() => BeginDrag(itemIndex))" @ondragend="EndDrag">
                                <MudIcon Icon="@Icons.Material.Outlined.DragIndicator" Size="Size.Small" />
                            </AppNativeButton>
                        }
                        <span class="source-priority-provider-row__rank">@(index + 1)</span>
                        <div class="source-priority-provider-row__identity">
                            <AppProviderLogo ImageUrl="@provider.LogoUrl" Icon="@provider.Icon" AccentColor="@provider.AccentColor"
                                             FallbackText="@Initials(provider.DisplayName)" Size="AppControlSize.Compact" AltText="" />
                            <span><strong>@provider.DisplayName</strong><small>@ProviderRoleDescription(provider, index)</small></span>
                        </div>
                        <AppStatusBadge Text="@PriorityLabel(provider, index)" Tone="@PriorityTone(provider, index)" />
                        <AppStatusBadge Text="@provider.HealthStatus" Tone="@ProviderHealthTone(provider)" />
                        <div class="source-priority-provider-row__actions">
                            <AppOverflowMenu AriaLabel="@($"More priority actions for {provider.DisplayName}")">
                                <AppMenuItem Label="Move earlier" Disabled="@(locked || index == 0)" OnClick="@(() => Move(itemIndex, -1))" />
                                <AppMenuItem Label="Move later" Disabled="@(locked || index == CurrentChain.Count - 1)" OnClick="@(() => Move(itemIndex, 1))" />
                                <AppMenuItem Label="Remove from this capability" Icon="@Icons.Material.Outlined.RemoveCircleOutline"
                                             Tone="AppUiTone.Error" Disabled="@locked" OnClick="@(() => Remove(itemIndex))" />
                            </AppOverflowMenu>
                        </div>
                    </div>
                }

                @foreach (var provider in CurrentSupportProviders)
                {
                    <div class="source-priority-provider-row is-support" role="listitem">
                        <span class="source-priority-provider-row__locked"><MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" /></span>
                        <span class="source-priority-provider-row__rank">—</span>
                        <div class="source-priority-provider-row__identity">
                            <AppProviderLogo ImageUrl="@provider.LogoUrl" Icon="@provider.Icon" AccentColor="@provider.AccentColor"
                                             FallbackText="@Initials(provider.DisplayName)" Size="AppControlSize.Compact" AltText="" />
                            <span><strong>@provider.DisplayName</strong><small>System or stage-defined support</small></span>
                        </div>
                        <AppStatusBadge Text="Support" Tone="AppUiTone.Info" />
                        <AppStatusBadge Text="@provider.HealthStatus" Tone="@ProviderHealthTone(provider)" />
                        <span></span>
                    </div>
                }
            </div>

            <div class="source-priority-add-zone">
                <span>Drag handles reorder only this media type and capability.</span>
                <AppButton Label="Add Provider" StartIcon="@Icons.Material.Outlined.Add" Size="AppControlSize.Compact"
                           Disabled="@(AvailableProviders.Count == 0)" OnClick="OpenAddDialog" />
            </div>
        </section>

        <footer class="source-priority-actions">
            <div class="source-priority-scope-note"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /><span>Changes apply only to @DisplayMediaType(_activeMediaType) → @CurrentCapability.Definition.Label.</span></div>
            <span class="source-priority-actions__spacer"></span>
            <AppButton Label="Cancel" OnClick="CancelEditor" />
            <AppButton Label="@(_saving ? "Saving..." : "Save Changes")" StartIcon="@Icons.Material.Outlined.Save"
                       Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || !HasChanges)" OnClick="SaveEditorAsync" />
        </footer>
    }
</div>

<AppDialog @bind-Visible="_addDialogOpen" Title="@($"Add provider to {DisplayMediaType(_activeMediaType)} {CurrentCapability?.Definition.Label}")"
           Size="Small" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
    <ChildContent>
        @if (AvailableProviders.Count == 0)
        {
            <AppEmptyState Title="No compatible providers available" Message="Every compatible configurable provider is already in this capability chain." />
        }
        else
        {
            <div class="source-priority-add-list">
                @foreach (var provider in AvailableProviders)
                {
                    <AppNativeButton Type="button" Class="source-priority-add-row" AriaLabel="@($"Add {provider.DisplayName}")" OnClick="@(() => Add(provider))">
                        <AppProviderLogo ImageUrl="@provider.LogoUrl" Icon="@provider.Icon" AccentColor="@provider.AccentColor"
                                         FallbackText="@Initials(provider.DisplayName)" Size="AppControlSize.Compact" AltText="" />
                        <span>@provider.DisplayName</span><MudIcon Icon="@Icons.Material.Outlined.Add" />
                    </AppNativeButton>
                }
            </div>
        }
    </ChildContent>
    <FooterContent><AppButton Label="Close" OnClick="@(() => _addDialogOpen = false)" /></FooterContent>
</AppDialog>

<AppDialog @bind-Visible="_copyDialogOpen" Title="@($"Copy priority to {DisplayMediaType(_activeMediaType)}")" Size="Small"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
    <ChildContent>
        <p class="source-priority-dialog-copy">Compatible capability orders are copied as a starting point. Unsupported providers and destination-only sources are preserved.</p>
        <AppSelect T="string" Value="@_copySourceMediaType" ValueChanged="SetCopySource" Label="Copy from" Options="@CopyOptions" />
    </ChildContent>
    <FooterContent>
        <AppButton Label="Cancel" OnClick="@(() => _copyDialogOpen = false)" />
        <AppButton Label="Copy Priority" StartIcon="@Icons.Material.Outlined.ContentCopy" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled"
                   Disabled="@(string.IsNullOrWhiteSpace(_copySourceMediaType))" OnClick="CopyFromSelectedMediaType" />
    </FooterContent>
</AppDialog>

<AppDialog @bind-Visible="_howDialogOpen" Title="How source priority works" Size="Small"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
    <ChildContent>
        <ol class="source-priority-how-list">
            <li>The top configurable provider is considered first for the selected capability.</li>
            <li>Later providers participate according to the Engine's existing fallback and claim-resolution behavior.</li>
            <li>Locked support sources remain controlled by canonical or enrichment stages.</li>
            <li>Drag the handle to reorder; the overflow menu provides keyboard-accessible Move earlier and Move later actions.</li>
        </ol>
    </ChildContent>
    <FooterContent><AppButton Label="Close" OnClick="@(() => _howDialogOpen = false)" /></FooterContent>
</AppDialog>
