@namespace MediaEngine.Web.Components.Settings
@inject IEngineApiClient ApiClient
@inject ProviderCatalogueService CatalogueService
@inject ILogger<ProviderEnrichmentSurface> Logger
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="enrichment-page">
    <div class="metadata-summary-grid metadata-summary-grid--three" aria-label="Enrichment summary">
        <MetadataMetricTile Value="@_items.Count.ToString()" Label="Enrichment types" Icon="@Icons.Material.Outlined.AutoAwesome" />
        <MetadataMetricTile Value="@EnabledCount.ToString()" Label="Enabled" Icon="@Icons.Material.Outlined.ToggleOn" Tone="AppUiTone.Neutral" />
        <MetadataMetricTile Value="@IssueCount.ToString()" Label="Issues" Icon="@Icons.Material.Outlined.WarningAmber" Tone="AppUiTone.Warning" />
    </div>

    @if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading enrichment policies" Class="py-8" />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <AppAlert Tone="AppUiTone.Warning">@_loadError</AppAlert>
    }
    else
    {
        <div class="enrichment-layout">
            <MetadataSelectorRail Items="@CategorySelectorItems"
                                  SelectedId="@_activeCategory"
                                  SelectionChanged="SelectCategory"
                                  AriaLabel="Enrichment categories" />

            <section class="enrichment-table" aria-label="Enrichment policies">
                <div class="enrichment-table__header" aria-hidden="true"><span>Enrichment type</span><span>Description</span><span>Sources</span><span>Status</span><span>Actions</span></div>
                @foreach (var item in FilteredItems)
                {
                    <article class="enrichment-row">
                        <div class="enrichment-row__identity" data-label="Enrichment type">
                            <span class="enrichment-row__icon"><MudIcon Icon="@item.Icon" Size="Size.Small" /></span><strong>@item.Title</strong>
                        </div>
                        <p data-label="Description">@item.Description</p>
                        <div class="enrichment-row__sources" data-label="Sources">
                            <span class="enrichment-row__media-icons">
                                @foreach (var mediaType in SourceMediaTypes(item))
                                {
                                    <MetadataMediaIconChip Label="@DisplayMediaType(mediaType)" Icon="@MediaTypeIcon(mediaType)" />
                                }
                            </span>
                            <AppNativeButton Type="button" Class="enrichment-row__source-link" AriaLabel="@($"View {item.Title} sources")" OnClick="@(() => OpenPolicy(item))">
                                @SourceCount(item) @(SourceCount(item) == 1 ? "source" : "sources")
                            </AppNativeButton>
                        </div>
                        <AppStatusBadge Text="@StatusLabel(item)" Tone="@StatusTone(item)" />
                        <div class="enrichment-row__actions" data-label="Actions">
                            <AppButton Label="Configure" Size="AppControlSize.Compact" OnClick="@(() => OpenPolicy(item))" />
                            <AppOverflowMenu AriaLabel="@($"More actions for {item.Title}")">
                                <AppMenuItem Label="Manage providers" Icon="@Icons.Material.Outlined.Dns" OnClick="OpenProviders" />
                                @if (item.HasSourcePriority)
                                {
                                    <AppMenuItem Label="Manage source priority" Icon="@Icons.Material.Outlined.LowPriority" OnClick="OpenPriority" />
                                }
                            </AppOverflowMenu>
                        </div>
                    </article>
                }
            </section>
        </div>

        <footer class="enrichment-footer">
            <div><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" /><span>Enrichment runs automatically when supported sources and required identities are available.</span></div>
            <AppButton Label="@(_running ? "Queueing..." : "Run Enrichment Now")" StartIcon="@Icons.Material.Outlined.Bolt"
                       Disabled="@(_running || _hydration?.Stage3Enabled != true)" OnClick="RunEnrichmentNowAsync" />
        </footer>

        <EnrichmentRefreshSchedulePanel />
    }
</div>

<MudDrawer Open="@(_selectedItem is not null)" OpenChanged="OnDrawerOpenChangedAsync" Anchor="Anchor.End" Width="480px"
           Overlay="true" Variant="DrawerVariant.Temporary" Class="enrichment-policy-drawer">
    @if (_selectedItem is not null && _draft is not null)
    {
        <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
            <div class="enrichment-drawer" role="dialog" aria-modal="true" aria-label="@($"Configure {_selectedItem.Title} enrichment")">
                <header class="enrichment-drawer__header">
                    <span><MudIcon Icon="@_selectedItem.Icon" /></span>
                    <div><h2>@_selectedItem.Title</h2><p>@_selectedItem.Description</p></div>
                    <AppIconButton Icon="@Icons.Material.Filled.Close" AriaLabel="@($"Close {_selectedItem.Title} enrichment settings")" Tooltip="Close" OnClick="CloseDrawerAsync" />
                </header>
                <div class="enrichment-drawer__body">
                    <section>
                        <h3>Sources</h3>
                        <div class="enrichment-drawer__sources">
                            @foreach (var provider in SourcesFor(_selectedItem))
                            {
                                <div><AppProviderLogo ImageUrl="@ProviderLogo(provider)" Icon="@ProviderIcon(provider)" AccentColor="@provider.AccentColor"
                                                      FallbackText="@Initials(provider.DisplayName)" Size="AppControlSize.Compact" AltText="" /><span>@provider.DisplayName</span></div>
                            }
                        </div>
                        <p>Source ordering stays in Source Priority; provider connection settings stay on Providers.</p>
                    </section>

                    @if (_selectedItem.PolicyKind == EnrichmentPolicyKind.ProviderManaged)
                    {
                        <section><h3>Automatic behavior</h3><AppAlert Tone="AppUiTone.Info">This enrichment currently follows provider availability. Tuvima does not expose a separate policy setting for it.</AppAlert></section>
                    }
                    else
                    {
                        <section>
                            <h3>Automatic enrichment</h3>
                            <AppSwitchRow Label="Universe enrichment" Value="@_draft.Stage3Enabled" ValueChanged="@(value => _draft.Stage3Enabled = value)"
                                          AriaLabel="Toggle universe enrichment" />
                            <p>This is a shared Stage 3 switch. Turning it off pauses artwork, people, relationship, and series enrichment together.</p>
                        </section>

                        <section>
                            <h3>@_selectedItem.Title policy</h3>
                            @if (_selectedItem.PolicyKind == EnrichmentPolicyKind.Artwork)
                            {
                                <AppNumericField T="int" @bind-Value="_draft.MaxConcurrentFanartJobs" Label="Concurrent artwork jobs" Min="1" Max="8" />
                                <AppNumericField T="int" @bind-Value="_draft.Stage3MaxItemsPerSweep" Label="Items per sweep" Min="1" Max="1000" />
                                <AppNumericField T="int" @bind-Value="_draft.Stage3RateLimitMs" Label="Delay between requests (ms)" Min="0" Max="60000" />
                                <AppNumericField T="int" @bind-Value="_draft.Stage3RefreshDays" Label="Refresh interval (days)" Min="1" Max="3650" />
                            }
                            else if (_selectedItem.PolicyKind == EnrichmentPolicyKind.People)
                            {
                                <AppNumericField T="int" @bind-Value="_draft.PersonRefreshDays" Label="People refresh interval (days)" Min="1" Max="3650" />
                                <AppNumericField T="int" @bind-Value="_draft.Stage3MaxDepth" Label="Maximum enrichment depth" Min="1" Max="10" />
                            }
                            else if (_selectedItem.PolicyKind == EnrichmentPolicyKind.Relationships)
                            {
                                <AppNumericField T="int" @bind-Value="_draft.Stage3MaxDepth" Label="Maximum relationship depth" Min="1" Max="10" />
                                <AppNumericField T="int" @bind-Value="_draft.Stage3RefreshDays" Label="Refresh interval (days)" Min="1" Max="3650" />
                            }
                            else if (_selectedItem.PolicyKind == EnrichmentPolicyKind.Series)
                            {
                                <AppNumericField T="int" @bind-Value="_draft.SeriesManifestRefreshDays" Label="Series manifest refresh (days)" Min="1" Max="3650" />
                                <AppNumericField T="int" @bind-Value="_draft.MinimumUniverseWorkCount" Label="Minimum works for universe grouping" Min="1" Max="100" />
                            }
                        </section>
                    }
                </div>
                <footer class="enrichment-drawer__footer">
                    @if (_selectedItem.PolicyKind == EnrichmentPolicyKind.ProviderManaged)
                    {
                        <AppButton Label="Manage Providers" StartIcon="@Icons.Material.Outlined.Dns" OnClick="OpenProviders" />
                        <AppButton Label="Close" Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" OnClick="CloseDrawerAsync" />
                    }
                    else
                    {
                        <AppButton Label="Cancel" OnClick="CloseDrawerAsync" />
                        <AppButton Label="@(_saving ? "Saving..." : "Save Changes")" StartIcon="@Icons.Material.Outlined.Save"
                                   Tone="AppUiTone.Primary" ButtonStyle="AppButtonStyle.Filled" Disabled="@(_saving || !DrawerHasChanges)" OnClick="SavePolicyAsync" />
                    }
                </footer>
            </div>
        </MudFocusTrap>
    }
</MudDrawer>
