@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.System
@using Microsoft.JSInterop
@inject IEngineApiClient ApiClient
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="backup-page">
    <div class="backup-page__toolbar">
        <AppButton Label="Refresh" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="@(_busy || _loading)" OnClick="LoadAsync" />
    </div>

    @if (_loading)
    {
        <div class="backup-panel__loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            <span>Loading backups...</span>
        </div>
    }
    else
    {
        <AppPanel Elevation="0" Class="tl-card backup-status">
            <MudText Typo="Typo.h6">Backup status</MudText>
            @if (LatestBackup is null)
            {
                <div class="backup-status__empty"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" /><span><strong>No recovery points yet</strong><small>Create a backup before significant library or configuration changes.</small></span></div>
            }
            else
            {
                <div class="backup-status__notice"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" /><span>Latest recovery point was created successfully.</span></div>
                <div class="backup-status__facts">
                    <div><small>Latest backup</small><strong>@LatestBackup.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</strong></div>
                    <div><small>Backup size</small><strong>@FormatBytes(LatestBackup.SizeBytes)</strong></div>
                    <div><small>Recovery points</small><strong>@_backups.Count</strong></div>
                </div>
            }
        </AppPanel>

        <div class="backup-actions-grid">
            <AppPanel Elevation="0" Class="tl-card backup-action-card">
                <MudText Typo="Typo.h6">Create backup</MudText>
                <p>Back up the library database and safe configuration. Provider secrets stay on this server.</p>
                <AppButton Label="Create backup" StartIcon="@Icons.Material.Outlined.Backup" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@_busy" Loading="@_busy" OnClick="CreateAsync" />
            </AppPanel>

            <AppPanel Elevation="0" Class="tl-card backup-action-card">
                <MudText Typo="Typo.h6">Restore</MudText>
                <p>The Engine validates and stages your chosen recovery point. Restart the Engine to apply it; the current database remains available as a recovery copy.</p>
                @if (_backups.Count == 0)
                {
                    <AppButton Label="No backups available" Disabled="true" />
                }
                else
                {
                    <div class="backup-list" aria-label="Available recovery points">
                        @foreach (var backup in _backups)
                        {
                            <div class="backup-list__row">
                                <div class="backup-list__identity"><strong>@backup.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</strong><small>@FormatBytes(backup.SizeBytes)</small></div>
                                <div class="backup-list__actions">
                                    <AppButton Label="Download" ButtonStyle="AppButtonStyle.Text" StartIcon="@Icons.Material.Outlined.Download" Disabled="@_busy" OnClick="@(() => DownloadAsync(backup))" />
                                    <AppButton Label="Restore" ButtonStyle="AppButtonStyle.Outlined" Tone="AppUiTone.Warning" StartIcon="@Icons.Material.Outlined.Restore" Disabled="@_busy" OnClick="@(() => RestoreAsync(backup))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </AppPanel>
        </div>

        <details class="backup-advanced">
            <summary>Advanced</summary>
            <div class="backup-advanced__content">
                <div><span>Stored content</span><strong>SQLite snapshot + non-secret configuration</strong></div>
                <div><span>Total archive size</span><strong>@FormatBytes(_backups.Sum(item => item.SizeBytes))</strong></div>
                <p>Backup location and retention are controlled by the Engine's server configuration.</p>
            </div>
        </details>
    }

    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <AppAlert Severity="@(_restartRequired ? Severity.Warning : Severity.Info)"
                  Variant="Variant.Outlined"
                  Dense="true">
            @_notice
        </AppAlert>
    }
</div>

@code {
    private IReadOnlyList<BackupArchiveDto> _backups = [];
    private bool _loading = true;
    private bool _busy;
    private bool _restartRequired;
    private string? _notice;
    private BackupArchiveDto? LatestBackup => _backups.OrderByDescending(item => item.CreatedAt).FirstOrDefault();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _backups = await ApiClient.GetBackupsAsync();
        _loading = false;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _notice = null;
        _restartRequired = false;
        var backup = await ApiClient.CreateBackupAsync();
        if (backup is null)
        {
            Snackbar.Add("The backup could not be created.", Severity.Error);
        }
        else
        {
            Snackbar.Add("Recovery point created.", Severity.Success);
            await LoadAsync();
        }
        _busy = false;
    }

    private async Task DownloadAsync(BackupArchiveDto backup)
    {
        _busy = true;
        var bytes = await ApiClient.DownloadBackupAsync(backup.FileName);
        if (bytes is null)
        {
            Snackbar.Add("The backup could not be downloaded.", Severity.Error);
        }
        else
        {
            await using var stream = new MemoryStream(bytes, writable: false);
            using var reference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("tuvimaDownloads.fromStream", backup.FileName, reference);
        }
        _busy = false;
    }

    private async Task RestoreAsync(BackupArchiveDto backup)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Schedule this recovery point? The current library will be preserved as a safety copy, and the Engine must be restarted to apply it.");
        if (!confirmed) return;

        _busy = true;
        var result = await ApiClient.ScheduleRestoreAsync(backup.FileName);
        if (result?.Scheduled == true)
        {
            _notice = result.Message;
            _restartRequired = result.RestartRequired;
            Snackbar.Add(
                result.RestartRequired
                    ? "Restore scheduled. Restart the Engine when ready."
                    : "Restore scheduled.",
                result.RestartRequired ? Severity.Warning : Severity.Success);
        }
        else
        {
            Snackbar.Add("The restore could not be scheduled.", Severity.Error);
        }
        _busy = false;
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824d:0.0} GB",
        >= 1_048_576 => $"{bytes / 1_048_576d:0.0} MB",
        >= 1024 => $"{bytes / 1024d:0.0} KB",
        _ => $"{bytes} B",
    };
}
