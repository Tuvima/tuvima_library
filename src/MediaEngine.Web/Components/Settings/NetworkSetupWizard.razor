@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<section class="network-setup network-settings">
    <header class="network-setup__header">
        <span class="network-setup__mark"><MudIcon Icon="@Icons.Material.Outlined.Lan" /></span>
        <div>
            <p class="network-setup__eyebrow">Tuvima setup</p>
            <h1>Network &amp; Remote Access</h1>
            <p>Set up local discovery first, then choose whether this server should be reachable away from home.</p>
        </div>
    </header>

    <ol class="network-setup__steps" aria-label="Setup progress">
        @Step(0, "Local network")
        @Step(1, "Remote access")
        @Step(2, "Streaming")
        @Step(3, "Finish")
    </ol>

    @if (_loading)
    {
        <AppSkeleton Size="AppControlSize.Large" />
    }
    else if (_settings is null)
    {
        <AppErrorState Title="The Engine is unavailable" Message="Start the Engine, then retry network setup." />
    }
    else
    {
        <div class="network-setup__content">
            @switch (_step)
            {
                case 0:
                    <LocalNetworkSettingsPanel Settings="@_settings" Status="@_status"
                                               SaveRequested="SaveAsync" StatusRefreshRequested="RefreshStatusAsync" />
                    break;
                case 1:
                    <RemoteAccessSettingsPanel Settings="@_settings" Status="@_status"
                                               SaveRequested="SaveAsync" StatusRefreshRequested="RefreshStatusAsync" />
                    break;
                case 2:
                    <NetworkStreamingSettingsPanel Settings="@_settings" Status="@_status"
                                                   SaveRequested="SaveAsync" StatusRefreshRequested="RefreshStatusAsync" />
                    break;
                default:
                    <div class="network-setup__finish">
                        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" />
                        <h2>Ready to connect</h2>
                        <p>@(_status?.Headline ?? "Your settings are ready to save.")</p>
                        <dl class="network-facts">
                            @Fact("Local address", _status?.PreferredLocalAddress ?? "Detected after the Dashboard starts")
                            @Fact("Local discovery", _settings.Local.DiscoveryEnabled ? $"{_settings.Local.PreferredServerName}.local" : "Off")
                            @Fact("Remote access", _settings.Remote.Enabled ? "On" : "Off — local only")
                            @Fact("Remote quality", Display(_settings.Streaming.RemoteQuality))
                        </dl>
                    </div>
                    break;
            }
        </div>

        <footer class="network-setup__actions">
            <AppButton Label="Skip for now" OnClick="SkipAsync" />
            <span></span>
            @if (_step > 0)
            {
                <AppButton Label="Back" OnClick="Back" />
            }
            <AppButton Label="@(_step == 3 ? "Finish setup" : "Continue")"
                       ButtonStyle="AppButtonStyle.Filled" OnClick="NextAsync" />
        </footer>
    }
</section>

@code {
    private NetworkSettingsDto? _settings;
    private NetworkRuntimeStatusDto? _status;
    private int _step;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var settingsTask = ApiClient.GetNetworkSettingsAsync();
        var statusTask = ApiClient.GetNetworkRuntimeStatusAsync();
        await Task.WhenAll(settingsTask, statusTask);
        _settings = await settingsTask;
        _status = await statusTask;
        _loading = false;
    }

    private RenderFragment Step(int index, string label) => @<li class="@(_step == index ? "is-current" : _step > index ? "is-complete" : null)" aria-current="@(_step == index ? "step" : null)">
        <span>@(_step > index ? "✓" : (index + 1).ToString())</span><strong>@label</strong>
    </li>;

    private void Back() => _step = Math.Max(0, _step - 1);

    private async Task NextAsync()
    {
        if (_settings is null)
            return;
        await SaveAsync();
        if (_step < 3)
        {
            _step++;
            return;
        }
        _settings.SetupCompleted = true;
        if (await ApiClient.UpdateNetworkSettingsAsync(_settings) is null)
        {
            Snackbar.Add("Network setup could not be completed.", Severity.Error);
            return;
        }
        Navigation.NavigateTo("/", replace: true);
    }

    private async Task SkipAsync()
    {
        if (_settings is null)
            return;
        _settings.Remote.Enabled = false;
        _settings.SetupCompleted = true;
        if (await ApiClient.UpdateNetworkSettingsAsync(_settings) is null)
        {
            Snackbar.Add("Network setup could not be skipped.", Severity.Error);
            return;
        }
        Navigation.NavigateTo("/", replace: true);
    }

    private async Task SaveAsync()
    {
        if (_settings is null)
            return;
        _settings = await ApiClient.UpdateNetworkSettingsAsync(_settings) ?? _settings;
        await RefreshStatusAsync();
    }

    private async Task RefreshStatusAsync()
    {
        _status = await ApiClient.GetNetworkRuntimeStatusAsync();
        StateHasChanged();
    }

    private static string Display(string value) => string.Join(' ', value.Split('-', StringSplitOptions.RemoveEmptyEntries)
        .Select(part => char.ToUpperInvariant(part[0]) + part[1..]));
    private static RenderFragment Fact(string label, string value) => @<div><dt>@label</dt><dd>@value</dd></div>;
}
