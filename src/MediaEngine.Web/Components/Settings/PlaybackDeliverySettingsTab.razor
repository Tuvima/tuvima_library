@namespace MediaEngine.Web.Components.Settings

<div class="tl-page playback-delivery">
    <AppTabs ActivePanelIndex="@ActivePanelIndex"
             Class="settings-tab-strip">
        <AppTabPanel Text="Transcoding" Icon="@Icons.Material.Outlined.VideoSettings">
            <EncodeSettingsTab Section="transcoding" />
        </AppTabPanel>
        <AppTabPanel Text="Variant Storage" Icon="@Icons.Material.Outlined.Storage">
            <EncodeSettingsTab Section="storage" />
        </AppTabPanel>
        <AppTabPanel Text="Active Jobs" Icon="@Icons.Material.Outlined.PendingActions">
            <OfflineDownloadsTab />
        </AppTabPanel>
        <AppTabPanel Text="Diagnostics" Icon="@Icons.Material.Outlined.MonitorHeart">
            <EncodeSettingsTab Section="diagnostics" />
        </AppTabPanel>
    </AppTabs>
</div>

@code {
    [Parameter] public string Subsection { get; set; } = "transcoding";

    private int ActivePanelIndex => Subsection.ToLowerInvariant() switch
    {
        "storage" or "variant-storage" => 1,
        "jobs" or "active-jobs" or "offline" => 2,
        "diagnostics" => 3,
        _ => 0,
    };
}
