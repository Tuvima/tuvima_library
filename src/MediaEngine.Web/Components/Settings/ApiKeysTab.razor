@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L
<div class="tl-page api-keys-page">
    <SettingsSectionPanel Title="Guest API keys"
                          Description="Keys allow approved tools to connect without using a person's sign-in."
                          Icon="@Icons.Material.Outlined.Key">
        <AppActionBar Align="AppHorizontalAlignment.End" Class="mb-3">
            <AppButton Label="@L["ApiKeys_GenerateKey"].Value"
                       StartIcon="@Icons.Material.Filled.Add"
                       ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       OnClick="@OpenGenerateDialog"
                       Disabled="@_loading" />
        </AppActionBar>

        @if (_loading)
        {
            <AppProgressBar Indeterminate="true" />
        }
        else if (_keys.Count == 0)
        {
            <AppEmptyState Title="@L["ApiKeys_NoKeysIssued"].Value" />
        }
        else
        {
            <div class="api-keys-page__table-wrap">
                <AppTable>
                    <thead>
                        <tr>
                            <th>@L["ApiKeys_Label"]</th>
                            <th>Role</th>
                            <th>@L["ApiKeys_Created"]</th>
                            <th class="tl-text-right">@L["ApiKeys_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in _keys)
                        {
                            <tr>
                                <td>@key.Label</td>
                                <td><AppChip Text="@key.Role" Tone="AppUiTone.Neutral" /></td>
                                <td>@key.CreatedAt.LocalDateTime.ToString("MMM d, yyyy · HH:mm")</td>
                                <td class="tl-text-right">
                                    <AppIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Tone="AppUiTone.Error"
                                                   AriaLabel="@($"Revoke {key.Label}")"
                                                   Tooltip="@L["ApiKeys_RevokeThisKey"].Value"
                                                   OnClick="@(() => RevokeKeyAsync(key))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </AppTable>
            </div>
            <AppActionBar Align="AppHorizontalAlignment.End" Class="mt-4">
                <AppButton Label="@L["ApiKeys_RevokeAllKeys"].Value"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           ButtonStyle="AppButtonStyle.Outlined"
                           Tone="AppUiTone.Error"
                           OnClick="@OpenRevokeAllDialog"
                           Disabled="@_revokingAll" />
            </AppActionBar>
        }
    </SettingsSectionPanel>
</div>
<AppDialog @bind-Visible="_generateOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Class="mr-2" />
            @L["ApiKeys_GenerateGuestApiKey"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <AppTextField @bind-Value="_newLabel"
                      Label="@L["ApiKeys_Label"]"
                      Placeholder="@L["ApiKeys_LabelPlaceholder"]"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Class="mb-2"
                      Immediate="true" />

        @if (_newKey is not null)
        {
            <AppAlert Severity="Severity.Warning" Class="mt-4" Icon="@Icons.Material.Filled.Warning">
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    @L["ApiKeys_CopyKeyNow"]
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <code class="tl-inline-code tl-inline-code--strong tl-flex-1">
                        @_newKey.Key
                    </code>
                    <AppIconButton Icon="@(_copyAnimating
                                             ? Icons.Material.Filled.Check
                                             : Icons.Material.Filled.ContentCopy)"
                                   Color="@(_copyAnimating ? Color.Success : Color.Default)"
                                   Size="Size.Medium"
                                   title="@L["ApiKeys_CopyKeyToClipboard"]"
                                   OnClick="@CopyKeyAsync" />
                </MudStack>
            </AppAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (_newKey is null)
        {
            <AppButton OnClick="@CloseGenerateDialog">@L["ApiKeys_Cancel"]</AppButton>
            <AppButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(string.IsNullOrWhiteSpace(_newLabel) || _generating)"
                       OnClick="@GenerateKeyAsync">
                @(_generating ? L["ApiKeys_Generating"] : L["ApiKeys_Generate"])
            </AppButton>
        }
        else
        {
            <AppButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="@DismissNewKey">
                @L["ApiKeys_IveSavedTheKey"]
            </AppButton>
        }
    </DialogActions>
</AppDialog>
<AppDialog @bind-Visible="_revokeAllOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Color="Color.Error" />
            @L["ApiKeys_RevokeAllGuestApiKeys"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">
            @L["ApiKeys_RevokeAllConfirmation1"] <strong>@L["ApiKeys_All"] @_keys.Count</strong> @L["ApiKeys_RevokeAllConfirmation2"]
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            @L["ApiKeys_ActionCannotBeUndone"]
        </MudText>
    </DialogContent>
    <DialogActions>
        <AppButton OnClick="@CloseRevokeAllDialog">@L["ApiKeys_Cancel"]</AppButton>
        <AppButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="@RevokeAllKeysAsync"
                   Disabled="@_revokingAll">
            @(_revokingAll ? L["ApiKeys_Revoking"] : L["ApiKeys_RevokeAll"])
        </AppButton>
    </DialogActions>
</AppDialog>

@code {

    private bool                  _loading      = true;
    private List<ApiKeyDto> _keys         = [];
    private bool                  _generateOpen;
    private bool                  _generating;
    private string                _newLabel     = string.Empty;
    private CreateApiKeyResponse? _newKey;
    private bool                  _copyAnimating;
    private bool                  _revokeAllOpen;
    private bool                  _revokingAll;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth         = MaxWidth.Small,
        FullWidth        = true,
        CloseOnEscapeKey = true,
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshKeysAsync();
    }

    private async Task RefreshKeysAsync()
    {
        _loading = true;
        _keys    = await Orchestrator.GetApiKeysAsync();
        _loading = false;
    }

    private void OpenGenerateDialog()
    {
        _newLabel      = string.Empty;
        _newKey        = null;
        _copyAnimating = false;
        _generateOpen  = true;
    }

    private void CloseGenerateDialog()
    {
        _generateOpen  = false;
        _newKey        = null;
        _newLabel      = string.Empty;
        _copyAnimating = false;
    }

    private async Task GenerateKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(_newLabel)) return;
        _generating = true;
        _newKey     = await Orchestrator.CreateApiKeyAsync(_newLabel.Trim());
        _generating = false;

        if (_newKey is null)
        {
            Snackbar.Add(L["ApiKeys_CouldNotGenerateKey"], Severity.Error);
            _generateOpen = false;
        }
        else
        {
            await RefreshKeysAsync();
        }
    }

    private async Task CopyKeyAsync()
    {
        if (_newKey is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _newKey.Key);
        _copyAnimating = true;
        StateHasChanged();

        await Task.Delay(1500);
        _copyAnimating = false;
        StateHasChanged();

        Snackbar.Add(L["ApiKeys_KeyCopiedToClipboard"], Severity.Success);
    }

    private async Task DismissNewKey()
    {
        _newKey        = null;
        _generateOpen  = false;
        _newLabel      = string.Empty;
        _copyAnimating = false;
        await RefreshKeysAsync();
    }

    private async Task RevokeKeyAsync(ApiKeyDto key)
    {
        var ok = await Orchestrator.RevokeApiKeyAsync(key.Id);
        if (ok)
        {
            Snackbar.Add($"{L["ApiKeys_KeyRevoked"]} \"{key.Label}\"", Severity.Info);
            await RefreshKeysAsync();
        }
        else
        {
            Snackbar.Add(L["ApiKeys_RevokeFailed"], Severity.Error);
        }
    }

    private void OpenRevokeAllDialog() => _revokeAllOpen = true;

    private void CloseRevokeAllDialog() => _revokeAllOpen = false;

    private async Task RevokeAllKeysAsync()
    {
        _revokingAll = true;

        var revoked = await Orchestrator.RevokeAllApiKeysAsync();

        _revokeAllOpen = false;
        _revokingAll   = false;

        if (revoked > 0)
            Snackbar.Add($"{L["ApiKeys_AllKeysRevoked"]} {revoked} {L["ApiKeys_Keys"]}", Severity.Info);
        else
            Snackbar.Add(L["ApiKeys_CouldNotRevokeKeys"], Severity.Warning);

        await RefreshKeysAsync();
    }
}
