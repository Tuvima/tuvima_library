@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject DeviceContextService DeviceContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedStrings> L
@inject NavigationManager Nav

@{
    var readOnly = DeviceContext.IsMobile;
    var unavailable = DeviceContext.IsTelevision || DeviceContext.IsAutomotive;
    var section = NormalizeSection(Subsection);
    var activeLibrary = section == "libraries" ? ActiveFilteredLibrary : ActiveLibrary(section);
}

<div class="media-management">
    @if (unavailable)
    {
        <AppPageState Kind="AppPageStateKind.Unavailable"
                      Icon="@Icons.Material.Outlined.DesktopAccessDisabled"
                      Title="Media Management is unavailable"
                      Message="Use a desktop or tablet to manage library storage and intake." />
    }
    else if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading libraries" Class="py-8" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@Icons.Material.Outlined.CloudOff"
                      Title="Libraries could not be loaded"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")" />
    }
    else
    {
        <AppActionBar Align="AppHorizontalAlignment.End" Class="media-management__actions">
            <AppStatusBadge Text="@(_engineUnavailable ? "Engine unavailable" : "Live")"
                            Tone="@(_engineUnavailable ? AppUiTone.Error : AppUiTone.Success)" />
            @if (section == "libraries")
            {
                <AppButton Label="Add Personal Library"
                           StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Disabled="@(readOnly || _engineUnavailable)"
                           OnClick="BeginPersonalLibrary" />
            }
        </AppActionBar>

        @if (_engineUnavailable)
        {
            <AppAlert Tone="AppUiTone.Error">
                The Engine is unavailable. Existing library values remain visible and are not replaced with sample data.
            </AppAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <AppAlert Tone="AppUiTone.Warning">@_loadError</AppAlert>
        }

        @if (_creatingPersonal)
        {
            @PersonalLibraryWizard(readOnly)
        }
        else if (section == "overview")
        {
            @OverviewSurface(readOnly)
        }
        else if (section == "incoming")
        {
            @IncomingSurface(readOnly)
        }
        else if (section == "activity")
        {
            <IngestionTasksTab />
        }
        else
        {
            @LibrariesSurface(activeLibrary, readOnly)
        }

        @if (!_creatingPersonal && HasUnsavedChanges)
        {
            <div class="media-management__savebar">
                <span>Library configuration has unsaved changes.</span>
                <AppActionBar Align="AppHorizontalAlignment.End">
                    <AppButton Label="Discard Changes"
                               StartIcon="@Icons.Material.Outlined.Undo"
                               ButtonStyle="AppButtonStyle.Text"
                               Disabled="@_saving"
                               OnClick="ReloadAsync" />
                    <AppButton Label="Save Changes"
                               StartIcon="@Icons.Material.Outlined.Save"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               Disabled="@(readOnly || _engineUnavailable || _saving)"
                               Loading="@_saving"
                               OnClick="SaveAsync" />
                </AppActionBar>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string? Subsection { get; set; }

    private LibrariesConfigurationDto? _configuration;
    private IngestionOperationsSnapshotDto? _ingestionSnapshot;
    private string _baseline = string.Empty;
    private string? _loadError;
    private bool _loading = true;
    private bool _saving;
    private bool _engineUnavailable;
    private bool _creatingPersonal;
    private string _libraryFilter = "read";
    private int _wizardStep = 1;
    private LibraryFolderDto _draft = NewPersonalLibrary(null);
    private readonly Dictionary<string, PathTestResultDto> _pathResults = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _selectedLibraryIds = new(StringComparer.OrdinalIgnoreCase);

    private static readonly IReadOnlyList<AppSelectOption> PresentationOptions =
    [
        new("mixed_gallery", "Mixed gallery", Icons.Material.Outlined.GridView),
        new("timeline", "Timeline", Icons.Material.Outlined.CalendarMonth),
        new("video", "Video", Icons.Material.Outlined.SmartDisplay),
        new("gallery", "Gallery", Icons.Material.Outlined.PhotoLibrary),
        new("documents", "Documents", Icons.Material.Outlined.Description),
        new("audio", "Audio", Icons.Material.Outlined.GraphicEq),
        new("mixed", "Mixed", Icons.Material.Outlined.DashboardCustomize),
    ];

    private static readonly IReadOnlyList<AppSelectOption> VisibilityOptions =
    [
        new("private", "Private", Icons.Material.Outlined.Lock),
        new("shared", "Selected users", Icons.Material.Outlined.Group),
        new("household", "Household", Icons.Material.Outlined.Home),
    ];

    private static readonly IReadOnlyList<AppSelectOption> DuplicateOptions =
    [
        new("skip_exact", "Skip exact duplicates"),
        new("keep_both", "Keep both"),
        new("replace_existing", "Replace existing"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> OrganizationOptions =
    [
        new("tuvima_standard", "Tuvima standard"),
        new("keep_original_names", "Keep original names"),
        new("capture_year_month", "Capture year / month"),
        new("year_month_day", "Year / month / day"),
        new("keep_original_folders", "Keep original folders"),
        new("flat_folder", "Flat folder"),
        new("custom", "Custom"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> ManagementOptions =
    [
        new("managed_by_tuvima", "Managed by Tuvima"),
        new("existing_library", "Existing library"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SourceRoleOptions =
    [
        new("primary_destination", "Primary destination"),
        new("secondary", "Secondary source"),
        new("intake", "Intake source"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SourceTypeOptions =
    [
        new("local_folder", "Local folder"),
        new("network_share", "Network share"),
        new("mobile_device", "Mobile device"),
        new("connected_device", "Connected device"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> IncomingPurposeOptions =
    [
        new("shared_intake", "Shared intake"),
        new("browser_uploads", "Browser uploads"),
        new("device_intake", "Device intake"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> IncomingHandlingOptions =
    [
        new("route_automatically", "Route automatically"),
        new("stage_then_route", "Stage then route"),
        new("index_in_place", "Index in place"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> LibraryFilterOptions =
    [
        new("all", "All", Icons.Material.Outlined.Layers),
        new("read", "Read", Icons.Material.Outlined.MenuBook),
        new("watch", "Watch", Icons.Material.Outlined.LiveTv),
        new("listen", "Listen", Icons.Material.Outlined.Headphones),
        new("view", "View", Icons.Material.Outlined.FolderOpen),
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override void OnParametersSet()
    {
        var section = NormalizeSection(Subsection);
        EnsureSelection(section);
    }

    private RenderFragment OverviewSurface(bool readOnly) => @<div class="media-management__overview">
        <AppSegmentedControl Value="@_libraryFilter"
                             ValueChanged="@SetLibraryFilter"
                             Options="@LibraryFilterOptions.Where(option => option.Value != "all").ToList()"
                             AriaLabel="Choose a media area" />

        <AppCard Class="media-management-card">
            <div class="media-management-card__heading">
                <div><h3>@TitleCase(_libraryFilter) folders</h3><p>Configured locations in this media area. Open a library to change its storage and organization rules.</p></div>
                <AppButton Href="/settings/media-management/libraries" Label="Manage folders" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ChevronRight" />
            </div>
            @if (FilteredLibraries.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Empty" Icon="@AreaIcon(_libraryFilter)" Title="No folders in this area" Message="Choose another media area or configure its first folder." />
            }
            else
            {
            <div class="media-management-table media-management-table--summary" role="table" aria-label="Configured folders">
                <div class="media-management-table__head" role="row"><span>Library</span><span>Type</span><span>Folders</span><span>Status</span></div>
                @foreach (var library in FilteredLibraries)
                {
                    <AppNativeButton Type="button" Class="media-management-table__row" OnClick="@(() => OpenLibrary(library))">
                        <span class="media-management-table__identity"><MudIcon Icon="@AreaIcon(library.Area)" Size="Size.Small" /><strong>@library.Name</strong></span>
                        <span>@(library.Kind == "personal" ? "Personal" : "Catalogued")</span>
                        <span>@library.Sources.Count</span>
                        <AppStatusBadge Text="@LibraryStatus(library)" Tone="@LibraryStatusTone(library)" />
                    </AppNativeButton>
                }
            </div>
            }
        </AppCard>

        <div class="media-management__aside-grid">
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" />
                <div><strong>Incoming</strong><p>@IncomingSummary</p><a href="/settings/media-management/incoming">Manage incoming folders</a></div>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" />
                <div><strong>Existing folders stay unchanged</strong><p>Tuvima can scan and index an existing library, but it never moves, renames, tags, or deletes its files.</p></div>
            </AppPanel>
        </div>
    </div>;

    private RenderFragment IncomingSurface(bool readOnly) => @<div class="media-management__incoming">
        <AppCard Class="media-management-card">
            <div class="media-management-card__heading">
                <div><h3>Incoming folders</h3><p>Shared intake locations are unassigned. Tuvima receives each file, determines its destination, then applies that library's policy.</p></div>
                <AppButton Label="Add incoming folder" StartIcon="@Icons.Material.Outlined.Add" ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary" Disabled="@(readOnly || _engineUnavailable)" OnClick="AddIncomingSource" />
            </div>
            <div class="media-management-source-list">
                @foreach (var source in _configuration!.IncomingSources)
                {
                    <details class="media-management-source media-management-source--incoming" @key="source.Id">
                        <summary>
                            <span class="media-management-table__identity"><MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" /><strong>@(string.IsNullOrWhiteSpace(source.Path) ? "New incoming folder" : source.Path)</strong></span>
                            <span>@TitleCase(source.Purpose)</span>
                            <span>@IncomingSourceSummary(source)</span>
                            <AppStatusBadge Text="@PathStatus(source.Path)" Tone="@PathTone(source.Path)" />
                            <span class="media-management-source__edit">Edit</span>
                        </summary>
                        <div class="media-management-source__editor">
                        <div class="media-management-source__path">
                            <MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" />
                            <AppTextField Value="@source.Path" ValueChanged="@((string? value) => source.Path = value ?? string.Empty)"
                                          Label="Path" Placeholder="C:\\Tuvima\\Incoming" ReadOnly="@(readOnly || _engineUnavailable)" />
                            <AppIconButton Icon="@Icons.Material.Outlined.FolderOpen" Tooltip="Browse" AriaLabel="Browse incoming folder"
                                           Disabled="@(readOnly || _engineUnavailable)" OnClick="@(() => BrowseIncomingAsync(source))" />
                            <AppStatusBadge Text="@PathStatus(source.Path)" Tone="@PathTone(source.Path)" />
                        </div>
                        <div class="media-management-source__fields">
                            <AppSelect Label="Purpose" Value="@source.Purpose" Options="@IncomingPurposeOptions"
                                       ValueChanged="@((string? value) => source.Purpose = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSelect Label="Default handling" Value="@source.DefaultHandling" Options="@IncomingHandlingOptions"
                                       ValueChanged="@((string? value) => source.DefaultHandling = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSelect Label="Source type" Value="@source.SourceType" Options="@SourceTypeOptions"
                                       ValueChanged="@((string? value) => source.SourceType = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSwitchRow Label="Include subfolders" Value="@source.IncludeSubdirectories"
                                          ValueChanged="@((bool value) => source.IncludeSubdirectories = value)" Disabled="@(readOnly || _engineUnavailable)" />
                        </div>
                        <div class="media-management-source__footer">
                            <span>@IncomingSourceSummary(source)</span>
                            <AppIconButton Icon="@Icons.Material.Outlined.Delete" Tooltip="Remove" AriaLabel="Remove incoming folder"
                                           Tone="AppUiTone.Error" Disabled="@(readOnly || _engineUnavailable)"
                                           OnClick="@(() => RemoveIncomingSource(source))" />
                        </div>
                        </div>
                    </details>
                }
            </div>
        </AppCard>

        <div class="media-management__aside-grid">
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.Route" />
                <div><strong>How incoming works</strong><p>Receive file → determine destination → apply library policy → store and index. Users never need to manage staging.</p></div>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.UploadFile" />
                <div><strong>Direct library intake</strong><p>Browser upload, drag-and-drop, mobile backup, and connected devices retain the chosen destination library.</p></div>
            </AppPanel>
        </div>
    </div>;

    private RenderFragment LibrariesSurface(LibraryFolderDto? activeLibrary, bool readOnly) => @<div class="media-management__area">
        <AppCard Class="media-management-card media-management-card--selector">
            <div class="media-management-card__heading">
                <div>
                    <h3>Libraries</h3>
                    <p>Structured libraries cover Read, Watch, and Listen. Personal libraries (View) keep local media separate from catalogue identity.</p>
                </div>
                <AppButton Label="Add Personal Library" StartIcon="@Icons.Material.Outlined.Add" ButtonStyle="AppButtonStyle.Outlined"
                           Disabled="@(readOnly || _engineUnavailable || !_configuration!.PersonalLibraryPolicy.AllowUserCreation)" OnClick="BeginPersonalLibrary" />
            </div>
            <AppSegmentedControl Value="@_libraryFilter"
                                 ValueChanged="@SetLibraryFilter"
                                 Options="@LibraryFilterOptions"
                                 AriaLabel="Filter libraries" />
            @if (FilteredLibraries.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Empty" Icon="@AreaIcon(_libraryFilter)"
                              Title="No libraries in this area" Message="Choose another filter or add a personal View library." />
            }
            else
            {
                <div class="media-management-table media-management-table--libraries" role="table" aria-label="Configured libraries">
                    <div class="media-management-table__head" role="row"><span>Library</span><span>Type</span><span>Folders</span><span>Status</span></div>
                    @foreach (var library in FilteredLibraries)
                    {
                        <AppNativeButton Type="button"
                                         Class="@($"media-management-table__row {(activeLibrary?.Id == library.Id ? "is-active" : string.Empty)}")"
                                         OnClick="@(() => SelectLibrary(library.Area, library.Id))">
                            <span class="media-management-table__identity"><MudIcon Icon="@AreaIcon(library.Area)" Size="Size.Small" /><strong>@library.Name</strong></span>
                            <span>@(library.Kind == "personal" ? "Personal" : "Catalogued") · @TitleCase(library.Area)</span>
                            <span>@library.Sources.Count</span>
                            <AppStatusBadge Text="@LibraryStatus(library)" Tone="@LibraryStatusTone(library)" />
                        </AppNativeButton>
                    }
                </div>
            }
        </AppCard>

        <AppCard Class="media-management-card">
            <div class="media-management-card__heading">
                <div><h3>Recent scans</h3><p>Latest processing outcomes reported by the Engine.</p></div>
                <AppButton Href="/settings/media-management/activity" Label="View activity" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ChevronRight" />
            </div>
            @if (RecentScans.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Empty" Icon="@Icons.Material.Outlined.History"
                              Title="No recent scans" Message="Scan history will appear after media processing runs." />
            }
            else
            {
                <div class="media-management-recent-scans" role="list">
                    @foreach (var scan in RecentScans)
                    {
                        <div class="media-management-recent-scan" role="listitem">
                            <span><strong>@(string.IsNullOrWhiteSpace(scan.Source) ? "Library scan" : scan.Source)</strong><small>@FormatRelative(scan.StartedAt)</small></span>
                            <span>@DisplayFormat.FormatCount(scan.ProcessedFiles) processed</span>
                            @if (scan.RegisteredCount > 0) { <AppStatusBadge Text="@($"{scan.RegisteredCount} added")" Tone="AppUiTone.Success" /> }
                            @if (scan.ReviewCount > 0) { <AppStatusBadge Text="@($"{scan.ReviewCount} need review")" Tone="AppUiTone.Warning" /> }
                            @if (scan.FailedCount > 0) { <AppStatusBadge Text="@($"{scan.FailedCount} failed")" Tone="AppUiTone.Error" /> }
                        </div>
                    }
                </div>
            }
        </AppCard>

        @if (activeLibrary is not null)
        {
            @LibraryEditor(activeLibrary, readOnly)
        }

        <details class="media-management-disclosure">
            <summary>Personal library permissions</summary>
            <div class="media-management__policy-grid">
                <AppSwitchRow Label="Users can create libraries" Description="Allow personal library creation in View."
                              Value="@_configuration!.PersonalLibraryPolicy.AllowUserCreation"
                              ValueChanged="@((bool value) => _configuration.PersonalLibraryPolicy.AllowUserCreation = value)" Disabled="@(readOnly || _engineUnavailable)" />
                <AppSwitchRow Label="Managed storage" Description="Allow Tuvima-managed writable destinations."
                              Value="@_configuration.PersonalLibraryPolicy.AllowManagedStorage"
                              ValueChanged="@((bool value) => _configuration.PersonalLibraryPolicy.AllowManagedStorage = value)" Disabled="@(readOnly || _engineUnavailable)" />
                <AppSwitchRow Label="Existing folder attachment" Description="Allow read-only local and network folders."
                              Value="@_configuration.PersonalLibraryPolicy.AllowExistingFolderAttachment"
                              ValueChanged="@((bool value) => _configuration.PersonalLibraryPolicy.AllowExistingFolderAttachment = value)" Disabled="@(readOnly || _engineUnavailable)" />
                <AppSwitchRow Label="Mobile backup" Value="@_configuration.PersonalLibraryPolicy.AllowMobileBackup"
                              ValueChanged="@((bool value) => _configuration.PersonalLibraryPolicy.AllowMobileBackup = value)" Disabled="@(readOnly || _engineUnavailable)" />
                <AppSwitchRow Label="Browser upload" Value="@_configuration.PersonalLibraryPolicy.AllowBrowserUpload"
                              ValueChanged="@((bool value) => _configuration.PersonalLibraryPolicy.AllowBrowserUpload = value)" Disabled="@(readOnly || _engineUnavailable)" />
                <AppSwitchRow Label="Drag-and-drop" Value="@_configuration.PersonalLibraryPolicy.AllowDragAndDrop"
                              ValueChanged="@((bool value) => _configuration.PersonalLibraryPolicy.AllowDragAndDrop = value)" Disabled="@(readOnly || _engineUnavailable)" />
                <AppSwitchRow Label="Connected device import" Value="@_configuration.PersonalLibraryPolicy.AllowConnectedDeviceImport"
                              ValueChanged="@((bool value) => _configuration.PersonalLibraryPolicy.AllowConnectedDeviceImport = value)" Disabled="@(readOnly || _engineUnavailable)" />
                <AppSelect Label="Default visibility" Value="@_configuration.PersonalLibraryPolicy.DefaultVisibility" Options="@VisibilityOptions"
                           ValueChanged="@((string? value) => _configuration.PersonalLibraryPolicy.DefaultVisibility = value ?? "private")" Disabled="@(readOnly || _engineUnavailable)" />
            </div>
        </details>
    </div>;

    private RenderFragment LibraryEditor(LibraryFolderDto library, bool readOnly) => @<div class="media-management__editor">
        <AppCard Class="media-management-card">
            <div class="media-management-card__heading">
                <div class="media-management-card__title-with-icon">
                    <MudIcon Icon="@AreaIcon(library.Area)" />
                    <div><h3>@library.Name</h3><p>@(library.Kind == "personal" ? "Personal View library" : "Structured provider-backed library")</p></div>
                </div>
                <AppActionBar>
                    <AppButton Label="Check all" StartIcon="@Icons.Material.Outlined.Refresh" ButtonStyle="AppButtonStyle.Text"
                               Disabled="@_engineUnavailable" OnClick="@(() => CheckLibraryPathsAsync(library))" />
                    @if (library.Kind == "personal")
                    {
                        <AppIconButton Icon="@Icons.Material.Outlined.Delete" Tooltip="Delete library" AriaLabel="Delete personal library"
                                       Tone="AppUiTone.Error" Disabled="@(readOnly || _engineUnavailable)" OnClick="@(() => RemovePersonalLibrary(library))" />
                    }
                </AppActionBar>
            </div>

            @if (library.Kind == "personal")
            {
                <div class="media-management-form-grid">
                    <AppTextField Label="Library name" Value="@library.Name" ValueChanged="@((string? value) => library.Name = value ?? string.Empty)"
                                  ReadOnly="@(readOnly || _engineUnavailable)" />
                    <AppSelect Label="Presentation" Value="@library.Presentation" Options="@PresentationOptions"
                               ValueChanged="@((string? value) => library.Presentation = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                    <AppTextField Label="Owner profile ID" Value="@library.OwnerProfileId" ValueChanged="@((string? value) => library.OwnerProfileId = value)"
                                  ReadOnly="@(readOnly || _engineUnavailable)" />
                    <AppSelect Label="Visibility" Value="@library.Visibility" Options="@VisibilityOptions"
                               ValueChanged="@((string? value) => SetVisibility(library, value))" Disabled="@(readOnly || _engineUnavailable)" />
                </div>
            }

            <div class="media-management-section-heading">
                <div><h4>Folders &amp; sources</h4><p>Every source has its own safety and organization rules.</p></div>
                <AppButton Label="Add source" StartIcon="@Icons.Material.Outlined.Add" ButtonStyle="AppButtonStyle.Outlined"
                           Disabled="@(readOnly || _engineUnavailable)" OnClick="@(() => AddLibrarySource(library))" />
            </div>

            <div class="media-management-source-list">
                @foreach (var source in library.Sources)
                {
                    <div class="media-management-source @(source.ManagementMode == "existing_library" ? "is-existing" : null)" @key="source.Id">
                        <div class="media-management-source__path">
                            <MudIcon Icon="@(source.SourceType == "network_share" ? Icons.Material.Outlined.Storage : Icons.Material.Outlined.Folder)" />
                            <AppTextField Value="@source.Path" ValueChanged="@((string? value) => source.Path = value ?? string.Empty)"
                                          Label="Folder path" ReadOnly="@(readOnly || _engineUnavailable)" />
                            <AppIconButton Icon="@Icons.Material.Outlined.FolderOpen" Tooltip="Browse" AriaLabel="Browse source folder"
                                           Disabled="@(readOnly || _engineUnavailable)" OnClick="@(() => BrowseLibrarySourceAsync(source))" />
                            <AppStatusBadge Text="@PathStatus(source.Path)" Tone="@PathTone(source.Path)" />
                        </div>
                        <div class="media-management-source__fields">
                            <AppSelect Label="Role" Value="@source.Role" Options="@SourceRoleOptions"
                                       ValueChanged="@((string? value) => SetSourceRole(library, source, value))" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSelect Label="Management" Value="@source.ManagementMode" Options="@ManagementOptions"
                                       ValueChanged="@((string? value) => SetManagementMode(library, source, value))" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSelect Label="Source type" Value="@source.SourceType" Options="@SourceTypeOptions"
                                       ValueChanged="@((string? value) => source.SourceType = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSwitchRow Label="Include subfolders" Value="@source.IncludeSubdirectories"
                                          ValueChanged="@((bool value) => source.IncludeSubdirectories = value)" Disabled="@(readOnly || _engineUnavailable)" />
                        </div>
                        @if (source.ManagementMode == "existing_library")
                        {
                            <div class="media-management-source__notice">
                                <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Small" />
                                <span><strong>Existing library:</strong> Tuvima scans and indexes this folder but leaves its files, names, tags, sidecars, and structure unchanged.</span>
                            </div>
                        }
                        else
                        {
                            <div class="media-management-source__managed">
                                <AppSwitchRow Label="Participates in organization" Description="New files may be moved and named using this library's policy."
                                              Value="@source.ParticipatesInOrganization" ValueChanged="@((bool value) => source.ParticipatesInOrganization = value)"
                                              Disabled="@(readOnly || _engineUnavailable)" />
                                <AppSwitchRow Label="Metadata writeback" Description="Separate from permission to organize files."
                                              Value="@(source.WritebackOverride == true)" ValueChanged="@((bool value) => source.WritebackOverride = value)"
                                              Disabled="@(readOnly || _engineUnavailable)" />
                            </div>
                        }
                        <div class="media-management-source__footer">
                            <span>@SourceSummary(source)</span>
                            <AppIconButton Icon="@Icons.Material.Outlined.Delete" Tooltip="Remove source" AriaLabel="Remove source"
                                           Tone="AppUiTone.Error" Disabled="@(readOnly || _engineUnavailable || library.Sources.Count == 1)"
                                           OnClick="@(() => RemoveLibrarySource(library, source))" />
                        </div>
                    </div>
                }
            </div>
        </AppCard>

        <div class="media-management__policy-grid">
            <AppCard Class="media-management-card">
                <div class="media-management-card__heading"><div><h3>Organization</h3><p>Controls naming and placement for managed sources only.</p></div></div>
                <AppSelect Label="Organization mode" Value="@library.OrganizationPolicy.Mode" Options="@OrganizationOptions"
                           ValueChanged="@((string? value) => library.OrganizationPolicy.Mode = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                @if (library.OrganizationPolicy.Mode == "custom")
                {
                    <AppTextField Label="Custom template" Value="@library.OrganizationPolicy.CustomTemplate"
                                  ValueChanged="@((string? value) => library.OrganizationPolicy.CustomTemplate = value)"
                                  Placeholder="{Title} ({Year})/{Title}{Ext}" ReadOnly="@(readOnly || _engineUnavailable)" />
                }
                <div class="media-management-example"><span>Example path</span><code>@OrganizationExample(library)</code></div>
            </AppCard>

            <AppCard Class="media-management-card">
                <div class="media-management-card__heading"><div><h3>Library settings</h3><p>Identity, metadata, intake, and duplicate behavior.</p></div></div>
                <div class="media-management-facts">
                    <div><span>Area</span><strong>@TitleCase(library.Area)</strong></div>
                    <div><span>Metadata</span><strong>@PolicyLabel(library.MetadataPolicy)</strong></div>
                    <div><span>Duplicate handling</span><strong>@DuplicateLabel(library.DuplicatePolicy)</strong></div>
                    <div><span>Primary destination</span><strong>@(library.GetPrimaryDestination()?.Path ?? "Not configured")</strong></div>
                </div>
                @if (library.Kind == "personal")
                {
                    <AppSelect Label="Duplicate handling" Value="@library.DuplicatePolicy" Options="@DuplicateOptions"
                               ValueChanged="@((string? value) => library.DuplicatePolicy = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                    <div class="media-management-intake-grid">
                        @IntakeToggle(library, "drag_and_drop", "Drag-and-drop", Icons.Material.Outlined.CloudUpload, readOnly)
                        @IntakeToggle(library, "browser_upload", "Browser upload", Icons.Material.Outlined.UploadFile, readOnly)
                        @IntakeToggle(library, "mobile_backup", "Mobile backup", Icons.Material.Outlined.PhoneIphone, readOnly)
                        @IntakeToggle(library, "connected_device_import", "Connected device", Icons.Material.Outlined.Usb, readOnly)
                    </div>
                }
            </AppCard>
        </div>
    </div>;

    private RenderFragment IntakeToggle(LibraryFolderDto library, string value, string label, string icon, bool readOnly) => @<AppSwitchRow
        Label="@label"
        Icon="@icon"
        Value="@library.AcceptedIntakeModes.Contains(value, StringComparer.OrdinalIgnoreCase)"
        ValueChanged="@((bool enabled) => SetIntakeMode(library, value, enabled))"
        Disabled="@(readOnly || _engineUnavailable)" />;

    private RenderFragment PersonalLibraryWizard(bool readOnly) => @<AppCard Class="media-management-card media-management-wizard">
        <div class="media-management-card__heading">
            <div><h3>Create Personal Library</h3><p>Build a View library for local mixed media. View is fixed and external identity providers are never used.</p></div>
            <AppButton Label="Cancel" ButtonStyle="AppButtonStyle.Text" OnClick="CancelPersonalLibrary" />
        </div>
        <div class="media-management-wizard__steps" aria-label="Creation steps">
            @for (var step = 1; step <= 4; step++)
            {
                <span class="@(_wizardStep == step ? "is-active" : _wizardStep > step ? "is-complete" : null)"><b>@step</b>@WizardStepLabel(step)</span>
            }
        </div>

        @if (_wizardStep == 1)
        {
            <div class="media-management-form-grid">
                <AppTextField Label="Library name" Value="@_draft.Name" ValueChanged="@((string? value) => _draft.Name = value ?? string.Empty)"
                              Placeholder="Shy's Phone Photos" ReadOnly="@readOnly" />
                <AppTextField Label="Description (optional)" Value="@_draft.Notes" ValueChanged="@((string? value) => _draft.Notes = value)"
                              Placeholder="Photos, short videos, and documents" ReadOnly="@readOnly" />
                <AppTextField Label="Owner profile ID" Value="@_draft.OwnerProfileId" ValueChanged="@((string? value) => _draft.OwnerProfileId = value)"
                              ReadOnly="@readOnly" />
                <div class="media-management-fixed-field"><span>Area</span><strong><MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" /> View</strong><small>Personal libraries always belong in View.</small></div>
            </div>
        }
        else if (_wizardStep == 2)
        {
            <div class="media-management-choice-grid">
                @foreach (var option in PresentationOptions)
                {
                    <AppNativeButton Type="button" Class="@($"media-management-choice {(_draft.Presentation == option.Value ? "is-active" : string.Empty)}")"
                                     OnClick="@(() => _draft.Presentation = option.Value)">
                        <MudIcon Icon="@option.Icon" /><strong>@option.Label</strong><span>@PresentationDescription(option.Value)</span>
                    </AppNativeButton>
                }
            </div>
        }
        else if (_wizardStep == 3)
        {
            <div class="media-management-form-grid">
                <AppTextField Label="Primary destination" Value="@_draft.Sources[0].Path"
                              ValueChanged="@((string? value) => _draft.Sources[0].Path = value ?? string.Empty)"
                              Placeholder="D:\\Media\\Personal" ReadOnly="@readOnly" />
                <AppSelect Label="Storage management" Value="@_draft.Sources[0].ManagementMode" Options="@ManagementOptions"
                           ValueChanged="@((string? value) => SetManagementMode(_draft, _draft.Sources[0], value))" Disabled="@readOnly" />
            </div>
            <div class="media-management-intake-grid">
                @IntakeToggle(_draft, "drag_and_drop", "Drag-and-drop", Icons.Material.Outlined.CloudUpload, readOnly)
                @IntakeToggle(_draft, "browser_upload", "Browser upload", Icons.Material.Outlined.UploadFile, readOnly)
                @IntakeToggle(_draft, "mobile_backup", "Mobile backup", Icons.Material.Outlined.PhoneIphone, readOnly)
                @IntakeToggle(_draft, "connected_device_import", "Connected device", Icons.Material.Outlined.Usb, readOnly)
            </div>
        }
        else
        {
            <div class="media-management-form-grid">
                <AppSelect Label="Visibility" Value="@_draft.Visibility" Options="@VisibilityOptions"
                           ValueChanged="@((string? value) => SetVisibility(_draft, value))" Disabled="@readOnly" />
                <AppSelect Label="Duplicate handling" Value="@_draft.DuplicatePolicy" Options="@DuplicateOptions"
                           ValueChanged="@((string? value) => _draft.DuplicatePolicy = value ?? string.Empty)" Disabled="@readOnly" />
                <AppSelect Label="Organization" Value="@_draft.OrganizationPolicy.Mode" Options="@OrganizationOptions"
                           ValueChanged="@((string? value) => _draft.OrganizationPolicy.Mode = value ?? string.Empty)" Disabled="@readOnly" />
                <div class="media-management-fixed-field"><span>Originals</span><strong><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" /> Preserved</strong><small>Preview files are stored separately; original bytes are not rewritten.</small></div>
            </div>
        }

        <AppActionBar Align="AppHorizontalAlignment.End" Class="media-management-wizard__footer">
            <AppButton Label="Back" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(_wizardStep == 1)" OnClick="WizardBack" />
            @if (_wizardStep < 4)
            {
                <AppButton Label="Continue" EndIcon="@Icons.Material.Outlined.ArrowForward" ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary" Disabled="@(!CanContinueWizard)" OnClick="WizardNext" />
            }
            else
            {
                <AppButton Label="Create Library" StartIcon="@Icons.Material.Outlined.CreateNewFolder" ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary" Disabled="@(!CanFinishWizard || _saving)" Loading="@_saving" OnClick="CreatePersonalLibraryAsync" />
            }
        </AppActionBar>
    </AppCard>;

    private IReadOnlyList<LibraryFolderDto> FilteredLibraries => _configuration?.Libraries
        .Where(library => _libraryFilter == "all" || string.Equals(library.Area, _libraryFilter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(library => library.Area)
        .ThenBy(library => library.Name)
        .ToList() ?? [];

    private LibraryFolderDto? ActiveFilteredLibrary
    {
        get
        {
            var libraries = FilteredLibraries;
            if (libraries.Count == 0) return null;
            var selectedId = _selectedLibraryIds.GetValueOrDefault(_libraryFilter);
            return libraries.FirstOrDefault(library => library.Id == selectedId) ?? libraries[0];
        }
    }

    private string IncomingSummary => _configuration?.IncomingSources.Count switch
    {
        null or 0 => "No shared incoming folders are configured.",
        1 => "1 shared incoming folder is configured. Processing history is available in Activity.",
        var count => $"{count} shared incoming folders are configured. Processing history is available in Activity.",
    };

    private IReadOnlyList<IngestionOperationsBatchDto> RecentScans => _ingestionSnapshot?.RecentBatches
        .OrderByDescending(batch => batch.StartedAt)
        .Take(4)
        .ToList() ?? [];

    private bool HasUnsavedChanges => _configuration is not null
        && !string.Equals(_baseline, JsonSerializer.Serialize(_configuration), StringComparison.Ordinal);

    private bool CanContinueWizard => _wizardStep != 1
        || (!string.IsNullOrWhiteSpace(_draft.Name) && Guid.TryParse(_draft.OwnerProfileId, out _));

    private bool CanFinishWizard => !string.IsNullOrWhiteSpace(_draft.Sources[0].Path)
        && _draft.AcceptedIntakeModes.Count > 0;

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var configurationTask = Orchestrator.GetLibrariesAsync();
            var ingestionTask = ApiClient.GetIngestionOperationsSnapshotAsync();
            await Task.WhenAll(configurationTask, ingestionTask);
            _configuration = await configurationTask;
            _ingestionSnapshot = await ingestionTask;
            _engineUnavailable = _configuration is null;
            if (_configuration is null)
                _loadError = ApiClient.LastError;
            else
            {
                _baseline = JsonSerializer.Serialize(_configuration);
                EnsureSelection(NormalizeSection(Subsection));
            }
        }
        catch (Exception ex)
        {
            _configuration = null;
            _engineUnavailable = true;
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        _creatingPersonal = false;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (_configuration is null || _saving) return;
        var validationError = ValidateConfiguration();
        if (validationError is not null)
        {
            Snackbar.Add(validationError, Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            if (!await ValidatePathsAsync()) return;
            var saved = await Orchestrator.UpdateLibrariesAsync(new UpdateLibrariesRequest
            {
                SchemaVersion = _configuration.SchemaVersion,
                Libraries = _configuration.Libraries,
                IncomingSources = _configuration.IncomingSources,
                PersonalLibraryPolicy = _configuration.PersonalLibraryPolicy,
            });
            if (saved is null)
            {
                Snackbar.Add(ApiClient.LastError ?? "Library configuration could not be saved.", Severity.Error);
                return;
            }

            _configuration = saved;
            _baseline = JsonSerializer.Serialize(saved);
            Snackbar.Add("Media Management settings saved.", Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<bool> ValidatePathsAsync()
    {
        var sources = _configuration!.Libraries.SelectMany(library => library.Sources)
            .Select(source => (source.Path, RequireWrite: source.ManagementMode == "managed_by_tuvima"))
            .Concat(_configuration.IncomingSources.Select(source => (source.Path, RequireWrite: true)))
            .ToList();
        foreach (var source in sources)
        {
            var result = await Orchestrator.TestPathAsync(source.Path);
            if (result is null || !result.Exists || !result.HasRead || (source.RequireWrite && !result.HasWrite))
            {
                Snackbar.Add($"Folder '{source.Path}' is not accessible with the required permissions.", Severity.Error);
                return false;
            }
            _pathResults[source.Path] = result;
        }
        return true;
    }

    private string? ValidateConfiguration()
    {
        foreach (var library in _configuration!.Libraries)
        {
            if (string.IsNullOrWhiteSpace(library.Name)) return "Every library needs a name.";
            if (library.Sources.Count == 0) return $"{library.Name} needs at least one source.";
            if (library.Sources.Any(source => string.IsNullOrWhiteSpace(source.Path))) return $"{library.Name} has an empty source path.";
            if (library.Sources.Any(source => source.Role == "primary_destination")
                && library.GetPrimaryDestination() is null) return $"{library.Name} needs an explicit primary destination.";
            if (library.Kind == "personal" && !Guid.TryParse(library.OwnerProfileId, out _)) return $"{library.Name} needs a valid owner profile.";
        }
        if (_configuration.IncomingSources.Any(source => string.IsNullOrWhiteSpace(source.Path))) return "Incoming folder paths cannot be empty.";
        return null;
    }

    private void BeginPersonalLibrary()
    {
        _draft = NewPersonalLibrary(null, _configuration?.PersonalLibraryPolicy);
        _creatingPersonal = true;
        _wizardStep = 1;
        _ = InitializeDraftOwnerAsync();
    }

    private async Task InitializeDraftOwnerAsync()
    {
        var profile = await Orchestrator.GetActiveProfileAsync();
        if (profile is not null) _draft.OwnerProfileId = profile.Id.ToString("D");
        await InvokeAsync(StateHasChanged);
    }

    private void CancelPersonalLibrary() => _creatingPersonal = false;
    private void WizardBack() => _wizardStep = Math.Max(1, _wizardStep - 1);
    private void WizardNext() => _wizardStep = Math.Min(4, _wizardStep + 1);

    private async Task CreatePersonalLibraryAsync()
    {
        _configuration!.Libraries.Add(_draft);
        _selectedLibraryIds["view"] = _draft.Id;
        _creatingPersonal = false;
        await SaveAsync();
    }

    private static LibraryFolderDto NewPersonalLibrary(string? ownerId, PersonalLibraryPolicyDto? policy = null)
    {
        var sourceId = Guid.NewGuid().ToString("D");
        return new LibraryFolderDto
        {
            Id = Guid.NewGuid().ToString("D"),
            Name = string.Empty,
            Kind = "personal",
            Area = "view",
            Presentation = "mixed_gallery",
            MetadataPolicy = "local_only",
            OwnerProfileId = ownerId,
            Visibility = policy?.DefaultVisibility ?? "private",
            DuplicatePolicy = "skip_exact",
            AcceptedIntakeModes = PersonalIntakeModes(policy),
            OrganizationPolicy = new LibraryOrganizationPolicyDto { Mode = "capture_year_month", PreserveOriginals = true },
            Sources =
            [
                new LibrarySourceDto
                {
                    Id = sourceId,
                    Role = "primary_destination",
                    ManagementMode = "managed_by_tuvima",
                    SourceType = "local_folder",
                    AccessMode = "writable",
                    IncludeSubdirectories = true,
                    ParticipatesInOrganization = true,
                    IntakeRole = "direct",
                    WritebackOverride = false,
                },
            ],
            PrimaryDestinationSourceId = sourceId,
        };
    }

    private static List<string> PersonalIntakeModes(PersonalLibraryPolicyDto? policy)
    {
        if (policy is null) return ["drag_and_drop", "browser_upload", "mobile_backup"];
        var modes = new List<string>();
        if (policy.AllowDragAndDrop) modes.Add("drag_and_drop");
        if (policy.AllowBrowserUpload) modes.Add("browser_upload");
        if (policy.AllowMobileBackup) modes.Add("mobile_backup");
        if (policy.AllowConnectedDeviceImport) modes.Add("connected_device_import");
        return modes;
    }

    private void AddIncomingSource() => _configuration!.IncomingSources.Add(new IncomingSourceDto
    {
        Id = Guid.NewGuid().ToString("D"), Path = string.Empty, Purpose = "shared_intake",
        DefaultHandling = "route_automatically", IncludeSubdirectories = true, SourceType = "local_folder",
    });

    private void RemoveIncomingSource(IncomingSourceDto source) => _configuration!.IncomingSources.Remove(source);

    private void AddLibrarySource(LibraryFolderDto library) => library.Sources.Add(new LibrarySourceDto
    {
        Id = Guid.NewGuid().ToString("D"), Role = "secondary", ManagementMode = "existing_library",
        SourceType = "local_folder", AccessMode = "read_only", IncludeSubdirectories = true, IntakeRole = "none",
    });

    private void RemoveLibrarySource(LibraryFolderDto library, LibrarySourceDto source)
    {
        library.Sources.Remove(source);
        if (library.PrimaryDestinationSourceId == source.Id) library.PrimaryDestinationSourceId = null;
    }

    private void RemovePersonalLibrary(LibraryFolderDto library)
    {
        if (library.Kind != "personal") return;
        _configuration!.Libraries.Remove(library);
        _selectedLibraryIds.Remove("view");
        EnsureSelection("view");
    }

    private void SetSourceRole(LibraryFolderDto library, LibrarySourceDto source, string? role)
    {
        source.Role = role ?? "secondary";
        if (source.Role == "primary_destination")
        {
            foreach (var other in library.Sources.Where(other => other != source && other.Role == "primary_destination")) other.Role = "secondary";
            source.ManagementMode = "managed_by_tuvima";
            source.AccessMode = "writable";
            source.ParticipatesInOrganization = true;
            library.PrimaryDestinationSourceId = source.Id;
        }
        else if (library.PrimaryDestinationSourceId == source.Id)
        {
            library.PrimaryDestinationSourceId = null;
        }
    }

    private static void SetManagementMode(LibraryFolderDto library, LibrarySourceDto source, string? mode)
    {
        source.ManagementMode = mode ?? "existing_library";
        if (source.ManagementMode == "existing_library")
        {
            source.AccessMode = "read_only";
            source.ParticipatesInOrganization = false;
            source.WritebackOverride = false;
            if (source.Role == "primary_destination")
            {
                source.Role = "secondary";
                library.PrimaryDestinationSourceId = null;
            }
        }
        else
        {
            source.AccessMode = "writable";
        }
    }

    private static void SetIntakeMode(LibraryFolderDto library, string mode, bool enabled)
    {
        library.AcceptedIntakeModes.RemoveAll(value => string.Equals(value, mode, StringComparison.OrdinalIgnoreCase));
        if (enabled) library.AcceptedIntakeModes.Add(mode);
    }

    private static void SetVisibility(LibraryFolderDto library, string? visibility)
    {
        library.Visibility = visibility ?? "private";
        if (library.Visibility != "shared") library.AuthorizedProfileIds.Clear();
    }

    private async Task CheckLibraryPathsAsync(LibraryFolderDto library)
    {
        foreach (var source in library.Sources) await CheckPathAsync(source.Path);
    }

    private async Task CheckPathAsync(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return;
        var result = await Orchestrator.TestPathAsync(path);
        if (result is not null) _pathResults[path] = result;
    }

    private async Task BrowseIncomingAsync(IncomingSourceDto source)
    {
        var selected = await BrowseForPathAsync(source.Path);
        if (selected is null) return;
        source.Path = selected;
        await CheckPathAsync(selected);
    }

    private async Task BrowseLibrarySourceAsync(LibrarySourceDto source)
    {
        var selected = await BrowseForPathAsync(source.Path);
        if (selected is null) return;
        source.Path = selected;
        await CheckPathAsync(selected);
    }

    private async Task<string?> BrowseForPathAsync(string currentPath)
    {
        var parameters = new DialogParameters<FolderBrowserDialog> { { x => x.InitialPath, currentPath } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FolderBrowserDialog>(L["Libraries_BrowseFolders"], parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string selectedPath } ? selectedPath : null;
    }

    private void OpenLibrary(LibraryFolderDto library)
    {
        _selectedLibraryIds[library.Area] = library.Id;
        _selectedLibraryIds["all"] = library.Id;
        _libraryFilter = library.Area;
        Nav.NavigateTo(SettingsNav.RouteFor(SettingsSection.Libraries, "libraries"));
    }

    private void SelectLibrary(string section, string id) => _selectedLibraryIds[section] = id;

    private void SetLibraryFilter(string? value)
    {
        _libraryFilter = value is "read" or "watch" or "listen" or "view" ? value : "all";
        var libraries = FilteredLibraries;
        if (libraries.Count > 0
            && (!_selectedLibraryIds.TryGetValue(_libraryFilter, out var id) || libraries.All(library => library.Id != id)))
        {
            _selectedLibraryIds[_libraryFilter] = libraries[0].Id;
        }
    }

    private LibraryFolderDto? ActiveLibrary(string section)
    {
        var libraries = LibrariesFor(section);
        if (libraries.Count == 0) return null;
        EnsureSelection(section);
        return libraries.FirstOrDefault(library => _selectedLibraryIds.GetValueOrDefault(section) == library.Id) ?? libraries[0];
    }

    private IReadOnlyList<LibraryFolderDto> LibrariesFor(string section) => _configuration?.Libraries
        .Where(library => string.Equals(library.Area, section, StringComparison.OrdinalIgnoreCase))
        .OrderBy(library => library.Name).ToList() ?? [];

    private void EnsureSelection(string section)
    {
        if (_configuration is null || section is "overview" or "incoming") return;
        var libraries = LibrariesFor(section);
        if (libraries.Count == 0) return;
        if (!_selectedLibraryIds.TryGetValue(section, out var id) || libraries.All(library => library.Id != id))
            _selectedLibraryIds[section] = libraries[0].Id;
    }

    private string PathStatus(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "Missing path";
        if (!_pathResults.TryGetValue(path, out var result)) return "Not checked";
        if (!result.Exists) return "Missing";
        if (!result.HasRead) return "Permission issue";
        if (!result.HasWrite) return "Read-only";
        return "Healthy";
    }

    private string IncomingSourceSummary(IncomingSourceDto source)
    {
        var folder = _ingestionSnapshot?.SourceGroups
            .SelectMany(group => group.Libraries)
            .SelectMany(library => library.Folders)
            .FirstOrDefault(candidate => string.Equals(candidate.Path, source.Path, StringComparison.OrdinalIgnoreCase));
        if (folder?.LastScan is { } lastScan)
            return $"Last scan {FormatRelative(lastScan)} · {DisplayFormat.FormatCount(folder.ItemCount)} items";

        return string.IsNullOrWhiteSpace(source.Notes) ? "No scan reported yet" : source.Notes;
    }

    private static string FormatRelative(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        return elapsed.TotalMinutes switch
        {
            < 1 => "just now",
            < 60 => $"{(int)elapsed.TotalMinutes}m ago",
            < 1440 => $"{(int)elapsed.TotalHours}h ago",
            _ => $"{(int)elapsed.TotalDays}d ago",
        };
    }

    private AppUiTone PathTone(string path) => PathStatus(path) switch
    {
        "Healthy" => AppUiTone.Success,
        "Not checked" => AppUiTone.Neutral,
        "Read-only" => AppUiTone.Warning,
        _ => AppUiTone.Error,
    };

    private string LibraryStatus(LibraryFolderDto library)
    {
        if (library.Sources.Count == 0) return "No sources";
        var statuses = library.Sources.Select(source => PathStatus(source.Path)).ToList();
        if (statuses.Any(status => status is "Missing path" or "Missing" or "Permission issue")) return "Needs attention";
        if (statuses.All(status => status == "Healthy")) return "Healthy";
        if (statuses.Any(status => status == "Read-only")) return "Read-only";
        return "Not checked";
    }

    private AppUiTone LibraryStatusTone(LibraryFolderDto library) => LibraryStatus(library) switch
    {
        "Healthy" => AppUiTone.Success,
        "Read-only" => AppUiTone.Info,
        "Not checked" => AppUiTone.Neutral,
        _ => AppUiTone.Warning,
    };

    private static string NormalizeSection(string? section) => section?.Trim().ToLowerInvariant() switch
    {
        "incoming" => "incoming", "libraries" => "libraries", "activity" => "activity", _ => "overview",
    };

    private static string TitleCase(string? value) => string.IsNullOrWhiteSpace(value)
        ? "Unknown"
        : string.Join(' ', value.Split('_', StringSplitOptions.RemoveEmptyEntries).Select(word => char.ToUpperInvariant(word[0]) + word[1..]));

    private static string AreaIcon(string? area) => area?.ToLowerInvariant() switch
    {
        "read" => Icons.Material.Outlined.MenuBook,
        "watch" => Icons.Material.Outlined.Tv,
        "listen" => Icons.Material.Outlined.Headphones,
        "view" => Icons.Material.Outlined.FolderOpen,
        _ => Icons.Material.Outlined.PermMedia,
    };

    private static string PolicyLabel(string? value) => value switch
    {
        "enriched" => "Provider metadata", "local_preferred" => "Local preferred", "local_only" => "Local metadata", "manual" => "Manual", _ => TitleCase(value),
    };

    private static string PresentationDescription(string value) => value switch
    {
        "mixed_gallery" => "Photos, short videos, and files together.",
        "timeline" => "Browse by capture date.",
        "video" => "Focus on videos and clips.",
        "gallery" => "Image-led thumbnail gallery.",
        "documents" => "Documents and file previews.",
        "audio" => "Audio notes and local recordings.",
        _ => "A flexible view for several file types.",
    };

    private static string DuplicateLabel(string? value) => value switch
    {
        "skip_exact" => "Skip exact duplicates", "keep_both" => "Keep both", "replace_existing" => "Replace existing", _ => TitleCase(value),
    };

    private static string SourceSummary(LibrarySourceDto source) => source.ManagementMode == "existing_library"
        ? "Read-only external source"
        : source.Role == "primary_destination" ? "Managed primary destination" : "Managed secondary source";

    private static string OrganizationExample(LibraryFolderDto library) => library.OrganizationPolicy.Mode switch
    {
        "capture_year_month" => "/2026/08/IMG_4821.HEIC",
        "year_month_day" => "/2026/08/24/IMG_4821.HEIC",
        "flat_folder" => "/IMG_4821.HEIC",
        "keep_original_folders" => "/Original Folder/IMG_4821.HEIC",
        "custom" => library.OrganizationPolicy.CustomTemplate ?? "Custom template required",
        "keep_original_names" => "/Original Folder/Original Name.ext",
        _ => library.Area switch
        {
            "read" => "/Books/Author/Title (2026)/Title.epub",
            "watch" => "/Movies/Title (2026)/Title (2026).mkv",
            "listen" => "/Music/Artist/Album (2026)/01 - Track.flac",
            _ => "/Library/Organized Item.ext",
        },
    };

    private static string WizardStepLabel(int step) => step switch { 1 => "Basics", 2 => "Experience", 3 => "Storage", _ => "Privacy" };
}
