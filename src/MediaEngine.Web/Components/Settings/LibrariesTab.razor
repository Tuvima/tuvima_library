@namespace MediaEngine.Web.Components.Settings
@using System.Text.Json
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject DeviceContextService DeviceContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

@{
    var readOnly = DeviceContext.IsMobile;
    var unavailable = DeviceContext.IsTelevision || DeviceContext.IsAutomotive;
    var section = NormalizeSection(Subsection);
    var activeLibrary = ResolveActiveLibrary(section);
}

<div class="media-management">
    @if (unavailable)
    {
        <AppPageState Kind="AppPageStateKind.Unavailable"
                      Icon="@Icons.Material.Outlined.DesktopAccessDisabled"
                      Title="Library settings are unavailable"
                      Message="Use a desktop or tablet to manage library storage and intake." />
    }
    else if (_loading)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading libraries" Class="py-8" />
    }
    else if (_configuration is null)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Icon="@Icons.Material.Outlined.CloudOff"
                      Title="Libraries could not be loaded"
                      Message="@(_loadError ?? "The Engine did not return library configuration.")" />
    }
    else
    {
        <AppActionBar Align="AppHorizontalAlignment.End" Class="media-management__actions">
            @if (section == "overview" && !readOnly)
            {
                <AppButton Label="Add import folder"
                           StartIcon="@Icons.Material.Outlined.MoveToInbox"
                           ButtonStyle="AppButtonStyle.Outlined"
                           Disabled="@_engineUnavailable"
                           Href="/settings/import-folders" />
                <AppButton Label="Add library"
                           StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           Disabled="@_engineUnavailable"
                           Href="/settings/libraries/new" />
            }
        </AppActionBar>

        @if (readOnly)
        {
            <p class="media-management__mobile-note">Library storage and intake are read-only on mobile. Use a desktop or tablet to add folders or change library configuration.</p>
        }

        @if (_engineUnavailable)
        {
            <AppAlert Tone="AppUiTone.Error">
                The Engine is unavailable. Existing library values remain visible and are not replaced with sample data.
            </AppAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <AppAlert Tone="AppUiTone.Warning">@_loadError</AppAlert>
        }

        @if (section == "incoming" || activeLibrary is not null)
        {
            <ServerPathGuidance ImportFolders="@(section == "incoming")" />
        }

        @if (section == "overview")
        {
            @OverviewSurface(readOnly)
        }
        else if (section == "incoming")
        {
            @IncomingSurface(readOnly)
        }
        else if (section == "activity")
        {
            <IngestionTasksTab />
        }
        else if (activeLibrary is not null)
        {
            @LibraryDetailSurface(activeLibrary, readOnly)
        }
        else
        {
            <AppPageState Kind="AppPageStateKind.Error" Icon="@Icons.Material.Outlined.SearchOff" Title="Library not found" Message="This library does not exist or is no longer configured." />
        }

        @if (HasUnsavedChanges)
        {
            <div class="media-management__savebar">
                <span>Library configuration has unsaved changes.</span>
                <AppActionBar Align="AppHorizontalAlignment.End">
                    <AppButton Label="Discard Changes"
                               StartIcon="@Icons.Material.Outlined.Undo"
                               ButtonStyle="AppButtonStyle.Text"
                               Disabled="@_saving"
                               OnClick="ReloadAsync" />
                    <AppButton Label="Save Changes"
                               StartIcon="@Icons.Material.Outlined.Save"
                               ButtonStyle="AppButtonStyle.Filled"
                               Tone="AppUiTone.Primary"
                               Disabled="@(readOnly || _engineUnavailable || _saving)"
                               Loading="@_saving"
                               OnClick="SaveAsync" />
                </AppActionBar>
            </div>
        }
    }
</div>

@code {
    private sealed record LibraryDetailTabOption(string Value, string Label);
    private sealed record OrganizationDetailOption(string Value, string Label, string Help, string Icon);

    [Parameter] public string? Subsection { get; set; }
    [Parameter] public string? DetailTab { get; set; }

    private LibrariesConfigurationDto? _configuration;
    private IngestionOperationsSnapshotDto? _ingestionSnapshot;
    private string _baseline = string.Empty;
    private string? _loadError;
    private bool _loading = true;
    private bool _saving;
    private bool _engineUnavailable;
    private string _libraryFilter = "all";
    private readonly Dictionary<string, PathTestResultDto> _pathResults = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _selectedLibraryIds = new(StringComparer.OrdinalIgnoreCase);

    private static readonly IReadOnlyList<AppSelectOption> DuplicateOptions =
    [
        new("skip_exact", "Skip exact duplicates"),
        new("keep_both", "Keep both"),
        new("replace_existing", "Replace existing"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> OrganizationOptions =
    [
        new("tuvima_standard", "Tuvima standard"),
        new("keep_original_names", "Keep original names"),
        new("capture_year_month", "Capture year / month"),
        new("year_month_day", "Year / month / day"),
        new("keep_original_folders", "Keep original folders"),
        new("flat_folder", "Flat folder"),
        new("custom", "Custom"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> ManagementOptions =
    [
        new("managed_by_tuvima", "Managed by Tuvima"),
        new("existing_library", "Existing library"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SourceRoleOptions =
    [
        new("primary_destination", "Primary destination"),
        new("secondary", "Secondary source"),
        new("intake", "Intake source"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> SourceTypeOptions =
    [
        new("local_folder", "Local folder"),
        new("network_share", "Network share"),
        new("mobile_device", "Mobile device"),
        new("connected_device", "Connected device"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> IncomingPurposeOptions =
    [
        new("shared_intake", "Shared intake"),
        new("browser_uploads", "Browser uploads"),
        new("device_intake", "Device intake"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> IncomingHandlingOptions =
    [
        new("route_automatically", "Route automatically"),
        new("stage_then_route", "Stage then route"),
        new("index_in_place", "Index in place"),
    ];

    private static readonly IReadOnlyList<AppSelectOption> LibraryFilterOptions =
    [
        new("all", "All", Icons.Material.Outlined.Layers),
        new("read", "Read", Icons.Material.Outlined.MenuBook),
        new("watch", "Watch", Icons.Material.Outlined.LiveTv),
        new("listen", "Listen", Icons.Material.Outlined.Headphones),
    ];

    private static readonly LibraryDetailTabOption[] LibraryDetailTabs =
    [
        new("overview", "Overview"),
        new("folders", "Folders"),
        new("organization", "Organization"),
        new("advanced", "Advanced"),
    ];

    private static readonly OrganizationDetailOption[] OrganizationDetailOptions =
    [
        new("tuvima_standard", "Tuvima Standard", "Use media-aware folders and filenames for new imports.", Icons.Material.Outlined.AutoAwesome),
        new("keep_original_names", "Keep original names", "Preserve existing names and folder structure.", Icons.Material.Outlined.FolderCopy),
        new("custom", "Custom", "Use a library-specific naming template.", Icons.Material.Outlined.Tune),
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override void OnParametersSet()
    {
        var section = NormalizeSection(Subsection);
        EnsureSelection(section);
    }

    private RenderFragment OverviewSurface(bool readOnly) => @<div class="media-management__overview">
        <AppSegmentedControl Value="@_libraryFilter"
                             ValueChanged="@SetLibraryFilter"
                             Options="@LibraryFilterOptions"
                             AriaLabel="Choose a media area" />

        <div class="media-management-metrics" aria-label="Library summary">
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-metric">
                <span class="media-management-metric__icon"><MudIcon Icon="@Icons.Material.Outlined.VideoLibrary" /></span>
                <span><small>Total libraries</small><strong>@(_configuration?.Libraries.Count ?? 0)</strong><em>Across Read, Watch, and Listen</em></span>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-metric">
                <span class="media-management-metric__icon media-management-metric__icon--blue"><MudIcon Icon="@Icons.Material.Outlined.Folder" /></span>
                <span><small>Total folders</small><strong>@(_configuration?.Libraries.Sum(library => library.Sources.Count) ?? 0)</strong><em>Organized server locations</em></span>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-metric media-management-metric--link">
                <a href="/settings/review" aria-label="Open items needing review"></a>
                <span class="media-management-metric__icon media-management-metric__icon--warning"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /></span>
                <span><small>Items needing review</small><strong>@(_ingestionSnapshot?.Summary.ItemsNeedingReview ?? 0)</strong><em>Across all libraries</em></span>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-metric">
                <span class="media-management-metric__icon media-management-metric__icon--success"><MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" /></span>
                <span><small>Monitored import folders</small><strong>@(_configuration?.IncomingSources.Count ?? 0)</strong><em>Watching for new media</em></span>
            </AppPanel>
        </div>

        <AppCard Class="media-management-card">
            <div class="media-management-card__heading">
                <div><h3>@(_libraryFilter == "all" ? "All libraries" : $"{TitleCase(_libraryFilter)} libraries")</h3><p>Open a library to review its folders, organization rules, and health.</p></div>
            </div>
            @if (FilteredLibraries.Count == 0)
            {
                <AppPageState Kind="AppPageStateKind.Empty" Icon="@AreaIcon(_libraryFilter)" Title="No folders in this area" Message="Choose another media area or configure its first folder." />
            }
            else
            {
            <div class="media-management-table media-management-table--summary" role="table" aria-label="Configured libraries">
                <div class="media-management-table__head" role="row"><span>Library</span><span>Area</span><span>Folders</span><span>Items</span><span>Health</span><span></span></div>
                @foreach (var library in FilteredLibraries)
                {
                    <AppNativeButton Type="button" Class="media-management-table__row" OnClick="@(() => OpenLibrary(library))">
                        <span class="media-management-table__identity"><span class="media-management-table__media-icon @($"is-{library.Area}")"><MudIcon Icon="@LibraryIcon(library)" Size="Size.Small" /></span><span><strong>@LibraryDisplayName(library)</strong><small>@LibraryDescription(library)</small></span></span>
                        <AppStatusBadge Text="@TitleCase(library.Area)" Tone="@AreaTone(library.Area)" />
                        <span>@library.Sources.Count @(library.Sources.Count == 1 ? "folder" : "folders")</span>
                        <span>@DisplayFormat.FormatCount(LibraryItemCount(library))</span>
                        <AppStatusBadge Text="@LibraryStatus(library)" Tone="@LibraryStatusTone(library)" />
                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                    </AppNativeButton>
                }
            </div>
            }
        </AppCard>

        <AppCard Class="media-management-card">
            <div class="media-management-card__heading">
                <div>
                    <h3>View storage</h3>
                    <p>Every profile receives one Personal Space beneath this root. Uploads, phones, and managed imports become source folders inside that profile folder.</p>
                </div>
                <AppButton Label="Choose root" StartIcon="@Icons.Material.Outlined.FolderOpen"
                           ButtonStyle="AppButtonStyle.Outlined" Disabled="@(readOnly || _engineUnavailable)"
                           OnClick="BrowseViewRootAsync" />
            </div>
            <div class="media-management-form-grid">
                <AppSelect Label="Storage location" Value="@_configuration!.ViewStorage.StorageLocationId"
                           Options="@ViewStorageLocationOptions"
                           ValueChanged="@((string? value) => _configuration.ViewStorage.StorageLocationId = value ?? string.Empty)"
                           Disabled="@(readOnly || _engineUnavailable)" />
                <AppTextField Label="Relative View root" Value="@_configuration.ViewStorage.RelativeRoot"
                              ValueChanged="@((string? value) => _configuration.ViewStorage.RelativeRoot = value ?? string.Empty)"
                              ReadOnly="@(readOnly || _engineUnavailable)" />
            </div>
            <div class="media-management-example">
                <span>Managed hierarchy</span>
                <code>@ViewRootPreview\profiles\&lt;profile-id&gt;\sources\&lt;source-id&gt;</code>
            </div>
            <AppAlert Tone="AppUiTone.Info">
                Personal Spaces are not libraries and do not have primary or secondary folders. Existing external archives can still be linked read-only from the owning profile's View settings.
            </AppAlert>
        </AppCard>

        <div class="media-management__aside-grid">
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" />
                <div><strong>Import folders</strong><p>@IncomingSummary</p><a href="/settings/import-folders">Manage import folders</a></div>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" />
                <div><strong>Existing folders stay unchanged</strong><p>Tuvima can scan and index an existing library, but it never moves, renames, tags, or deletes its files.</p></div>
            </AppPanel>
        </div>
    </div>;

    private RenderFragment IncomingSurface(bool readOnly) => @<div class="media-management__incoming">
        <AppCard Class="media-management-card">
            <div class="media-management-card__heading">
                <div><h3>Import folders</h3><p>Shared intake locations are unassigned. Tuvima receives each file, determines its destination, then applies that library's policy.</p></div>
                <AppButton Label="Add import folder" StartIcon="@Icons.Material.Outlined.Add" ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary" Disabled="@(readOnly || _engineUnavailable)" OnClick="AddIncomingSourceAsync" />
            </div>
            <div class="media-management-source-list">
                @foreach (var source in _configuration!.IncomingSources)
                {
                    <details class="media-management-source media-management-source--incoming" @key="source.Id">
                        <summary>
                            <span class="media-management-table__identity"><MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" /><strong>@(string.IsNullOrWhiteSpace(source.Path) ? "New import folder" : source.Path)</strong></span>
                            <span>@TitleCase(source.Purpose)</span>
                            <span>@IncomingSourceSummary(source)</span>
                            <AppStatusBadge Text="@PathStatus(source.Path)" Tone="@PathTone(source.Path)" />
                            <span class="media-management-source__edit">Edit</span>
                        </summary>
                        <div class="media-management-source__editor">
                        <div class="media-management-source__path">
                            <MudIcon Icon="@Icons.Material.Outlined.MoveToInbox" />
                            <AppTextField Value="@source.Path" ValueChanged="@((string? value) => source.Path = value ?? string.Empty)"
                                          Label="Engine path" Placeholder="/watch" ReadOnly="@(readOnly || _engineUnavailable)" />
                            <AppIconButton Icon="@Icons.Material.Outlined.FolderOpen" Tooltip="Browse" AriaLabel="Browse incoming folder"
                                           Disabled="@(readOnly || _engineUnavailable)" OnClick="@(() => BrowseIncomingAsync(source))" />
                            <AppStatusBadge Text="@PathStatus(source.Path)" Tone="@PathTone(source.Path)" />
                        </div>
                        <div class="media-management-source__fields">
                            <AppTextField Label="Friendly name" Value="@source.Notes" ValueChanged="@((string? value) => source.Notes = value)" ReadOnly="@(readOnly || _engineUnavailable)" />
                            <AppSelect Label="Purpose" Value="@source.Purpose" Options="@IncomingPurposeOptions"
                                       ValueChanged="@((string? value) => source.Purpose = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSelect Label="Default handling" Value="@source.DefaultHandling" Options="@IncomingHandlingOptions"
                                       ValueChanged="@((string? value) => source.DefaultHandling = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSelect Label="Source type" Value="@source.SourceType" Options="@SourceTypeOptions"
                                       ValueChanged="@((string? value) => source.SourceType = value ?? string.Empty)" Disabled="@(readOnly || _engineUnavailable)" />
                            <AppSwitchRow Label="Include subfolders" Value="@source.IncludeSubdirectories"
                                          ValueChanged="@((bool value) => source.IncludeSubdirectories = value)" Disabled="@(readOnly || _engineUnavailable)" />
                        </div>
                        <div class="media-management-source__footer">
                            <span>@IncomingSourceSummary(source)</span>
                            <AppIconButton Icon="@Icons.Material.Outlined.Delete" Tooltip="Remove" AriaLabel="Remove incoming folder"
                                           Tone="AppUiTone.Error" Disabled="@(readOnly || _engineUnavailable)"
                                           OnClick="@(() => RemoveIncomingSource(source))" />
                        </div>
                        </div>
                    </details>
                }
            </div>
        </AppCard>

        <div class="media-management__aside-grid">
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.Route" />
                <div><strong>How incoming works</strong><p>Receive file → determine destination → apply library policy → store and index. Users never need to manage staging.</p></div>
            </AppPanel>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="media-management-info">
                <MudIcon Icon="@Icons.Material.Outlined.UploadFile" />
                <div><strong>Direct library intake</strong><p>Browser upload, drag-and-drop, mobile backup, and connected devices retain the chosen destination library.</p></div>
            </AppPanel>
        </div>
    </div>;

    private RenderFragment LibraryDetailSurface(LibraryFolderDto library, bool readOnly) => @<div class="library-detail">
        <header class="library-detail__header">
            <div class="library-detail__identity">
                <span class="library-detail__icon @($"is-{library.Area}")"><MudIcon Icon="@LibraryIcon(library)" /></span>
                <div>
                    <h2>@LibraryDisplayName(library)</h2>
                    <p>@TitleCase(library.Area) library · @LibraryDescription(library)</p>
                    <span><AppStatusBadge Text="@TitleCase(library.Area)" Tone="@AreaTone(library.Area)" /><code>ID: @library.Id</code></span>
                </div>
            </div>
            <AppActionBar>
                <AppButton Label="Edit library" StartIcon="@Icons.Material.Outlined.Edit" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Href="@LibraryTabRoute(library, "advanced")" />
                <AppButton Label="Add folder" StartIcon="@Icons.Material.Outlined.Add" ButtonStyle="AppButtonStyle.Outlined" Disabled="@(readOnly || _engineUnavailable)" OnClick="@(() => AddAndBrowseLibrarySourceAsync(library))" />
            </AppActionBar>
        </header>

        <nav class="library-detail__tabs" aria-label="Library detail sections">
            @foreach (var tab in LibraryDetailTabs)
            {
                <a href="@LibraryTabRoute(library, tab.Value)" class="@(CurrentDetailTab == tab.Value ? "is-active" : null)" aria-current="@(CurrentDetailTab == tab.Value ? "page" : null)">@tab.Label</a>
            }
        </nav>

        @if (CurrentDetailTab == "overview")
        {
            <MetadataPipelineStrip MediaType="@library.MediaTypes.FirstOrDefault()"
                                   LocalOnly="@(library.MetadataPolicy is "local_only" or "manual")" />
            <div class="library-detail__metrics" aria-label="Library health summary">
                @DetailMetric(Icons.Material.Outlined.CollectionsBookmark, "Items", DisplayFormat.FormatCount(LibraryItemCount(library)), "Owned media")
                @DetailMetric(Icons.Material.Outlined.Folder, "Folders", library.Sources.Count.ToString(), "Server locations")
                @DetailMetric(Icons.Material.Outlined.CalendarMonth, "Last scan", LibraryLastScan(library), "Across all folders")
                @DetailMetric(Icons.Material.Outlined.CheckCircle, "Health", LibraryStatus(library), "Current folder access")
            </div>
            <div class="library-detail__overview-grid">
                <AppCard Class="library-detail__folders-card">
                    <div class="media-management-card__heading"><div><h3>Folders in this library</h3><p>Managed destinations and protected existing sources.</p></div><AppButton Label="Manage folders" Href="@LibraryTabRoute(library, "folders")" ButtonStyle="AppButtonStyle.Text" EndIcon="@Icons.Material.Outlined.ChevronRight" /></div>
                    <div class="library-detail__folder-summary" role="list">
                        @foreach (var source in library.Sources)
                        {
                            <div role="listitem">
                                <span class="library-detail__folder-path"><MudIcon Icon="@Icons.Material.Outlined.Folder" /><span><strong>@SourceFriendlyName(source)</strong><code>@source.Path</code></span></span>
                                <AppStatusBadge Text="@(source.Role == "primary_destination" ? "Primary" : "Secondary")" Tone="@(source.Role == "primary_destination" ? AppUiTone.Primary : AppUiTone.Neutral)" />
                                <span>@(source.ManagementMode == "managed_by_tuvima" ? "Managed" : "Existing library")</span>
                                <AppStatusBadge Text="@PathStatus(source.Path)" Tone="@PathTone(source.Path)" />
                            </div>
                        }
                    </div>
                </AppCard>
                <AppCard Class="library-detail__organization-card">
                    <div class="media-management-card__heading"><div><h3>Organization</h3><p>How managed media is named and placed.</p></div><AppButton Label="Customize" Href="@LibraryTabRoute(library, "organization")" ButtonStyle="AppButtonStyle.Text" /></div>
                    <dl class="library-detail__summary-list">
                        <div><dt>Naming mode</dt><dd>@OrganizationModeLabel(library.OrganizationPolicy.Mode)</dd></div>
                        <div><dt>Organize new imports</dt><dd>@(library.Sources.Any(source => source.ParticipatesInOrganization) ? "On" : "Off")</dd></div>
                        <div><dt>Existing files unchanged</dt><dd>Yes</dd></div>
                        <div><dt>Metadata writeback</dt><dd>@(library.Sources.Any(source => source.WritebackOverride == true) ? "On" : "Off")</dd></div>
                    </dl>
                </AppCard>
            </div>
            <AppPanel Density="AppSurfaceDensity.Compact" Class="library-detail__explanation">
                <MudIcon Icon="@LibraryIcon(library)" />
                <div><strong>@LibraryDisplayName(library) is a @TitleCase(library.Area) library</strong><p>@LibraryDescription(library). Tuvima identifies owned media, enriches it with trusted metadata, and keeps Existing Library folders unchanged.</p></div>
            </AppPanel>
        }
        else if (CurrentDetailTab == "folders")
        {
            <AppCard Class="media-management-card">
                <div class="media-management-card__heading"><div><h3>Folders</h3><p>Choose an explicit primary destination and protect existing libraries from mutation.</p></div><AppButton Label="Add folder" StartIcon="@Icons.Material.Outlined.Add" ButtonStyle="AppButtonStyle.Filled" Tone="AppUiTone.Primary" Disabled="@(readOnly || _engineUnavailable)" OnClick="@(() => AddAndBrowseLibrarySourceAsync(library))" /></div>
                <div class="media-management-source-list">
                    @foreach (var source in library.Sources)
                    {
                        <article class="library-detail__folder-editor @(source.ManagementMode == "existing_library" ? "is-existing" : null)" @key="source.Id">
                            <div class="library-detail__folder-path"><MudIcon Icon="@Icons.Material.Outlined.Folder" /><span><strong>@SourceFriendlyName(source)</strong><code>@source.Path</code></span></div>
                            <div><span>Role</span><AppSelect Value="@source.Role" Options="@SourceRoleOptions" ValueChanged="@((string? value) => SetSourceRole(library, source, value))" Disabled="@(readOnly || _engineUnavailable)" /></div>
                            <div><span>Mode</span><AppSelect Value="@source.ManagementMode" Options="@ManagementOptions" ValueChanged="@((string? value) => SetManagementMode(library, source, value))" Disabled="@(readOnly || _engineUnavailable)" /></div>
                            <div><span>Access</span><strong>@(source.ManagementMode == "managed_by_tuvima" ? "Read / Write" : "Read-only")</strong></div>
                            <AppSwitchRow Label="Include subfolders" Value="@source.IncludeSubdirectories" ValueChanged="@((bool value) => source.IncludeSubdirectories = value)" Disabled="@(readOnly || _engineUnavailable)" />
                            <div class="library-detail__folder-actions"><AppStatusBadge Text="@PathStatus(source.Path)" Tone="@PathTone(source.Path)" /><AppIconButton Icon="@Icons.Material.Outlined.FolderOpen" Tooltip="Change path" AriaLabel="Change folder path" OnClick="@(() => BrowseLibrarySourceAsync(library, source))" /><AppIconButton Icon="@Icons.Material.Outlined.Refresh" Tooltip="Test path" AriaLabel="Test folder path" OnClick="@(() => CheckPathAsync(source.Path))" /><AppIconButton Icon="@Icons.Material.Outlined.Delete" Tooltip="Remove" AriaLabel="Remove folder" Tone="AppUiTone.Error" Disabled="@(library.Sources.Count == 1)" OnClick="@(() => RemoveLibrarySource(library, source))" /></div>
                            <p>@(source.ManagementMode == "managed_by_tuvima" ? "Tuvima may organize new files here and apply naming rules." : "Tuvima scans and indexes this folder without renaming, moving, or modifying existing files.")</p>
                        </article>
                    }
                </div>
            </AppCard>
        }
        else if (CurrentDetailTab == "organization")
        {
            <AppCard Class="media-management-card">
                <div class="media-management-card__heading"><div><h3>Naming &amp; organization</h3><p>These rules apply only to new media entering managed folders.</p></div></div>
                <div class="library-detail__organization-options" role="radiogroup" aria-label="Organization mode">
                    @foreach (var option in OrganizationDetailOptions)
                    {
                        <AppNativeButton Type="button" Class="@($"library-detail__organization-option {(library.OrganizationPolicy.Mode == option.Value ? "is-active" : null)}")" OnClick="@(() => library.OrganizationPolicy.Mode = option.Value)">
                            <MudIcon Icon="@option.Icon" /><span><strong>@option.Label</strong><small>@option.Help</small></span><MudIcon Icon="@(library.OrganizationPolicy.Mode == option.Value ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Outlined.RadioButtonUnchecked)" />
                        </AppNativeButton>
                    }
                </div>
                @if (library.OrganizationPolicy.Mode == "custom")
                {
                    <AppTextField Label="Naming template" Value="@library.OrganizationPolicy.CustomTemplate" ValueChanged="@((string? value) => library.OrganizationPolicy.CustomTemplate = value)" Placeholder="{Title} ({Year})/{Title} ({Year}).{Extension}" />
                }
                <div class="media-management-example"><span>Live example</span><code>@OrganizationExample(library)</code></div>
                <AppAlert Tone="AppUiTone.Info">Changing organization rules does not alter existing files. Preview any reorganization from a managed folder before applying filesystem changes.</AppAlert>
            </AppCard>
        }
        else
        {
            <AppCard Class="media-management-card">
                <div class="media-management-card__heading"><div><h3>Advanced library settings</h3><p>Identity and source policies that rarely need adjustment.</p></div></div>
                <div class="media-management-form-grid">
                    <AppTextField Label="Library name" Value="@library.Name" ValueChanged="@((string? value) => library.Name = value ?? string.Empty)" ReadOnly="@(readOnly || _engineUnavailable)" />
                    <AppSelect Label="Duplicate handling" Value="@library.DuplicatePolicy" Options="@DuplicateOptions" ValueChanged="@((string? value) => library.DuplicatePolicy = value ?? "skip_exact")" Disabled="@(readOnly || _engineUnavailable)" />
                </div>
                <dl class="library-detail__summary-list">
                    <div><dt>Library kind</dt><dd>Catalogued</dd></div>
                    <div><dt>Metadata policy</dt><dd>@PolicyLabel(library.MetadataPolicy)</dd></div>
                    <div><dt>Primary destination</dt><dd>@(library.GetPrimaryDestination()?.Path ?? "Not configured")</dd></div>
                    <div><dt>Visibility</dt><dd>@TitleCase(library.Visibility)</dd></div>
