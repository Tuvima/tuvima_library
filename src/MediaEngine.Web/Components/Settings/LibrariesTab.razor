    private RenderFragment DetailMetric(string icon, string label, string value, string help) => @<AppPanel Density="AppSurfaceDensity.Compact" Class="library-detail__metric">
        <span><MudIcon Icon="@icon" /></span><div><small>@label</small><strong>@value</strong><em>@help</em></div>
    </AppPanel>;

