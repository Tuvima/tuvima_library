@namespace MediaEngine.Web.Components.Settings

<AppAlert Tone="AppUiTone.Info">
    <strong>@Title</strong>
    <span>
        Enter the path as the Engine sees it. In Docker or a NAS container this is the container mount path
        (for example <code>@ExamplePath</code>), not the host's <code>/mnt/...</code>, <code>/share/...</code>, or <code>/volume1/...</code> path.
        Browse or test the path before saving; existing sources should remain read-only unless Tuvima is allowed to manage their files.
    </span>
</AppAlert>

@code {
    private const string Title = "Library source paths";
    private const string ExamplePath = "/library/Books";
}
