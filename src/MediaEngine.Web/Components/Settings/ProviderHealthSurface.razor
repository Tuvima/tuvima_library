@namespace MediaEngine.Web.Components.Settings
@inject IEngineApiClient ApiClient
@inject ProviderCatalogueService CatalogueService
@inject ILogger<ProviderHealthSurface> Logger
@inject ISnackbar Snackbar

<div class="provider-health-page">
    <div class="provider-health-page__actions">
        <AppButton Label="Refresh health"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   Size="AppControlSize.Compact"
                   Disabled="@_loading"
                   OnClick="LoadAsync" />
    </div>

    @if (_loading && _providers.Count == 0)
    {
        <AppPageState Kind="AppPageStateKind.Loading" Title="Loading provider health" Class="py-8" />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _providers.Count == 0)
    {
        <AppPageState Kind="AppPageStateKind.Error"
                      Title="Provider health is unavailable"
                      Message="@_error">
            <Actions>
                <AppButton Label="Try again" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" />
            </Actions>
        </AppPageState>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
        }

        <div class="metadata-summary-grid" aria-label="Provider health summary">
            <MetadataMetricTile Value="@EnabledCount.ToString()" Label="Enabled providers" Icon="@Icons.Material.Outlined.Dns" />
            <MetadataMetricTile Value="@HealthyCount.ToString()" Label="Healthy" Icon="@Icons.Material.Outlined.CheckCircleOutline" Tone="AppUiTone.Success" />
            <MetadataMetricTile Value="@IssueCount.ToString()" Label="Need attention" Icon="@Icons.Material.Outlined.WarningAmber" Tone="@(IssueCount > 0 ? AppUiTone.Warning : AppUiTone.Neutral)" />
            <MetadataMetricTile Value="@NotCheckedCount.ToString()" Label="Not checked" Icon="@Icons.Material.Outlined.HelpOutline" Tone="AppUiTone.Neutral" />
        </div>

        @if (_providers.Count == 0)
        {
            <AppEmptyState Title="No metadata providers"
                           Message="The Engine did not report any user-facing metadata providers." />
        }
        else
        {
            <section class="provider-health-table" aria-label="Provider health details">
                <div class="provider-health-table__header" aria-hidden="true">
                    <span>Provider</span><span>Status</span><span>Last checked</span><span>Recent failures</span><span>Actions</span>
                </div>
                @foreach (var provider in _providers)
                {
                    <article class="provider-health-row" @key="provider.Key">
                        <div class="provider-health-row__identity" data-label="Provider">
                            <span class="provider-health-row__icon">
                                <MudIcon Icon="@provider.Icon" />
                            </span>
                            <span><strong>@provider.DisplayName</strong><small>@ProviderAvailability(provider)</small></span>
                        </div>
                        <div data-label="Status">
                            <AppStatusBadge Text="@HealthLabel(provider)" Tone="@HealthTone(provider)" Icon="@HealthIcon(provider)" />
                        </div>
                        <div class="provider-health-row__time" data-label="Last checked">@LastChecked(provider)</div>
                        <div class="provider-health-row__failures" data-label="Recent failures">
                            @if (provider.ConsecutiveFailures > 0)
                            {
                                <strong>@provider.ConsecutiveFailures consecutive</strong>
                                @if (!string.IsNullOrWhiteSpace(provider.FailureReason))
                                {
                                    <small>@provider.FailureReason</small>
                                }
                            }
                            else
                            {
                                <span>None recorded</span>
                            }
                        </div>
                        <div class="provider-health-row__action" data-label="Actions">
                            <AppButton Label="@(provider.Testing ? "Testing…" : "Test connection")"
                                       StartIcon="@Icons.Material.Outlined.NetworkCheck"
                                       Size="AppControlSize.Compact"
                                       Disabled="@(provider.Testing || !provider.Enabled)"
                                       OnClick="@(() => TestAsync(provider))" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(provider.TestMessage))
                        {
                            <div class="provider-health-row__result" role="status">@provider.TestMessage</div>
                        }
                    </article>
                }
            </section>
        }

        <p class="provider-health-page__note">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
            Health and failure history come from recorded Engine checks. Response time is shown only after you run a live connection test.
        </p>
    }
</div>

@code {
    private readonly List<ProviderHealthItem> _providers = [];
    private bool _loading = true;
    private string? _error;

    private int EnabledCount => _providers.Count(provider => provider.Enabled);
    private int HealthyCount => _providers.Count(provider => provider.State == ProviderHealthState.Healthy);
    private int IssueCount => _providers.Count(provider => provider.State is ProviderHealthState.Degraded or ProviderHealthState.Unavailable or ProviderHealthState.AuthenticationRequired);
    private int NotCheckedCount => _providers.Count(provider => provider.State == ProviderHealthState.NotChecked);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var catalogueTask = CatalogueService.GetCatalogueAsync();
            var statusTask = ApiClient.GetProviderStatusAsync();
            var healthTask = ApiClient.GetProviderHealthAsync();
            await Task.WhenAll(catalogueTask, statusTask, healthTask);

            var catalogue = (await catalogueTask).ToDictionary(item => item.Name, StringComparer.OrdinalIgnoreCase);
            var health = (await healthTask).ToDictionary(item => item.ProviderId, StringComparer.OrdinalIgnoreCase);
            _providers.Clear();
            foreach (var status in (await statusTask).Where(item => ProviderCatalogueService.IsVisibleProvider(item.Name)))
            {
                catalogue.TryGetValue(status.Name, out var catalog);
                health.TryGetValue(status.Name, out var recorded);
                _providers.Add(new ProviderHealthItem
                {
                    Key = status.Name,
                    DisplayName = !string.IsNullOrWhiteSpace(catalog?.DisplayName)
                        ? catalog.DisplayName
                        : !string.IsNullOrWhiteSpace(status.DisplayName) ? status.DisplayName : CatalogueService.GetDisplayName(status.Name),
                    Icon = CatalogueService.GetAccent(status.Name, catalog?.MaterialIcon ?? status.CustomIconName).Icon,
                    Enabled = status.Enabled,
                    State = ResolveState(status, recorded),
                    LastCheckedAt = ParseDate(recorded?.LastCheckAt) ?? ParseDate(status.LastSuccessAt) ?? ParseDate(status.LastFailureAt),
                    ConsecutiveFailures = recorded?.ConsecutiveFailures ?? status.ConsecutiveFailures,
                    FailureReason = recorded?.LastFailureReason ?? status.LastFailureReason,
                });
            }

            _providers.Sort((left, right) => string.Compare(left.DisplayName, right.DisplayName, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load provider health");
            _error = "The Engine did not return provider health. Existing settings were not changed.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TestAsync(ProviderHealthItem provider)
    {
        if (provider.Testing || !provider.Enabled) return;
        provider.Testing = true;
        provider.TestMessage = null;
        try
        {
            var result = await ApiClient.TestProviderAsync(provider.Key);
            provider.LastCheckedAt = DateTimeOffset.Now;
            if (result?.Success == true)
            {
                provider.State = ProviderHealthState.Healthy;
                provider.ConsecutiveFailures = 0;
                provider.FailureReason = null;
                provider.TestMessage = result.ResponseTimeMs > 0
                    ? $"Connection verified in {result.ResponseTimeMs} ms."
                    : "Connection verified.";
            }
            else
            {
                provider.State = ProviderHealthState.Unavailable;
                provider.FailureReason = ShortMessage(result?.Message);
                provider.TestMessage = provider.FailureReason;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not test provider {Provider}", provider.Key);
            provider.State = ProviderHealthState.Unavailable;
            provider.TestMessage = provider.FailureReason = "Connection test failed.";
            Snackbar.Add($"Could not test {provider.DisplayName}.", Severity.Warning);
        }
        finally
        {
            provider.Testing = false;
        }
    }

    private static ProviderHealthState ResolveState(ProviderStatusDto status, ProviderHealthStatusResponse? health)
    {
        if (!status.Enabled) return ProviderHealthState.Disabled;
        if (status.RequiresApiKey && !status.HasApiKey) return ProviderHealthState.AuthenticationRequired;
        return (health?.Status ?? status.HealthStatus)?.Trim().ToLowerInvariant() switch
        {
            "healthy" => ProviderHealthState.Healthy,
            "degraded" => ProviderHealthState.Degraded,
            "down" or "offline" or "unavailable" => ProviderHealthState.Unavailable,
            _ when status.IsReachable => ProviderHealthState.Healthy,
            _ => ProviderHealthState.NotChecked,
        };
    }

    private static string HealthLabel(ProviderHealthItem item) => item.State switch
    {
        ProviderHealthState.Healthy => "Healthy",
        ProviderHealthState.Degraded => "Degraded",
        ProviderHealthState.Unavailable => "Unavailable",
        ProviderHealthState.AuthenticationRequired => "Authentication required",
        ProviderHealthState.Disabled => "Disabled",
        _ => "Not checked",
    };

    private static AppUiTone HealthTone(ProviderHealthItem item) => item.State switch
    {
        ProviderHealthState.Healthy => AppUiTone.Success,
        ProviderHealthState.Degraded or ProviderHealthState.AuthenticationRequired => AppUiTone.Warning,
        ProviderHealthState.Unavailable => AppUiTone.Error,
        _ => AppUiTone.Neutral,
    };

    private static string HealthIcon(ProviderHealthItem item) => item.State switch
    {
        ProviderHealthState.Healthy => Icons.Material.Outlined.CheckCircleOutline,
        ProviderHealthState.Degraded => Icons.Material.Outlined.WarningAmber,
        ProviderHealthState.Unavailable => Icons.Material.Outlined.CloudOff,
        ProviderHealthState.AuthenticationRequired => Icons.Material.Outlined.Key,
        ProviderHealthState.Disabled => Icons.Material.Outlined.PauseCircleOutline,
        _ => Icons.Material.Outlined.HelpOutline,
    };

    private static string ProviderAvailability(ProviderHealthItem item) => item.Enabled ? "Enabled" : "Disabled";
    private static DateTimeOffset? ParseDate(string? value) => DateTimeOffset.TryParse(value, out var parsed) ? parsed : null;
    private static string LastChecked(ProviderHealthItem item)
    {
        if (!item.LastCheckedAt.HasValue) return "No check recorded";
        var elapsed = DateTimeOffset.Now - item.LastCheckedAt.Value.ToLocalTime();
        if (elapsed.TotalMinutes < 1) return "Just now";
        if (elapsed.TotalMinutes < 60) return $"{Math.Max(1, (int)elapsed.TotalMinutes)} min ago";
        if (elapsed.TotalHours < 24) return $"{Math.Max(1, (int)elapsed.TotalHours)} hr ago";
        return item.LastCheckedAt.Value.LocalDateTime.ToString("MMM d, yyyy");
    }

    private static string ShortMessage(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Connection test did not succeed.";
        var line = value.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim();
        return string.IsNullOrWhiteSpace(line) ? "Connection test did not succeed." : line;
    }

    private enum ProviderHealthState { NotChecked, Healthy, Degraded, Unavailable, AuthenticationRequired, Disabled }

    private sealed class ProviderHealthItem
    {
        public string Key { get; init; } = string.Empty;
        public string DisplayName { get; init; } = string.Empty;
        public string Icon { get; init; } = Icons.Material.Outlined.Cloud;
        public bool Enabled { get; init; }
        public ProviderHealthState State { get; set; }
        public DateTimeOffset? LastCheckedAt { get; set; }
        public int ConsecutiveFailures { get; set; }
        public string? FailureReason { get; set; }
        public bool Testing { get; set; }
        public string? TestMessage { get; set; }
    }
}
