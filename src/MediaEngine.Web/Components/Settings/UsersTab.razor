@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.LocalAssets
@inject UIOrchestratorService Orchestrator
@inject IEngineApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedStrings> L

<div class="tl-page users-page">
    @if (_loading)
    {
        <AppProgressBar Indeterminate="true" Class="users-page__progress" />
    }
    else
    {
        <section class="users-page__summary" aria-label="User summary">
            <div>
                <span>Profiles</span>
                <strong>@_allRows.Count</strong>
            </div>
            <div>
                <span>Administrators</span>
                <strong>@AdministratorCount</strong>
            </div>
            <div>
                <span>Other roles</span>
                <strong>@(_allRows.Count - AdministratorCount)</strong>
            </div>
        </section>

        <SettingsSectionPanel Title="Profiles"
                              Description="Manage the people who can use this Tuvima Library."
                              Icon="@Icons.Material.Outlined.Group">
            <AppActionBar Align="AppHorizontalAlignment.End" Class="users-page__actions">
                <AppButton Label="@L["Users_NewProfile"].Value"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           ButtonStyle="AppButtonStyle.Filled"
                           Tone="AppUiTone.Primary"
                           OnClick="@OpenCreateDialog" />
            </AppActionBar>

            @if (_allRows.Count == 0)
            {
                <AppEmptyState Title="@L["Users_NoProfiles"].Value" />
            }
            else
            {
                <div class="users-page__table-wrap">
                    <AppTable Class="users-table">
                        <thead>
                            <tr>
                                <th>Profile</th>
                                <th>@L["Users_ColRole"]</th>
                                <th>Created</th>
                                <th class="users-table__actions">@L["Users_ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _allRows)
                            {
                                <tr>
                                    <td>
                                        <div class="users-table__identity">
                                            <AppAvatar Initials="@row.Initials"
                                                       ImageUrl="@row.AvatarImageUrl"
                                                       AltText="@row.DisplayName"
                                                       AccentColor="@row.AvatarColor"
                                                       Size="AppControlSize.Compact"
                                                       Title="@row.DisplayName" />
                                            <span class="users-table__name">@row.DisplayName</span>
                                        </div>
                                    </td>
                                    <td><AppChip Text="@row.Role" Tone="@RoleTone(row.Role)" /></td>
                                    <td><span class="users-table__muted">@row.Created</span></td>
                                    <td class="users-table__actions">
                                        <AppIconButton Icon="@Icons.Material.Outlined.PhotoLibrary"
                                                       Tooltip="Manage View access"
                                                       AriaLabel="@($"Manage View access for {row.DisplayName}")"
                                                       Disabled="@row.Id.Equals(Guid.Empty)"
                                                       OnClick="@(() => OpenViewPolicyDialogAsync(row))" />
                                        <AppIconButton Icon="@Icons.Material.Outlined.ManageAccounts"
                                                       Tooltip="Manage sign-in accounts"
                                                       AriaLabel="@($"Manage sign-in accounts for {row.DisplayName}")"
                                                       Disabled="@row.Id.Equals(Guid.Empty)"
                                                       OnClick="@(() => OpenExternalLoginsDialogAsync(row))" />
                                        <AppIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Tooltip="@L["Users_DeleteProfileTooltip"].Value"
                                                       AriaLabel="@L["Users_DeleteProfileTooltip"].Value"
                                                       Tone="AppUiTone.Error"
                                                       Disabled="@row.IsSeed"
                                                       OnClick="@(() => DeleteProfileAsync(row))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </AppTable>
                </div>
            }
        </SettingsSectionPanel>

        <SettingsSectionPanel Title="View administration"
                              Description="View keeps each profile's personal media separate from the catalogued library."
                              Icon="@Icons.Material.Outlined.PhotoLibrary">
            <AppAlert Tone="AppUiTone.Info">
                Folder sources and connected devices are managed as real personal-library sources. Face grouping and other local analysis use the existing Local AI settings; there are no separate or simulated View AI controls.
            </AppAlert>
            <SettingsAdvancedLinkRow Title="Folders and sources"
                                     Description="Attach or review server-visible folders for each profile's Personal Space."
                                     Href="/settings/access"
                                     ActionLabel="Manage" />
            <SettingsAdvancedLinkRow Title="Local AI"
                                     Description="Review the server's existing local analysis models and schedules."
                                     Href="/settings/ai"
                                     ActionLabel="View" />
        </SettingsSectionPanel>

        <SettingsSectionPanel Title="Advanced"
                              Description="Authentication, guest integrations, and connection policy."
                              Icon="@Icons.Material.Outlined.Tune">
            <SettingsAdvancedLinkRow Title="Authentication"
                                     Description="Review local and external sign-in configuration."
                                     Href="/settings/access/authentication"
                                     ActionLabel="View" />
            <SettingsAdvancedLinkRow Title="Guest API keys"
                                     Description="Create or revoke keys for approved integrations."
                                     Href="/settings/access/api-keys"
                                     ActionLabel="Manage" />
            <SettingsAdvancedLinkRow Title="Session policy"
                                     Description="Review how remote and local connections are protected."
                                     Href="/settings/access/session-policy"
                                     ActionLabel="View" />
        </SettingsSectionPanel>
    }
</div>

<AppDialog @bind-Visible="_createOpen"
           Title="@L["Users_CreateProfileTitle"].Value"
           Icon="@Icons.Material.Filled.PersonAdd"
           Size="Small"
           Options="@_dialogOptions"
           OnClose="@CloseCreateDialog">
    <ChildContent>
        <AppForm>
            <AppTextField @bind-Value="_newDisplayName"
                          Label="@L["Users_DisplayNameLabel"].Value"
                          Placeholder="@L["Users_DisplayNamePlaceholder"].Value"
                          MaxLength="50" />
            <AppSelect T="string" @bind-Value="_newRole"
                       Label="@L["Users_RoleLabel"].Value"
                       Options="@RoleOptions" />
        </AppForm>
    </ChildContent>
    <FooterContent>
        <AppActionBar>
            <AppButton Label="@L["Users_Cancel"].Value" OnClick="@CloseCreateDialog" />
            <AppButton Label="@(_creating ? L["Users_Creating"].Value : L["Users_Create"].Value)"
                       ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       Disabled="@(string.IsNullOrWhiteSpace(_newDisplayName) || _creating)"
                       OnClick="@CreateProfileAsync" />
        </AppActionBar>
    </FooterContent>
</AppDialog>

<AppDialog @bind-Visible="_viewPolicyOpen"
           Title="View access"
           Icon="@Icons.Material.Outlined.PhotoLibrary"
           Size="Medium"
           Options="@_dialogOptions"
           OnClose="@CloseViewPolicyDialog">
    <ChildContent>
        @if (_selectedViewUser is not null)
        {
            <div class="users-dialog-title">@_selectedViewUser.DisplayName</div>
        }

        @if (_viewPolicyLoading)
        {
            <AppProgressBar Indeterminate="true" Class="users-page__progress" />
        }
        else if (_viewPolicyUnavailable)
        {
            <AppAlert Tone="AppUiTone.Error">
                View policy could not be loaded from the Engine. No placeholder settings are shown.
            </AppAlert>
        }
        else
        {
            <div class="users-view-policy" aria-label="View profile policy">
                <AppSwitchRow @bind-Value="_viewEnabled"
                              Label="View enabled"
                              Description="Show this profile's private personal-media space in View." />
                <AppSwitchRow @bind-Value="_accessSharedView"
                              Label="Access Shared View"
                              Description="Allow this profile to browse the Shared View aggregate." />
                <AppSwitchRow @bind-Value="_includeInSharedView"
                              Label="Include in Shared View"
                              Description="Contribute this profile's eligible personal media to Shared View. This is independent from access." />
                <AppSwitchRow @bind-Value="_allowGallerySharing"
                              Label="Allow Gallery Sharing"
                              Description="Allow this profile to share individual Galleries with other profiles." />
            </div>
        }

        <div class="users-dialog-divider"></div>
        <section class="users-view-sources" aria-labelledby="view-sources-heading">
            <div class="users-view-sources__heading">
                <div>
                    <div class="users-dialog-title" id="view-sources-heading">Sources &amp; Devices</div>
                    <p>Read-only status from this profile's persisted Personal Space.</p>
                </div>
                <AppActionBar>
                    <AppButton Label="@(_viewReconciling ? "Reconciling…" : "Reconcile")"
                               StartIcon="@Icons.Material.Outlined.Refresh"
                               ButtonStyle="AppButtonStyle.Text"
                               Size="AppControlSize.Compact"
                               Loading="@_viewReconciling"
                               Disabled="@(_selectedViewUser is null || _viewSourcesLoading || _viewSources?.PersonalSpace is null)"
                               OnClick="ReconcileViewAsync" />
                    <AppButton Label="Import folder"
                               StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                               ButtonStyle="AppButtonStyle.Outlined"
                               Size="AppControlSize.Compact"
                               Disabled="@(_selectedViewUser is null || _viewSourcesLoading)"
                               OnClick="@(() => AddPersonalSpaceFolderAsync(true))" />
                    <AppButton Label="Link existing folder"
                               StartIcon="@Icons.Material.Outlined.FolderOpen"
                               ButtonStyle="AppButtonStyle.Text"
                               Size="AppControlSize.Compact"
                               Disabled="@(_selectedViewUser is null || _viewSourcesLoading)"
                               OnClick="@(() => AddPersonalSpaceFolderAsync(false))" />
                </AppActionBar>
            </div>

            @if (_viewSourcesLoading)
            {
                <AppProgressBar Indeterminate="true" Class="users-page__progress" />
            }
            else if (_viewSourcesUnavailable)
            {
                <AppAlert Tone="AppUiTone.Error">
                    Sources and devices could not be loaded from the Engine. No placeholder status is shown.
                </AppAlert>
            }
            else if (_viewSources?.PersonalSpace is null)
            {
                <AppAlert Tone="AppUiTone.Info">
                    This profile does not have a persisted Personal Space yet. It will be created when a personal source is attached.
                </AppAlert>
            }
            else
            {
                <div class="users-view-sources__space-status">
                    <span>Personal Space · @_viewSources.PersonalSpace.RootPath</span>
                    <span>Updated @FormatWhen(_viewSources.PersonalSpace.UpdatedAt)</span>
                </div>

                <div class="users-view-sources__group">
                    <h4>Sources</h4>
                    @if (_viewSources.Sources.Count == 0)
                    {
                        <p class="users-view-sources__empty">No persisted sources are attached.</p>
                    }
                    else
                    {
                        <div class="users-view-sources__list">
                            @foreach (var source in _viewSources.Sources)
                            {
                                <AppCard Density="AppSurfaceDensity.Compact" Class="users-view-source-card">
                                    <div class="users-view-source-card__identity">
                                        <strong>@source.Name</strong>
                                        <span>@SourceTypeLabel(source.SourceType) · @source.StorageMode</span>
                                        <small>@source.Location</small>
                                    </div>
                                    <div class="users-view-source-card__status">
                                        <AppStatusBadge Text="@(source.Enabled ? "Active" : "Disabled")"
                                                        Tone="@(source.Enabled ? AppUiTone.Success : AppUiTone.Neutral)" />
                                        <span>Last activity</span>
                                        <strong>@FormatWhen(source.LastActivityAt)</strong>
                                        @if (!string.Equals(source.SourceType, "browser_upload", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <AppIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                           Tooltip="Detach source" AriaLabel="@($"Detach {source.Name}")"
                                                           Tone="AppUiTone.Error"
                                                           OnClick="@(() => DetachViewSourceAsync(source))" />
                                        }
                                    </div>
                                </AppCard>
                            }
                        </div>
                    }
                </div>

                <div class="users-view-sources__group">
                    <h4>Devices</h4>
                    @if (_viewSources.Devices.Count == 0)
                    {
                        <p class="users-view-sources__empty">No persisted devices are connected.</p>
                    }
                    else
                    {
                        <div class="users-view-sources__list">
                            @foreach (var device in _viewSources.Devices)
                            {
                                <AppCard Density="AppSurfaceDensity.Compact" Class="users-view-source-card">
                                    <div class="users-view-source-card__identity">
                                        <strong>@device.Name</strong>
                                        <span>@DeviceDetails(device)</span>
                                    </div>
                                    <div class="users-view-source-card__status">
                                        <AppChip Text="@BackupStateLabel(device.BackupState)"
                                                 Tone="@BackupStateTone(device.BackupState)" />
                                        <span>@FormatWhen(device.LastBackupAt)</span>
                                    </div>
                                </AppCard>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </ChildContent>
    <FooterContent>
        <AppActionBar>
            <AppButton Label="Cancel" OnClick="@CloseViewPolicyDialog" />
            <AppButton Label="@(_viewPolicySaving ? "Saving…" : "Save")"
                       ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       Disabled="@(_viewPolicyLoading || _viewPolicyUnavailable || _viewPolicySaving)"
                       OnClick="@SaveViewPolicyAsync" />
        </AppActionBar>
    </FooterContent>
</AppDialog>

<AppDialog @bind-Visible="_externalLoginsOpen"
           Title="Sign-in accounts"
           Icon="@Icons.Material.Outlined.ManageAccounts"
           Size="Small"
           Options="@_dialogOptions"
           OnClose="@CloseExternalLoginsDialog">
    <ChildContent>
        @if (_selectedUser is not null)
        {
            <div class="users-dialog-title">@_selectedUser.DisplayName</div>
        }

        @if (_externalLoginsLoading)
        {
            <AppProgressBar Indeterminate="true" Class="users-page__progress" />
        }
        else if (_externalLogins.Count == 0)
        {
            <AppAlert Tone="AppUiTone.Info">
                No SSO or OAuth accounts are linked to this profile.
            </AppAlert>
        }
        else
        {
            <div class="users-linked-list">
                @foreach (var login in _externalLogins)
                {
                    <AppCard Density="AppSurfaceDensity.Compact" Class="users-linked-account">
                        <div class="users-linked-account__body">
                            <div class="users-linked-account__provider">@login.Provider</div>
                            <div class="users-linked-account__identity">
                                @(login.Email ?? login.DisplayName ?? login.Subject)
                            </div>
                        </div>
                        <AppIconButton Icon="@Icons.Material.Outlined.LinkOff"
                                       Tooltip="Unlink account"
                                       AriaLabel="@($"Unlink {login.Provider} account")"
                                       Tone="AppUiTone.Error"
                                       Size="AppControlSize.Compact"
                                       OnClick="@(() => UnlinkExternalLoginAsync(login.Id))" />
                    </AppCard>
                }
            </div>
        }

        <div class="users-dialog-divider"></div>
        <div class="users-dialog-title">Link account manually</div>
        <AppForm>
            <AppTextField @bind-Value="_newLoginProvider"
                          Label="Provider"
                          Placeholder="oidc, google, microsoft, authentik" />
            <AppTextField @bind-Value="_newLoginSubject"
                          Label="Subject"
                          Placeholder="Stable user ID from the identity provider" />
            <AppTextField @bind-Value="_newLoginEmail" Label="Email" />
            <AppTextField @bind-Value="_newLoginDisplayName" Label="Display name" />
        </AppForm>
    </ChildContent>
    <FooterContent>
        <AppActionBar>
            <AppButton Label="Close" OnClick="@CloseExternalLoginsDialog" />
            <AppButton Label="@(_linkingExternalLogin ? "Linking…" : "Link account")"
                       ButtonStyle="AppButtonStyle.Filled"
                       Tone="AppUiTone.Primary"
                       Disabled="@(_selectedUser is null || string.IsNullOrWhiteSpace(_newLoginProvider) || string.IsNullOrWhiteSpace(_newLoginSubject) || _linkingExternalLogin)"
                       OnClick="@LinkExternalLoginAsync" />
        </AppActionBar>
    </FooterContent>
</AppDialog>

@code {
    private sealed record UserRow(
        Guid Id,
        string DisplayName,
        string Initials,
        string AvatarColor,
        string? AvatarImageUrl,
        string Role,
        string Created,
        bool IsSeed);

    private bool _loading = true;
    private List<UserRow> _allRows = [];
    private bool _createOpen;
    private bool _creating;
    private string _newDisplayName = string.Empty;
    private string _newRole = "RestrictedProfile";
    private const string NewAvatarColor = "#7C4DFF";
    private bool _externalLoginsOpen;
    private bool _externalLoginsLoading;
    private bool _linkingExternalLogin;
    private UserRow? _selectedUser;
    private List<ProfileExternalLoginViewModel> _externalLogins = [];
    private string _newLoginProvider = string.Empty;
    private string _newLoginSubject = string.Empty;
    private string? _newLoginEmail;
    private string? _newLoginDisplayName;
    private bool _viewPolicyOpen;
    private bool _viewPolicyLoading;
    private bool _viewPolicySaving;
    private bool _viewPolicyUnavailable;
    private bool _viewSourcesLoading;
    private bool _viewSourcesUnavailable;
    private bool _viewReconciling;
    private ViewPersonalSpaceAdminReviewDto? _viewSources;
    private UserRow? _selectedViewUser;
    private bool _viewEnabled;
    private bool _accessSharedView;
    private bool _includeInSharedView;
    private bool _allowGallerySharing;

    private int AdministratorCount => _allRows.Count(row =>
        string.Equals(row.Role, "Administrator", StringComparison.OrdinalIgnoreCase));

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    private IReadOnlyList<AppSelectOption> RoleOptions =>
    [
        new("Administrator", L["Users_RoleAdministrator"].Value),
        new("StandardUser", "Standard user"),
        new("RestrictedProfile", "Restricted profile"),
    ];

    protected override async Task OnInitializedAsync() => await RefreshProfilesAsync();

    private static AppUiTone RoleTone(string role) => role switch
    {
        "Administrator" => AppUiTone.Primary,
        "StandardUser" => AppUiTone.Info,
        _ => AppUiTone.Neutral,
    };

    private static string GetInitials(string displayName)
    {
        var parts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][0].ToString().ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }

    private async Task RefreshProfilesAsync()
    {
        _loading = true;
        var profiles = await Orchestrator.GetProfilesAsync();
        _allRows = profiles.Select(profile => new UserRow(
            profile.Id,
            profile.DisplayName,
            GetInitials(profile.DisplayName),
            profile.AvatarColor,
            profile.AvatarImageUrl,
            profile.Role,
            profile.CreatedAt.LocalDateTime.ToString("MMM d, yyyy"),
            profile.IsSeed)).ToList();
        _loading = false;
    }

    private void OpenCreateDialog()
    {
        _newDisplayName = string.Empty;
        _newRole = "RestrictedProfile";
        _createOpen = true;
    }

    private void CloseCreateDialog()
    {
        _createOpen = false;
        _newDisplayName = string.Empty;
    }

    private async Task CreateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDisplayName))
            return;

        _creating = true;
        var displayName = _newDisplayName.Trim();
        var ok = await Orchestrator.CreateProfileAsync(displayName, NewAvatarColor, _newRole);
        _creating = false;

        if (!ok)
        {
            Snackbar.Add(L["Users_CreateError"], Severity.Error);
            return;
        }

        Snackbar.Add($"Profile \"{displayName}\" created", Severity.Success);
        _createOpen = false;
        await RefreshProfilesAsync();
    }

    private async Task DeleteProfileAsync(UserRow row)
    {
        if (row.IsSeed || row.Id == Guid.Empty)
            return;

        var ok = await Orchestrator.DeleteProfileAsync(row.Id);
        Snackbar.Add(
            ok ? $"Profile \"{row.DisplayName}\" deleted" : L["Users_DeleteError"],
            ok ? Severity.Info : Severity.Error);
        if (ok)
            await RefreshProfilesAsync();
    }

    private async Task OpenExternalLoginsDialogAsync(UserRow row)
    {
        _selectedUser = row;
        _externalLoginsOpen = true;
        _externalLoginsLoading = true;
        ResetExternalLoginForm();
        _externalLogins = await Orchestrator.GetProfileExternalLoginsAsync(row.Id);
        _externalLoginsLoading = false;
    }

    private async Task OpenViewPolicyDialogAsync(UserRow row)
    {
        _selectedViewUser = row;
        _viewPolicyOpen = true;
        _viewPolicyLoading = true;
        _viewPolicyUnavailable = false;
        _viewSourcesLoading = true;
        _viewSourcesUnavailable = false;
        _viewSources = null;

        var policyTask = Orchestrator.GetViewProfilePolicyAsync(row.Id);
        var sourcesTask = Orchestrator.GetViewProfileSourcesAsync(row.Id);
        await Task.WhenAll(policyTask, sourcesTask);
        var policy = await policyTask;
        _viewSources = await sourcesTask;
        _viewPolicyLoading = false;
        _viewSourcesLoading = false;
        _viewSourcesUnavailable = _viewSources is null;
        if (policy is null)
        {
            _viewPolicyUnavailable = true;
            return;
        }

        _viewEnabled = policy.ViewEnabled;
        _accessSharedView = policy.AccessSharedView;
        _includeInSharedView = policy.IncludeInSharedView;
        _allowGallerySharing = policy.AllowGallerySharing;
    }

    private void CloseViewPolicyDialog()
    {
        _viewPolicyOpen = false;
        _selectedViewUser = null;
        _viewPolicyUnavailable = false;
        _viewSourcesUnavailable = false;
        _viewSources = null;
    }

    private async Task SaveViewPolicyAsync()
    {
        if (_selectedViewUser is null)
            return;

        _viewPolicySaving = true;
        var saved = await Orchestrator.UpdateViewProfilePolicyAsync(
            _selectedViewUser.Id,
            new UpdateViewProfilePolicyRequest
            {
                ViewEnabled = _viewEnabled,
                AccessSharedView = _accessSharedView,
                IncludeInSharedView = _includeInSharedView,
                AllowGallerySharing = _allowGallerySharing,
            });
        _viewPolicySaving = false;

        if (saved is null)
        {
            Snackbar.Add("Could not save View access.", Severity.Error);
            return;
        }

        Snackbar.Add($"View access saved for {_selectedViewUser.DisplayName}.", Severity.Success);
        CloseViewPolicyDialog();
    }

    private async Task AddPersonalSpaceFolderAsync(bool managed)
    {
        if (_selectedViewUser is null) return;
        var parameters = new DialogParameters<ServerFolderPicker>
        {
            { component => component.SelectionMode, ServerFolderSelectionModes.PersonalSpaceExisting },
            { component => component.HelpText, managed
                ? $"Choose a folder to copy into {_selectedViewUser.DisplayName}'s Personal Space. Originals remain unchanged."
                : $"Choose an existing folder to link read-only to {_selectedViewUser.DisplayName}'s Personal Space." },
        };
        var dialog = await DialogService.ShowAsync<ServerFolderPicker>(string.Empty, parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
        });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: ServerFolderValidationResultDto selected }) return;
        var source = await Orchestrator.CreateViewProfileSourceAsync(
            _selectedViewUser.Id,
            new CreateViewSourceRequest(
                Path.GetFileName(selected.Path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)),
                managed ? "managed" : "linked",
                selected.Path,
                true));
        if (source is null)
        {
            Snackbar.Add(ApiClient.LastError ?? (managed
                ? "The folder could not be imported."
                : "The existing folder could not be linked."), Severity.Error);
            return;
        }

        Snackbar.Add(managed
            ? $"{source.Name} copied into {_selectedViewUser.DisplayName}'s Personal Space. Originals were unchanged."
            : $"{source.Name} linked read-only to {_selectedViewUser.DisplayName}'s Personal Space.", Severity.Success);
        await ReloadViewSourcesAsync();
    }

    private async Task DetachViewSourceAsync(ViewSourceAdminDto source)
    {
        if (_selectedViewUser is null) return;
        if (!await Orchestrator.DeleteViewProfileSourceAsync(_selectedViewUser.Id, source.Id))
        {
            Snackbar.Add(ApiClient.LastError ?? "The source could not be detached.", Severity.Error);
            return;
        }
        Snackbar.Add($"{source.Name} detached. No files were deleted.", Severity.Success);
        await ReloadViewSourcesAsync();
    }

    private async Task ReconcileViewAsync()
    {
        if (_selectedViewUser is null || _viewReconciling) return;
        _viewReconciling = true;
        var result = await Orchestrator.ReconcileViewPersonalSpaceAsync(_selectedViewUser.Id);
        _viewReconciling = false;
        if (result is null)
        {
            Snackbar.Add(ApiClient.LastError ?? "The Personal Space could not be reconciled.", Severity.Error);
            return;
        }
        Snackbar.Add($"Reconciliation complete: {result.ItemsAdded} items added, {result.DuplicatesFound} duplicates, {result.Errors} errors.",
            result.Errors > 0 ? Severity.Warning : Severity.Success);
        await ReloadViewSourcesAsync();
    }

    private async Task ReloadViewSourcesAsync()
    {
        if (_selectedViewUser is null) return;
        _viewSourcesLoading = true;
        _viewSources = await Orchestrator.GetViewProfileSourcesAsync(_selectedViewUser.Id);
        _viewSourcesLoading = false;
        _viewSourcesUnavailable = _viewSources is null;
    }

    private void CloseExternalLoginsDialog()
    {
        _externalLoginsOpen = false;
        _selectedUser = null;
        _externalLogins = [];
        ResetExternalLoginForm();
    }

    private async Task LinkExternalLoginAsync()
    {
        if (_selectedUser is null
            || string.IsNullOrWhiteSpace(_newLoginProvider)
            || string.IsNullOrWhiteSpace(_newLoginSubject))
            return;

        _linkingExternalLogin = true;
        var login = await Orchestrator.LinkProfileExternalLoginAsync(
            _selectedUser.Id,
            _newLoginProvider,
            _newLoginSubject,
            _newLoginEmail,
            _newLoginDisplayName);
        _linkingExternalLogin = false;

        if (login is null)
        {
            Snackbar.Add("Could not link sign-in account.", Severity.Error);
            return;
        }

        Snackbar.Add("Sign-in account linked.", Severity.Success);
        ResetExternalLoginForm();
        _externalLogins = await Orchestrator.GetProfileExternalLoginsAsync(_selectedUser.Id);
    }

    private async Task UnlinkExternalLoginAsync(Guid loginId)
    {
        if (_selectedUser is null)
            return;

        var ok = await Orchestrator.UnlinkProfileExternalLoginAsync(loginId);
        if (!ok)
        {
            Snackbar.Add("Could not unlink sign-in account.", Severity.Error);
            return;
        }

        Snackbar.Add("Sign-in account unlinked.", Severity.Info);
        _externalLogins = await Orchestrator.GetProfileExternalLoginsAsync(_selectedUser.Id);
    }

    private void ResetExternalLoginForm()
    {
        _newLoginProvider = string.Empty;
        _newLoginSubject = string.Empty;
        _newLoginEmail = null;
        _newLoginDisplayName = null;
    }

    private static string SourceTypeLabel(string sourceType) => sourceType switch
    {
        "folder" => "Folder",
        "browser_upload" => "Browser upload",
        "device_import" => "Device import",
        "mobile_backup" => "Mobile backup",
        "network" => "Network source",
        _ => "Other source",
    };

    private static string BackupStateLabel(string state) => state switch
    {
        "idle" => "Idle",
        "backing_up" => "Backing up",
        "complete" => "Complete",
        "error" => "Needs attention",
        _ => "Status unknown",
    };

    private static AppUiTone BackupStateTone(string state) => state switch
    {
        "complete" => AppUiTone.Success,
        "error" => AppUiTone.Error,
        "backing_up" => AppUiTone.Info,
        _ => AppUiTone.Neutral,
    };

    private static string DeviceDetails(ViewDeviceAdminDto device)
    {
        var parts = new[] { device.Make, device.Model }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var label = string.Join(' ', parts);
        return string.IsNullOrWhiteSpace(label) ? "Connected device" : label;
    }

    private static string FormatWhen(DateTimeOffset? value) =>
        value.HasValue ? value.Value.LocalDateTime.ToString("MMM d, yyyy · h:mm tt") : "Not recorded";
}
