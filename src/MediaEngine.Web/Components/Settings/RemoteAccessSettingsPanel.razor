@namespace MediaEngine.Web.Components.Settings
@using MediaEngine.Contracts.Settings
@using MediaEngine.Web.Services.Integration
@inject IEngineApiClient ApiClient

<div class="network-panel">
    <header class="network-panel__heading">
        <div><h3>Remote Access</h3><p>Allow secure access to Tuvima from outside your home.</p></div>
    </header>
    <AppSwitchRow Label="Enable Remote Access"
                  Description="Allow Tuvima to be accessed securely outside your home."
                  Value="@Settings.Remote.Enabled" ValueChanged="ChangeEnabledAsync" />

    <SettingsSectionPanel Title="Connection Mode" Icon="@Icons.Material.Outlined.Public"
                          Description="Choose how Tuvima connects to the internet.">
        <div class="network-mode-list" role="radiogroup" aria-label="Remote connection mode">
            @Mode("automatic", "Automatic — Recommended", "Try direct router configuration first and use an installed secure provider when needed.", false)
            @Mode("direct-only", "Direct Only", "Use a router mapping or a manually forwarded port. Remote access is unavailable when direct connectivity fails.", false)
            @Mode("secure-provider", "Secure Connectivity Provider", "Use an installed secure tunnel or relay provider.", true)
            @Mode("custom", "Custom", "Use your own HTTPS hostname or reverse proxy.", false)
        </div>
    </SettingsSectionPanel>

    @if (Settings.Remote.ConnectionMode == "custom")
    {
        <SettingsSectionPanel Title="Custom HTTPS Address" Icon="@Icons.Material.Outlined.Language">
            <AppTextField T="string" @bind-Value="Settings.Remote.PublicHostname"
                          Label="Public HTTPS address" Placeholder="https://tuvima.example.com" />
            <div class="network-card-actions"><AppButton Label="Save address" OnClick="SaveRequested" /></div>
        </SettingsSectionPanel>
    }

    <SettingsSectionPanel Title="Automatic Router Configuration" Icon="@Icons.Material.Outlined.Router">
        <dl class="network-facts">
            @Fact("Status", Display(Status?.MappingStatus))
            @Fact("Method", Status?.RouterMethod ?? "Not detected")
            @Fact("Internal address", Status?.PreferredLocalAddress ?? "Unavailable")
            @Fact("External port", (Settings.Remote.ExternalPort ?? Settings.Local.Port).ToString())
            @Fact("Last checked", Status?.MappingCheckedAt?.ToLocalTime().ToString("g") ?? "Not checked")
            @Fact("Lease renewal", Status?.MappingExpiresAt?.ToLocalTime().ToString("g") ?? "Not reported")
        </dl>
        <AppSwitchRow Label="Manage the router mapping automatically"
                      Description="Tuvima tries PCP, NAT-PMP, then UPnP and renews only the mapping it owns."
                      Value="@Settings.Remote.AutomaticRouterConfiguration"
                      ValueChanged="ChangeRouterAutomationAsync" />
        <div class="network-card-actions">
            @if (Settings.Remote.Enabled && Status?.MappingStatus != "active")
            {
                <AppButton Label="Set Up Manually" StartIcon="@Icons.Material.Outlined.Tune" OnClick="OpenManual" />
            }
            @if (Settings.Remote.Enabled && Settings.Remote.AutomaticRouterConfiguration)
            {
                <AppButton Label="Renew Now" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="RenewAsync" />
            }
            <AppButton Label="Test Remote Access" StartIcon="@Icons.Material.Outlined.Science" OnClick="TestRemoteAsync" />
            <AppButton Label="Refresh Status" OnClick="StatusRefreshRequested" />
        </div>
    </SettingsSectionPanel>

    <SettingsSectionPanel Title="Remote Access Address" Icon="@Icons.Material.Outlined.Link">
        <dl class="network-facts network-facts--compact">
            @Fact("Address", Status?.ExternalAddress ?? Settings.Remote.PublicHostname ?? "Not available")
            @Fact("Public IP", Status?.PublicIp ?? "Not observed")
        </dl>
        @if (Status?.CgnatSuspected == true)
        {
            <AppAlert Tone="AppUiTone.Warning">Carrier-grade NAT may prevent a direct connection. A secure connectivity provider or your own reverse proxy may be required.</AppAlert>
        }
    </SettingsSectionPanel>
</div>

<NetworkTestDialog @bind-Visible="_testDialogOpen" Busy="@_testing" Result="@_testResult" />
<ManualPortForwardingDialog @bind-Visible="_manualDialogOpen"
                            InternalPort="@Settings.Local.Port"
                            ExternalPort="@(Settings.Remote.ExternalPort ?? Settings.Local.Port)"
                            InternalAddress="@InternalAddress"
                            CgnatSuspected="@(Status?.CgnatSuspected == true)"
                            TestAgain="TestRemoteAsync" />

@code {
    [Parameter, EditorRequired] public NetworkSettingsDto Settings { get; set; } = new();
    [Parameter] public NetworkRuntimeStatusDto? Status { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback StatusRefreshRequested { get; set; }

    private bool _testDialogOpen;
    private bool _testing;
    private bool _manualDialogOpen;
    private NetworkTestResultDto? _testResult;
    private string InternalAddress => Status?.LocalAddresses.FirstOrDefault(address => address.AddressFamily == "ipv4")?.Address
        ?? Status?.LocalAddresses.FirstOrDefault()?.Address
        ?? "Unavailable";

    private RenderFragment Mode(string value, string title, string description, bool unavailable) => @<label class="network-mode-option @(unavailable ? "is-disabled" : null)">
        <AppNativeInput Type="radio" Name="network-mode" Value="@value"
                        Checked="@(Settings.Remote.ConnectionMode == value)"
                        Disabled="@unavailable" OnChange="@(_ => ChangeModeAsync(value))" />
        <span><strong>@title</strong><small>@description</small>@if (unavailable) { <em>No provider installed</em> }</span>
    </label>;

    private async Task ChangeEnabledAsync(bool value)
    {
        Settings.Remote.Enabled = value;
        await SaveRequested.InvokeAsync();
    }

    private async Task ChangeModeAsync(string value)
    {
        Settings.Remote.ConnectionMode = value;
        await SaveRequested.InvokeAsync();
    }

    private async Task ChangeRouterAutomationAsync(bool value)
    {
        Settings.Remote.AutomaticRouterConfiguration = value;
        await SaveRequested.InvokeAsync();
    }

    private async Task TestRemoteAsync()
    {
        _testDialogOpen = true;
        _testing = true;
        _testResult = await ApiClient.TestRemoteNetworkAsync();
        _testing = false;
        await StatusRefreshRequested.InvokeAsync();
    }

    private void OpenManual() => _manualDialogOpen = true;

    private async Task RenewAsync()
    {
        await ApiClient.RenewNetworkRouterMappingAsync();
        await StatusRefreshRequested.InvokeAsync();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value)
        ? "Unavailable"
        : string.Join(' ', value.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]) + part[1..]));

    private static RenderFragment Fact(string label, string value) => @<div><dt>@label</dt><dd>@value</dd></div>;
}
