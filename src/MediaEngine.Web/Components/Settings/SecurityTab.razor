@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator

<div class="tl-page security-settings">
    <AppCard Title="Authentication">
        @if (_authLoading)
        {
            <AppSkeleton Height="180px" />
        }
        else if (_authSettings is null)
        {
            <AppErrorState Title="Authentication configuration is unavailable"
                           Message="The Engine did not return the current sign-in configuration." />
        }
        else
        {
            <dl class="security-settings__facts">
                <div><dt>Authentication mode</dt><dd>@_authSettings.Mode</dd></div>
                <div><dt>OIDC status</dt><dd>@(_authSettings.OidcEnabled ? "Enabled" : "Disabled")</dd></div>
                <div><dt>Provider</dt><dd>@ValueOrNotConfigured(_authSettings.OidcDisplayName)</dd></div>
                <div><dt>Authority</dt><dd>@ValueOrNotConfigured(_authSettings.OidcAuthority)</dd></div>
                <div><dt>Client ID</dt><dd>@ValueOrNotConfigured(_authSettings.OidcClientId)</dd></div>
                <div><dt>Require HTTPS</dt><dd>@YesNo(_authSettings.RequireHttpsRemote)</dd></div>
                <div><dt>Localhost bypass</dt><dd>@YesNo(_authSettings.LocalhostBypass)</dd></div>
            </dl>
            <AppAlert Tone="AppUiTone.Info" Class="mt-4">
                Authentication is configured by the Engine. Linked external identities are managed from Profiles &amp; Roles.
            </AppAlert>
        }
    </AppCard>
</div>

@code {
    private bool _authLoading = true;
    private AuthSettingsDto? _authSettings;

    protected override async Task OnInitializedAsync()
    {
        _authSettings = await Orchestrator.GetAuthSettingsAsync();
        _authLoading = false;
    }

    private static string ValueOrNotConfigured(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not configured" : value;

    private static string YesNo(bool value) => value ? "Yes" : "No";
}
