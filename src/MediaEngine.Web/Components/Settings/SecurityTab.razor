@namespace MediaEngine.Web.Components.Settings
@inject UIOrchestratorService Orchestrator

<div class="tl-page security-settings">
    <SettingsSectionPanel Title="@PanelTitle"
                          Description="@PanelDescription"
                          Icon="@PanelIcon">
        @if (_authLoading)
        {
            <AppSkeleton Size="AppControlSize.Large" Class="security-settings__skeleton" />
        }
        else if (_authSettings is null)
        {
            <AppErrorState Title="Authentication configuration is unavailable"
                           Message="The Engine did not return the current sign-in configuration." />
        }
        else
        {
            @if (IsSessionPolicy)
            {
                <dl class="security-settings__facts">
                    <div><dt>Remote connections</dt><dd>@(_authSettings.RequireHttpsRemote ? "HTTPS required" : "HTTPS not required")</dd></div>
                    <div><dt>Local access</dt><dd>@(_authSettings.LocalhostBypass ? "Localhost bypass allowed" : "Authentication required")</dd></div>
                    <div><dt>Sign-in policy</dt><dd>@FriendlyMode(_authSettings.Mode)</dd></div>
                </dl>
                <AppAlert Tone="AppUiTone.Info" Class="mt-4">
                    Session duration is not separately configurable. The Engine owns active session lifecycle and player takeover rules.
                </AppAlert>
            }
            else
            {
                <dl class="security-settings__facts">
                    <div><dt>Authentication mode</dt><dd>@FriendlyMode(_authSettings.Mode)</dd></div>
                    <div><dt>External sign-in</dt><dd>@(_authSettings.ExternalProviders.Any(provider => provider.Enabled) ? "Enabled" : "Disabled")</dd></div>
                    <div><dt>Email password reset</dt><dd>@(_authSettings.PasswordReset.Configured ? "SMTP configured" : "Recovery codes and host reset")</dd></div>
                </dl>
                @if (_authSettings.PasswordReset.Configured)
                {
                    <dl class="security-settings__facts">
                        <div><dt>Public URL</dt><dd>@_authSettings.PasswordReset.PublicBaseUrl</dd></div>
                        <div><dt>SMTP server</dt><dd>@_authSettings.PasswordReset.SmtpHost:@_authSettings.PasswordReset.SmtpPort</dd></div>
                        <div><dt>From</dt><dd>@_authSettings.PasswordReset.FromAddress</dd></div>
                    </dl>
                }
                @foreach (var provider in _authSettings.ExternalProviders)
                {
                    <h3 class="mt-5">@provider.DisplayName</h3>
                    <dl class="security-settings__facts">
                        <div><dt>Status</dt><dd>@(provider.Enabled ? "Enabled" : "Disabled")</dd></div>
                        <div><dt>Protocol</dt><dd>@FriendlyProviderKind(provider.Kind)</dd></div>
                        <div><dt>Issuer</dt><dd>@ValueOrNotConfigured(provider.Issuer)</dd></div>
                        @if (!string.IsNullOrWhiteSpace(provider.Authority))
                        {
                            <div><dt>Authority</dt><dd>@provider.Authority</dd></div>
                        }
                        <div><dt>Client ID</dt><dd>@ValueOrNotConfigured(provider.ClientId)</dd></div>
                        <div><dt>Callback path</dt><dd><code>@provider.CallbackPath</code></dd></div>
                    </dl>
                }
                <AppAlert Tone="AppUiTone.Info" Class="mt-4">
                    Authentication is configured by the Engine. Provider secrets stay in the server's private authentication secret file and are never returned here.
                </AppAlert>
            }
        }
    </SettingsSectionPanel>
</div>

@code {
    [Parameter] public string Section { get; set; } = "authentication";

    private bool _authLoading = true;
    private AuthSettingsDto? _authSettings;
    private bool IsSessionPolicy => string.Equals(Section, "session-policy", StringComparison.OrdinalIgnoreCase);
    private string PanelTitle => IsSessionPolicy ? "Session policy" : "Authentication";
    private string PanelDescription => IsSessionPolicy
        ? "Review the connection rules currently enforced by the Engine."
        : "Review how people sign in to this Tuvima Library.";
    private string PanelIcon => IsSessionPolicy
        ? Icons.Material.Outlined.Policy
        : Icons.Material.Outlined.AdminPanelSettings;

    protected override async Task OnInitializedAsync()
    {
        _authSettings = await Orchestrator.GetAuthSettingsAsync();
        _authLoading = false;
    }

    private static string ValueOrNotConfigured(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not configured" : value;

    private static string FriendlyMode(string value) => value switch
    {
        "DisabledLocalOnly" => "Local access only",
        "Optional" => "Optional sign-in",
        "Required" => "Sign-in required",
        _ => value,
    };

    private static string FriendlyProviderKind(string value) => value switch
    {
        "oidc" => "OpenID Connect",
        "oauth" => "OAuth 2.0",
        _ => value,
    };
}
