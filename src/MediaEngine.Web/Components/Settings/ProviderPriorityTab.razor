@namespace MediaEngine.Web.Components.Settings
@inject IEngineApiClient ApiClient
@inject ProviderCatalogueService CatalogueService
@inject ILogger<ProviderPriorityTab> Logger
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MetadataAdminShell ActiveSubsection="@Subsection">
    @if (IsPrioritySurface)
    {
        <ProviderPrioritySurface />
    }
    else if (IsEnrichmentSurface)
    {
        <ProviderEnrichmentSurface />
    }
    else
    {
        <div class="provider-page">
            <div class="metadata-summary-grid metadata-summary-grid--four" aria-label="Provider summary">
                <MetadataMetricTile Value="@_providers.Count.ToString()" Label="Providers" Icon="@Icons.Material.Outlined.PeopleOutline" />
                <MetadataMetricTile Value="@EnabledCount.ToString()" Label="Enabled" Icon="@Icons.Material.Outlined.ToggleOn" Tone="AppUiTone.Neutral" />
                <MetadataMetricTile Value="@HealthyCount.ToString()" Label="Healthy" Icon="@Icons.Material.Outlined.FavoriteBorder" Tone="AppUiTone.Success" />
                <MetadataMetricTile Value="@IssueCount.ToString()" Label="@(IssueCount == 1 ? "Issue" : "Issues")" Icon="@Icons.Material.Outlined.WarningAmber" Tone="AppUiTone.Warning" />
            </div>

        @if (_loading)
        {
            <AppPageState Kind="AppPageStateKind.Loading" Title="Loading metadata providers" Class="py-8" />
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <AppAlert Tone="AppUiTone.Warning" Class="mb-4">@_loadError</AppAlert>
            }

            <section class="provider-toolbar" aria-label="Filter metadata providers">
                <div class="provider-filter-row" role="group" aria-label="Filter providers by capability">
                    @foreach (var capability in CapabilityFilters)
                    {
                        <AppChip Text="@CapabilityFilterLabel(capability)"
                                 Tone="@(string.Equals(_capabilityFilter, capability, StringComparison.OrdinalIgnoreCase) ? AppUiTone.Primary : AppUiTone.Neutral)"
                                 OnClick="@(() => _capabilityFilter = capability)" Class="provider-filter-chip" />
                    }
                </div>
                <AppSearchField @bind-Value="_search" Placeholder="Search providers..." Size="AppControlSize.Compact" />
            </section>

            <section class="provider-table" aria-label="Metadata providers">
                <div class="provider-table__header" aria-hidden="true">
                    <span>Provider</span><span>Capabilities</span><span>Supported media</span><span>Status</span><span>Last tested</span><span>Actions</span>
                </div>
                <div class="provider-list">
                    @if (FilteredProviders.Count == 0)
                    {
                        <AppEmptyState Title="No matching providers" Message="Try another search or capability filter." />
                    }
                    else
                    {
                        @foreach (var provider in FilteredProviders)
                        {
                            <article class="provider-row @(IsSelected(provider) ? "is-selected" : null)" @key="provider.Key">
                                <div class="provider-row__identity" data-label="Provider">
                                    <AppProviderLogo ImageUrl="@provider.LogoUrl" Icon="@provider.Icon"
                                                     AccentColor="@provider.AccentColor" FallbackText="@Initials(provider.DisplayName)" AltText="" />
                                    <div class="provider-row__copy">
                                        <h3>@provider.DisplayName</h3>
                                        <div class="provider-row__description">@provider.Description</div>
                                        @if (!string.IsNullOrWhiteSpace(provider.SystemRole))
                                        {
                                            <AppStatusBadge Text="@SystemRoleLabel(provider.SystemRole)" Tone="AppUiTone.Info" />
                                        }
                                    </div>
                                </div>

                                <div class="provider-row__capabilities" data-label="Capabilities">
                                    @foreach (var capability in provider.Capabilities.Take(4))
                                    {
                                        <AppChip Text="@ProviderCapabilityPresentation.Label(capability)" Tone="@CapabilityTone(capability)" Size="AppControlSize.Compact" />
                                    }
                                    @if (provider.Capabilities.Count > 4)
                                    {
                                        <AppChip Text="@($"+{provider.Capabilities.Count - 4}")" Tone="AppUiTone.Neutral" Size="AppControlSize.Compact" />
                                    }
                                </div>

                                <div class="provider-row__media" data-label="Supported media">
                                    @if (provider.MediaTypes.Count == 0)
                                    {
                                        <span class="provider-row__all-media">All</span>
                                    }
                                    else
                                    {
                                        @foreach (var mediaType in provider.MediaTypes)
                                        {
                                            <MetadataMediaIconChip Label="@DisplayMediaType(mediaType)" Icon="@MediaTypeIcon(mediaType)" />
                                        }
                                    }
                                </div>

                                <div class="provider-row__status" data-label="Status" aria-live="polite">
                                    <AppStatusBadge Text="@HealthLabel(provider)" Tone="@HealthTone(provider)" Icon="@HealthIcon(provider)" />
                                    @if (provider.LastResponseTimeMs.HasValue) { <span>@provider.LastResponseTimeMs ms</span> }
                                    @if (ShouldShowFailure(provider)) { <span class="provider-row__failure">@provider.FailureReason</span> }
                                </div>

                                <div class="provider-row__last-tested" data-label="Last tested">@LastCheckedValue(provider)</div>

                                <div class="provider-row__actions" data-label="Actions">
                                    <AppButton Label="@(provider.Testing ? "Testing..." : "Test")"
                                               aria-label="@($"Test {provider.DisplayName} connection")"
                                               StartIcon="@Icons.Material.Outlined.NetworkCheck" Size="AppControlSize.Compact"
                                               Disabled="@(provider.Testing || !provider.Enabled)" OnClick="@(() => TestProviderAsync(provider))" />
                                    <AppOverflowMenu AriaLabel="@($"More actions for {provider.DisplayName}")" Size="AppControlSize.Compact">
                                        <AppMenuItem Label="Edit settings" Icon="@Icons.Material.Outlined.Settings" OnClick="@(() => OpenEditor(provider))" />
                                        <AppMenuItem Label="@(provider.Enabled ? "Disable" : "Enable")"
                                                     Icon="@(provider.Enabled ? Icons.Material.Outlined.PauseCircleOutline : Icons.Material.Outlined.PlayCircleOutline)"
                                                     Disabled="@provider.RequiredSystemProvider"
                                                     OnClick="@(() => ToggleProviderAsync(provider, !provider.Enabled))" />
                                        <AppMenuItem Label="Manage source priority" Icon="@Icons.Material.Outlined.LowPriority" OnClick="OpenPriority" />
                                    </AppOverflowMenu>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(provider.TestMessage))
                                {
                                    <div class="provider-row__test-result @(provider.LastTestSucceeded == true ? "is-success" : "is-error")" role="status">@provider.TestMessage</div>
                                }
                            </article>
                        }
                    }
                </div>
            </section>

            <div class="provider-page__note"><MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />Provider health uses recorded Engine checks. Response time appears only after a live connection test.</div>
        }
        </div>
    }
</MetadataAdminShell>

@if (!IsPrioritySurface && !IsEnrichmentSurface)
{
    <ProviderEditDrawer @ref="_editDrawer" Open="@(_selectedProvider is not null)" Provider="@_selectedProvider"
                        Closed="CloseEditor" SaveRequested="SaveProviderAsync" TestRequested="TestSelectedProviderAsync" />
}
