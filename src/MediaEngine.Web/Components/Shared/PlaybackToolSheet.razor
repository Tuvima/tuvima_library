@namespace MediaEngine.Web.Components.Shared
@using System.Linq

<section class="@RootClass" role="dialog" aria-label="@Title" aria-modal="@(Modal ? "true" : null)" @attributes="AdditionalAttributes">
    <PlaybackSheetHandleButton Class="playback-tool-sheet__handle" Label="@CloseLabel" OnClick="@OnClose" />
    <div class="playback-tool-sheet__header">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <MudIcon Icon="@Icon" Class="playback-tool-sheet__header-icon" />
        }
        <div class="playback-tool-sheet__heading">
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </div>
        <AppNativeButton Type="button"
                         Class="playback-tool-sheet__close"
                         OnClick="@OnClose"
                         AriaLabel="@CloseAriaLabel"
                         title="@CloseAriaLabel">
            <MudIcon Icon="@Icons.Material.Outlined.Close" />
        </AppNativeButton>
    </div>
    <div class="playback-tool-sheet__content">
        @ChildContent
    </div>
</section>

@code {
    [Parameter]
    public string Title { get; set; } = "Playback tools";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string Surface { get; set; } = "panel";

    [Parameter]
    public string Presentation { get; set; } = "inline";

    [Parameter]
    public bool Modal { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CloseLabel => Surface == "popup" || Presentation == "full-overlay"
        ? "Collapse sheet"
        : "Close sheet";
    private string CloseAriaLabel => $"Close {Title}";

    private string NormalizedSurface => Surface switch
    {
        "popup" => "popup",
        "fullscreen" => "fullscreen",
        _ => "panel",
    };

    private string NormalizedPresentation => Presentation switch
    {
        "full-overlay" => "full-overlay",
        "rollup" => "full-overlay",
        _ => "inline",
    };

    private string RootClass => string.Join(" ", new[]
    {
        "playback-tool-sheet",
        $"playback-tool-sheet--{NormalizedSurface}",
        $"playback-tool-sheet--{NormalizedPresentation}",
        Class,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
