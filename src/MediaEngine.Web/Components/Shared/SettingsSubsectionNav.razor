@namespace MediaEngine.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Routing
@using MediaEngine.Web.Models.ViewDTOs

@if (Items.Count > 1 || ShowWhenSingle)
{
    <nav class="@RootClass" aria-label="@AriaLabel">
        <ul class="settings-subsection-nav__list" role="tablist">
            @foreach (var item in Items)
            {
                var active = IsActive(item);
                <li class="settings-subsection-nav__entry" role="presentation">
                    <NavLink href="@SettingsNav.RouteFor(Section, item.Slug)"
                             Match="NavLinkMatch.All"
                             class="@(active ? "settings-subsection-nav__item is-active" : "settings-subsection-nav__item")"
                             role="tab"
                             aria-selected="@(active ? "true" : "false")"
                             aria-current="@(active ? "page" : null)">
                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                        {
                            <MudIcon Icon="@item.Icon" Size="Size.Small" aria-hidden="true" />
                        }
                        <span>@item.Label</span>
                    </NavLink>
                </li>
            }
        </ul>
    </nav>
}

@code {
    [Parameter, EditorRequired] public SettingsSection Section { get; set; }
    [Parameter] public string? ActiveSubsection { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Settings subsections";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool ShowWhenSingle { get; set; }

    private IReadOnlyList<SettingsSubsectionDef> Items => SettingsNav.GetSubsections(Section);

    private string RootClass =>
        string.Join(" ", new[] { "settings-subsection-nav", Class }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private bool IsActive(SettingsSubsectionDef item) =>
        string.Equals(item.Slug, ActiveSubsection, StringComparison.OrdinalIgnoreCase);
}
