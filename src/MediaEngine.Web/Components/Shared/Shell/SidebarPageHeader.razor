@namespace MediaEngine.Web.Components.Shared.Shell

<AppPageHeader Eyebrow="@Eyebrow" Title="@Title" Subtitle="@Subtitle" Status="@Status"
               Healthy="@Healthy" Metadata="@Metadata" Actions="@Actions" Class="sidebar-page-header" />

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public bool Healthy { get; set; }
    [Parameter] public RenderFragment? Metadata { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
