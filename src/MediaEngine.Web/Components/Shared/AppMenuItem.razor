@namespace MediaEngine.Web.Components.Shared

@if (DividerBefore)
{
    <MudDivider Class="app-menu-divider" />
}
<button type="button"
        role="menuitem"
        class="@RootClass"
        disabled="@Disabled"
        @onpointerdown:stopPropagation="true"
        @onclick="HandleClick">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <MudIcon Icon="@Icon" />
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Label
    }
</button>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool DividerBefore { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AppUiTone Tone { get; set; } = AppUiTone.Neutral;
    [Parameter] public string? Class { get; set; }

    private string RootClass => string.Join(" ", new[] { "app-menu-item", AppUiMaps.ToneClass(Tone), Class }
        .Where(value => !string.IsNullOrWhiteSpace(value)));

    private Task HandleClick(MouseEventArgs _) => OnClick.InvokeAsync();
}
