@using System.Globalization
@using MediaEngine.Contracts.LocalAssets
@namespace MediaEngine.Web.Components.View

@if (Minimum is not null && Maximum is not null)
{
    <section class="places-timeline" aria-label="Places date range">
        <div class="places-timeline__summary">
            <span><MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary" /><strong>@MappedAssetCount.ToString("N0")</strong> items on map</span>
            <span>@ImageCount.ToString("N0") photos</span><span>@VideoCount.ToString("N0") videos</span>
        </div>
        <div class="places-timeline__plot">
            <div class="places-timeline__histogram" aria-label="Media by date">
                @foreach (var bucket in Buckets)
                {
                    var detail = $"{bucket.Start:MMM d, yyyy}–{BucketEnd(bucket).AddTicks(-1):MMM d, yyyy} · {bucket.AssetCount:N0} items · {bucket.ImageCount:N0} photos · {bucket.VideoCount:N0} videos";
                    <AppNativeButton Type="button" InlineStyle="@BarStyle(bucket)" AriaLabel="@detail" OnClick="@(_ => _detail = detail)" @onmouseenter="@(() => _detail = detail)" @onfocus="@(() => _detail = detail)"><span></span></AppNativeButton>
                }
            </div>
            <div class="places-timeline__detail" role="status">@_detail</div>
            <div class="@($"places-timeline__range{(ToIndex - FromIndex < Scale.Days * .35 ? " is-crowded" : "")}")" @attributes="@CssAttributes(RangeStyle)">
                <div class="places-timeline__range-track" aria-hidden="true"><span></span></div>
                <AppNativeInput Type="range" Min="0" Max="@Scale.Days" Value="@FromIndex" OnInput="DraftFrom" OnChange="FromChangedAsync" AriaLabel="Start date" aria-valuetext="@DisplayDate(Scale.DateAt(FromIndex))" />
                <AppNativeInput Type="range" Min="0" Max="@Scale.Days" Value="@ToIndex" OnInput="DraftTo" OnChange="ToChangedAsync" AriaLabel="End date" aria-valuetext="@DisplayDate(Scale.DateAt(ToIndex))" />
                <output class="places-timeline__callout is-start" @attributes="@CssAttributes(CalloutStyle(FromIndex))">@DisplayDate(Scale.DateAt(FromIndex))</output>
                <output class="places-timeline__callout is-end" @attributes="@CssAttributes(CalloutStyle(ToIndex))">@DisplayDate(Scale.DateAt(ToIndex))</output>
            </div>
            <div class="places-timeline__axis">
                <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" />
                @foreach (var tick in Scale.Ticks())
                {
                    <span @attributes="@CssAttributes(PositionStyle(tick))">@Scale.DateAt(tick).ToString(Scale.Days > 730 ? "yyyy" : Scale.Days > 60 ? "MMM yy" : "MMM d")</span>
                }
            </div>
        </div>
        <div class="places-timeline__actions">
            <div class="places-timeline__controls" role="group" aria-label="Timeline resolution">
                @foreach (var option in new[] { "year", "month", "day" })
                {
                    <AppNativeButton Type="button" Class="@(Resolution == option ? "is-active" : null)" aria-pressed="@(Resolution == option)" OnClick="@(_ => OnResolutionChanged.InvokeAsync(option))">@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(option)</AppNativeButton>
                }
            </div>
            <AppNativeButton Type="button" Class="places-timeline__reset" OnClick="@(_ => OnReset.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.RestartAlt" />Reset</AppNativeButton>
        </div>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<ViewAtlasTimelineBucketDto> Buckets { get; set; } = [];
    [Parameter] public DateTimeOffset? EarliestAt { get; set; }
    [Parameter] public DateTimeOffset? LatestAt { get; set; }
    [Parameter] public int? SelectedYear { get; set; }
    [Parameter] public DateTimeOffset? SelectedFrom { get; set; }
    [Parameter] public DateTimeOffset? SelectedTo { get; set; }
    [Parameter] public string Resolution { get; set; } = "year";
    [Parameter] public int MappedAssetCount { get; set; }
    [Parameter] public int ImageCount { get; set; }
    [Parameter] public int VideoCount { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> OnFromChanged { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> OnToChanged { get; set; }
    [Parameter] public EventCallback<string> OnResolutionChanged { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    private string? _detail;
    private static IReadOnlyDictionary<string, object> CssAttributes(string css) => new Dictionary<string, object> { ["style"] = css };
    private int? _draftFrom, _draftTo;
    private DateTimeOffset? Minimum => EarliestAt ?? Buckets.FirstOrDefault()?.Start;
    private DateTimeOffset? Maximum => LatestAt ?? Buckets.LastOrDefault()?.Start;
    private PlacesTimeScale Scale => new(Minimum!.Value, Maximum!.Value);
    private int FromIndex => _draftFrom ?? Scale.Index(SelectedFrom ?? Minimum!.Value);
    private int ToIndex => _draftTo ?? Scale.Index(SelectedTo ?? Maximum!.Value);
    private string RangeStyle => FormattableString.Invariant($"--range-from:{Scale.Percent(FromIndex)}%;--range-to:{Scale.Percent(ToIndex)}%");
    private string PositionStyle(int index) => FormattableString.Invariant($"left:{Scale.Percent(index)}%");
    private string CalloutStyle(int index) => PositionStyle(index) + (Scale.Percent(index) > 50 ? ";--label-shift:-100%;--pointer:100%" : ";--label-shift:0%;--pointer:0%");
    private string BarStyle(ViewAtlasTimelineBucketDto bucket)
    {
        var end = BucketEnd(bucket);
        var startPercent = Scale.Percent(Scale.Index(bucket.Start));
        var endPercent = Scale.Percent(Scale.Index(end));
        var height = bucket.AssetCount * 100d / Math.Max(1, Buckets.Max(b => b.AssetCount));
        return FormattableString.Invariant($"left:{startPercent}%;width:{Math.Max(.15, endPercent - startPercent)}%;--bar-height:{height}%");
    }
    private static string DisplayDate(DateTimeOffset date) => date.ToString("MMM d, yyyy", CultureInfo.CurrentCulture);
    private DateTimeOffset BucketEnd(ViewAtlasTimelineBucketDto bucket) => bucket.End ?? (Resolution switch { "day" => bucket.Start.AddDays(1), "month" => bucket.Start.AddMonths(1), _ => bucket.Start.AddYears(1) });
    private void DraftFrom(ChangeEventArgs args) => _draftFrom = Math.Clamp(Parse(args, 0), 0, ToIndex);
    private void DraftTo(ChangeEventArgs args) => _draftTo = Math.Clamp(Parse(args, Scale.Days), FromIndex, Scale.Days);
    private static int Parse(ChangeEventArgs args, int fallback) => int.TryParse(args.Value?.ToString(), out var value) ? value : fallback;
    private async Task FromChangedAsync(ChangeEventArgs args) { DraftFrom(args); var date = Scale.DateAt(FromIndex); await OnFromChanged.InvokeAsync(date); _draftFrom = null; }
    private async Task ToChangedAsync(ChangeEventArgs args) { DraftTo(args); var date = Scale.DateAt(ToIndex).AddDays(1).AddTicks(-1); await OnToChanged.InvokeAsync(date); _draftTo = null; }
}
