@using System.Globalization
@using MediaEngine.Contracts.LocalAssets
@namespace MediaEngine.Web.Components.View

@if (Minimum is { } minimum && Maximum is { } maximum)
{
    <section class="@RootClass" aria-label="Places date range">
        <div class="places-timeline__summary">
            <span><MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary" /><strong>@MappedAssetCount.ToString("N0")</strong> mapped @(MappedAssetCount == 1 ? "memory" : "memories")</span>
            <span><i></i>@ImageCount.ToString("N0") photos</span>
            <span><i class="is-video"></i>@VideoCount.ToString("N0") videos</span>
        </div>
        <div class="places-timeline__plot">
            <div class="places-timeline__histogram" aria-hidden="true">
                @if (IsSingleYear)
                {
                    <span class="@BucketClass(MappedAssetCount)"></span>
                }
                else
                {
                    @foreach (var bucket in Buckets)
                    {
                        <span class="@BucketClass(bucket.AssetCount)"></span>
                    }
                }
            </div>
            @if (IsSingleYear)
            {
                <div class="places-timeline__single-period"><i></i><strong>@SingleYearLabel</strong></div>
            }
            else
            {
                <div class="places-timeline__range">
                    <AppNativeInput Type="range" Min="0" Max="@MaximumIndex" Value="@FromIndex" AriaLabel="Start date" OnChange="FromChangedAsync" />
                    <AppNativeInput Type="range" Min="0" Max="@MaximumIndex" Value="@ToIndex" AriaLabel="End date" OnChange="ToChangedAsync" />
                </div>
                <div class="places-timeline__labels"><span>@DisplayDate(SelectedFrom ?? minimum)</span><span>@DisplayDate(SelectedTo ?? maximum)</span></div>
            }
        </div>
        <div class="places-timeline__actions">
            <div class="places-timeline__controls" role="group" aria-label="Timeline resolution">
                @foreach (var option in Resolutions)
                {
                    <AppNativeButton Type="button" Class="@(Resolution == option.Value ? "is-active" : null)" aria-pressed="@(Resolution == option.Value)" OnClick="@(_ => OnResolutionChanged.InvokeAsync(option.Value))">@option.Label</AppNativeButton>
                }
            </div>
            <AppNativeButton Type="button" Class="places-timeline__reset" OnClick="@(_ => OnReset.InvokeAsync())"><MudIcon Icon="@Icons.Material.Outlined.RestartAlt" />Reset</AppNativeButton>
        </div>
    </section>
}

@code {
    private static readonly (string Label, string Value)[] Resolutions = [("Year", "year"), ("Month", "month"), ("Day", "day")];
    [Parameter] public IReadOnlyList<ViewAtlasTimelineBucketDto> Buckets { get; set; } = [];
    [Parameter] public DateTimeOffset? EarliestAt { get; set; }
    [Parameter] public DateTimeOffset? LatestAt { get; set; }
    [Parameter] public int? SelectedYear { get; set; }
    [Parameter] public DateTimeOffset? SelectedFrom { get; set; }
    [Parameter] public DateTimeOffset? SelectedTo { get; set; }
    [Parameter] public string Resolution { get; set; } = "year";
    [Parameter] public int MappedAssetCount { get; set; }
    [Parameter] public int ImageCount { get; set; }
    [Parameter] public int VideoCount { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> OnFromChanged { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> OnToChanged { get; set; }
    [Parameter] public EventCallback<string> OnResolutionChanged { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    private DateTimeOffset? Minimum => EarliestAt ?? Buckets.FirstOrDefault()?.Start;
    private DateTimeOffset? Maximum => LatestAt ?? Buckets.LastOrDefault()?.Start;
    private bool IsSingleYear => string.Equals(Resolution, "year", StringComparison.OrdinalIgnoreCase)
                                 && (SelectedYear.HasValue
                                     || (Minimum is { } minimum && Maximum is { } maximum
                                         && minimum.Year == maximum.Year));
    private int SingleYearLabel => SelectedYear ?? Minimum?.Year ?? DateTimeOffset.Now.Year;
    private string RootClass => $"places-timeline{(IsSingleYear ? " is-single-year" : string.Empty)}";
    private int MaximumIndex => Minimum is { } min && Maximum is { } max ? Math.Max(1, (int)Math.Ceiling((max - min).TotalDays)) : 1;
    private int FromIndex => Index(SelectedFrom ?? Minimum);
    private int ToIndex => Index(SelectedTo ?? Maximum);
    private int LargestBucket => Math.Max(1, Buckets.Count == 0 ? 1 : Buckets.Max(bucket => bucket.AssetCount));
    private int BucketHeight(int count) => Math.Clamp((int)Math.Round(count / (double)LargestBucket * 100), 8, 100);
    private string BucketClass(int count) => $"is-height-{Math.Clamp((int)Math.Ceiling(BucketHeight(count) / 10d), 1, 10)}";
    private int Index(DateTimeOffset? value) => Minimum is { } minimum && value is { } date ? Math.Clamp((int)Math.Round((date - minimum).TotalDays), 0, MaximumIndex) : 0;
    private DateTimeOffset DateAt(int index) => Minimum!.Value.AddDays(Math.Clamp(index, 0, MaximumIndex));
    private async Task FromChangedAsync(ChangeEventArgs args)
    {
        var index = int.TryParse(args.Value?.ToString(), out var parsed) ? parsed : 0;
        await OnFromChanged.InvokeAsync(DateAt(Math.Min(index, ToIndex)));
    }
    private async Task ToChangedAsync(ChangeEventArgs args)
    {
        var index = int.TryParse(args.Value?.ToString(), out var parsed) ? parsed : MaximumIndex;
        await OnToChanged.InvokeAsync(DateAt(Math.Max(index, FromIndex)).AddDays(1).AddTicks(-1));
    }
    private string DisplayDate(DateTimeOffset value) => Resolution switch
    {
        "day" => value.ToString("MMM d, yyyy", CultureInfo.CurrentCulture),
        "month" => value.ToString("MMM yyyy", CultureInfo.CurrentCulture),
        _ => value.ToString("yyyy", CultureInfo.CurrentCulture),
    };
}
