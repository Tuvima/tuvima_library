@namespace MediaEngine.Web.Components.Artwork
@using MediaEngine.Contracts.Artwork

<ArtworkWorkspace Item="@Item" ActiveProfileId="@ActiveProfileId" OnClose="HandleClose" />

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public ArtworkLibraryItemDto Item { get; set; } = default!;
    [Parameter] public Guid? ActiveProfileId { get; set; }

    private Task HandleClose(bool changed)
    {
        if (changed) MudDialog.Close(DialogResult.Ok(true));
        else MudDialog.Cancel();
        return Task.CompletedTask;
    }
}
