@namespace MediaEngine.Web.Components.Collections
@using MediaEngine.Contracts.Collections
@using MediaEngine.Web.Models.ViewDTOs
@implements IDisposable

@inject IEngineApiClient ApiClient

<section class="collection-rule-builder @($"collection-rule-builder--{Density}")">
    <header class="collection-rule-builder__header">
        <div>
            <span class="collection-rule-builder__eyebrow">Smart membership</span>
            <h3>Build rules</h3>
            <p>Create rule groups and conditions to define which items belong in this collection.</p>
        </div>
    </header>

    <div class="collection-rule-builder__workspace">
        <div class="collection-rule-builder__conditions">
            @for (var groupIndex = 0; groupIndex < Definition.Groups.Count; groupIndex++)
            {
                var group = Definition.Groups[groupIndex];
                var capturedGroupIndex = groupIndex;

                @if (groupIndex > 0)
                {
                    <div class="collection-rule-builder__join" role="group" aria-label="Relationship to preceding group">
                        <span>Combine groups with</span>
                        <AppNativeButton Type="button" Class="@(group.JoinWithPrevious == "and" ? "is-selected" : null)"
                                         OnClick="@(() => SetGroupJoinAsync(group, "and"))">AND</AppNativeButton>
                        <AppNativeButton Type="button" Class="@(group.JoinWithPrevious != "and" ? "is-selected" : null)"
                                         OnClick="@(() => SetGroupJoinAsync(group, "or"))">OR</AppNativeButton>
                    </div>
                }

                <article class="collection-rule-builder__group"
                         @key="group.Id"
                         @ondragover:preventDefault
                         @ondrop="@(() => DropGroupAsync(group.Id))">
                    <header class="collection-rule-builder__group-header">
                        <div class="collection-rule-builder__group-identity">
                            <span class="collection-rule-builder__drag"
                                  draggable="true"
                                  title="Drag to reorder group"
                                  @ondragstart="@(() => BeginGroupDrag(group.Id))">
                                <MudIcon Icon="@Icons.Material.Outlined.DragIndicator" />
                            </span>
                            <strong>Group @(groupIndex + 1)</strong>
                        </div>
                        <div class="collection-rule-builder__group-mode" role="group" aria-label="Group match mode">
                            <AppNativeButton Type="button" Class="@(group.MatchMode == "all" ? "is-selected" : null)"
                                             OnClick="@(() => SetGroupModeAsync(group, "all"))">Match ALL</AppNativeButton>
                            <AppNativeButton Type="button" Class="@(group.MatchMode == "any" ? "is-selected" : null)"
                                             OnClick="@(() => SetGroupModeAsync(group, "any"))">Match ANY</AppNativeButton>
                        </div>
                        @if (Definition.Groups.Count > 1)
                        {
                            <AppIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                           Tooltip="Remove group" AriaLabel="Remove rule group"
                                           OnClick="@(() => RemoveGroupAsync(capturedGroupIndex))" />
                        }
                    </header>

                    <div class="collection-rule-builder__rows">
                        @for (var conditionIndex = 0; conditionIndex < group.Conditions.Count; conditionIndex++)
                        {
                            var condition = group.Conditions[conditionIndex];
                            var capturedConditionIndex = conditionIndex;
                            <div class="collection-rule-builder__row" @key="condition">
                                <MudIcon Icon="@Icons.Material.Outlined.DragIndicator" Class="collection-rule-builder__condition-drag" />
                                <AppSelect T="string" Value="@condition.Field"
                                           ValueChanged="@(value => OnFieldChangedAsync(condition, value))"
                                           Label="Field" Variant="Variant.Outlined" Dense="true" Class="app-dialog-select">
                                    @foreach (var field in Fields)
                                    {
                                        <MudSelectItem T="string" Value="@field.Key">@field.Label</MudSelectItem>
                                    }
                                </AppSelect>
                                <AppSelect T="string" Value="@condition.Op"
                                           ValueChanged="@(value => OnOperatorChangedAsync(condition, value))"
                                           Label="Condition" Variant="Variant.Outlined" Dense="true" Class="app-dialog-select">
                                    @foreach (var op in OperatorsFor(condition.Field))
                                    {
                                        <MudSelectItem T="string" Value="@op.Key">@op.Label</MudSelectItem>
                                    }
                                </AppSelect>
                                @if (IsValueFreeOperator(condition.Op))
                                {
                                    <div class="collection-rule-builder__no-value">No value needed</div>
                                }
                                else if (IsBooleanField(condition.Field))
                                {
                                    <AppSelect T="string" Value="@condition.Value"
                                               ValueChanged="@(value => OnTextValueChangedAsync(condition, value))"
                                               Label="Value" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem T="string" Value="@("true")">Yes</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("false")">No</MudSelectItem>
                                    </AppSelect>
                                }
                                else if (UsesLibraryValues(condition.Field))
                                {
                                    <AppAutocomplete TItem="CollectionRuleValueDto"
                                                     Value="@SelectedOption(condition)"
                                                     ValueChanged="@(value => OnOptionChangedAsync(condition, value))"
                                                     SearchFunc="@((text, token) => SearchOptionsAsync(condition.Field, text, token))"
                                                     ToStringFunc="@(option => option?.Label ?? string.Empty)"
                                                     Label="Value" Placeholder="Type to search library values"
                                                     CoerceText="false" CoerceValue="false" ResetValueOnEmptyText="true" MaxItems="40">
                                        <ItemTemplate Context="option">
                                            <div class="collection-rule-builder__option">
                                                <span><strong>@option.Label</strong><small>@option.Group</small></span>
                                                @if (option.LocalCount > 0){<em>@option.LocalCount</em>}
                                            </div>
                                        </ItemTemplate>
                                    </AppAutocomplete>
                                }
                                else
                                {
                                    <AppTextField T="string" Value="@condition.Value"
                                                  ValueChanged="@(value => OnTextValueChangedAsync(condition, value))"
                                                  Label="Value" Variant="Variant.Outlined" Immediate="true"
                                                  DebounceInterval="300" Class="app-dialog-field" />
                                }
                                <AppIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                               Tooltip="Remove condition" AriaLabel="Remove condition"
                                               OnClick="@(() => RemoveConditionAsync(group, capturedConditionIndex))" />
                            </div>
                        }
                    </div>
                    <AppButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                               Class="collection-rule-builder__add-condition"
                               OnClick="@(() => OpenConditionPicker(group))">Add condition</AppButton>

                    @if (string.Equals(_pickerGroupId, group.Id, StringComparison.Ordinal))
                    {
                        <div class="collection-rule-builder__picker">
                            <div class="collection-rule-builder__picker-title">
                                <strong>Add condition</strong>
                                <AppIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                               Tooltip="Close rule picker" AriaLabel="Close rule picker"
                                               OnClick="CloseConditionPicker" />
                            </div>
                            <AppTextField T="string" Value="@_pickerSearch" ValueChanged="OnPickerSearchChanged"
                                          Placeholder="Search rule types..." Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Outlined.Search" Immediate="true"
                                          Class="collection-rule-builder__picker-search" />
                            <nav class="collection-rule-builder__picker-families" aria-label="Rule families">
                                @foreach (var category in Categories)
                                {
                                    <AppNativeButton Type="button" Class="@(category.Key == _pickerCategory ? "is-selected" : null)"
                                                     OnClick="@(() => SelectPickerCategory(category.Key))">
                                        <MudIcon Icon="@category.Icon" /><span>@category.Label</span>
                                    </AppNativeButton>
                                }
                            </nav>
                            <div class="collection-rule-builder__picker-options">
                                @foreach (var field in PickerFields)
                                {
                                    <AppNativeButton Type="button" Class="collection-rule-builder__picker-option"
                                                     OnClick="@(() => SelectFieldAsync(group, field))">
                                        <MudIcon Icon="@IconForField(field)" />
                                        <span><strong>@field.Label</strong><small>@DescriptionForField(field)</small></span>
                                        <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                                    </AppNativeButton>
                                }
                            </div>
                        </div>
                    }
                </article>
            }

            <AppButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                       Class="collection-rule-builder__add-group" OnClick="AddGroupAsync">Add group</AppButton>

            <div class="collection-rule-builder__ordering">
                <div class="collection-rule-builder__ordering-header">
                    <div><MudIcon Icon="@Icons.Material.Outlined.SwapVert" /><strong>Sort results</strong><span>Sorting controls the display order of matching items.</span></div>
                    <small><MudIcon Icon="@Icons.Material.Outlined.Info" /> Sorting affects order, not membership rules.</small>
                </div>
                <div class="collection-rule-builder__sort">
                    <span>Sort by</span>
                    @RenderSortFieldSelect(SortField ?? "title", OnSortFieldChangedAsync)
                    @RenderSortDirectionSelect(SortField ?? "title", SortDirection, OnSortDirectionChangedAsync)
                </div>
                @if (string.IsNullOrWhiteSpace(SecondarySortField))
                {
                    <AppButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                               Class="collection-rule-builder__add-secondary" OnClick="AddSecondarySortAsync">Add “Then by”</AppButton>
                }
                else
                {
                    <div class="collection-rule-builder__sort">
                        <span>Then by</span>
                        @RenderSortFieldSelect(SecondarySortField, OnSecondarySortFieldChangedAsync)
                        @RenderSortDirectionSelect(SecondarySortField, SecondarySortDirection ?? "asc", OnSecondarySortDirectionChangedAsync)
                        <AppIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                       Tooltip="Remove secondary sort" AriaLabel="Remove secondary sort"
                        OnClick="RemoveSecondarySortAsync" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public CollectionRuleDefinitionViewModel Definition { get; set; } = new();
    [Parameter] public EventCallback<CollectionRuleDefinitionViewModel> DefinitionChanged { get; set; }
    [Parameter] public string? SortField { get; set; } = "title";
    [Parameter] public EventCallback<string?> SortFieldChanged { get; set; }
    [Parameter] public string SortDirection { get; set; } = "asc";
    [Parameter] public EventCallback<string> SortDirectionChanged { get; set; }
    [Parameter] public string? SecondarySortField { get; set; }
    [Parameter] public EventCallback<string?> SecondarySortFieldChanged { get; set; }
    [Parameter] public string? SecondarySortDirection { get; set; }
    [Parameter] public EventCallback<string?> SecondarySortDirectionChanged { get; set; }
    [Parameter] public CollectionPreviewResult? Preview { get; set; }
    [Parameter] public EventCallback<CollectionPreviewResult?> PreviewChanged { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public string Density { get; set; } = "editor";

    private string _pickerCategory = "media";
    private string _pickerSearch = string.Empty;
    private string? _pickerGroupId;
    private string? _draggedGroupId;
    private bool _initialPreviewQueued;
    private CancellationTokenSource? _previewCts;

    private static readonly RuleCategory[] Categories =
    [
        new("media", "Media", Icons.Material.Outlined.Movie), new("people", "People & organizations", Icons.Material.Outlined.People),
        new("story", "Story & world", Icons.Material.Outlined.Public), new("recognition", "Recognition", Icons.Material.Outlined.StarBorder),
        new("production", "Production", Icons.Material.Outlined.MovieFilter), new("library", "My library", Icons.Material.Outlined.Inventory2),
    ];

    private static readonly RuleField[] Fields =
    [
        new("media", "media_type", "Media type"), new("media", "genre", "Genre"), new("media", "year", "Year"), new("media", "decade", "Decade"),
        new("media", "language", "Language", true), new("media", "original_language", "Original language", true), new("media", "country_of_origin", "Country of origin", true),
        new("people", "person_qid", "Person", true), new("people", "author", "Author", true), new("people", "narrator", "Narrator", true),
        new("people", "director", "Director", true), new("people", "cast_member", "Actor / cast member", true), new("people", "voice_actor", "Voice actor", true),
        new("people", "artist", "Artist / performer", true), new("people", "composer", "Composer", true), new("people", "screenwriter", "Screenwriter", true),
        new("people", "illustrator", "Illustrator", true), new("people", "production_company", "Production company", true), new("people", "publisher", "Publisher", true),
        new("people", "record_label", "Record label", true), new("people", "network", "Network / broadcaster", true),
        new("story", "series", "Series"), new("story", "wikidata_franchise", "Franchise / universe", true), new("story", "based_on", "Based on", true),
        new("story", "narrative_location", "Narrative location", true), new("story", "set_in_period", "Set in period", true), new("story", "main_subject", "Main subject", true),
        new("story", "characters", "Character", true), new("story", "fictional_universe", "Universe", true), new("story", "is_adaptation", "Is an adaptation"),
        new("story", "source_work_owned", "Source work is owned"), new("story", "adaptation_owned", "Adaptation is owned"),
        new("recognition", "provider_rating", "Provider rating"), new("recognition", "award_received", "Award won", true), new("recognition", "award_nominated", "Award nominated", true),
        new("recognition", "award_family", "Award family", true), new("recognition", "nomination_family", "Nomination family", true),
        new("production", "filming_location", "Filming location", true), new("library", "added_within_days", "Added within days"),
    ];

    private List<CollectionRulePredicateViewModel> CompleteConditions => Definition.AllConditions.Where(IsComplete).ToList();

    protected override void OnParametersSet()
    {
        if (Definition.Groups.Count == 0)
            Definition.Groups.Add(NewGroup());
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialPreviewQueued){_initialPreviewQueued = true; _ = SchedulePreviewAsync(true);}
        return Task.CompletedTask;
    }

    private static CollectionRuleGroupViewModel NewGroup() => new() { Conditions = [] };
    private IReadOnlyList<RuleField> PickerFields => Fields
        .Where(ruleField => ruleField.Category == _pickerCategory)
        .Where(ruleField => string.IsNullOrWhiteSpace(_pickerSearch)
            || ruleField.Label.Contains(_pickerSearch, StringComparison.OrdinalIgnoreCase)
            || ruleField.Key.Replace('_', ' ').Contains(_pickerSearch, StringComparison.OrdinalIgnoreCase)
            || DescriptionForField(ruleField).Contains(_pickerSearch, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void OpenConditionPicker(CollectionRuleGroupViewModel group)
    {
        _pickerGroupId = group.Id;
        _pickerCategory = "media";
        _pickerSearch = string.Empty;
    }
    private Task CloseConditionPicker(){_pickerGroupId = null; return Task.CompletedTask;}
    private Task OnPickerSearchChanged(string? value){_pickerSearch = value ?? string.Empty; return Task.CompletedTask;}
    private void SelectPickerCategory(string category){_pickerCategory = category; _pickerSearch = string.Empty;}
    private async Task SelectFieldAsync(CollectionRuleGroupViewModel group, RuleField field)
    {
        group.Conditions.Add(new CollectionRulePredicateViewModel
        {
            Field = field.Key,
            Op = OperatorsFor(field.Key).First().Key,
        });
        _pickerGroupId = null;
        await NotifyChangedAsync();
    }

    private async Task AddGroupAsync()
    {
        var group = NewGroup();
        group.JoinWithPrevious = "or";
        Definition.Groups.Add(group);
        OpenConditionPicker(group);
        await NotifyChangedAsync();
    }
    private async Task RemoveGroupAsync(int index){Definition.Groups.RemoveAt(index); await NotifyChangedAsync();}
    private async Task RemoveConditionAsync(CollectionRuleGroupViewModel group, int index){group.Conditions.RemoveAt(index); await NotifyChangedAsync();}
    private async Task SetGroupModeAsync(CollectionRuleGroupViewModel group, string mode){group.MatchMode = mode; await NotifyChangedAsync();}
    private async Task SetGroupJoinAsync(CollectionRuleGroupViewModel group, string join){group.JoinWithPrevious = join; await NotifyChangedAsync();}
    private void BeginGroupDrag(string groupId) => _draggedGroupId = groupId;
    private async Task DropGroupAsync(string targetGroupId)
    {
        if (string.IsNullOrWhiteSpace(_draggedGroupId) || _draggedGroupId == targetGroupId)
            return;
        var sourceIndex = Definition.Groups.FindIndex(group => group.Id == _draggedGroupId);
        var targetIndex = Definition.Groups.FindIndex(group => group.Id == targetGroupId);
        if (sourceIndex < 0 || targetIndex < 0)
            return;
        var moved = Definition.Groups[sourceIndex];
        Definition.Groups.RemoveAt(sourceIndex);
        if (sourceIndex < targetIndex)
            targetIndex--;
        Definition.Groups.Insert(targetIndex, moved);
        _draggedGroupId = null;
        await NotifyChangedAsync();
    }

    private async Task OnFieldChangedAsync(CollectionRulePredicateViewModel condition, string field)
    { condition.Field = field; condition.Op = OperatorsFor(field).First().Key; condition.Value = null; condition.DisplayValue = null; condition.Values = null; await NotifyChangedAsync(); }
    private async Task OnOperatorChangedAsync(CollectionRulePredicateViewModel condition, string op)
    { condition.Op = op; if (IsValueFreeOperator(op)){condition.Value = null; condition.DisplayValue = null; condition.Values = null;} await NotifyChangedAsync(); }
    private async Task OnTextValueChangedAsync(CollectionRulePredicateViewModel condition, string? value)
    { condition.Value = value; condition.DisplayValue = null; condition.Values = null; await NotifyChangedAsync(); }
    private async Task OnOptionChangedAsync(CollectionRulePredicateViewModel condition, CollectionRuleValueDto? option)
    { condition.Value = option?.Value; condition.DisplayValue = option?.Label; condition.Values = null; await NotifyChangedAsync(); }
    private CollectionRuleValueDto? SelectedOption(CollectionRulePredicateViewModel condition) => string.IsNullOrWhiteSpace(condition.Value) ? null : new(condition.Value, condition.DisplayValue ?? condition.Value, 0, OptionGroup(condition.Field));

    private async Task<IEnumerable<CollectionRuleValueDto>> SearchOptionsAsync(string field, string? text, CancellationToken token)
    {
        if (IsEntityField(field)) return await ApiClient.GetCollectionEntityFieldValuesAsync(field, text, 40, token);
        var values = await ApiClient.GetCollectionFieldValuesAsync(field, text, 40, token);
        return values.Select(value => new CollectionRuleValueDto(value, value, 0, OptionGroup(field)));
    }

    private async Task OnSortFieldChangedAsync(string value){SortField = value; await SortFieldChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync();}
    private async Task OnSortDirectionChangedAsync(string value){SortDirection = value; await SortDirectionChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync();}
    private async Task OnSecondarySortFieldChangedAsync(string value){SecondarySortField = value; await SecondarySortFieldChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync();}
    private async Task OnSecondarySortDirectionChangedAsync(string value){SecondarySortDirection = value; await SecondarySortDirectionChanged.InvokeAsync(value); await Changed.InvokeAsync(); await SchedulePreviewAsync();}
    private async Task AddSecondarySortAsync()
    {
        SecondarySortField = string.Equals(SortField, "title", StringComparison.OrdinalIgnoreCase) ? "year" : "title";
        SecondarySortDirection = "asc";
        await SecondarySortFieldChanged.InvokeAsync(SecondarySortField);
        await SecondarySortDirectionChanged.InvokeAsync(SecondarySortDirection);
        await Changed.InvokeAsync();
        await SchedulePreviewAsync();
    }
    private async Task RemoveSecondarySortAsync()
    {
        SecondarySortField = null;
        SecondarySortDirection = null;
        await SecondarySortFieldChanged.InvokeAsync(null);
        await SecondarySortDirectionChanged.InvokeAsync(null);
        await Changed.InvokeAsync();
        await SchedulePreviewAsync();
    }
    private async Task NotifyChangedAsync(){await DefinitionChanged.InvokeAsync(Definition); await Changed.InvokeAsync(); await SchedulePreviewAsync();}

    private RenderFragment RenderSortFieldSelect(string value, Func<string, Task> changed) => @<AppSelect T="string" Value="@value" ValueChanged="@changed" Dense="true">
        @foreach (var option in SortFields)
        {
            <MudSelectItem T="string" Value="@option.Key">@option.Label</MudSelectItem>
        }
    </AppSelect>;

    private RenderFragment RenderSortDirectionSelect(string field, string value, Func<string, Task> changed) => @<AppSelect T="string" Value="@value" ValueChanged="@changed" Dense="true">
        <MudSelectItem T="string" Value="@("asc")">@DirectionLabel(field, "asc")</MudSelectItem>
        <MudSelectItem T="string" Value="@("desc")">@DirectionLabel(field, "desc")</MudSelectItem>
    </AppSelect>;

    private static readonly (string Key, string Label)[] SortFields =
    [
        ("title", "Title"), ("creator", "Creator"), ("year", "Release year"),
        ("provider_rating", "Provider rating"), ("added_at", "Date added"), ("media_type", "Media type"),
    ];

    private static string DirectionLabel(string field, string direction) => (field, direction) switch
    {
        ("provider_rating", "asc") => "Lowest first",
        ("provider_rating", _) => "Highest first",
        ("year" or "added_at", "asc") => "Oldest first",
        ("year" or "added_at", _) => "Newest first",
        (_, "asc") => "A–Z",
        _ => "Z–A",
    };

    private async Task SchedulePreviewAsync(bool immediate = false)
    {
        _previewCts?.Cancel(); _previewCts?.Dispose(); _previewCts = new CancellationTokenSource();
        try{if (!immediate) await Task.Delay(350, _previewCts.Token); await RunPreviewAsync(_previewCts.Token);}catch(OperationCanceledException){}
    }
    public async Task RefreshAsync(){_previewCts?.Cancel(); _previewCts?.Dispose(); _previewCts = new CancellationTokenSource(); await RunPreviewAsync(_previewCts.Token);}
    private async Task RunPreviewAsync(CancellationToken token)
    {
        if (CompleteConditions.Count == 0){Preview = null; await PreviewChanged.InvokeAsync(null); await InvokeAsync(StateHasChanged); return;}
        await InvokeAsync(StateHasChanged);
        try{Preview = await ApiClient.PreviewCollectionRulesAsync(Definition, SortField, SortDirection, limit: 15, ct: token, secondarySortField: SecondarySortField, secondarySortDirection: SecondarySortDirection); await PreviewChanged.InvokeAsync(Preview);}
        catch(OperationCanceledException){throw;} catch{Preview = null; await PreviewChanged.InvokeAsync(null);}
        finally{await InvokeAsync(StateHasChanged);}
    }

    private static bool IsEntityField(string field) => Fields.FirstOrDefault(item => item.Key == field)?.Entity == true;
    private static bool UsesLibraryValues(string field) => field is "media_type" or "genre" or "series" or "language" or "original_language" or "country_of_origin" or "person_qid" or "author" or "narrator" or "director" or "cast_member" or "voice_actor" or "artist" or "composer" or "screenwriter" or "illustrator" or "production_company" or "publisher" or "record_label" or "network" or "wikidata_franchise" or "award_received" or "award_nominated" or "award_family" or "nomination_family" or "characters" or "fictional_universe" or "narrative_location" or "set_in_period" or "main_subject" or "based_on" or "filming_location";
    private static bool IsBooleanField(string field) => field is "is_adaptation" or "source_work_owned" or "adaptation_owned";
    private static bool IsValueFreeOperator(string op) => op is "known" or "unknown" or "has_any_value" or "has_no_known_value";
    private static bool IsComplete(CollectionRulePredicateViewModel condition) => !string.IsNullOrWhiteSpace(condition.Field) && (IsValueFreeOperator(condition.Op) || !string.IsNullOrWhiteSpace(condition.Value) || condition.Values?.Length > 0);
    private static string OptionGroup(string field) => field switch { "award_received" or "award_nominated" or "award_family" or "nomination_family" or "director" or "cast_member" or "screenwriter" or "production_company" or "filming_location" or "network" => "Movies & TV", "author" or "illustrator" or "publisher" => "Books & Comics", "narrator" => "Audiobooks", "artist" or "composer" or "record_label" => "Music", _ => "Cross-media" };
    private static string IconForField(RuleField field) => field.Key switch
    {
        "media_type" => Icons.Material.Outlined.Movie,
        "genre" => Icons.Material.Outlined.LocalOffer,
        "year" or "decade" => Icons.Material.Outlined.CalendarToday,
        "language" or "original_language" or "country_of_origin" => Icons.Material.Outlined.Language,
        "provider_rating" => Icons.Material.Outlined.Star,
        "award_received" or "award_nominated" or "award_family" or "nomination_family" => Icons.Material.Outlined.EmojiEvents,
        "added_within_days" => Icons.Material.Outlined.History,
        _ when field.Category == "people" => Icons.Material.Outlined.People,
        _ when field.Category == "story" => Icons.Material.Outlined.Public,
        _ when field.Category == "production" => Icons.Material.Outlined.MovieFilter,
        _ => Icons.Material.Outlined.Tune,
    };
    private static string DescriptionForField(RuleField field) => field.Key switch
    {
        "media_type" => "Filter by type of media.",
        "genre" => "Filter by genre or category.",
        "year" => "Filter by release year.",
        "decade" => "Filter by release decade.",
        "language" or "original_language" => "Filter by language.",
        "country_of_origin" => "Filter by country of origin.",
        "provider_rating" => "Filter by average provider rating.",
        "added_within_days" => "Filter by when an item entered your library.",
        _ when field.Entity => $"Filter by {field.Label.ToLowerInvariant()}.",
        _ => $"Filter using {field.Label.ToLowerInvariant()} metadata.",
    };
    private static List<RuleOperator> OperatorsFor(string field) => field switch
    {
        "is_adaptation" or "source_work_owned" or "adaptation_owned" => [new("eq", "is")],
        "media_type" => [new("eq", "is"), new("neq", "is not")],
        "year" or "provider_rating" or "added_within_days" => [new("eq", "is"), new("gt", "greater than"), new("lt", "less than"), new("between", "between"), new("gte", "at least"), new("lte", "at most")],
        "decade" => [new("eq", "is")],
        _ when IsEntityField(field) => [new("eq", "is"), new("neq", "is not"), new("known", "is known"), new("unknown", "is unknown")],
        _ => [new("eq", "is"), new("neq", "is not"), new("contains", "contains"), new("known", "is known")],
    };

    public void Dispose(){_previewCts?.Cancel(); _previewCts?.Dispose();}
    private sealed record RuleCategory(string Key, string Label, string Icon);
    private sealed record RuleField(string Category, string Key, string Label, bool Entity = false);
    private sealed record RuleOperator(string Key, string Label);
}
