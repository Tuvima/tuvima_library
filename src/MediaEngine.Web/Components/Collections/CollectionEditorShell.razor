@namespace MediaEngine.Web.Components.Collections
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Routing
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Components.MediaEditor

@inject IEngineApiClient ApiClient
@inject UIOrchestratorService Orchestrator
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<CollectionEditorShell> Logger

<NavigationLock ConfirmExternalNavigation="@_hasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmNavigationWithUnsavedChanges" />

<MediaEditorSurface Inline="@Inline">
    <div class="sme-shell collection-editor-workspace">
        <header class="sme-header collection-editor-header">
            <div class="collection-editor-header-icon" aria-hidden="true">
                <MudIcon Icon="@CollectionTypeIcon" />
            </div>
            <div class="sme-header-copy">
                <div class="sme-kicker">@DialogEyebrow</div>
                <h2 class="sme-title" tabindex="-1">@EditorIdentityTitle</h2>
                <div class="sme-subtitle">@HeaderSubtitle</div>
            </div>
            <div class="collection-editor-header-actions">
                <AppIconButton Icon="@Icons.Material.Outlined.Close"
                               Size="Size.Small"
                               Color="Color.Inherit"
                               Class="sme-close"
                               Tooltip="Close editor"
                               AriaLabel="Close editor"
                               OnClick="Cancel" />
            </div>
        </header>

        <div class="sme-workspace collection-editor-layout">
            <nav class="sme-section-nav collection-editor-rail" aria-label="Collection editor sections">
                @for (var index = 0; index < VisibleTabs.Length; index++)
                {
                    var tabIndex = index;
                    var tab = VisibleTabs[index];
                    <AppButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               Class="@TabClass(tab.Id)"
                               OnClick="@(() => OnTabChanged(tabIndex))">
                        <MudIcon Icon="@tab.Icon" Size="Size.Small" />
                        <span>@tab.Label</span>
                    </AppButton>

                    @if (tab.Id == "artwork" && _activeTab.StartsWith("artwork", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="sme-section-nav__nested" role="tablist" aria-label="Artwork types">
                            @foreach (var artworkTab in ArtworkTabs)
                            {
                                var isSelected = string.Equals(artworkTab.Slot, _activeArtworkSlot, StringComparison.OrdinalIgnoreCase);
                                <AppButton Variant="Variant.Text"
                                           Color="Color.Inherit"
                                           Class="@(isSelected ? "sme-section-nav__nested-item is-active" : "sme-section-nav__nested-item")"
                                           OnClick="@(() => SelectArtworkTab(artworkTab))">
                                    <MudIcon Icon="@artworkTab.Icon" Size="Size.Small" />
                                    <span>@artworkTab.Label</span>
                                </AppButton>
                            }
                        </div>
                    }
                }

                @if (EditingCollection is not null)
                {
                    <div class="collection-editor-rail-footer">
                        @if (CanDeleteCollection)
                        {
                            <AppButton Variant="Variant.Filled" Color="Color.Error"
                                       Class="collection-editor-delete-button"
                                       StartIcon="@Icons.Material.Outlined.DeleteOutline"
                                       OnClick="DeleteCollectionAsync" Disabled="@_saving">Delete collection</AppButton>
                            <small>Media remains in your library.</small>
                        }
                    </div>
                }
            </nav>

            <main class="sme-main-pane collection-editor-main">
                <div class="sme-body collection-editor-body">
                    @switch (_activeTab)
                    {
                        case "details":
                            @RenderDetailsTab()
                            break;
                        case "artwork":
                        case "artwork-background":
                        case "artwork-banner":
                        case "artwork-logo":
                            @RenderArtworkTab()
                            break;
                        case "rules":
                            @RenderRulesTab()
                            break;
                        case "items":
                            @RenderItemsTab()
                            break;
                        case "history":
                            @RenderHistoryTab()
                            break;
                        default:
                            @RenderDetailsTab()
                            break;
                    }
                </div>

                <footer class="sme-footer collection-editor-footer">
                    <div class="collection-editor-footer-copy" aria-live="polite">@FooterSummary</div>
                    <div class="collection-editor-footer-actions">
                        <AppButton Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   OnClick="Cancel"
                                   Disabled="@_saving">
                            Cancel
                        </AppButton>
                        <AppButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Save"
                                   OnClick="SaveCollection"
                                   Disabled="@_saving">
                            @if (_saving)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="tl-u-color-inherit tl-u-width-14px tl-u-height-14px" />
                            }
                            @SaveButtonText
                        </AppButton>
                    </div>
                </footer>
            </main>
        </div>
    </div>
</MediaEditorSurface>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public CollectionEditorLaunchRequest Request { get; set; } = new();
    [Parameter] public bool Inline { get; set; }
    [Parameter] public EventCallback<bool> Closed { get; set; }

    private static readonly (string Id, string Label, string Icon)[] Tabs =
    [
        ("details", "Details", Icons.Material.Outlined.Article),
        ("artwork", "Artwork", Icons.Material.Outlined.PhotoLibrary),
        ("items", "Contents", Icons.Material.Outlined.Inventory2),
        ("rules", "Rules", Icons.Material.Outlined.FilterAlt),
        ("history", "History", Icons.Material.Outlined.History),
    ];
    private static readonly (string Id, string Slot, string Label, string Icon)[] ArtworkTabs =
    [
        ("artwork", "poster", "Poster / Cover", Icons.Material.Outlined.Image),
        ("artwork-background", "background", "Background", Icons.Material.Outlined.Panorama),
        ("artwork-banner", "banner", "Banner", Icons.Material.Outlined.ViewDay),
        ("artwork-logo", "logo", "Logo", Icons.Material.Outlined.BrandingWatermark),
    ];
    private static readonly (string Id, string Label, string Icon)[] PlaylistTabs = [("details", "Details", Icons.Material.Outlined.Article)];
    private static readonly (string Id, string Label, string Icon)[] SmartPlaylistTabs = [("details", "Details", Icons.Material.Outlined.Article)];
    private static readonly (string Label, string Icon)[] IconChoices =
    [
        ("Playlist", Icons.Material.Outlined.QueueMusic),
        ("Smart", Icons.Material.Outlined.AutoAwesomeMotion),
        ("Favorites", Icons.Material.Outlined.FavoriteBorder),
        ("Recent", Icons.Material.Outlined.Schedule),
        ("Albums", Icons.Material.Outlined.Album),
        ("Artist", Icons.Material.Outlined.Person),
        ("Mood", Icons.Material.Outlined.GraphicEq),
        ("Folder", Icons.Material.Outlined.Folder)
    ];

    private CollectionListItemViewModel? EditingCollection => Request.EditingCollection;
    private bool IsPlaylistLaunch => Request.Mode == CollectionEditorMode.ManualPlaylist;
    private bool IsSmartPlaylistLaunch => Request.Mode == CollectionEditorMode.SmartPlaylist;
    private bool IsPlaylistDialog => IsPlaylistLaunch || IsSmartPlaylistLaunch;
    private (string Id, string Label, string Icon)[] VisibleTabs => IsPlaylistLaunch ? PlaylistTabs : IsSmartPlaylistLaunch ? SmartPlaylistTabs : Tabs;

    private string _activeTab = "details";
    private string _activeArtworkSlot = "poster";
    private string _name = string.Empty;
    private string? _description;
    private string? _iconName;
    private readonly Dictionary<string, IBrowserFile> _artworkFiles = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _artworkPreviewUrls = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _removedArtworkSlots = new(StringComparer.OrdinalIgnoreCase);
    private string _collectionType = "Custom";
    private bool _rulesEnabled = true;
    private CollectionRuleDefinitionViewModel _ruleDefinition = new()
    {
        Groups = [new CollectionRuleGroupViewModel { Conditions = [new CollectionRulePredicateViewModel()] }],
    };
    private string _sortField = "title";
    private string _sortDirection = "asc";
    private string? _secondarySortField;
    private string? _secondarySortDirection;
    private bool _saving;
    private bool _hasUnsavedChanges;
    private CollectionPreviewResult? _previewResult;
    private string _itemSearchText = string.Empty;
    private bool _loadingLibraryItems;
    private bool _loadingManualItems;
    private bool _showItemPicker;
    private List<CollectionMediaLookupDto> _lookupItems = [];
    private List<ManualCollectionItem> _manualItems = [];

    private bool IsPlaylist => string.Equals(_collectionType, "Playlist", StringComparison.OrdinalIgnoreCase);
    private bool IsSmartPlaylist => string.Equals(_collectionType, "Smart", StringComparison.OrdinalIgnoreCase);
    private string PersistenceVisibility => IsPlaylistDialog || IsPlaylist || IsSmartPlaylist ? "private" : "shared";
    private bool SupportsManualItems => IsPlaylist || !_rulesEnabled;
    private bool CanDeleteCollection => EditingCollection is not null
        && EditingCollection.CollectionType is "Custom" or "Playlist" or "Smart";
    private string CollectionTypeIcon => !string.IsNullOrWhiteSpace(_iconName)
        ? _iconName
        : _collectionType switch
        {
            "Smart" => Icons.Material.Outlined.AutoAwesomeMotion,
            "Playlist" => Icons.Material.Outlined.QueueMusic,
            _ => Icons.Material.Outlined.Collections,
        };

    private string TabClass(string tabId) =>
        string.Equals(tabId, _activeTab, StringComparison.OrdinalIgnoreCase)
        || (string.Equals(tabId, "artwork", StringComparison.OrdinalIgnoreCase)
            && _activeTab.StartsWith("artwork-", StringComparison.OrdinalIgnoreCase))
            ? "sme-section-nav__item is-active"
            : "sme-section-nav__item";
    private string DialogEyebrow => IsPlaylistDialog ? "Playlist editor" : "Collection editor";
    private string DialogTitle => EditingCollection is not null
        ? "Edit Collection"
        : IsSmartPlaylistLaunch
            ? "Smart Playlist"
            : IsPlaylistLaunch
                ? "New Playlist"
                : "New Collection";
    private string EditorIdentityTitle => string.IsNullOrWhiteSpace(_name) ? DialogTitle : _name;

    private string HeaderSubtitle =>
        IsSmartPlaylistLaunch
            ? "Choose artwork, name it, then add the rule that keeps it updated."
            : IsPlaylistLaunch
                ? "Choose artwork and name a playlist for this profile."
                : EditingCollection is null
                    ? "Create a saved collection using either live rules or manual membership."
                    : "Update the collection settings, rules, and saved items.";

    private string? FooterSummary =>
        IsPlaylistDialog
            ? null
            : SupportsManualItems
                ? $"{_manualItems.Count} item(s) staged for this collection."
                : _previewResult is null
                    ? "Add at least one complete rule to calculate membership."
                    : FormatMatchSummary(_previewResult);
    private string SaveButtonText => EditingCollection is not null
        ? "Save"
        : IsSmartPlaylistLaunch
            ? "Create Smart Playlist"
            : IsPlaylistLaunch
                ? "Create Playlist"
                : "Create Collection";

    private List<CollectionMediaLookupDto> FilteredLibraryItems =>
        _lookupItems
            .Where(work => !SelectedWorkIds.Contains(work.WorkId))
            .Take(12)
            .ToList();

    private HashSet<Guid> SelectedWorkIds => _manualItems.Select(item => item.WorkId).ToHashSet();

    protected override void OnInitialized()
    {
        if (EditingCollection is null)
        {
            _name = Request.InitialTitle ?? string.Empty;
            _collectionType = Request.InitialCollectionType ?? "Custom";
            _rulesEnabled = Request.InitialRulesEnabled ?? !IsPlaylist;
            _iconName = DefaultIconForCollectionType(_collectionType);
            return;
        }

        if (EditingCollection is null)
            return;

        _name = EditingCollection.Name;
        _description = EditingCollection.Description;
        _iconName = EditingCollection.IconName;
        _collectionType = EditingCollection.CollectionType;
        _sortField = EditingCollection.SortField ?? "title";
        _sortDirection = string.IsNullOrWhiteSpace(EditingCollection.SortDirection) ? "asc" : EditingCollection.SortDirection;
        _secondarySortField = EditingCollection.SecondarySortField;
        _secondarySortDirection = EditingCollection.SecondarySortDirection;
        _rulesEnabled = !string.Equals(EditingCollection.Resolution, "materialized", StringComparison.OrdinalIgnoreCase);

        if (string.IsNullOrWhiteSpace(EditingCollection.RuleJson))
            return;

        try
        {
            var parsed = JsonSerializer.Deserialize<CollectionRuleDefinitionDto>(
                EditingCollection.RuleJson,
                MediaEngineJson.CaseInsensitive);

            if (parsed is { Groups.Count: > 0 })
            {
                _ruleDefinition = new CollectionRuleDefinitionViewModel
                {
                    Version = parsed.Version,
                    Groups = parsed.Groups.Select(group => new CollectionRuleGroupViewModel
                    {
                        Id = group.Id,
                        JoinWithPrevious = group.JoinWithPrevious,
                        MatchMode = group.MatchMode,
                        Conditions = group.Conditions.Select(rule => new CollectionRulePredicateViewModel
                        {
                            Field = rule.Field, Op = rule.Op, Value = rule.Value,
                            DisplayValue = rule.DisplayValue, Values = rule.Values,
                            DisplayValues = rule.DisplayValues,
                        }).ToList(),
                    }).ToList(),
                };
                if (!string.Equals(EditingCollection.Resolution, "materialized", StringComparison.OrdinalIgnoreCase))
                    _rulesEnabled = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not parse collection rule JSON for {CollectionId}.", EditingCollection.Id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (SupportsManualItems && !IsPlaylistDialog)
            await LoadManualItemsAsync();
    }

    private Task OnTabChanged(int index)
    {
        if (index < 0 || index >= VisibleTabs.Length)
        {
            return Task.CompletedTask;
        }

        _activeTab = VisibleTabs[index].Id;
        _activeArtworkSlot = _activeTab switch
        {
            "artwork-background" => "background",
            "artwork-banner" => "banner",
            "artwork-logo" => "logo",
            "artwork" => "poster",
            _ => _activeArtworkSlot,
        };
        return Task.CompletedTask;
    }

    private Task SelectArtworkTab((string Id, string Slot, string Label, string Icon) artworkTab)
    {
        _activeTab = artworkTab.Id;
        _activeArtworkSlot = artworkTab.Slot;
        return Task.CompletedTask;
    }

    private void MarkDirty() => _hasUnsavedChanges = true;

    private Task OnNameChanged(string value)
    {
        _name = value;
        MarkDirty();
        return Task.CompletedTask;
    }

    private Task OnDescriptionChanged(string? value)
    {
        _description = value;
        MarkDirty();
        return Task.CompletedTask;
    }

    private void SetActiveTab(string tabId)
    {
        if (VisibleTabs.Any(tab => string.Equals(tab.Id, tabId, StringComparison.OrdinalIgnoreCase)))
            _activeTab = tabId;
    }

    private Task OnIconChanged(string value)
    {
        _iconName = value;
        MarkDirty();
        return Task.CompletedTask;
    }

    private async Task SetMembershipModeAsync(bool rulesEnabled)
    {
        if (_rulesEnabled == rulesEnabled)
            return;

        _rulesEnabled = rulesEnabled;
        _previewResult = null;
        MarkDirty();

        if (rulesEnabled)
        {
            if (_ruleDefinition.AllConditions.Any(IsCompleteRule))
                await RunPreview();
            return;
        }

        await LoadManualItemsAsync();
    }

    private async Task ConfirmNavigationWithUnsavedChanges(LocationChangingContext context)
    {
        if (_hasUnsavedChanges && !await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Leave without saving?"))
            context.PreventNavigation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _rulesEnabled && _ruleDefinition.AllConditions.Any(IsCompleteRule))
            await RunPreview();
    }

    private async Task Cancel()
    {
        if (_hasUnsavedChanges && !await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Leave without saving?"))
            return;

        _hasUnsavedChanges = false;
        await CloseEditorAsync(applied: false);
    }

    private async Task OpenItemPickerAsync()
    {
        _showItemPicker = true;
        await EnsureLibraryItemsLoadedAsync();
    }

    private void CloseItemPicker()
    {
        _showItemPicker = false;
        _itemSearchText = string.Empty;
    }

    private async Task EnsureLibraryItemsLoadedAsync()
    {
        if (_lookupItems.Count > 0 || _loadingLibraryItems)
            return;

        _loadingLibraryItems = true;
        StateHasChanged();

        try
        {
            await RefreshLookupItemsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load libraryItems: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingLibraryItems = false;
            StateHasChanged();
        }
    }

    private async Task RefreshLookupItemsAsync()
    {
        _lookupItems = await ApiClient.LookupCollectionMediaAsync(
            _itemSearchText,
            EditingCollection?.Id,
            offset: 0,
            limit: 24,
            profileId: Request.ActiveProfileId);
    }

    private async Task OnItemSearchChanged(string value)
    {
        _itemSearchText = value;
        _loadingLibraryItems = true;
        StateHasChanged();

        try
        {
            await RefreshLookupItemsAsync();
        }
        finally
        {
            _loadingLibraryItems = false;
            StateHasChanged();
        }
    }

    private async Task LoadManualItemsAsync()
    {
        _loadingManualItems = true;
        StateHasChanged();

        try
        {
            if (EditingCollection is null)
            {
                _manualItems = [];
                return;
            }

            var items = await ApiClient.GetCollectionItemsAsync(EditingCollection.Id, 200, Request.ActiveProfileId);
            _manualItems = items
                .OrderBy(item => item.SortOrder)
                .Select(item => new ManualCollectionItem
                {
                    Id = item.Id,
                    WorkId = item.WorkId,
                    Title = item.Title,
                    Creator = item.Creator,
                    MediaType = item.MediaType,
                    CoverUrl = item.CoverUrl,
                    SortOrder = item.SortOrder,
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load saved items: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingManualItems = false;
            StateHasChanged();
        }
    }

    private async Task OnArtworkSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        var slot = IsPlaylistDialog ? "poster" : _activeArtworkSlot;
        if (slot == "logo" && !string.Equals(Path.GetExtension(file.Name), ".png", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Collection logos must be transparent PNG files.", Severity.Warning);
            return;
        }
        _artworkFiles[slot] = file;
        _removedArtworkSlots.Remove(slot);
        MarkDirty();

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _artworkPreviewUrls[slot] = $"data:{file.ContentType ?? "image/jpeg"};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch
        {
            _artworkFiles.Remove(slot);
            _artworkPreviewUrls.Remove(slot);
            Snackbar.Add("Artwork preview could not be loaded.", Severity.Warning);
        }
    }

    private Task OnRuleDefinitionChanged(CollectionRuleDefinitionViewModel definition)
    {
        _ruleDefinition = definition;
        return Task.CompletedTask;
    }

    private Task OnRuleBuilderPreviewChanged(CollectionPreviewResult? preview)
    {
        _previewResult = preview;
        return Task.CompletedTask;
    }

    private Task OnRuleBuilderChanged()
    {
        MarkDirty();
        return Task.CompletedTask;
    }

    private async Task AddManualItemAsync(CollectionMediaLookupDto work)
    {
        if (SelectedWorkIds.Contains(work.WorkId))
            return;

        if (EditingCollection is not null)
        {
            var ok = await ApiClient.AddCollectionItemAsync(EditingCollection.Id, work.WorkId, Request.ActiveProfileId);
            if (!ok)
            {
                Snackbar.Add("Failed to add the item to this collection.", Severity.Error);
                return;
            }

            await LoadManualItemsAsync();
            await RefreshLookupItemsAsync();
            return;
        }

        _manualItems.Add(new ManualCollectionItem
        {
            Id = Guid.Empty,
            WorkId = work.WorkId,
            Title = work.Title,
            Creator = work.Creator,
            MediaType = work.MediaType,
            CoverUrl = work.ArtworkUrl,
            SortOrder = _manualItems.Count == 0 ? 1 : _manualItems.Max(item => item.SortOrder) + 1,
        });
        MarkDirty();

        StateHasChanged();
    }

    private async Task RemoveManualItemAsync(ManualCollectionItem item)
    {
        if (EditingCollection is not null)
        {
            var ok = await ApiClient.RemoveCollectionItemAsync(EditingCollection.Id, item.Id, Request.ActiveProfileId);
            if (!ok)
            {
                Snackbar.Add("Failed to remove the item from this collection.", Severity.Error);
                return;
            }

            await LoadManualItemsAsync();
            await RefreshLookupItemsAsync();
            return;
        }

        _manualItems.RemoveAll(existing => existing.WorkId == item.WorkId);
        MarkDirty();
        StateHasChanged();
    }

    private async Task MoveManualItemAsync(ManualCollectionItem item, int direction)
    {
        var ordered = _manualItems.OrderBy(existing => existing.SortOrder).ToList();
        var index = ordered.FindIndex(existing => existing.Id == item.Id && existing.WorkId == item.WorkId);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= ordered.Count)
            return;

        (ordered[index], ordered[targetIndex]) = (ordered[targetIndex], ordered[index]);

        _manualItems = ordered
            .Select((existing, order) => existing with { SortOrder = order + 1 })
            .ToList();

        if (EditingCollection is not null)
        {
            var itemIds = _manualItems
                .OrderBy(existing => existing.SortOrder)
                .Select(existing => existing.Id)
                .Where(id => id != Guid.Empty)
                .ToList();
            var ok = await ApiClient.ReorderCollectionItemsAsync(EditingCollection.Id, itemIds, Request.ActiveProfileId);
            if (!ok)
            {
                Snackbar.Add("Failed to reorder the collection.", Severity.Error);
                await LoadManualItemsAsync();
                return;
            }
        }
        else
        {
            MarkDirty();
        }

        StateHasChanged();
    }

    private async Task RunPreview()
    {
        if (!_rulesEnabled)
        {
            _previewResult = null;
            return;
        }

        var validRules = _ruleDefinition.AllConditions.Where(IsCompleteRule).ToList();

        if (validRules.Count == 0)
        {
            _previewResult = null;
            StateHasChanged();
            return;
        }

        _previewResult = await ApiClient.PreviewCollectionRulesAsync(
            _ruleDefinition,
            _sortField,
            _sortDirection,
            limit: 24,
            secondarySortField: _secondarySortField,
            secondarySortDirection: _secondarySortDirection);
        StateHasChanged();
    }

    private async Task SaveCollection()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Please enter a name for the collection.", Severity.Warning);
            _activeTab = "details";
            return;
        }

        if (string.Equals(PersistenceVisibility, "private", StringComparison.OrdinalIgnoreCase) && !Request.ActiveProfileId.HasValue)
        {
            Snackbar.Add("An active profile is required to save a private collection.", Severity.Warning);
            _activeTab = "details";
            return;
        }

        if (_rulesEnabled && !_ruleDefinition.AllConditions.Any(IsCompleteRule))
        {
            Snackbar.Add("Add at least one complete rule before saving a dynamic collection.", Severity.Warning);
            _activeTab = "rules";
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            var definition = _rulesEnabled ? BuildPersistableDefinition() : new CollectionRuleDefinitionViewModel();

            var normalizedSortField = string.IsNullOrWhiteSpace(_sortField) ? null : _sortField;
            Guid? savedCollectionId = EditingCollection?.Id;
            var ok = false;

            if (EditingCollection is not null)
            {
                ok = await ApiClient.UpdateCollectionAsync(
                    EditingCollection.Id,
                    _name,
                    _description,
                    _iconName,
                    definition,
                    PersistenceVisibility,
                    normalizedSortField,
                    _sortDirection,
                    true,
                    null,
                    Request.ActiveProfileId,
                    secondarySortField: _secondarySortField,
                    secondarySortDirection: _secondarySortDirection);
            }
            else
            {
                savedCollectionId = await ApiClient.CreateCollectionAndReturnIdAsync(
                    _name,
                    _description,
                    _iconName,
                    _collectionType,
                    definition,
                    normalizedSortField,
                    _sortDirection,
                    PersistenceVisibility,
                    Request.ActiveProfileId,
                    secondarySortField: _secondarySortField,
                    secondarySortDirection: _secondarySortDirection);
                ok = savedCollectionId.HasValue;
            }

            if (!ok)
            {
                Snackbar.Add(
                    string.IsNullOrWhiteSpace(ApiClient.LastError)
                        ? "Failed to save collection."
                        : ApiClient.LastError,
                    Severity.Error);
                return;
            }

            if (savedCollectionId.HasValue)
            {
                foreach (var (slot, file) in _artworkFiles)
                {
                    await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    if (!await ApiClient.UploadCollectionArtworkAsync(savedCollectionId.Value, slot, stream, file.Name, Request.ActiveProfileId))
                        Snackbar.Add($"Collection saved, but {slot} artwork could not be uploaded.", Severity.Warning);
                }
            }

            if (EditingCollection is null && SupportsManualItems && _manualItems.Count > 0)
                await AttachStagedManualItemsAsync();

            Snackbar.Add(
                EditingCollection is not null
                    ? $"Collection \"{_name}\" updated."
                    : $"Collection \"{_name}\" created.",
                Severity.Success);

            _hasUnsavedChanges = false;
            await CloseEditorAsync(applied: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save collection: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task CloseEditorAsync(bool applied)
    {
        if (Inline)
        {
            await Closed.InvokeAsync(applied);
            return;
        }

        if (applied)
            MudDialog?.Close(DialogResult.Ok(true));
        else
            MudDialog?.Cancel();
    }

    private async Task AttachStagedManualItemsAsync()
    {
        var collections = await ApiClient.GetManagedCollectionsAsync(Request.ActiveProfileId);
        var createdCollection = collections
            .Where(collection => string.Equals(collection.Name, _name, StringComparison.OrdinalIgnoreCase))
            .Where(collection => string.Equals(collection.CollectionType, _collectionType, StringComparison.OrdinalIgnoreCase))
            .Where(collection => string.Equals(collection.Visibility, PersistenceVisibility, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(collection => collection.CreatedAt)
            .FirstOrDefault();

        if (createdCollection is null)
        {
            Snackbar.Add("The collection was created, but staged items will need to be added after reopening it.", Severity.Info);
            return;
        }

        var failures = 0;
        foreach (var item in _manualItems)
        {
            if (!await ApiClient.AddCollectionItemAsync(createdCollection.Id, item.WorkId, Request.ActiveProfileId))
                failures++;
        }

        if (failures > 0)
            Snackbar.Add($"{failures} item(s) could not be added automatically. Reopen the collection to finish curation.", Severity.Warning);
    }

    private static string FormatWorkMeta(CollectionMediaLookupDto work)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(work.ParentContext))
            parts.Add(work.ParentContext);
        if (!string.IsNullOrWhiteSpace(work.Creator))
            parts.Add(work.Creator);
        if (!string.IsNullOrWhiteSpace(work.MediaType))
            parts.Add(work.MediaType);
        if (!string.IsNullOrWhiteSpace(work.Year))
            parts.Add(work.Year);
        return parts.Count == 0 ? "Library item" : string.Join("  -  ", parts);
    }

    private static string FormatManualItemMeta(ManualCollectionItem item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.Creator))
            parts.Add(item.Creator);
        if (!string.IsNullOrWhiteSpace(item.MediaType))
            parts.Add(item.MediaType);
        return parts.Count == 0 ? "Saved item" : string.Join("  -  ", parts);
    }

    private static string FormatPreviewMeta(CollectionResolvedItemViewModel item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.Creator))
            parts.Add(item.Creator);
        if (!string.IsNullOrWhiteSpace(item.Year))
            parts.Add(item.Year);
        return parts.Count == 0 ? "Matching item" : string.Join("  -  ", parts);
    }

    private static string FormatMatchSummary(CollectionPreviewResult preview)
    {
        if (preview.Count == 0)
            return "No items match these rules.";

        var normalized = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var (mediaType, count) in preview.MediaTypeCounts)
        {
            var key = NormalizeMediaType(mediaType);
            normalized[key] = normalized.GetValueOrDefault(key) + count;
        }

        var ordered = new[] { "movie", "TV show", "book", "comic", "music item", "audiobook", "item" };
        var parts = ordered
            .Where(normalized.ContainsKey)
            .Select(key => FormatMediaCount(key, normalized[key]))
            .ToList();

        return parts.Count == 0
            ? $"{preview.Count} {(preview.Count == 1 ? "item" : "items")} matched"
            : $"{string.Join(" · ", parts)} matched";
    }

    private static string NormalizeMediaType(string? mediaType) => mediaType?.Trim().ToLowerInvariant() switch
    {
        "movie" or "movies" or "film" or "films" => "movie",
        "tv" or "television" or "tv show" or "tv shows" or "series" => "TV show",
        "book" or "books" => "book",
        "comic" or "comics" => "comic",
        "music" or "album" or "albums" => "music item",
        "audiobook" or "audiobooks" => "audiobook",
        _ => "item",
    };

    private static string FormatMediaCount(string label, int count) =>
        $"{count} {label}{(count == 1 ? string.Empty : "s")}";

    private static string? ContentThumbnailUrl(string? coverUrl) =>
        MediaTileArtworkUrl.Sized(coverUrl, "s") ?? coverUrl;

    private static bool IsValueFreeOperator(string op) =>
        op is "known" or "unknown" or "has_any_value" or "has_no_known_value";

    private static bool IsCompleteRule(CollectionRulePredicateViewModel rule) =>
        !string.IsNullOrWhiteSpace(rule.Field)
        && (IsValueFreeOperator(rule.Op) || !string.IsNullOrWhiteSpace(rule.Value) || rule.Values?.Length > 0);

    private string? SelectedArtworkPreviewUrl => _artworkPreviewUrls.GetValueOrDefault(_activeArtworkSlot);
    private string? CurrentArtworkUrl => _removedArtworkSlots.Contains(_activeArtworkSlot) ? null : _activeArtworkSlot switch
    {
        "background" => EditingCollection?.BackgroundUrl,
        "banner" => EditingCollection?.BannerUrl,
        "logo" => EditingCollection?.LogoUrl,
        _ => EditingCollection?.CoverUrl,
    };
    private string ArtworkSlotTitle => _activeArtworkSlot switch { "background" => "Background", "banner" => "Banner", "logo" => "Logo", _ => "Poster / Cover" };
    private string ArtworkSlotDescription => _activeArtworkSlot switch
    {
        "background" => "Optional custom landscape artwork behind the collection detail presentation.",
        "banner" => "Optional wide collection artwork for compact headers and banner placements.",
        "logo" => "Optional transparent collection branding shown without a boxed background.",
        _ => "Automatic representative artwork or an optional custom portrait image.",
    };
    private string ArtworkUploadDescription => _activeArtworkSlot switch { "background" => "Upload a cinematic landscape image.", "banner" => "Upload a wide banner image.", "logo" => "Upload transparent collection branding.", _ => "Upload a custom portrait image or keep the automatic stack." };
    private string ArtworkFileRequirements => _activeArtworkSlot == "logo" ? "Transparent PNG, up to 5 MB" : "JPG or PNG, up to 5 MB";
    private string ArtworkAccept => _activeArtworkSlot == "logo" ? ".png" : ".jpg,.jpeg,.png";
    private string ArtworkGuidance => _activeArtworkSlot switch
    {
        "background" => "Use high-contrast 16:9 artwork near 1920 × 1080. Keep important subjects away from text areas.",
        "banner" => "Use a wide image near 1920 × 480. Keep important subjects and text within the center safe area.",
        "logo" => "Use a wide transparent canvas near 1600 × 600 with generous clear padding. Do not bake in a background.",
        _ => "Automatic stacked is the default and updates with membership. Custom posters work best at a 2:3 ratio near 1000 × 1500.",
    };
    private string ArtworkEmptyTitle => _activeArtworkSlot switch { "background" => "Neutral collection background", "banner" => "No custom banner", "logo" => "No custom logo", _ => "Automatic stacked artwork" };
    private string ArtworkEmptyDescription => _activeArtworkSlot switch { "background" => "The standard Tuvima collection wash will be used until a custom background is uploaded.", "banner" => "The collection will use its normal compact header treatment until a banner is uploaded.", "logo" => "The collection name remains the visual identity until a transparent logo is uploaded.", _ => "Representative item art appears as members become available." };
    private string ArtworkSlotIcon => _activeArtworkSlot switch { "background" => Icons.Material.Outlined.Panorama, "banner" => Icons.Material.Outlined.ViewDay, "logo" => Icons.Material.Outlined.BrandingWatermark, _ => Icons.Material.Outlined.AutoAwesomeMotion };
    private IReadOnlyList<ArtworkStackItem> AutomaticArtworkItems => (SupportsManualItems
            ? _manualItems.Select(item => (item.WorkId, item.Title, item.CoverUrl, item.MediaType))
            : (_previewResult?.Items ?? []).Select(item => (item.EntityId, item.Title, item.CoverUrl, item.MediaType)))
        .Where(item => !string.IsNullOrWhiteSpace(item.Item3))
        .Take(4)
        .Select(item => new ArtworkStackItem
        {
            Id = item.Item1.ToString("N"), WorkId = item.Item1, Title = item.Item2,
            ImageUrl = item.Item3!, MediaType = item.Item4,
            Shape = item.Item4.Equals("Music", StringComparison.OrdinalIgnoreCase) ? ArtworkShape.Square : ArtworkShape.Portrait,
        }).ToList();

    private async Task RemoveArtworkAsync()
    {
        if (EditingCollection is null)
            return;
        if (!await ApiClient.DeleteCollectionArtworkAsync(EditingCollection.Id, _activeArtworkSlot, Request.ActiveProfileId))
        {
            Snackbar.Add("Artwork could not be removed.", Severity.Error);
            return;
        }
        _artworkFiles.Remove(_activeArtworkSlot);
        _artworkPreviewUrls.Remove(_activeArtworkSlot);
        _removedArtworkSlots.Add(_activeArtworkSlot);
        Snackbar.Add(_activeArtworkSlot == "poster" ? "Automatic stacked artwork restored." : $"{ArtworkSlotTitle} removed.", Severity.Success);
    }

    private CollectionRuleDefinitionViewModel BuildPersistableDefinition() => new()
    {
        Version = _ruleDefinition.Version,
        Groups = _ruleDefinition.Groups
            .Select(group => new CollectionRuleGroupViewModel
            {
                Id = group.Id,
                JoinWithPrevious = group.JoinWithPrevious,
                MatchMode = group.MatchMode,
                Conditions = group.Conditions.Where(IsCompleteRule).ToList(),
            })
            .Where(group => group.Conditions.Count > 0)
            .ToList(),
    };

    private async Task DeleteCollectionAsync()
    {
        if (!CanDeleteCollection || EditingCollection is null)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete collection '{EditingCollection.Name}'? The media in it will remain in your library.");
        if (!confirmed)
            return;

        _saving = true;
        try
        {
            if (!await ApiClient.DeleteCollectionAsync(EditingCollection.Id, Request.ActiveProfileId))
            {
                Snackbar.Add("The collection could not be deleted.", Severity.Error);
                return;
            }

            _hasUnsavedChanges = false;
            Snackbar.Add($"Collection \"{EditingCollection.Name}\" deleted.", Severity.Success);
            await CloseEditorAsync(applied: true);
        }
        finally
        {
            _saving = false;
        }
    }

