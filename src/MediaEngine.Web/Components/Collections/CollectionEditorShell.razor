    private static bool IsEntityRuleField(string field) =>
        RuleFields.FirstOrDefault(definition => definition.Key.Equals(field, StringComparison.OrdinalIgnoreCase))?.Entity == true;

    private static bool IsBooleanRuleField(string field) =>
        field is "is_adaptation" or "source_work_owned" or "adaptation_owned";

    private static bool SupportsUnknownRuleField(string field) => field is
        "award_received" or "award_nominated" or "award_family" or "nomination_family"
        or "country_of_origin" or "language" or "original_language"
        or "production_company" or "publisher" or "record_label" or "network"
        or "narrative_location" or "set_in_period" or "main_subject" or "based_on" or "filming_location";

    private static bool IsValueFreeOperator(string op) =>
        op is "known" or "unknown" or "has_any_value" or "has_no_known_value";

    private static bool IsCompleteRule(CollectionRulePredicateViewModel rule) =>
        !string.IsNullOrWhiteSpace(rule.Field)
        && (IsValueFreeOperator(rule.Op) || !string.IsNullOrWhiteSpace(rule.Value));

    private sealed record ManualCollectionItem
    {
        public Guid Id { get; init; }
        public Guid WorkId { get; init; }
        public string Title { get; init; } = string.Empty;
        public string? Creator { get; init; }
        public string MediaType { get; init; } = string.Empty;
        public string? CoverUrl { get; init; }
        public int SortOrder { get; init; }
    }

    private static List<OpDef> GetOperatorsForField(string field) => field switch
    {
        "is_adaptation" or "source_work_owned" or "adaptation_owned" => [new("eq", "is")],
        "media_type" => [new("eq", "is"), new("neq", "is not")],
        "year" or "provider_rating" or "added_within_days" =>
            [new("eq", "is"), new("gt", "greater than"), new("lt", "less than"), new("between", "between"), new("gte", "at least"), new("lte", "at most")],
        "decade" => [new("eq", "is")],
        _ when IsEntityRuleField(field) && SupportsUnknownRuleField(field) =>
            [new("eq", "is"), new("neq", "is not"), new("known", "is known"), new("unknown", "is unknown"), new("has_any_value", "has any value")],
        _ when IsEntityRuleField(field) =>
            [new("eq", "is"), new("neq", "is not"), new("known", "is known"), new("has_any_value", "has any value")],
        _ => [new("eq", "is"), new("neq", "is not"), new("contains", "contains"), new("known", "is known")],
    };

    private static int GetSelectedIndex(IEnumerable<string> keys, string activeKey)
    {
        var index = 0;
        foreach (var key in keys)
        {
            if (string.Equals(key, activeKey, StringComparison.OrdinalIgnoreCase))
            {
                return index;
            }

            index++;
        }

        return 0;
    }

    private static string DefaultIconForCollectionType(string collectionType) => collectionType switch
    {
        "Smart" => Icons.Material.Outlined.AutoAwesomeMotion,
        "Playlist" => Icons.Material.Outlined.QueueMusic,
        "Mix" => Icons.Material.Outlined.GraphicEq,
        "System" => Icons.Material.Outlined.SettingsSuggest,
        _ => Icons.Material.Outlined.Collections,
    };

    private RenderFragment RenderDetailsTab() => @<div class="collection-editor-pane">
        <section class="collection-editor-section">
            @if (IsPlaylistDialog)
            {
                <label class="app-artwork-picker collection-editor-artwork-picker">
                    @if (!string.IsNullOrWhiteSpace(_artworkPreviewUrl))
                    {
                        <img src="@_artworkPreviewUrl" alt="Selected playlist artwork" />
                    }
                    else if (!string.IsNullOrWhiteSpace(EditingCollection?.CoverUrl))
                    {
                        <img src="@EditingCollection.CoverUrl" alt="Current playlist artwork" />
                    }
                    else
                    {
                        <span class="app-artwork-picker__placeholder">
                            <MudIcon Icon="@CollectionTypeIcon" Class="tl-u-font-size-28px" />
                        </span>
                    }
                    <span class="app-artwork-picker__edit" title="Edit artwork">
                        <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" Class="tl-u-font-size-18px" />
                    </span>
                    <InputFile class="app-artwork-picker__input" OnChange="OnArtworkSelected" accept=".jpg,.jpeg,.png" />
                </label>
            }

            <AppTextField T="string"
                          Value="_name"
                          ValueChanged="OnNameChanged"
                          Placeholder="Playlist Title"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Class="collection-editor-field app-dialog-field" />

            <AppTextarea Value="_description"
                         ValueChanged="OnDescriptionChanged"
                         Placeholder="Description (Optional)"
                         Lines="3"
                         Immediate="true"
                         Class="collection-editor-field app-dialog-field app-dialog-textarea" />

            @if (!IsPlaylistDialog)
            {
                <div class="collection-editor-grid">
                <AppSelect T="string"
                           Value="_collectionType"
                           ValueChanged="OnCollectionTypeChanged"
                           Label="Collection type"
                           Variant="Variant.Outlined"
                           Disabled="@(EditingCollection is not null)"
                           Class="collection-editor-field app-dialog-field app-dialog-select">
                    <MudSelectItem T="string" Value="@("Custom")">Curated Collection</MudSelectItem>
                </AppSelect>

                <AppTextField T="string"
                              @bind-Value="_iconName"
                              Label="Icon"
                              Placeholder="Optional MudBlazor icon"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Class="collection-editor-field app-dialog-field" />
                </div>
            }

            @if (!IsPlaylistDialog)
            {
                <div class="collection-editor-note">
                    @if (IsPlaylist)
                    {
                        <span>Playlists are manual collections. Rules are turned off and membership is curated directly.</span>
                    }
                    else if (SupportsManualItems)
                    {
                        <span>This collection is in manual mode right now. Use the Items tab to curate membership directly.</span>
                    }
                    else
                    {
                        <span>This collection stays live and updates from matching rules.</span>
                    }
                </div>
            }
        </section>

        @if (!IsPlaylistDialog)
        {
            <section class="collection-editor-section">
                <div class="collection-editor-section-title">Publication</div>
                <div class="collection-editor-note">
                    <span>Curated collections are published to every profile. Only administrators can create or change them.</span>
                </div>
            </section>
        }

        @if (IsSmartPlaylistLaunch)
        {
            @RenderRulesSection()
        }
    </div>;

    private RenderFragment RenderRulesTab() => @<div class="collection-editor-pane">
        @RenderRulesSection()
    </div>;

    private RenderFragment RenderRulesSection() => @<section class="collection-editor-section">
        <AppCheckbox
                     Value="_rulesEnabled"
                     ValueChanged="OnRulesEnabledChanged"
                     Color="Color.Primary"
                     Dense="true"
                     Disabled="@IsPlaylist"
                     Label="Match for the following rule:" />

        @if (_rulesEnabled)
        {
            <div class="collection-editor-rules">
                @for (var i = 0; i < _rules.Count; i++)
                {
                    var idx = i;
                    var rule = _rules[idx];

                    <div class="collection-editor-rule-row">
                        <AppSelect T="string"
                                   Value="rule.Field"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Class="app-dialog-field app-dialog-select"
                                   ValueChanged="@(value => OnRuleFieldChanged(rule, value))">
                            @foreach (var category in RuleFields.GroupBy(field => field.Category))
                            {
                                <MudSelectItem T="string" Value="@($"__{category.Key}")" Disabled="true">@category.Key</MudSelectItem>
                                @foreach (var field in category)
                                {
                                    <MudSelectItem T="string" Value="@field.Key">@field.Label</MudSelectItem>
                                }
                            }
                        </AppSelect>

                        <AppSelect T="string"
                                   Value="rule.Op"
                                   ValueChanged="@(value => OnRuleOperatorChanged(rule, value))"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Class="app-dialog-field app-dialog-select">
                            @foreach (var op in GetOperatorsForField(rule.Field))
                            {
                                <MudSelectItem T="string" Value="@op.Key">@op.Label</MudSelectItem>
                            }
                        </AppSelect>

                        @if (!IsValueFreeOperator(rule.Op))
                        {
                            if (IsBooleanRuleField(rule.Field))
                            {
                                <AppSelect T="string"
                                           Value="rule.Value"
                                           ValueChanged="@(value => OnRuleValueChanged(rule, value))"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Class="collection-editor-rule-input app-dialog-field app-dialog-select">
                                    <MudSelectItem T="string" Value="@("true")">Yes</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("false")">No</MudSelectItem>
                                </AppSelect>
                            }
                            else if (IsEntityRuleField(rule.Field))
                            {
                                <AppSelect T="string"
                                           Value="rule.Value"
                                           ValueChanged="@(value => OnRuleValueChanged(rule, value))"
                                           Placeholder="Choose a value from this library"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Class="collection-editor-rule-input app-dialog-field app-dialog-select">
                                    @foreach (var option in GetEntityRuleValues(rule.Field))
                                    {
                                        <MudSelectItem T="string" Value="@option.Value">@option.Label (@option.LocalCount)</MudSelectItem>
                                    }
                                </AppSelect>
                            }
                            else
                            {
                                <AppTextField T="string"
                                              Value="rule.Value"
                                              ValueChanged="@(value => OnRuleValueChanged(rule, value))"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              DebounceInterval="350"
                                              Class="collection-editor-rule-input app-dialog-field" />
                            }
                        }
                        else
                        {
                            <span class="collection-editor-rule-input">No value needed</span>
                        }

                        <AppIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => AddRule(idx))" aria-label="Add rule" />
                        <AppIconButton Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Disabled="@(_rules.Count == 1)" OnClick="@(() => RemoveRule(idx))" aria-label="Remove rule" />
                    </div>
                }
            </div>

            <div class="collection-editor-rule-extras">
                <AppCheckbox @bind-Value="_liveUpdating" Color="Color.Primary" Dense="true" Label="Live updating" />
            </div>
        }
    </section>;

    private RenderFragment RenderItemsTab() => @<div class="collection-editor-pane">
        <section class="collection-editor-section">
            <div class="collection-editor-section-title">Items</div>

            @if (SupportsManualItems)
            {
                @if (_loadingLibraryItems || _loadingManualItems)
                {
                    <div class="collection-editor-empty">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        <span>Loading collection items...</span>
                    </div>
                }
                else
                {
                    <AppTextField T="string"
                                  Value="_itemSearchText"
                                  ValueChanged="OnItemSearchChanged"
                                  Label="Add items"
                                  Placeholder="Search title, creator, or media type"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Class="collection-editor-field" />

                    <div class="collection-editor-item-grid">
                        <div class="collection-editor-item-column">
                            <div class="collection-editor-column-title">Available</div>
                            @if (FilteredLibraryItems.Count == 0)
                            {
                                <div class="collection-editor-empty collection-editor-empty--compact">
                                    <span>No matching items are available to add.</span>
                                </div>
                            }
                            else
                            {
                                <div class="collection-editor-item-list">
                                    @foreach (var work in FilteredLibraryItems)
                                    {
                                        <div class="collection-editor-item-row">
                                            <div class="collection-editor-item-copy">
                                                <div class="collection-editor-item-title">@work.Title</div>
                                                <div class="collection-editor-item-meta">@FormatWorkMeta(work)</div>
                                            </div>
                                            <AppIconButton Icon="@Icons.Material.Outlined.AddCircle" Size="Size.Small" OnClick="@(() => AddManualItemAsync(work))" aria-label="Add item" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="collection-editor-item-column">
                            <div class="collection-editor-column-title">Saved</div>
                            @if (_manualItems.Count == 0)
                            {
                                <div class="collection-editor-empty collection-editor-empty--compact">
                                    <span>@(EditingCollection is null
                                        ? "Add items now and they will be attached after the collection is created."
                                        : "This collection does not have any saved items yet.")</span>
                                </div>
                            }
                            else
                            {
                                <div class="collection-editor-item-list">
                                    @foreach (var item in _manualItems.OrderBy(item => item.SortOrder))
                                    {
                                        <div class="collection-editor-item-row">
                                            <div class="collection-editor-item-copy">
                                                <div class="collection-editor-item-title">@item.Title</div>
                                                <div class="collection-editor-item-meta">@FormatManualItemMeta(item)</div>
                                            </div>
                                            <AppIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp" Size="Size.Small" Disabled="@(item.SortOrder == _manualItems.Min(existing => existing.SortOrder))" OnClick="@(() => MoveManualItemAsync(item, -1))" aria-label="Move item up" />
                                            <AppIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" Size="Size.Small" Disabled="@(item.SortOrder == _manualItems.Max(existing => existing.SortOrder))" OnClick="@(() => MoveManualItemAsync(item, 1))" aria-label="Move item down" />
                                            <AppIconButton Icon="@Icons.Material.Outlined.RemoveCircle" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveManualItemAsync(item))" aria-label="Remove item" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="collection-editor-actions-row">
                    <div class="collection-editor-note collection-editor-note--tight">
                        <span>The preview below shows what currently matches these rules.</span>
                    </div>
                    <AppButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RunPreview">Refresh preview</AppButton>
                </div>

                @if (_previewResult is null)
                {
                    <div class="collection-editor-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.Visibility" Class="tl-u-font-size-24px tl-u-opacity-0-18" />
                        <span>Add at least one rule value to preview matching media.</span>
                    </div>
                }
                else
                {
                    <div class="collection-editor-preview">
                        <div class="collection-editor-preview-header">
                            <span>@_previewResult.Count item(s) match right now</span>
                        </div>

                        @foreach (var item in _previewResult.Items)
                        {
                            <div class="collection-editor-preview-item">
                                <div class="collection-editor-preview-copy">
                                    <div class="collection-editor-item-title">@item.Title</div>
                                    <div class="collection-editor-item-meta">@FormatPreviewMeta(item)</div>
                                </div>
                                <span class="collection-editor-preview-type">@item.MediaType</span>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    </div>;

    private RenderFragment RenderOptionsTab() => @<div class="collection-editor-pane">
        @RenderOptionsSection()
    </div>;

    private RenderFragment RenderOptionsSection() => @<section class="collection-editor-section">
        <div class="collection-editor-section-title">Options</div>

        <div class="collection-editor-grid">
            <AppSelect T="string" @bind-Value="_sortField" Label="Sort field" Variant="Variant.Outlined" Class="collection-editor-field">
                <MudSelectItem T="string" Value="@string.Empty">Library default</MudSelectItem>
                <MudSelectItem T="string" Value="@("title")">Title</MudSelectItem>
                <MudSelectItem T="string" Value="@("creator")">Creator</MudSelectItem>
                <MudSelectItem T="string" Value="@("year")">Year</MudSelectItem>
                <MudSelectItem T="string" Value="@("added_at")">Date Added</MudSelectItem>
            </AppSelect>

            <AppSelect T="string" @bind-Value="_sortDirection" Label="Sort direction" Variant="Variant.Outlined" Class="collection-editor-field">
                <MudSelectItem T="string" Value="@("asc")">Ascending</MudSelectItem>
                <MudSelectItem T="string" Value="@("desc")">Descending</MudSelectItem>
            </AppSelect>
        </div>

        @if (!SupportsManualItems)
        {
            <AppCheckbox @bind-Value="_liveUpdating" Color="Color.Error" Dense="true" Label="Live updating" />
            <div class="collection-editor-note collection-editor-note--tight">
                <span>When enabled, this collection re-evaluates itself as the library changes.</span>
            </div>
        }
        else
        {
            <div class="collection-editor-note collection-editor-note--tight">
                <span>Manual collections keep the items you save. Sort settings act as defaults when the collection is displayed elsewhere.</span>
            </div>
        }

        @if (EditingCollection is not null)
        {
            <div class="collection-editor-toggle-grid">
                <AppCheckbox @bind-Value="_isEnabled" Color="Color.Primary" Dense="true" Label="Enabled" />
                <AppCheckbox @bind-Value="_isFeatured" Color="Color.Primary" Dense="true" Label="Featured" />
            </div>
        }
    </section>;

}
