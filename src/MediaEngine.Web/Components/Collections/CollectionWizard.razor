@namespace MediaEngine.Web.Components.Collections
@using MediaEngine.Contracts.Collections
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Services.Editing
@using MediaEngine.Web.Components.MediaEditor
@implements IDisposable

@inject IEngineApiClient ApiClient
@inject ISnackbar Snackbar

<NavigationLock ConfirmExternalNavigation="@_dirty" />

<MediaEditorSurface>
    <div class="collection-setup-workspace">
        <header class="collection-setup-header">
            <div class="collection-setup-header__icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
            </div>
            <div class="collection-setup-header__copy">
                <div class="collection-setup-header__kicker">Guided setup</div>
                <h2>@DialogTitle</h2>
                <p>Set the essentials and membership rules now, then refine artwork and contents in the same full editor.</p>
            </div>
            <AppIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           Color="Color.Inherit"
                           Tooltip="Close setup"
                           AriaLabel="Close setup"
                           OnClick="Cancel" />
        </header>

        <div class="collection-wizard">
            <div class="collection-wizard__mobile-progress">
                Step @VisibleStepOrdinal(_step) of @VisibleSteps.Count <span aria-hidden="true">·</span> <strong>@StepLabel(_step)</strong>
            </div>

            <nav class="@StepperClass" aria-label="Collection creation progress">
                @for (var index = 0; index < VisibleSteps.Count; index++)
                {
                    var step = VisibleSteps[index];
                    @RenderStepperStep(step, index + 1)
                    @if (index < VisibleSteps.Count - 1)
                    {
                        <span class="collection-wizard__step-line" aria-hidden="true"></span>
                    }
                }
            </nav>

            <main class="collection-wizard__content">
                @switch (_step)
                {
                    case 1:
                        @RenderDetailsStep()
                        break;
                    case 2:
                        @RenderContentsStep()
                        break;
                    default:
                        @RenderReviewStep()
                        break;
                }
            </main>
            <footer class="collection-wizard__footer">
            <AppButton Variant="Variant.Outlined"
                       Color="Color.Inherit"
                       StartIcon="@(_step == FirstStep ? null : Icons.Material.Outlined.ArrowBack)"
                       OnClick="BackOrCancel"
                       Disabled="@_saving">
                @(_step == FirstStep ? "Cancel" : "Back")
            </AppButton>
            <AppButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="collection-wizard__primary"
                       EndIcon="@(_step == 3 ? null : Icons.Material.Outlined.ArrowForward)"
                       OnClick="ContinueOrSave"
                       Disabled="@(_saving || !CanContinue)">
                @if (_saving)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                @(_step == 3 ? FinalActionLabel : "Continue")
            </AppButton>
            </footer>
        </div>
    </div>
</MediaEditorSurface>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public CollectionEditorLaunchRequest Request { get; set; } = new();

    private int _step = 1;
    private int _furthestStep = 1;
    private CollectionEditorMode _mode;
    private string _name = string.Empty;
    private string? _description;
    private bool _dynamic;
    private string _sortField = "title";
    private string _sortDirection = "asc";
    private string? _secondarySortField;
    private string? _secondarySortDirection;
    private string _manualCategory = "all";
    private string _manualSearch = string.Empty;
    private bool _dirty;
    private bool _saving;
    private bool _manualLoading;
    private string? _manualError;
    private readonly List<CollectionMediaLookupDto> _manualItems = [];
    private readonly Dictionary<Guid, CollectionMediaLookupDto> _selectedManualItems = [];
    private CancellationTokenSource? _manualLookupCts;
    private CollectionRuleDefinitionViewModel _ruleDefinition = new()
    {
        Groups = [new CollectionRuleGroupViewModel { Conditions = [new CollectionRulePredicateViewModel()] }],
    };
    private CollectionPreviewResult? _preview;

    private bool IsPlaylist => _mode is CollectionEditorMode.ManualPlaylist or CollectionEditorMode.SmartPlaylist;
    private string DialogTitle => IsPlaylist ? "Create Playlist" : "Create Collection";
    private string FinalActionLabel => IsPlaylist ? "Create Playlist" : "Create Collection";
    private string CollectionType => IsPlaylist ? (_dynamic ? "Smart" : "Playlist") : "Custom";
    private IReadOnlyList<int> VisibleSteps => [1, 2, 3];
    private int FirstStep => VisibleSteps[0];
    private string StepperClass => "collection-wizard__stepper is-three-step";
    private bool CanContinue => _step switch
    {
        1 => !string.IsNullOrWhiteSpace(_name),
        2 => _dynamic
            ? _ruleDefinition.AllConditions.Any(IsCompleteRule)
            : _selectedManualItems.Count > 0,
        _ => true,
    };

    protected override void OnInitialized()
    {
        _mode = Request.Mode;
        _step = FirstStep;
        _furthestStep = FirstStep;
        _dynamic = Request.InitialRulesEnabled ?? Request.Mode == CollectionEditorMode.SmartPlaylist;
        _name = Request.InitialTitle ?? string.Empty;
    }

    private RenderFragment RenderStepperStep(int step, int ordinal) => @<AppNativeButton Type="button"
        Class="@StepClass(step)"
        Disabled="@(step > _furthestStep)"
        OnClick="@(() => GoToStep(step))"
        AriaLabel="@($"Go to {StepLabel(step)} step")">
        <span class="collection-wizard__step-number">@(step < _step ? "✓" : ordinal)</span>
        <span>@StepLabel(step)</span>
    </AppNativeButton>;

    private RenderFragment RenderDetailsStep() => @<section class="collection-wizard__step">
        <div class="collection-wizard__field">
            <label>Name</label>
            <AppTextField T="string"
                          Value="@_name"
                          ValueChanged="OnNameChanged"
                          Placeholder="Name this collection"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Class="app-dialog-field" />
        </div>
        @if (NameSuggestions.Count > 0)
        {
            <div class="collection-wizard__suggestions">
                <span>Suggestions (optional)</span>
                <div>
                    @foreach (var suggestion in NameSuggestions)
                    {
                        <AppNativeButton Type="button" OnClick="@(() => OnNameChanged(suggestion))">@suggestion</AppNativeButton>
                    }
                </div>
            </div>
        }
        <div class="collection-wizard__field">
            <label>Description <span>(optional)</span></label>
            <AppTextarea Value="@_description"
                         ValueChanged="OnDescriptionChanged"
                         Placeholder="Describe what belongs here"
                         Lines="3"
                         Immediate="true"
                         Class="app-dialog-field app-dialog-textarea" />
        </div>
    </section>;

    private RenderFragment RenderContentsStep() => @<section class="collection-wizard__step">
        <h3>How should this @(IsPlaylist ? "playlist" : "collection") stay updated?</h3>
        <div class="collection-wizard__segmented" role="group" aria-label="Membership mode">
            <AppNativeButton Type="button" Class="@(!_dynamic ? "is-selected" : null)" OnClick="@(() => SetDynamic(false))">Manual</AppNativeButton>
            <AppNativeButton Type="button" Class="@(_dynamic ? "is-selected" : null)" OnClick="@(() => SetDynamic(true))">Dynamic</AppNativeButton>
        </div>

        @if (_dynamic)
        {
            @RenderDynamicContents()
        }
        else
        {
            @RenderManualContents()
        }
    </section>;

    private RenderFragment RenderManualContents() => @<div class="collection-wizard__manual">
        <div class="collection-wizard__manual-heading">
            <div>
                <span class="collection-wizard__eyebrow">Manual membership</span>
                <h3>Choose items from your library</h3>
                <p>Filter by media type, search the library, and select the top-level works to include.</p>
            </div>
            <strong>@_selectedManualItems.Count selected</strong>
        </div>
        <nav class="collection-wizard__media-filters" aria-label="Filter library items by media type">
            @foreach (var category in ManualCategories)
            {
                <AppNativeButton Type="button"
                                 Class="@(category.Key == _manualCategory ? "is-selected" : null)"
                                 OnClick="@(() => SelectManualCategoryAsync(category.Key))"
                                 AriaLabel="@($"Show {category.Label}")">
                    <MudIcon Icon="@category.Icon" />
                    <span>@category.Label</span>
                </AppNativeButton>
            }
        </nav>
        <AppTextField T="string"
                      Value="@_manualSearch"
                      ValueChanged="OnManualSearchChangedAsync"
                      Placeholder="Search titles, creators, series, or shows"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Immediate="true"
                      DebounceInterval="300"
                      Class="collection-wizard__manual-search" />

        <div class="collection-wizard__manual-results" aria-live="polite">
            @if (_manualLoading)
            {
                <div class="collection-wizard__manual-state"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><span>Loading library items…</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(_manualError))
            {
                <div class="collection-wizard__manual-state is-error"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" /><span>@_manualError</span></div>
            }
            else if (_manualItems.Count == 0)
            {
                <div class="collection-wizard__manual-state"><MudIcon Icon="@Icons.Material.Outlined.SearchOff" /><span>No library items match this filter.</span></div>
            }
            else
            {
                @foreach (var item in _manualItems)
                {
                    var selected = _selectedManualItems.ContainsKey(item.WorkId);
                    <AppNativeButton Type="button"
                                     Class="@($"collection-wizard__manual-item {(selected ? "is-selected" : string.Empty)}")"
                                     OnClick="@(() => ToggleManualItem(item))"
                                     AriaLabel="@($"{(selected ? "Remove" : "Include")} {item.Title}")">
                        @MediaArtwork(item.ArtworkUrl, item.Title)
                        <span class="collection-wizard__manual-item-copy">
                            <strong>@item.Title</strong>
                            <small>@FormatManualItemMeta(item)</small>
                        </span>
                        <span class="collection-wizard__manual-item-state" aria-hidden="true">
                            <MudIcon Icon="@(selected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.AddCircleOutline)" />
                        </span>
                    </AppNativeButton>
                }
            }
        </div>
        <div class="collection-wizard__editor-note">
            <MudIcon Icon="@Icons.Material.Outlined.EditNote" />
            <div>
                <strong>Fine-tune it in the full editor</strong>
                <span>You can add, remove, and reorder items after creation.</span>
            </div>
        </div>
    </div>;

    private RenderFragment RenderDynamicContents() => @<CollectionRuleBuilder @ref="_ruleBuilder"
                                                                                  Definition="@_ruleDefinition"
                                                                                  DefinitionChanged="OnDefinitionChanged"
                                                                                  SortField="@_sortField"
                                                                                  SortFieldChanged="@(value => _sortField = value ?? "title")"
                                                                                  SortDirection="@_sortDirection"
                                                                                  SortDirectionChanged="@(value => _sortDirection = value)"
                                                                                  SecondarySortField="@_secondarySortField"
                                                                                  SecondarySortFieldChanged="@(value => _secondarySortField = value)"
                                                                                  SecondarySortDirection="@_secondarySortDirection"
                                                                                  SecondarySortDirectionChanged="@(value => _secondarySortDirection = value)"
                                                                                  Preview="@_preview"
                                                                                  PreviewChanged="OnPreviewChanged"
                                                                                  Changed="OnRuleBuilderChanged"
                                                                                  Density="wizard" />;

    private RenderFragment RenderReviewStep() => @<section class="collection-wizard__step collection-wizard__review">
        <div class="collection-wizard__review-identity">
            <div class="collection-wizard__review-art">
                @foreach (var item in ReviewItems.Take(4))
                {
                    @MediaArtwork(item.CoverUrl, item.Title)
                }
            </div>
            <div>
                <h3>@_name</h3>
                <p>@(IsPlaylist ? "Playlist · Listen" : "Collection · Cross-media") · @(_dynamic ? "Dynamic" : "Manual")</p>
            </div>
        </div>

        <div class="collection-wizard__review-panel">
            <div class="collection-wizard__review-heading"><strong>@(_dynamic ? "Matching now" : "Included items")</strong><span>@ReviewItems.Count @(ReviewItems.Count == 1 ? "item" : "items")</span></div>
            <div class="collection-wizard__review-items">
                @foreach (var item in ReviewItems.Take(4))
                {
                    <div @key="item.EntityId">@MediaArtwork(item.CoverUrl, item.Title)<span>@item.Title</span></div>
                }
            </div>
        </div>

        @if (_dynamic)
        {
            <div class="collection-wizard__review-panel">
                <strong>Automatically includes items where:</strong>
                <div class="collection-wizard__review-rules">
                    @foreach (var rule in _ruleDefinition.AllConditions.Where(IsCompleteRule))
                    {
                        <div @key="rule"><MudIcon Icon="@IconForRule(rule.Field)" /> <span>@HumanizeRule(rule)</span></div>
                    }
                </div>
            </div>
        }
    </section>;

    private IReadOnlyList<string> NameSuggestions
    {
        get
        {
            var people = _ruleDefinition.AllConditions
                .Where(rule => rule.Field == "person_qid")
                .Select(rule => rule.DisplayValue ?? rule.Value)
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Cast<string>()
                .Take(2)
                .ToArray();
            if (people.Length == 2)
                return [$"{people[0]} + {people[1]}", $"{people[0]} & {people[1]}"];
            return [];
        }
    }

    private IReadOnlyList<CollectionResolvedItemViewModel> ReviewItems => _dynamic
        ? _preview?.Items ?? []
        : _selectedManualItems.Values.Select(item => new CollectionResolvedItemViewModel
        {
            EntityId = item.WorkId,
            Title = item.Title,
            Creator = item.Creator,
            MediaType = item.MediaType,
            CoverUrl = item.ArtworkUrl,
            Year = item.Year,
        }).ToList();
    private CollectionRuleBuilder? _ruleBuilder;

    private static readonly ManualMediaCategory[] ManualCategories =
    [
        new("all", "All", Icons.Material.Outlined.Apps, null),
        new("movies", "Movies", Icons.Material.Outlined.Movie, "Movies"),
        new("tv", "TV shows", Icons.Material.Outlined.Tv, "TV"),
        new("books", "Books", Icons.Material.Outlined.MenuBook, "Books"),
        new("comics", "Comics", Icons.Material.Outlined.AutoStories, "Comics"),
        new("music", "Music", Icons.Material.Outlined.Album, "Music"),
        new("audiobooks", "Audiobooks", Icons.Material.Outlined.Headphones, "Audiobooks"),
    ];

    private async Task SetDynamic(bool dynamic)
    {
        _dynamic = dynamic;
        _mode = IsPlaylist
            ? (dynamic ? CollectionEditorMode.SmartPlaylist : CollectionEditorMode.ManualPlaylist)
            : CollectionEditorMode.CuratedCollection;
        _dirty = true;
        if (!dynamic)
            await LoadManualItemsAsync();
    }

    private void GoToStep(int step)
    {
        if (VisibleSteps.Contains(step) && step <= _furthestStep)
            _step = step;
    }

    private async Task ContinueOrSave()
    {
        if (_step < 3)
        {
            if (_step == 2 && _dynamic && _ruleBuilder is not null)
                await _ruleBuilder.RefreshAsync();
            if (_step == 1 && !_dynamic)
                await LoadManualItemsAsync();
            _step++;
            _furthestStep = Math.Max(_furthestStep, _step);
            return;
        }
        await SaveAsync();
    }

    private void BackOrCancel()
    {
        if (_step == FirstStep)
            Cancel();
        else
            _step = VisibleSteps[VisibleStepOrdinal(_step) - 2];
    }

    private void Cancel() => MudDialog.Cancel();

    private Task OnNameChanged(string value)
    {
        _name = value;
        _dirty = true;
        return Task.CompletedTask;
    }

    private Task OnDescriptionChanged(string? value)
    {
        _description = value;
        _dirty = true;
        return Task.CompletedTask;
    }

    private Task OnDefinitionChanged(CollectionRuleDefinitionViewModel definition)
    {
        _ruleDefinition = definition;
        return Task.CompletedTask;
    }

    private Task OnPreviewChanged(CollectionPreviewResult? preview)
    {
        _preview = preview;
        return Task.CompletedTask;
    }

    private Task OnRuleBuilderChanged()
    {
        _dirty = true;
        return Task.CompletedTask;
    }

    private async Task SelectManualCategoryAsync(string category)
    {
        if (string.Equals(_manualCategory, category, StringComparison.OrdinalIgnoreCase))
            return;

        _manualCategory = category;
        await LoadManualItemsAsync();
    }

    private async Task OnManualSearchChangedAsync(string value)
    {
        _manualSearch = value;
        await LoadManualItemsAsync();
    }

    private void ToggleManualItem(CollectionMediaLookupDto item)
    {
        if (!_selectedManualItems.Remove(item.WorkId))
            _selectedManualItems[item.WorkId] = item;
        _dirty = true;
    }

    private async Task LoadManualItemsAsync()
    {
        _manualLookupCts?.Cancel();
        _manualLookupCts?.Dispose();
        _manualLookupCts = new CancellationTokenSource();
        var token = _manualLookupCts.Token;
        _manualLoading = true;
        _manualError = null;
        try
        {
            var mediaTypes = ManualCategories.First(category => category.Key == _manualCategory).MediaTypes;
            var items = await ApiClient.LookupCollectionMediaAsync(
                string.IsNullOrWhiteSpace(_manualSearch) ? null : _manualSearch.Trim(),
                mediaTypes: mediaTypes,
                limit: 100,
                profileId: Request.ActiveProfileId,
                ct: token);
            _manualItems.Clear();
            _manualItems.AddRange(items);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            _manualError = "Library items could not be loaded.";
        }
        finally
        {
            if (!token.IsCancellationRequested)
                _manualLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var collectionId = await ApiClient.CreateCollectionWithItemsAsync(
                _name.Trim(),
                string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                IsPlaylist ? Icons.Material.Outlined.QueueMusic : Icons.Material.Outlined.Collections,
                CollectionType,
                _dynamic ? BuildPersistableDefinition() : new CollectionRuleDefinitionViewModel(),
                _sortField,
                _sortDirection,
                IsPlaylist ? "private" : "shared",
                _dynamic ? [] : _selectedManualItems.Keys.ToList(),
                Request.ActiveProfileId,
                secondarySortField: _secondarySortField,
                secondarySortDirection: _secondarySortDirection);

            if (!collectionId.HasValue)
            {
                var reason = string.IsNullOrWhiteSpace(ApiClient.LastError)
                    ? $"The {(_mode == CollectionEditorMode.CuratedCollection ? "collection" : "playlist")} could not be created."
                    : ApiClient.LastError;
                Snackbar.Add(reason, Severity.Error);
                return;
            }

            _dirty = false;
            Snackbar.Add($"{(IsPlaylist ? "Playlist" : "Collection")} \"{_name.Trim()}\" created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(collectionId.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment MediaArtwork(string? url, string title) => @<div class="collection-wizard__media-art">
        @if (!string.IsNullOrWhiteSpace(url))
        {
            <img src="@url" alt="" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Outlined.ImageNotSupported" />
        }
    </div>;

    private string StepClass(int step) => $"collection-wizard__step-button {(step == _step ? "is-active" : step < _step ? "is-complete" : string.Empty)}";
    private int VisibleStepOrdinal(int step) => VisibleSteps.TakeWhile(candidate => candidate != step).Count() + 1;
    private static string StepLabel(int step) => step switch { 1 => "Basics", 2 => "Setup", _ => "Review" };
    private static bool IsCompleteRule(CollectionRulePredicateViewModel rule) =>
        !string.IsNullOrWhiteSpace(rule.Field)
        && (rule.Op is "known" or "unknown" || (rule.Values?.Length > 0) || !string.IsNullOrWhiteSpace(rule.Value));
    private CollectionRuleDefinitionViewModel BuildPersistableDefinition() => new()
    {
        Version = _ruleDefinition.Version,
        Groups = _ruleDefinition.Groups.Select(group => new CollectionRuleGroupViewModel
        {
            Id = group.Id,
            JoinWithPrevious = group.JoinWithPrevious,
            MatchMode = group.MatchMode,
            Conditions = group.Conditions.Where(IsCompleteRule).ToList(),
        }).Where(group => group.Conditions.Count > 0).ToList(),
    };
    private static string RuleLabel(string field) => field switch { "media_type" => "Media type", "provider_rating" => "Rating", "added_within_days" => "Date", "fictional_universe" => "Universe", _ => char.ToUpperInvariant(field[0]) + field[1..].Replace('_', ' ') };
    private static string IconForRule(string field) => field switch
    {
        "person_qid" => Icons.Material.Outlined.Person,
        "media_type" => Icons.Material.Outlined.Movie,
        "provider_rating" => Icons.Material.Outlined.StarBorder,
        "added_within_days" => Icons.Material.Outlined.CalendarToday,
        "genre" => Icons.Material.Outlined.TheaterComedy,
        "series" => Icons.Material.Outlined.Tv,
        _ => Icons.Material.Outlined.Public,
    };
    private static string RuleDescription(CollectionRulePredicateViewModel rule) => rule.DisplayValue ?? rule.Value ?? "Known value";
    private string HumanizeRule(CollectionRulePredicateViewModel rule)
    {
        if (rule.Field == "person_qid")
        {
            var name = rule.DisplayValue ?? rule.Value;
            return string.IsNullOrWhiteSpace(name) ? "A selected person is associated" : $"{name} is associated";
        }
        return rule.Field switch
        {
            "media_type" => $"Media type is {RuleDescription(rule)}",
            "provider_rating" => $"Rating is {RuleDescription(rule)}",
            "added_within_days" => RuleDescription(rule),
            _ => $"{RuleLabel(rule.Field)} is {RuleDescription(rule)}",
        };
    }

    private static string FormatManualItemMeta(CollectionMediaLookupDto item)
    {
        var values = new[] { item.Creator, item.Year, item.MediaType }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        return string.Join(" · ", values);
    }

    private sealed record ManualMediaCategory(string Key, string Label, string Icon, string? MediaTypes);

    public void Dispose()
    {
        _manualLookupCts?.Cancel();
        _manualLookupCts?.Dispose();
    }
}
