@namespace MediaEngine.Web.Components.Activity
@using MediaEngine.Contracts.Activity
@using MediaEngine.Contracts.Paging
@using Microsoft.AspNetCore.WebUtilities
@inject UIOrchestratorService Orchestrator
@inject NavigationManager Nav

<div class="activity-audit">
    <div class="activity-audit__toolbar">
        @if (_requestedRunId.HasValue)
        {
            <AppButton Href="/settings/activity" Label="All activity" ButtonStyle="AppButtonStyle.Text" StartIcon="@Icons.Material.Outlined.ArrowBack" />
        }
        else
        {
            <AppSelect Value="@_dateRange" ValueChanged="@OnDateRangeChanged" Options="@DateRangeOptions" Label="Date range" Class="activity-audit__date" />
        }
        <AppButton Label="Refresh" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="@_loading" OnClick="@LoadOperationsAsync" />
    </div>

    @if (_loading && DisplayOperations.Count == 0)
    {
        <AppProgressBar Indeterminate="true" Class="activity-audit__progress" />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && DisplayOperations.Count == 0)
    {
        <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
    }
    else if (DisplayOperations.Count == 0)
    {
        <AppEmptyState Title="No operations" Message="No activity operations were recorded in this date range." />
    }
    else
    {
        <section class="activity-ledger" aria-label="Activity operations">
            <div class="activity-ledger__head" aria-hidden="true">
                <span>Operation</span><span>Date &amp; time</span><span>Duration</span><span>Files</span><span>Media items</span><span>Result</span><span>Details</span>
            </div>
            @foreach (var operation in DisplayOperations)
            {
                var open = _expandedOperation == operation.BatchId;
                <article class="activity-operation @StatusClass(operation.Status)" @key="operation.BatchId">
                    <AppNativeButton Type="button" Class="activity-operation__row" OnClick="@(_ => ToggleOperationAsync(operation))" aria-expanded="@open" aria-controls="@PanelId(operation)">
                        <span class="activity-operation__identity">
                            <span class="activity-operation__disclosure" aria-hidden="true"><MudIcon Icon="@(open ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ChevronRight)" /></span>
                            <span class="activity-operation__icon" aria-hidden="true"><MudIcon Icon="@OperationIcon(operation)" /></span>
                            <span><strong>@OperationTitle(operation)</strong><small>@OperationSubtitle(operation)</small></span>
                        </span>
                        <time><small>Date &amp; time</small>@FormatDate(operation.StartedAt)</time>
                        <span><small>Duration</small>@Duration(operation)</span>
                        <span><small>Files</small>@operation.FilesDiscoveredCount.ToString("N0")</span>
                        <span><small>Media items</small><strong>@operation.ItemCount.ToString("N0")</strong></span>
                        <span class="activity-operation__result @ResultClass(operation)"><small>Result</small><MudIcon Icon="@ResultIcon(operation)" /><span><strong>@ResultLabel(operation)</strong>@if (AttentionCount(operation) > 0) { <em class="@AttentionClass(operation)"><MudIcon Icon="@AttentionIcon(operation)" />@AttentionLabel(operation)</em> }</span></span>
                        <span class="activity-operation__action">@(open ? "View less" : "View details")<MudIcon Icon="@(open ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" /></span>
                    </AppNativeButton>
                    @if (open)
                    {
                        <ActivityBatchInspector Id="@PanelId(operation)" Batch="@operation" InitialPanel="@_selectedPanel" />
                    }
                </article>
            }
        </section>
        @if (!_requestedRunId.HasValue)
        {
            <AppCompactPager Offset="@_query.Offset" Limit="@_query.Limit" HasMore="@(_page?.HasMore == true)" TotalCount="@_page?.TotalCount" Loading="@_loading" OffsetChanged="@OnPageChanged" />
        }
    }
</div>

@code {
    private readonly ActivityAuditQuery _query = new() { Sort = "started", SortDirection = "desc", Start = DateTimeOffset.Now.AddDays(-30), Limit = 25 };
    private PagedResponse<ActivityBatchSummaryDto>? _page;
    private List<ActivityBatchSummaryDto> _operations = [];
    private ActivityBatchSummaryDto? _requestedOperation;
    private Guid? _requestedRunId;
    private Guid? _expandedOperation;
    private string _selectedPanel = "media";
    private bool _loading = true;
    private string? _error;
    private string _dateRange = "30d";
    private int _loadRevision;
    private IReadOnlyList<ActivityBatchSummaryDto> DisplayOperations => _requestedRunId.HasValue ? _requestedOperation is null ? [] : [_requestedOperation] : _operations;
    private static readonly IReadOnlyList<AppSelectOption> DateRangeOptions = [new("today", "Today"), new("7d", "Last 7 days"), new("30d", "Last 30 days"), new("all", "All time")];

    protected override async Task OnInitializedAsync()
    {
        _requestedRunId = ResolveRunId();
        if (_requestedRunId is { } runId)
        {
            _requestedOperation = await Orchestrator.GetActivityBatchAsync(runId);
            if (_requestedOperation is not null) { _expandedOperation = runId; _selectedPanel = ResolvePanel(); }
            else _error = "That operation could not be found. It may have expired or the link may be invalid.";
            _loading = false;
            return;
        }
        await LoadOperationsAsync();
    }

    private async Task LoadOperationsAsync()
    {
        if (_requestedRunId.HasValue) { _requestedOperation = await Orchestrator.GetActivityBatchAsync(_requestedRunId.Value); return; }
        var revision = ++_loadRevision; _loading = true; _error = null;
        try { var page = await Orchestrator.GetActivityBatchesAsync(_query); if (revision != _loadRevision) return; _page = page; _operations = page?.Items.GroupBy(operation => operation.BatchId).Select(group => group.First()).ToList() ?? []; }
        catch (Exception ex) { if (revision == _loadRevision) { _error = $"Activity operations could not load: {ex.Message}"; _operations = []; } }
        finally { if (revision == _loadRevision) _loading = false; }
    }

    private Task ToggleOperationAsync(ActivityBatchSummaryDto operation) { _expandedOperation = _expandedOperation == operation.BatchId ? null : operation.BatchId; _selectedPanel = "media"; return Task.CompletedTask; }
    private async Task OnDateRangeChanged(string? value) { _dateRange = string.IsNullOrWhiteSpace(value) ? "30d" : value; _query.Start = _dateRange switch { "today" => DateTimeOffset.Now.Date, "7d" => DateTimeOffset.Now.AddDays(-7), "all" => null, _ => DateTimeOffset.Now.AddDays(-30) }; _query.Offset = 0; await LoadOperationsAsync(); }
    private async Task OnPageChanged(int offset) { _query.Offset = offset; await LoadOperationsAsync(); }
    private Guid? ResolveRunId() { var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query); return query.TryGetValue("runId", out var raw) && Guid.TryParse(raw.FirstOrDefault(), out var id) ? id : null; }
    private string ResolvePanel() { var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query); var panel = query.TryGetValue("detail", out var raw) ? raw.FirstOrDefault()?.ToLowerInvariant() : null; return panel is "enrichment" or "data" or "technical" ? panel : "media"; }
    private static string PanelId(ActivityBatchSummaryDto operation) => $"activity-operation-{operation.BatchId:N}";
    private static string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString("MMM d, yyyy, h:mm tt");
    private static string Duration(ActivityBatchSummaryDto operation) => StringHelpers.FirstNonBlankOr("In progress", operation.DurationLabel);
    private static string SourceName(string? source) { if (string.IsNullOrWhiteSpace(source)) return "library"; var trimmed = source.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar); return Path.GetFileName(trimmed) is { Length: > 0 } label ? label : "library"; }
    private static string OperationTitle(ActivityBatchSummaryDto operation) => operation.MediaTypeCount > 1 ? "Library Ingestion — New Items" : operation.MediaTypes.Count == 1 ? $"Library Ingestion — {ActivityDisplay.NormalizeMediaType(operation.MediaTypes[0].MediaType)}" : !string.IsNullOrWhiteSpace(operation.Category) ? operation.Category : $"Library Ingestion — {SourceName(operation.Source)}";
    private static string OperationSubtitle(ActivityBatchSummaryDto operation) => $"{operation.FilesDiscoveredCount:N0} files · {(operation.Source?.Contains("Multiple", StringComparison.OrdinalIgnoreCase) == true ? "Multiple source folders" : SourceName(operation.Source))}";
    private static string OperationIcon(ActivityBatchSummaryDto operation) => operation.Category?.Contains("people", StringComparison.OrdinalIgnoreCase) == true ? Icons.Material.Outlined.People : operation.Category?.Contains("refresh", StringComparison.OrdinalIgnoreCase) == true ? Icons.Material.Outlined.Image : Icons.Material.Outlined.Storage;
    private static int AttentionCount(ActivityBatchSummaryDto operation) => operation.ReviewCount + operation.WarningCount + operation.FailureCount;
    private static string AttentionLabel(ActivityBatchSummaryDto operation) => operation.FailureCount > 0 ? $"{operation.FailureCount:N0} failed" : operation.WarningCount > 0 ? $"{operation.WarningCount:N0} warnings" : $"{operation.ReviewCount:N0} need review";
    private static string AttentionClass(ActivityBatchSummaryDto operation) => operation.FailureCount > 0 ? "is-danger" : "is-warning";
    private static string AttentionIcon(ActivityBatchSummaryDto operation) => operation.FailureCount > 0 ? Icons.Material.Outlined.ErrorOutline : operation.WarningCount > 0 ? Icons.Material.Outlined.WarningAmber : Icons.Material.Outlined.PendingActions;
    private static string ResultLabel(ActivityBatchSummaryDto operation) => operation.Status?.ToLowerInvariant() switch { "running" or "active" or "processing" => "In progress", "failed" => "Failed", "abandoned" or "interrupted" => "Interrupted", _ => "Completed" };
    private static string ResultClass(ActivityBatchSummaryDto operation) => operation.Status?.ToLowerInvariant() switch { "failed" => "is-danger", "abandoned" or "interrupted" => "is-warning", "running" or "active" or "processing" => "is-active", _ => "is-success" };
    private static string ResultIcon(ActivityBatchSummaryDto operation) => operation.Status?.ToLowerInvariant() switch { "failed" => Icons.Material.Outlined.ErrorOutline, "abandoned" or "interrupted" => Icons.Material.Outlined.WarningAmber, "running" or "active" or "processing" => Icons.Material.Outlined.Sync, _ => Icons.Material.Outlined.CheckCircle };
    private static string StatusClass(string? status) => $"is-{(string.IsNullOrWhiteSpace(status) ? "unknown" : status.ToLowerInvariant())}";
}
