@namespace MediaEngine.Web.Components.Activity
@using MediaEngine.Contracts.Activity
@using MediaEngine.Contracts.Paging
@inject UIOrchestratorService Orchestrator

<section id="@Id" class="@($"batch-inspector is-panel-{Panel}")" aria-label="@($"{PanelLabel} for this operation")">
    <header class="batch-inspector__header">
        <div><MudIcon Icon="@PanelIcon" /><span><strong>@PanelLabel</strong><small>@PanelDescription</small></span></div>
        <AppIconButton Icon="@Icons.Material.Outlined.Close" Size="AppControlSize.Compact" AriaLabel="Close operation details" Tooltip="Close details" OnClick="@OnClose" />
    </header>

    @if (_loading)
    {
        <div class="batch-inspector__loading"><AppProgressBar Indeterminate="true" /><span>Loading @PanelLabel.ToLowerInvariant()…</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
    }
    else if (Panel == "overview")
    {
        <div class="batch-inspector__overview">
            @OverviewRow(Icons.Material.Outlined.FolderOpen, "Files checked", Batch.FilesDiscoveredCount, $"{Batch.ItemsIdentifiedCount:N0} identified")
            @OverviewRow(Icons.Material.Outlined.VideoLibrary, "Media items", MediaItemCount, MediaTypeSummary)
            @OverviewRow(Icons.Material.Outlined.AutoAwesome, "Enrichment", Batch.EnrichmentOperationCount, $"{Batch.PeopleCount:N0} people · {Batch.MetadataUpdatedCount:N0} metadata updates")
            @OverviewRow(Icons.Material.Outlined.WarningAmber, "Attention", AttentionCount, AttentionSummary)
        </div>
        <div class="batch-inspector__run-id"><span>Batch ID</span><code>@Batch.BatchId</code></div>
    }
    else if (Panel == "media")
    {
        @if (_groups.Count > 0)
        {
            <div class="batch-inspector__media-options" aria-label="Media types in this operation">
                <AppNativeButton Type="button" Class="@MediaOptionClass(null)" OnClick="@(_ => SelectMediaAsync(null))">All <strong>@_groups.Sum(MediaCount).ToString("N0")</strong></AppNativeButton>
                @foreach (var group in _groups.Where(group => MediaCount(group) > 0))
                {
                    <AppNativeButton Type="button" Class="@MediaOptionClass(group.MediaType)" OnClick="@(_ => SelectMediaAsync(group.MediaType))"><AppMaterialIcon Icon="@ActivityDisplay.MediaIcon(group.MediaType)" Size="MudBlazor.Size.Small" />@ActivityDisplay.NormalizeMediaType(group.MediaType)<strong>@MediaCount(group).ToString("N0")</strong></AppNativeButton>
                }
            </div>
        }

        @if (_itemPage?.Items.Count > 0)
        {
            <div class="batch-inspector__item-table">
                <div class="batch-inspector__item-head"><span>Item</span><span>Type</span><span>Result</span><span></span></div>
                @foreach (var item in _itemPage.Items)
                {
                    var open = _expandedItem == item.AssetId;
                    <article class="batch-inspector__item" @key="item.AssetId">
                        <div class="batch-inspector__item-row">
                            <span><AppMaterialIcon Icon="@ActivityDisplay.MediaIcon(item.MediaType)" Size="MudBlazor.Size.Small" /><span><strong>@item.Title</strong><small>@item.SourcePath</small></span></span>
                            <span>@ActivityDisplay.NormalizeMediaType(item.MediaType)</span>
                            @if (item.ReviewCount > 0) { <a class="is-warning" href="/settings/review"><MudIcon Icon="@Icons.Material.Outlined.RateReview" />Needs review</a> }
                            else if (item.AlertCount > 0) { <span class="is-danger"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />Failed</span> }
                            else { <span class="is-success"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />Complete</span> }
                            @if (item.AssetId is { } assetId)
                            {
                                <AppIconButton Icon="@(open ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" AriaLabel="@($"{(open ? "Hide" : "Show")} details for {item.Title}")" Tooltip="@($"{(open ? "Hide" : "Show")} item details")" Size="AppControlSize.Compact" OnClick="@(() => ToggleItemAsync(assetId))" />
                            }
                        </div>
                        @if (open) { <div class="batch-inspector__item-detail">@RenderItemDetail(item)</div> }
                    </article>
                }
            </div>
            <AppCompactPager Offset="@_itemOffset" Limit="@ItemLimit" HasMore="@_itemPage.HasMore" TotalCount="@_itemPage.TotalCount" Loading="@_loading" OffsetChanged="@OnItemPageChanged" />
        }
        else
        {
            <p class="batch-inspector__note">No media items were recorded for this operation.</p>
        }
    }
    else if (Panel == "enrichment")
    {
        @if (EnrichmentTargets.Count > 0)
        {
            <div class="batch-inspector__fact-list">
                @foreach (var target in EnrichmentTargets)
                {
                    <article class="batch-inspector__fact-row"><MudIcon Icon="@target.Icon" /><span><strong>@target.Label</strong><small>@target.Detail</small></span><b>@target.Count.ToString("N0")</b></article>
                }
            </div>
        }
        else
        {
            <p class="batch-inspector__note">No completed enrichment output was recorded for this operation.</p>
        }
    }
    else if (Panel == "attention")
    {
        <div class="batch-inspector__attention">
            @if (Batch.ReviewCount > 0) { <a href="/settings/review"><MudIcon Icon="@Icons.Material.Outlined.RateReview" /><span><strong>@Batch.ReviewCount.ToString("N0") need review</strong><small>Open the review queue to resolve uncertain identification or metadata.</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }
            @if (Batch.WarningCount > 0) { <div><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /><span><strong>@Batch.WarningCount.ToString("N0") warnings</strong><small>Work retried or waited during this operation.</small></span></div> }
            @if (Batch.FailureCount > 0) { <div class="is-danger"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" /><span><strong>@Batch.FailureCount.ToString("N0") failures</strong><small>Required technical work ended without completing.</small></span></div> }
        </div>
    }
    else
    {
        <div class="batch-inspector__data-grid">
            <article><small>Provider operations</small><strong>@ValueOrUnavailable(_insights?.ProviderOperationCount)</strong></article>
            <article><small>Waiting or retrying</small><strong>@ValueOrUnavailable(_insights?.RetryCount)</strong></article>
            <article><small>Provider failures</small><strong>@ValueOrUnavailable(_insights?.ProviderFailureCount)</strong></article>
            <article><small>Downloaded data</small><strong>Unavailable</strong></article>
        </div>
        @if (_insights?.Providers.Count > 0)
        {
            <section class="batch-inspector__providers"><h4>Provider activity</h4>@foreach (var provider in _insights.Providers) { <div><strong>@provider.Provider</strong><span>@provider.OperationCount.ToString("N0") operations</span><span>@provider.RetryCount.ToString("N0") waiting or retrying</span><span>@provider.FailureCount.ToString("N0") failed</span></div> }</section>
        }
        <p class="batch-inspector__note">Download size is shown as unavailable because this operation did not record a reliable byte count.</p>
    }
</section>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public ActivityBatchSummaryDto Batch { get; set; } = new();
    [Parameter] public string Panel { get; set; } = "overview";
    [Parameter] public EventCallback OnClose { get; set; }

    private const int ItemLimit = 25;
    private bool _loading;
    private string? _error;
    private Guid _loadedBatchId;
    private string? _loadedPanel;
    private string? _selectedMediaType;
    private int _itemOffset;
    private int _loadRevision;
    private List<ActivityMediaTypeGroupDto> _groups = [];
    private PagedResponse<ActivityBatchItemDto>? _itemPage;
    private ActivityBatchInsightsDto? _insights;
    private readonly Dictionary<Guid, ActivityBatchItemDetailDto?> _itemDetails = [];
    private Guid? _expandedItem;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedBatchId == Batch.BatchId && _loadedPanel == Panel) return;
        if (_loadedBatchId != Batch.BatchId)
        {
            _groups = [];
            _itemPage = null;
            _insights = null;
            _itemDetails.Clear();
            _expandedItem = null;
            _selectedMediaType = null;
            _itemOffset = 0;
        }

        _loadedBatchId = Batch.BatchId;
        _loadedPanel = Panel;
        await LoadPanelAsync();
    }

    private async Task LoadPanelAsync()
    {
        if (Panel == "overview" || Panel == "attention") { _loading = false; _error = null; return; }
        var revision = ++_loadRevision;
        _loading = true;
        _error = null;
        try
        {
            if (Panel == "media")
            {
                var groupsTask = Orchestrator.GetActivityBatchGroupsAsync(Batch.BatchId);
                var itemsTask = Orchestrator.GetActivityBatchItemsAsync(Batch.BatchId, _selectedMediaType, _itemOffset, ItemLimit, "title", "asc");
                await Task.WhenAll(groupsTask, itemsTask);
                if (revision != _loadRevision) return;
                _groups = groupsTask.Result;
                _itemPage = itemsTask.Result;
            }
            else
            {
                _insights = await Orchestrator.GetActivityBatchInsightsAsync(Batch.BatchId);
                if (revision != _loadRevision) return;
            }
        }
        catch (Exception ex)
        {
            if (revision == _loadRevision) _error = $"{PanelLabel} could not load: {ex.Message}";
        }
        finally { if (revision == _loadRevision) _loading = false; }
    }

    private async Task SelectMediaAsync(string? mediaType) { _selectedMediaType = mediaType; _itemOffset = 0; _expandedItem = null; await LoadPanelAsync(); }
    private async Task OnItemPageChanged(int offset) { _itemOffset = offset; _expandedItem = null; await LoadPanelAsync(); }
    private async Task ToggleItemAsync(Guid assetId) { if (_expandedItem == assetId) { _expandedItem = null; return; } _expandedItem = assetId; if (!_itemDetails.ContainsKey(assetId)) _itemDetails[assetId] = await Orchestrator.GetActivityBatchItemDetailAsync(Batch.BatchId, assetId); }
    private RenderFragment RenderItemDetail(ActivityBatchItemDto item) => builder => { builder.OpenComponent<ActivityBatchItemInspector>(0); builder.AddAttribute(1, nameof(ActivityBatchItemInspector.Item), item); builder.AddAttribute(2, nameof(ActivityBatchItemInspector.Detail), item.AssetId is { } id ? _itemDetails.GetValueOrDefault(id) : null); builder.CloseComponent(); };
    private RenderFragment OverviewRow(string icon, string label, int value, string detail) => builder => { builder.OpenElement(0, "article"); builder.OpenComponent<MudIcon>(1); builder.AddAttribute(2, nameof(MudIcon.Icon), icon); builder.CloseComponent(); builder.OpenElement(3, "span"); builder.OpenElement(4, "strong"); builder.AddContent(5, label); builder.CloseElement(); builder.OpenElement(6, "small"); builder.AddContent(7, detail); builder.CloseElement(); builder.CloseElement(); builder.OpenElement(8, "b"); builder.AddContent(9, value.ToString("N0")); builder.CloseElement(); builder.CloseElement(); };
    private int MediaItemCount => Batch.ItemCount;
    private int AttentionCount => Batch.ReviewCount + Batch.WarningCount + Batch.FailureCount;
    private string AttentionSummary => AttentionCount == 0 ? "No review items, warnings, or failures" : $"{Batch.ReviewCount:N0} review · {Batch.WarningCount:N0} warnings · {Batch.FailureCount:N0} failures";
    private string MediaTypeSummary => Batch.MediaTypes.Count == 0 ? "No classified media recorded" : string.Join(" · ", Batch.MediaTypes.Take(3).Select(media => $"{media.Count:N0} {ActivityDisplay.NormalizeMediaType(media.MediaType)}"));
    private string PanelLabel => Panel switch { "media" => "Media", "enrichment" => "Enrichment", "attention" => "Attention", "data" => "Data & downloads", _ => "Operation summary" };
    private string PanelDescription => Panel switch { "media" => "Items represented by this operation.", "enrichment" => "Details added to identified media.", "attention" => "Items or technical work that need attention.", "data" => "Provider requests and recorded downloads.", _ => "The useful outcomes from this operation." };
    private string PanelIcon => Panel switch { "media" => Icons.Material.Outlined.VideoLibrary, "enrichment" => Icons.Material.Outlined.AutoAwesome, "attention" => Icons.Material.Outlined.WarningAmber, "data" => Icons.Material.Outlined.CloudDownload, _ => Icons.Material.Outlined.Summarize };
    private string MediaOptionClass(string? mediaType) => $"batch-inspector__media-option {(string.Equals(_selectedMediaType, mediaType, StringComparison.OrdinalIgnoreCase) ? "is-selected" : null)}";
    private static int MediaCount(ActivityMediaTypeGroupDto group) => group.ItemCount;
    private static string ValueOrUnavailable(int? value) => value.HasValue ? value.Value.ToString("N0") : "Unavailable";
    private IReadOnlyList<EnrichmentTarget> EnrichmentTargets { get { var insight = _insights ?? new ActivityBatchInsightsDto(); return new[] { new EnrichmentTarget("People", Batch.PeopleCount, "unique people", Icons.Material.Outlined.People), new EnrichmentTarget("Artwork", insight.ArtworkCount, "recorded artwork operations", Icons.Material.Outlined.Image), new EnrichmentTarget("Relationships", insight.RelationshipCount, "series, collections, and connections", Icons.Material.Outlined.AccountTree), new EnrichmentTarget("Metadata", Batch.MetadataUpdatedCount, "recorded metadata updates", Icons.Material.Outlined.Description), new EnrichmentTarget("Identification", Batch.ItemsIdentifiedCount, "resolved media identities", Icons.Material.Outlined.Search), new EnrichmentTarget("Subtitles", insight.SubtitleCount, "recorded subtitle operations", Icons.Material.Outlined.Subtitles), new EnrichmentTarget("Lyrics", insight.LyricsCount, "recorded lyric operations", Icons.Material.Outlined.Lyrics) }.Where(target => target.Count > 0).ToList(); } }
    private sealed record EnrichmentTarget(string Label, int Count, string Detail, string Icon);
}
