@namespace MediaEngine.Web.Components.Activity
@using MediaEngine.Contracts.Activity
@using MediaEngine.Contracts.Ingestion
@using MediaEngine.Contracts.Paging
@inject IEngineApiClient Api
@inject UIOrchestratorService Orchestrator
@implements IDisposable

<section id="@Id" class="batch-inspector" aria-label="Batch details">
    @if (_loading && _presentation is null)
    {
        <AppProgressBar Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppAlert Tone="AppUiTone.Warning">@_error</AppAlert>
    }
    else if (_presentation is not null)
    {
        <header class="batch-inspector__header">
            <div><span><MudIcon Icon="@ResultIcon" /></span><h3>@_presentation.DisplayName — details</h3><em class="@ResultClass">@ResultLabel</em></div>
            <p>@_presentation.Summary</p>
            <small>Ran @Batch.StartedAt.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt") · Batch ID: <code>@Batch.BatchId.ToString("D")</code></small>
        </header>

        <div class="batch-inspector__metrics">
            @foreach (var metric in Metrics)
            {
                <article><MudIcon Icon="@metric.Icon" /><span><strong>@metric.Value.ToString("N0")</strong><small>@metric.Label</small></span></article>
            }
        </div>

        <div class="batch-inspector__columns">
            <section class="batch-inspector__added">
                <header><h4>Added in this batch</h4>@if (_presentation.AddedTotal > _presentation.AddedPreview.Count) { <AppNativeButton Type="button" OnClick="@(_ => ToggleAllMediaAsync())">@(_showAllMedia ? "Hide all" : $"View all {_presentation.AddedTotal:N0}")<MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></AppNativeButton> }</header>
                @if (_showAllMedia && _mediaPage is not null)
                {
                    <div class="batch-inspector__media-grid">
                        @foreach (var item in _mediaPage.Items) { @MediaCard(item) }
                    </div>
                    <AppCompactPager Offset="@_mediaPage.Offset" Limit="@_mediaPage.Limit" HasMore="@_mediaPage.HasMore" TotalCount="@_mediaPage.TotalCount" Loading="@_mediaLoading" OffsetChanged="LoadMediaAsync" />
                }
                else if (_presentation.AddedPreview.Count > 0)
                {
                    <div class="batch-inspector__media-grid is-preview">
                        @foreach (var item in _presentation.AddedPreview) { @MediaCard(item) }
                    </div>
                }
                else
                {
                    <p>No browseable media was produced by this run.</p>
                }
            </section>

            @if (_presentation.FollowUp.Count > 0)
            {
                <section class="batch-inspector__follow-up"><header><h4>Needs follow-up</h4></header>@foreach (var item in _presentation.FollowUp) { <a href="@item.Route"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" /><span><strong>@item.Label</strong><small>@item.Description</small></span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }</section>
            }

            @if (_presentation.Timeline.Count > 0)
            {
                <section class="batch-inspector__timeline"><header><h4>Run timeline</h4></header><ol>@foreach (var item in _presentation.Timeline) { <li class="is-@item.State"><MudIcon Icon="@TimelineIcon(item.State)" /><span><strong>@item.Label</strong><small>@item.Detail</small></span>@if (item.OccurredAt.HasValue) { <time>@item.OccurredAt.Value.ToLocalTime().ToString("h:mm tt")</time> }</li> }</ol></section>
            }
        </div>

        <details class="batch-inspector__technical" @ontoggle="OnTechnicalToggle">
            <summary>Processing details</summary>
            @if (_technicalLoading) { <AppProgressBar Indeterminate="true" /> }
            else if (_events?.Items.Count > 0)
            {
                <div>@foreach (var item in _events.Items) { <article><time>@item.OccurredAt.ToLocalTime().ToString("h:mm:ss tt")</time><span><strong>@Humanize(item.EventType)</strong><small>@(item.Detail ?? item.Item)</small></span><em>@item.Result</em></article> }</div>
                <AppCompactPager Offset="@_events.Offset" Limit="@_events.Limit" HasMore="@_events.HasMore" TotalCount="@_events.TotalCount" Loading="@_technicalLoading" OffsetChanged="LoadEventsAsync" />
            }
            else { <p>No technical events were retained for this run.</p> }
        </details>
    }
</section>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public ActivityBatchSummaryDto Batch { get; set; } = new();
    private ActivityBatchPresentationDto? _presentation;
    private PagedResponse<IngestionMediaGroupDto>? _mediaPage;
    private PagedResponse<ActivityTechnicalEventDto>? _events;
    private Guid _loadedBatch;
    private bool _loading;
    private bool _showAllMedia;
    private bool _mediaLoading;
    private bool _technicalLoading;
    private string? _error;
    private readonly CancellationTokenSource _lifetimeCts = new();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedBatch == Batch.BatchId) return;
        _loadedBatch = Batch.BatchId; _loading = true; _error = null;
        try { _presentation = await Api.GetActivityBatchPresentationAsync(Batch.BatchId, _lifetimeCts.Token); }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested) { }
        catch (Exception ex) { _error = $"Batch details could not load: {ex.Message}"; }
        finally { _loading = false; }
    }

    private IReadOnlyList<(string Label, int Value, string Icon)> Metrics
    {
        get
        {
            if (_presentation is null) return [];
            var values = new List<(string, int, string)>();
            AddMetric(values, "Files processed", _presentation.FilesProcessed, Icons.Material.Outlined.Description);
            AddMetric(values, "Media added", _presentation.GroupsAdded, Icons.Material.Outlined.Album);
            AddMetric(values, "People updated", _presentation.PeopleUpdated, Icons.Material.Outlined.Groups);
            AddMetric(values, "Artwork added", _presentation.ArtworkAdded, Icons.Material.Outlined.Image);
            AddMetric(values, "Lyrics/subtitles", _presentation.TextTracksAdded, Icons.Material.Outlined.Lyrics);
            AddMetric(values, "Need follow-up", _presentation.ItemsNeedingFollowUp, Icons.Material.Outlined.WarningAmber);
            return values;
        }
    }

    private static void AddMetric(List<(string, int, string)> values, string label, int? value, string icon) { if (value.HasValue) values.Add((label, value.Value, icon)); }
    private async Task ToggleAllMediaAsync() { _showAllMedia = !_showAllMedia; if (_showAllMedia && _mediaPage is null) await LoadMediaAsync(0); }
    private async Task LoadMediaAsync(int offset) { _mediaLoading = true; try { _mediaPage = await Api.GetActivityBatchMediaGroupsAsync(Batch.BatchId, offset, 50, _lifetimeCts.Token); } catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested) { } finally { _mediaLoading = false; } }
    private async Task OnTechnicalToggle() { if (_events is null) await LoadEventsAsync(0); }
    private async Task LoadEventsAsync(int offset) { _technicalLoading = true; try { _events = await Orchestrator.GetActivityBatchEventsAsync(Batch.BatchId, offset: offset, limit: 25, ct: _lifetimeCts.Token); } catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested) { } finally { _technicalLoading = false; } }
    private RenderFragment MediaCard(IngestionMediaGroupDto item) => @<a class="batch-inspector__media-card" href="@item.DetailRoute"><span><AppMediaArtwork ImageUrl="@item.CoverUrl" Alt="" FallbackIcon="@MediaIcon(item.MediaType)" /></span><strong>@item.Title</strong><small>@AdditionCopy(item)</small></a>;
    private static string AdditionCopy(IngestionMediaGroupDto item) => item.ChildUnit is null ? IngestionType(item.MediaType) : $"{item.ChildCompleted:N0} {item.ChildUnit} added";
    private static string IngestionType(string media) => media switch { "Music" => "Album added", "TV" => "TV added", "Movies" => "Movie added", "Books" => "Book added", "Audiobooks" => "Audiobook added", "Comics" => "Comic added", _ => "Media added" };
    private string ResultLabel => Batch.Status?.ToLowerInvariant() switch { "running" or "active" or "processing" or "queued" => "In progress", "failed" => "Failed", "abandoned" or "interrupted" => "Interrupted", _ => Batch.ReviewCount > 0 ? "Needs follow-up" : "Completed" };
    private string ResultClass => Batch.Status?.ToLowerInvariant() switch { "failed" => "is-danger", "abandoned" or "interrupted" => "is-warning", "running" or "active" or "processing" or "queued" => "is-active", _ => Batch.FailureCount > 0 ? "is-danger" : Batch.ReviewCount > 0 ? "is-warning" : "is-success" };
    private string ResultIcon => Batch.Status?.ToLowerInvariant() switch { "failed" => Icons.Material.Outlined.ErrorOutline, "abandoned" or "interrupted" => Icons.Material.Outlined.WarningAmber, "running" or "active" or "processing" or "queued" => Icons.Material.Outlined.Sync, _ => Batch.FailureCount > 0 ? Icons.Material.Outlined.ErrorOutline : Batch.ReviewCount > 0 ? Icons.Material.Outlined.WarningAmber : Icons.Material.Outlined.CheckCircle };
    private static string TimelineIcon(string state) => state switch { "failed" => Icons.Material.Outlined.ErrorOutline, "attention" => Icons.Material.Outlined.WarningAmber, "active" => Icons.Material.Outlined.RadioButtonUnchecked, _ => Icons.Material.Outlined.CheckCircle };
    private static string MediaIcon(string media) => media switch { "Music" => Icons.Material.Outlined.Album, "TV" => Icons.Material.Outlined.Tv, "Movies" => Icons.Material.Outlined.Movie, "Books" => Icons.Material.Outlined.MenuBook, "Audiobooks" => Icons.Material.Outlined.Headphones, "Comics" => Icons.Material.Outlined.CollectionsBookmark, _ => Icons.Material.Outlined.PlayCircle };
    private static string Humanize(string value) => string.Concat(value.Select((character, index) => index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString())).Replace('_', ' ');
    public void Dispose() { _lifetimeCts.Cancel(); _lifetimeCts.Dispose(); }
}
