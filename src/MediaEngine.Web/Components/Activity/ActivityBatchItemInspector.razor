@namespace MediaEngine.Web.Components.Activity
@using MediaEngine.Contracts.Activity

@if (Detail is null)
{
    <AppProgressBar Indeterminate="true" />
}
else
{
    <div class="batch-item-inspector">
        <header><div><h4>@Item.Title</h4><p>@ActivityDisplay.NormalizeMediaType(Item.MediaType) · @StringHelpers.FirstNonBlankOr("Processed", Detail.Status)</p></div></header>
        <div class="batch-item-inspector__sections">
            @foreach (var itemSection in ItemSections)
            {
                <article><MudIcon Icon="@itemSection.Icon" /><span><strong>@itemSection.Title</strong><small>@itemSection.Detail</small></span></article>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ActivityBatchItemDto Item { get; set; } = new();
    [Parameter] public ActivityBatchItemDetailDto? Detail { get; set; }
    private IReadOnlyList<ActivityEvidenceDto> Identification => Evidence("match", "identity", "qid", "canonical");
    private IReadOnlyList<ActivityEvidenceDto> Metadata => Evidence("metadata", "field");
    private IReadOnlyList<ActivityEvidenceDto> Artwork => Evidence("artwork", "image", "cover", "poster", "backdrop");
    private IReadOnlyList<ActivityEvidenceDto> Relationships => Evidence("relationship", "collection", "series", "universe");
    private IReadOnlyList<ActivityEvidenceDto> Subtitles => Evidence("subtitle");
    private IReadOnlyList<ActivityEvidenceDto> Lyrics => Evidence("lyric");
    private IReadOnlyList<ActivityEvidenceDto> Evidence(params string[] terms) => Detail?.Evidence.Where(entry => terms.Any(term => $"{entry.Kind} {entry.Label}".Contains(term, StringComparison.OrdinalIgnoreCase))).ToList() ?? [];
    private IReadOnlyList<ItemSection> ItemSections
    {
        get
        {
            if (Detail is null) return [];
            var sections = new List<ItemSection>();
            AddEvidence(sections, "Identification", Icons.Material.Outlined.Search, Identification);
            AddEvidence(sections, "Metadata", Icons.Material.Outlined.Description, Metadata);
            AddEvidence(sections, "Artwork", Icons.Material.Outlined.Image, Artwork);
            if (Detail.People.Count > 0) sections.Add(new("People & contributors", Icons.Material.Outlined.People, $"{Detail.People.Select(person => person.PersonId).Distinct().Count():N0} people · {string.Join(", ", Detail.People.Select(person => person.Role).Where(role => !string.IsNullOrWhiteSpace(role)).Distinct().Take(3))}"));
            AddEvidence(sections, "Relationships", Icons.Material.Outlined.AccountTree, Relationships);
            if (Detail.FileDetails.Count > 0) sections.Add(new("Files", Icons.Material.Outlined.Description, StringHelpers.FirstNonBlankOr("File information recorded", Detail.SourcePath)));
            AddEvidence(sections, "Subtitles", Icons.Material.Outlined.Subtitles, Subtitles);
            AddEvidence(sections, "Lyrics", Icons.Material.Outlined.Lyrics, Lyrics);
            if (Detail.Timeline.Count > 0) sections.Add(new("Technical events", Icons.Material.Outlined.Terminal, $"{Detail.Timeline.Count:N0} recorded for this item"));
            return sections;
        }
    }
    private static void AddEvidence(List<ItemSection> sections, string title, string icon, IReadOnlyList<ActivityEvidenceDto> entries)
    {
        if (entries.Count == 0) return;
        sections.Add(new(title, icon, string.Join(" · ", entries.Select(entry => StringHelpers.FirstNonBlankOr(entry.Kind, entry.Label, entry.Value)).Take(3))));
    }
    private sealed record ItemSection(string Title, string Icon, string Detail);
}
