@namespace MediaEngine.Web.Shared
@inherits LayoutComponentBase
@inject ThemeService ThemeService
@inject DeviceContextService DeviceContext
@inject UIOrchestratorService Orchestrator
@inject UniverseStateContainer State
@inject ShellActivityState Activity
@inject DashboardAuthUiOptions AuthUi
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> L
@inject ILogger<MainLayout> Logger
@implements IAsyncDisposable

@using MediaEngine.Web.Components.Listen
@using MediaEngine.Web.Components.Search
@using MediaEngine.Web.Components.Shared
@using MediaEngine.Web.Components.Watch
@using MediaEngine.Web.Models.ViewDTOs
@using MediaEngine.Web.Resources
@using Microsoft.Extensions.Localization

<MudThemeProvider Theme="@ThemeService.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

@if (!DeviceContext.IsFeatureDisabled("command_palette"))
{
    <UniversalSearchOverlay @ref="_searchOverlay" Closed="RestoreSearchFocusAsync" />
}

<a class="skip-to-content" href="#main-content">@L["Layout_SkipToContent"]</a>

<AppCssElement Tag="div" Class="layout-accent-scope" @onclick="CloseOpenShellMenus">
<MudLayout Class="@LayoutShellClass">
    <MudAppBar Fixed="true" Elevation="0" Dense="true" Class="@AppBarClass">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="layout-shell__left-rail">
            <MudLink Href="/" Underline="Underline.None" Class="layout-shell__brand-link" aria-label="Tuvima Library">
                <span class="layout-shell__brand-lockup-shell" aria-hidden="true">
                    <img src="/images/library.svg"
                         alt=""
                         class="layout-shell__brand-lockup" />
                </span>
            </MudLink>
        </MudStack>

        <nav class="layout-shell__desktop-nav" aria-label="Primary">
            @foreach (var link in _navLinks)
            {
                <a href="@link.Path"
                   @key="link.Path"
                   class="@GetNavLinkClass(link.Path)"
                   aria-current="@(IsNavActive(link.Path) ? "page" : null)">
                    <span class="layout-shell__nav-link-label">
                        @L[link.LabelKey].Value.ToUpperInvariant()
                    </span>
                </a>
            }
        </nav>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="layout-shell__actions">
            <span class="layout-shell__search-action-slot">
                <MudTooltip Text="@L["Nav_Search"]" Placement="Placement.Bottom">
                    <AppNativeButton Type="button"
                                     @ref="_searchButton"
                                     Class="layout-shell__search-action"
                                     AriaLabel="@L["Nav_Search"]"
                                     OnClick="@(_ => OpenSearch())">
                        <MudIcon Icon="@Icons.Material.Outlined.Search"
                                 Class="layout-shell__search-action-icon" />
                    </AppNativeButton>
                </MudTooltip>
            </span>

            <span class="layout-shell__my-list-slot">
                <MudTooltip Text="@L["TopBar_MyList"]" Placement="Placement.Bottom">
                    <AppNativeButton Type="button"
                                     Class="layout-shell__my-list"
                                     AriaLabel="@L["TopBar_MyList"]"
                                     OnClick="@(_ => OpenMyList())">
                        <MudIcon Icon="@Icons.Material.Filled.Bookmark"
                                 Class="layout-shell__my-list-icon" />
                    </AppNativeButton>
                </MudTooltip>
            </span>

            <span class="layout-shell__activity-slot">
                <SystemActivityIndicator ConnectionState="@Orchestrator.EngineConnectionState"
                                         CanOpenSystemActivity="@CanViewSystemActivity" />
            </span>

            <span @onclick:stopPropagation="true">
                <TopNavAccountMenu @key="_accountMenuVersion"
                                   DisplayName="@_displayName"
                                   ProfileRole="@_profileRole"
                                   AvatarInitial="@_avatarInitial"
                                   AvatarColor="@_avatarColor"
                                   AvatarForeground="@AvatarForeground"
                                   AvatarImageUrl="@_avatarImageUrl"
                                   ActiveProfileId="@_activeProfileId"
                                   Profiles="@_profiles"
                                   ReviewCount="@_reviewCount"
                                   CanViewReview="@CanViewReview"
                                   ShowSignOut="true"
                                   ProfileSelected="SwitchProfileAsync" />
            </span>
        </MudStack>
    </MudAppBar>

    @if (ShouldShowEngineStatusBanner)
    {
        <div class="layout-shell__engine-banner" role="status" aria-live="polite">
            <MudIcon Icon="@GetEngineStatusIcon()" Size="Size.Small" />
            <span>@GetEngineStatusBannerText()</span>
            @if (Orchestrator.EngineConnectionState == EngineConnectionState.LiveUpdatesDisconnected)
            {
                <AppNativeButton Type="button"
                                 Class="layout-shell__engine-banner-retry"
                                 AriaLabel="Retry live updates"
                                 OnClick="RetryLiveUpdatesAsync">
                    Retry
                </AppNativeButton>
            }
        </div>
    }

    <MudMainContent id="main-content" role="main" tabindex="-1" Class="@MainContentClass">
        <MudContainer MaxWidth="MaxWidth.False" Class="@MainContainerClass">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@if (DeviceContext.Settings.Shell.DockVisible)
{
    <nav class="@IntentDockClass" aria-label="Primary mobile navigation">
        @foreach (var link in IntentDockLinks)
        {
            <a href="@link.Path"
               @key="link.Path"
               class="@GetIntentDockLinkClass(link.Path)"
               aria-current="@(IsNavActive(link.Path) ? "page" : null)">
                <MudIcon Icon="@link.Icon" />
                <span>@L[link.LabelKey]</span>
            </a>
        }
    </nav>
}
</AppCssElement>

<PwaInstallPrompt />
<ListenNowPlayingBar />
<VideoPlaybackHost />

@code {
    private UniversalSearchOverlay? _searchOverlay;
    private AppNativeButton? _searchButton;
    private string _avatarColor = "var(--tl-accent-primary)";
    private string? _avatarImageUrl;
    private string _avatarInitial = "?";
    private string _currentPath = "/";
    private string _displayName = "User";
    private string _engineStatusSummary = string.Empty;
    private string _profileRole = "Profile";
    private Guid? _activeProfileId;
    private int _reviewCount;
    private int _accountMenuVersion;
    private List<ProfileViewModel> _profiles = [];
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private readonly record struct ShellNavLink(string Path, string LabelKey, string Icon = "");

    private static readonly ShellNavLink[] _navLinks =
    [
        new("/read", "Nav_Read"),
        new("/watch", "Nav_Watch"),
        new("/listen", "Nav_Listen"),
        new("/view", "Nav_View"),
        new("/collections", "Nav_Collections"),
    ];

    private static readonly IReadOnlyDictionary<string, ShellNavLink> _intentDockCatalog =
        new Dictionary<string, ShellNavLink>(StringComparer.OrdinalIgnoreCase)
        {
            ["Home"] = new("/", "Nav_Home", Icons.Material.Outlined.Home),
            ["Read"] = new("/read", "Nav_Read", Icons.Material.Outlined.MenuBook),
            ["Watch"] = new("/watch", "Nav_Watch", Icons.Material.Outlined.LiveTv),
            ["Listen"] = new("/listen", "Nav_Listen", Icons.Material.Outlined.Headphones),
            ["View"] = new("/view", "Nav_View", Icons.Material.Outlined.PhotoLibrary),
            ["Collections"] = new("/collections", "Nav_Collections", Icons.Material.Outlined.CollectionsBookmark),
        };

    private bool IsDetailShell => IsDetailPath(_currentPath);
    private bool IsCinematicShell => IsDetailShell || string.Equals(_currentPath, "/", StringComparison.Ordinal);
    private string LayoutShellClass => IsCinematicShell ? "app-bg app-bg--cinematic" : "app-bg";
    private string AppBarClass => IsCinematicShell
        ? "layout-shell__appbar layout-shell__appbar--cinematic"
        : "layout-shell__appbar";
    private string MainContentClass => IsCinematicShell
        ? "main-content-with-topbar main-content-with-topbar--cinematic"
        : "main-content-with-topbar";
    private string MainContainerClass => IsCinematicShell ? "px-0 py-0" : "py-6 px-0";
    private bool CanViewReview => SettingsNav.IsVisible(SettingsSection.Review, _profileRole);
    private bool CanViewSystemActivity => SettingsNav.IsVisible(SettingsSection.ActivityLogs, _profileRole);
    private IReadOnlyList<ShellNavLink> IntentDockLinks => DeviceContext.Settings.Shell.IntentDockItems
        .Select(item => _intentDockCatalog.TryGetValue(item, out var link) ? link : (ShellNavLink?)null)
        .Where(link => link.HasValue)
        .Select(link => link!.Value)
        .DistinctBy(link => link.Path, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private string IntentDockClass => string.Join(' ', new[]
    {
        "layout-shell__intent-dock",
        $"layout-shell__intent-dock--{NormalizeCssToken(DeviceContext.Settings.Shell.IntentDockStyle)}",
        DeviceContext.IsTelevision || DeviceContext.IsAutomotive ? "is-device-profile-dock" : null,
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override void OnInitialized()
    {
        DeviceContext.OnChanged += OnDeviceContextChanged;
        Nav.LocationChanged += OnLocationChanged;
        State.OnStateChanged += OnUniverseStateChanged;
        Orchestrator.OnEngineConnectionStateChanged += OnEngineConnectionStateChanged;
        SyncLocationState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var detectedDevice = await JS.InvokeAsync<string>("detectDeviceClass");
        await DeviceContext.InitialiseAsync(detectedDevice);

        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("tuvimaResponsive.registerDeviceClassObserver", _dotNetRef);

        if (!DeviceContext.IsFeatureDisabled("command_palette"))
        {
            await JS.InvokeVoidAsync("registerCtrlK", _dotNetRef);
        }

        await JS.InvokeVoidAsync("setThemeClass");

        await SyncCultureAsync();
        await LoadActiveProfileAsync();
        await LoadReviewCountAsync();
        await Orchestrator.StartSignalRAsync();
        await Activity.InitializeAsync();
        await LoadEngineStatusAsync();

        Orchestrator.OnReviewCountChanged += OnReviewCountChanged;
        Orchestrator.OnProfileChanged += OnProfileChanged;

        StateHasChanged();
    }

    [JSInvokable]
    public void OpenPalette() => _searchOverlay?.Open();

    [JSInvokable]
    public async Task HandleViewportDeviceClassChanged(string deviceClass)
    {
        if (DeviceContext.IsTelevision || DeviceContext.IsAutomotive)
            return;

        await DeviceContext.SwitchDeviceAsync(deviceClass, _activeProfileId?.ToString());
    }

    private void CloseOpenShellMenus(MouseEventArgs _) => _accountMenuVersion++;

    private void OnDeviceContextChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncLocationState();
        InvokeAsync(StateHasChanged);
    }

    private void OpenMyList() => Nav.NavigateTo("/my-list");

    private void OpenSearch() => _searchOverlay?.Open();

    private async Task RetryLiveUpdatesAsync(MouseEventArgs _)
    {
        await Orchestrator.StartSignalRAsync();
    }

    private async Task RestoreSearchFocusAsync()
    {
        if (_searchButton is not null)
            await _searchButton.FocusAsync();
    }

    private string GetNavLinkClass(string path) =>
        IsNavActive(path)
            ? "layout-shell__nav-link layout-shell__nav-link--active"
            : "layout-shell__nav-link";

    private string GetIntentDockLinkClass(string path) => IsNavActive(path)
        ? "layout-shell__intent-dock-link is-active"
        : "layout-shell__intent-dock-link";

    private void SyncLocationState()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var trimmedPath = relativePath.Split('?', '#')[0].Trim('/');
        _currentPath = string.IsNullOrWhiteSpace(trimmedPath)
            ? "/"
            : $"/{trimmedPath}";

    }

    private async Task SyncCultureAsync()
    {
        try
        {
            var settings = await Orchestrator.GetServerGeneralAsync();
            if (settings is not null && !string.IsNullOrEmpty(settings.DisplayLanguage))
            {
                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                var desired = settings.DisplayLanguage.Split('-', '_')[0].ToLowerInvariant();
                if (!string.Equals(currentCulture, desired, StringComparison.OrdinalIgnoreCase))
                {
                    var redirectBack = Uri.EscapeDataString(Nav.Uri);
                    Nav.NavigateTo($"/culture/set?culture={Uri.EscapeDataString(settings.DisplayLanguage)}&redirectUri={redirectBack}", forceLoad: true);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to sync culture during initial layout render.");
        }
    }

    private async Task LoadActiveProfileAsync()
    {
        try
        {
            var profile = await Orchestrator.GetActiveProfileAsync();
            if (profile is null)
            {
                return;
            }

            _profiles = await Orchestrator.GetProfilesAsync();
            _activeProfileId = profile.Id;
            _avatarColor = profile.AvatarColor;
            _avatarImageUrl = profile.AvatarImageUrl;
            _displayName = string.IsNullOrWhiteSpace(profile.DisplayName)
                ? "User"
                : profile.DisplayName.Trim();
            _profileRole = string.IsNullOrWhiteSpace(profile.Role)
                ? "Profile"
                : profile.Role.Trim();
            _avatarInitial = GetAvatarInitial(_displayName);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load active profile for layout shell.");
        }
    }

    private async Task SwitchProfileAsync(Guid profileId)
    {
        var profile = await Orchestrator.SetActiveProfileAsync(profileId);
        if (profile is null)
        {
            return;
        }

        await LoadActiveProfileAsync();
        await LoadReviewCountAsync();
        StateHasChanged();
    }

    private async Task LoadReviewCountAsync()
    {
        if (!CanViewReview)
        {
            _reviewCount = 0;
            return;
        }

        try
        {
            _reviewCount = await Orchestrator.RefreshReviewCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load review count for layout shell.");
        }
    }

    private async Task LoadEngineStatusAsync()
    {
        try
        {
            var status = await Orchestrator.GetSystemStatusAsync();
            _engineStatusSummary = BuildEngineStatusSummary(status);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load Engine status for layout shell.");
            _engineStatusSummary = BuildEngineStatusSummary(null);
        }
    }

    private void OnReviewCountChanged()
    {
        _reviewCount = CanViewReview ? Orchestrator.ReviewCount : 0;
        InvokeAsync(StateHasChanged);
    }

    private void OnProfileChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadActiveProfileAsync();
            await LoadReviewCountAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        DeviceContext.OnChanged -= OnDeviceContextChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Orchestrator.OnReviewCountChanged -= OnReviewCountChanged;
        Orchestrator.OnProfileChanged -= OnProfileChanged;
        Orchestrator.OnEngineConnectionStateChanged -= OnEngineConnectionStateChanged;
        State.OnStateChanged -= OnUniverseStateChanged;

        try
        {
            await JS.InvokeVoidAsync("unregisterCtrlK");
            await JS.InvokeVoidAsync("tuvimaResponsive.unregisterDeviceClassObserver");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Failed to unregister Ctrl+K during layout disposal.");
        }

        _dotNetRef?.Dispose();
    }

    private string BuildEngineStatusSummary(SystemStatusViewModel? status)
    {
        var engineLabel = status?.IsHealthy == true
            ? L["TopBar_EngineOnline"]
            : L["TopBar_EngineUnavailable"];
        var liveUpdatesLabel = Orchestrator.IsIntercomConnected
            ? L["TopBar_LiveUpdatesConnected"]
            : L["TopBar_LiveUpdatesOffline"];

        return $"{engineLabel} - {liveUpdatesLabel}";
    }

    private bool ShouldShowEngineStatusBanner =>
        Orchestrator.EngineConnectionState is EngineConnectionState.Offline
            or EngineConnectionState.Degraded
            or EngineConnectionState.Reconnecting
            or EngineConnectionState.LiveUpdatesDisconnected;

    private string GetEngineStatusBannerText() => Orchestrator.EngineConnectionState switch
    {
        EngineConnectionState.Offline => L["TopBar_EngineUnavailable"],
        EngineConnectionState.Degraded => L["TopBar_EngineDegradedBanner"],
        EngineConnectionState.Reconnecting => L["TopBar_LiveUpdatesReconnecting"],
        EngineConnectionState.LiveUpdatesDisconnected => L["TopBar_LiveUpdatesOffline"],
        _ => _engineStatusSummary,
    };

    private void OnEngineConnectionStateChanged(EngineConnectionState state)
    {
        _engineStatusSummary = state switch
        {
            EngineConnectionState.Offline => BuildEngineStatusSummary(null),
            EngineConnectionState.Degraded => L["TopBar_EngineDegradedSummary"],
            EngineConnectionState.Reconnecting => L["TopBar_LiveUpdatesReconnecting"],
            EngineConnectionState.LiveUpdatesDisconnected => $"{L["TopBar_EngineOnline"]} - {L["TopBar_LiveUpdatesOffline"]}",
            EngineConnectionState.Online => $"{L["TopBar_EngineOnline"]} - {L["TopBar_LiveUpdatesConnected"]}",
            _ => _engineStatusSummary,
        };
        InvokeAsync(StateHasChanged);
    }

    private void OnUniverseStateChanged() => InvokeAsync(StateHasChanged);

    private string GetEngineStatusIcon() =>
        _engineStatusSummary.Contains(L["TopBar_EngineOnline"].Value, StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Filled.CheckCircle
            : Icons.Material.Filled.ErrorOutline;

    private bool IsNavActive(string path) =>
        _currentPath.Equals(path, StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);

    private static bool IsDetailPath(string path)
        => path.StartsWith("/details/", StringComparison.OrdinalIgnoreCase);

    private static string NormalizeCssToken(string? value) => string.IsNullOrWhiteSpace(value)
        ? "normal"
        : new string(value.Trim().ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-')
            .ToArray());

    private static string GetAvatarInitial(string displayName)
    {
        var firstLetter = displayName.FirstOrDefault(static c => !char.IsWhiteSpace(c));
        return firstLetter == default
            ? "?"
            : char.ToUpperInvariant(firstLetter).ToString();
    }

    private string AvatarForeground
    {
        get
        {
            var theme = ThemeService.Theme.PaletteDark;
            return GetAvatarForeground(_avatarColor, theme.TextPrimary.ToString(), theme.Background.ToString());
        }
    }

    private static string GetAvatarForeground(string backgroundHex, string lightForeground, string darkForeground)
    {
        if (!TryParseHexColor(backgroundHex, out var r, out var g, out var b))
        {
            return lightForeground;
        }

        var luminance = (0.299 * r) + (0.587 * g) + (0.114 * b);
        return luminance >= 160 ? darkForeground : lightForeground;
    }

    private static bool TryParseHexColor(string input, out int red, out int green, out int blue)
    {
        red = green = blue = 0;
        if (string.IsNullOrWhiteSpace(input))
        {
            return false;
        }

        var value = input.Trim().TrimStart('#');
        if (value.Length == 3)
        {
            value = string.Concat(value.Select(character => $"{character}{character}"));
        }

        if (value.Length != 6)
        {
            return false;
        }

        return int.TryParse(value[..2], System.Globalization.NumberStyles.HexNumber, null, out red)
            && int.TryParse(value.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out green)
            && int.TryParse(value.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out blue);
    }
}

<style>
    .skip-to-content {
        position: fixed;
        top: 8px;
        left: 8px;
        z-index: 5000;
        padding: 8px 12px;
        border-radius: 6px;
        background: var(--tl-accent-primary);
        color: #080B14;
        font-weight: 700;
        transform: translateY(-160%);
        transition: transform 0.12s ease;
    }

    .skip-to-content:focus {
        transform: translateY(0);
    }

    .layout-shell__engine-banner {
        position: fixed;
        top: 56px;
        left: 0;
        right: 0;
        z-index: 1100;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 32px;
        padding: 6px 16px;
        border-bottom: 1px solid rgba(255, 190, 92, 0.24);
        background: rgba(60, 42, 14, 0.92);
        color: var(--tl-text-primary);
        font-size: 0.82rem;
    }
</style>
